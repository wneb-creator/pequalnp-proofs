import PEqualNP.MetaComplexity.L1049

theorem PEqualNP.MetaComplexity.L1355 : (∀ h t : ℕ, 1 ≤ h → (2 ^ h * 2 ^ h / 2) * (2 ^ ((h + 3 + 2 ^ t - 1) / 2 ^ t - 1 - 1) - 1) ≤ (WithTop.untopD 0 (((Finset.range (h + 3)).powerset.filter (fun P : Finset ℕ => P.card + 1 ≤ 2 ^ t)).image (fun P : Finset ℕ => ((Finset.range (h + 3) ×ˢ Finset.range (h + 3)).filter (fun uv : ℕ × ℕ => uv.1 ≤ uv.2 ∧ ∀ w ∈ P, ¬ (uv.1 < w ∧ w ≤ uv.2))).sup (fun uv : ℕ × ℕ => ((if uv.1 = 0 then (2 ^ h * 2 ^ h + 2 ^ h + 1) else if uv.1 = h + 2 then 0 else 2 ^ h * (2 ^ h + 1) / 2 ^ (uv.1 - 1) - 2 ^ h) - (if uv.2 = 0 then (2 ^ h * 2 ^ h + 2 ^ h + 1) else if uv.2 = h + 2 then 0 else 2 ^ h * (2 ^ h + 1) / 2 ^ (uv.2 - 1) - 2 ^ h)) * (if uv.2 = h + 2 then 2 ^ h else 2 ^ (uv.2 - 1) - 1)))).min)) → ∀ (h q n t : ℕ) (S : Fin n → Finset (Fin n)) (K : Fin (h + 1) → Finset (Fin n)), 1 ≤ h → q = 2 ^ h → n = q * q + q + 1 → (∀ i : Fin n, (S i).card = q + 1) → (∀ i j : Fin n, i ≠ j → (S i ∩ S j).card = 1) → (∀ p p' : Fin n, p ≠ p' → ∃ i : Fin n, p ∈ S i ∧ p' ∈ S i) → (∀ j : Fin (h + 1), (K j).card = (2 ^ (j : ℕ) - 1) * q + 2 ^ (j : ℕ)) → (∀ (j : Fin (h + 1)) (i : Fin n), (S i ∩ K j).card = 0 ∨ (S i ∩ K j).card = 2 ^ (j : ℕ)) → (∀ j j' : Fin (h + 1), j ≤ j' → K j ⊆ K j') → ∀ (gates : List PEqualNP.CircuitLowerBounds.Gate) (out : Fin n → ℕ), (∀ g ∈ gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) → (∃ ι : Fin t → Fin gates.length, ∀ i : Fin gates.length, (gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → ∃ j : Fin t, ι j = i) → (∀ (w : Fin n) (x : Fin n → Bool), PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, out w⟩ (List.ofFn x) = decide (∃ v ∈ S w, x v = true)) → (q * q / 2) * (2 ^ ((h + 3 + 2 ^ t - 1) / 2 ^ t - 1 - 1) - 1) ≤ gates.length := by
  intro hv h q n t S K h1 hq hn hS hSS hcov hK hKS hmono gates out hops hnot hout
  subst hq; subst hn
  exact le_trans (hv h t h1) (PEqualNP.MetaComplexity.L1049 h _ _ t S K h1 rfl rfl hS hSS hcov hK hKS hmono gates out hops hnot hout)
