import PEqualNP.MetaComplexity.Helpers.Guard965Main

/-- The guard lemma, conditional on the recorded statements of L-meta-669, L-meta-738 and
L-meta-782 taken as hypotheses: on an incidence of points and lines with no two points on two
common lines, let a fan-in-two AND/OR circuit have products of a wire `fa j` and a wire `fb j` of
line-degree at most 1, each product true only where an incident point and line are both on. Fix
a set `Wz` of lines. The incident pairs (p, w), with w outside `Wz` and p on no line of `Wz`, such
that some `fa j` is true at (p, `Wz`) and its `fb j` at (p, w), number at most the lines outside
`Wz` plus twice the size plus twice the number of products. -/
theorem PEqualNP.MetaComplexity.L965 : ∀ (Np Nl Jn : ℕ) (Inc : Fin Np → Fin Nl → Prop) [DecidableRel Inc] (Ckt : PEqualNP.CircuitLowerBounds.Circuit) (fa fb : Fin Jn → ℕ) (Wz : Finset (Fin Nl)), (∀ (n : ℕ) (gates : List PEqualNP.CircuitLowerBounds.Gate) (T Z : Finset (Fin n)), (∀ g ∈ gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) → ∃ (gates' : List PEqualNP.CircuitLowerBounds.Gate) (r : ℕ → ℕ), (∀ g ∈ gates', (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length = 2) ∧ gates'.length ≤ gates.length ∧ ∀ o : ℕ, (∃ x y : Fin n → Bool, PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, o⟩ (List.ofFn (fun i => if i ∈ T then true else if i ∈ Z then false else x i)) ≠ PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, o⟩ (List.ofFn (fun i => if i ∈ T then true else if i ∈ Z then false else y i))) → ∀ x : Fin n → Bool, PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates', r o⟩ (List.ofFn x) = PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, o⟩ (List.ofFn (fun i => if i ∈ T then true else if i ∈ Z then false else x i))) → (∀ (P1 L1 : ℕ) (C1 : PEqualNP.CircuitLowerBounds.Circuit) (N1 : Finset (Fin L1)), PEqualNP.CircuitLowerBounds.IsMonotoneCircuit C1 → (∀ g1 ∈ C1.gates, g1.inputs.length ≤ 2) → PEqualNP.CircuitLowerBounds.HasLineDegree (P1 + L1) (Finset.Ico P1 (P1 + L1)) C1 1 → (∀ j1 : Fin C1.gates.length, Relation.ReflTransGen (fun a1 b1 : ℕ => a1 < b1 ∧ ∃ i1 : Fin C1.gates.length, b1 = P1 + L1 + i1.val ∧ a1 ∈ (C1.gates.get i1).inputs) (P1 + L1 + j1.val) C1.output) → (∀ w1 : Fin L1, w1 ∈ N1 ↔ Relation.ReflTransGen (fun r1 s1 : ℕ => r1 < s1 ∧ ∃ k1 : Fin C1.gates.length, s1 = P1 + L1 + k1.val ∧ r1 ∈ (C1.gates.get k1).inputs) (P1 + w1.val) C1.output) → ∃ (D1 : PEqualNP.CircuitLowerBounds.Circuit) (T1 : Finset (Fin L1)) (o1 : Fin L1 → ℕ), PEqualNP.CircuitLowerBounds.IsMonotoneCircuit D1 ∧ (∀ h1 ∈ D1.gates, h1.inputs.length ≤ 2) ∧ D1.size + N1.card ≤ C1.size + 1 ∧ ∀ (x1 : Fin P1 → Bool) (y1 : Fin L1 → Bool), C1.eval (List.ofFn x1 ++ List.ofFn y1) = (C1.eval (List.ofFn x1 ++ List.ofFn (fun v1 : Fin L1 => false)) || decide (∃ u1 : Fin L1, y1 u1 = true ∧ (u1 ∈ T1 ∨ (D1.wires (List.ofFn x1)).getD (o1 u1) false = true)))) → (∀ (n m k : ℕ) (S : Fin m → Finset (Fin n)) (C : PEqualNP.CircuitLowerBounds.Circuit) (o : Fin m → ℕ) (c : Fin m → ℕ), (∀ i j : Fin m, i ≠ j → (S i ∩ S j).card ≤ 1) → (∀ i : Fin m, 2 ≤ (Finset.univ.filter (fun a : Fin n => (C.wires (List.ofFn (fun b : Fin n => decide (b = a)))).getD (o i) false = true)).card) → (∀ g ∈ C.gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length = 2) → (∀ (i : Fin m) (p : Fin n), (C.wires (List.ofFn (fun q : Fin n => decide (q = p)))).getD (o i) false = true → p ∈ S i) → (∀ (i : Fin m) (x : Fin n → Bool), (Finset.univ.filter (fun q : Fin n => x q = true)).card ≤ k → (∀ q ∈ S i, x q = false) → (C.wires (List.ofFn x)).getD (o i) false = false) → (∀ i : Fin m, c i ≤ k) → (∀ i : Fin m, c i + 1 ≤ (Finset.univ.filter (fun a : Fin n => (C.wires (List.ofFn (fun b : Fin n => decide (b = a)))).getD (o i) false = true)).card) → ∑ i : Fin m, c i ≤ C.size) → (∀ (pt pt' : Fin Np) (ln ln' : Fin Nl), pt ≠ pt' → ln ≠ ln' → ¬ (Inc pt ln ∧ Inc pt ln' ∧ Inc pt' ln ∧ Inc pt' ln')) → PEqualNP.MetaComplexity.Monotone2 Ckt → (∀ jd : Fin Jn, (Ckt.lineDegrees (Np + Nl) (Finset.Ico Np (Np + Nl))).getD (fb jd) 0 ≤ 1) → (∀ (jb : Fin Jn) (zz : Fin (Np + Nl) → Bool), (Ckt.wires (List.ofFn zz)).getD (fa jb) false = true → (Ckt.wires (List.ofFn zz)).getD (fb jb) false = true → ∃ (pa : Fin Np) (lb : Fin Nl), Inc pa lb ∧ zz (Fin.castAdd Nl pa) = true ∧ zz (Fin.natAdd Np lb) = true) → (Finset.univ.filter (fun e2 : Fin Np × Fin Nl => Inc e2.1 e2.2 ∧ e2.2 ∉ Wz ∧ (∀ uu ∈ Wz, ¬ Inc e2.1 uu) ∧ ∃ jc : Fin Jn, (Ckt.wires (List.ofFn (fun vv : Fin (Np + Nl) => if vv = Fin.castAdd Nl e2.1 then true else decide (∃ ww ∈ Wz, vv = Fin.natAdd Np ww)))).getD (fa jc) false = true ∧ (Ckt.wires (List.ofFn (fun vq : Fin (Np + Nl) => if vq = Fin.castAdd Nl e2.1 then true else if vq = Fin.natAdd Np e2.2 then true else false))).getD (fb jc) false = true)).card ≤ (Finset.univ.filter (fun lc : Fin Nl => lc ∉ Wz)).card + 2 * Ckt.size + 2 * Jn :=
  PEqualNP.MetaComplexity.Guard965.guard_main
