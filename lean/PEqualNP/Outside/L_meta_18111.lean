namespace PEqualNP.Outside.L_meta_18111

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

private instance : DecidableEq GateOp := NestedCover.gateOpDecEq

private def orNor (g : Gate) : Prop := g.op = GateOp.or ∨ g.op = GateOp.not

private def reads {n : ℕ} (rs : List (Finset (Fin n))) (g : Gate) : Finset (Fin n) :=
  g.inputs.toFinset.biUnion (fun i => rs.getD i ∅)

private def headAt {α : Type} (xs : List α) (d : α) (g : Gate) : α :=
  (g.inputs.head?.map fun i => xs.getD i d).getD d

private def rawStep {n : ℕ} (rs : List (Finset (Fin n))) (g : Gate) : List (Finset (Fin n)) :=
  rs ++ [if g.op = GateOp.or then reads rs g else ∅]

private def raws {n : ℕ} (gs : List Gate) (rs : List (Finset (Fin n))) : List (Finset (Fin n)) :=
  gs.foldl rawStep rs

private def guardList {n : ℕ} : List Gate → List (Finset (Fin n)) → List (Finset (Fin n))
  | [], _ => []
  | g :: gs, rs => if g.op = GateOp.not then headAt rs ∅ g :: guardList gs (rawStep rs g)
                   else guardList gs (rawStep rs g)

private def evalStep (ws : List Bool) (g : Gate) : List Bool :=
  ws ++ [g.op.eval (g.inputs.map fun i => ws.getD i false)]

private def evalWires (gs : List Gate) (ws : List Bool) : List Bool := gs.foldl evalStep ws

private def hit {n : ℕ} (x : Fin n → Bool) (s : Finset (Fin n)) : Prop := ∃ i ∈ s, x i = true

private def Init (n : ℕ) : List (Finset (Fin n)) := List.ofFn (fun i : Fin n => {i})

private def Sound {n : ℕ} (x : Fin n → Bool) (rs : List (Finset (Fin n))) (ws : List Bool) : Prop :=
  ∀ j : ℕ, hit x (rs.getD j ∅) → ws.getD j false = true

private def AllOnes (n : ℕ) : Fin n → Bool := fun _ => true

private theorem getD_appendLast {α : Type} (xs : List α) (v d : α) (i : ℕ) :
    (xs ++ [v]).getD i d = if i = xs.length then v else xs.getD i d := by
  by_cases hi : i < xs.length
  · rw [ite_eq_right (by omega), List.getD_append _ _ _ _ hi]
  · by_cases hEq : i = xs.length
    · rw [hEq, ite_eq_left rfl, List.getD_append_right _ _ _ _ (Nat.le_refl _), Nat.sub_self]
      rfl
    · rw [ite_eq_right hEq, List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by omega)]

private theorem hitReads {n : ℕ} (x : Fin n → Bool) (rs : List (Finset (Fin n))) (g : Gate) :
    hit x (reads rs g) ↔ ∃ j ∈ g.inputs, hit x (rs.getD j ∅) := by
  constructor
  · rintro ⟨i, hi, hx⟩
    obtain ⟨j,hj,hmem⟩ := Finset.mem_biUnion.mp hi
    exact ⟨j, List.mem_toFinset.mp hj, i, hmem, hx⟩
  · rintro ⟨j,hj,i,hi,hx⟩
    exact ⟨i, Finset.mem_biUnion.mpr ⟨j,List.mem_toFinset.mpr hj,hi⟩, hx⟩

private theorem orEval (g : Gate) (ws : List Bool) (hor : g.op = GateOp.or) :
    g.op.eval (g.inputs.map fun i => ws.getD i false) = true ↔ ∃ i ∈ g.inputs, ws.getD i false = true := by
  simp [hor,GateOp.eval,List.any_eq_true]

private theorem notEval (g : Gate) (ws : List Bool) (hnot : g.op = GateOp.not) :
    g.op.eval (g.inputs.map fun i => ws.getD i false) = !headAt ws false g := by
  simp only [hnot,GateOp.eval,headAt]
  cases g.inputs <;> rfl

private theorem soundStep {n : ℕ} (x : Fin n → Bool) (r : List (Finset (Fin n)))
    (w : List Bool) (g : Gate) (hl : r.length = w.length) (hs : Sound x r w) :
    Sound x (rawStep r g) (evalStep w g) := by
  intro j hj
  unfold rawStep evalStep at *
  rw [getD_appendLast,hl] at hj
  rw [getD_appendLast]
  by_cases h : j = w.length
  · rw [ite_eq_left h] at hj ⊢
    by_cases hor : g.op = GateOp.or
    · rw [ite_eq_left hor, hitReads] at hj
      obtain ⟨i,hi,hv⟩ := hj
      exact (orEval g w hor).mpr ⟨i,hi,hs _ hv⟩
    · rw [ite_eq_right hor] at hj
      obtain ⟨_, h, _⟩ := hj
      exact (Finset.notMem_empty _ h).elim
  · rw [ite_eq_right h] at hj ⊢
    exact hs _ hj

private theorem soundRun {n : ℕ} (x : Fin n → Bool) (gs : List Gate)
    (r : List (Finset (Fin n))) (w : List Bool) (hl : r.length = w.length) (hs : Sound x r w) :
    Sound x (raws gs r) (evalWires gs w) := by
  induction gs generalizing r w with
  | nil => exact hs
  | cons g gs ih =>
    apply ih
    · simp [rawStep,evalStep,hl]
    · exact soundStep x r w g hl hs

private theorem initSound {n : ℕ} (x : Fin n → Bool) : Sound x (Init n) (List.ofFn x) := by
  intro j hj
  by_cases hjn : j < n
  · have hr : (Init n).getD j ∅ = {⟨j,hjn⟩} := by
      rw [Init,List.getD_eq_getElem _ _ (by simpa using hjn), List.getElem_ofFn]
    have hx : (List.ofFn x).getD j false = x ⟨j,hjn⟩ := by
      rw [List.getD_eq_getElem _ _ (by simpa using hjn), List.getElem_ofFn]
    obtain ⟨i,hi,hv⟩ := hj
    rw [hr,Finset.mem_singleton] at hi
    exact hx.trans (hi ▸ hv)
  · rw [List.getD_eq_default _ _ (by simp [Init]; omega)] at hj
    obtain ⟨_,h,_⟩ := hj
    exact (Finset.notMem_empty _ h).elim

private theorem allOnesRun {n : ℕ} (gs : List Gate) (r : List (Finset (Fin n))) (w : List Bool)
    (hops : ∀ g ∈ gs, orNor g) (hl : r.length = w.length)
    (initial : ∀ i, w.getD i false = true ↔ (r.getD i ∅).Nonempty)
    (guards : ∀ a ∈ guardList gs r, a.Nonempty) :
    ∀ i, (evalWires gs w).getD i false = true ↔ ((raws gs r).getD i ∅).Nonempty := by
  induction gs generalizing r w with
  | nil => exact initial
  | cons g gs ih =>
    change ∀ i, (evalWires gs (evalStep w g)).getD i false = true ↔
      ((raws gs (rawStep r g)).getD i ∅).Nonempty
    apply ih
    · exact fun g' h => hops g' (List.mem_cons_of_mem g h)
    · simp [rawStep,evalStep,hl]
    · intro j
      simp only [rawStep,evalStep,getD_appendLast,hl]
      by_cases h : j = w.length
      · rw [ite_eq_left h,ite_eq_left h]
        rcases hops g (by simp) with hor | hnot
        · rw [ite_eq_left hor,orEval g w hor]
          simp only [Finset.Nonempty]
          exact (exists_congr fun i => and_congr_right fun _ => initial i).trans (by
            simpa [hit,AllOnes,Finset.Nonempty] using (hitReads (AllOnes n) r g).symm)
        · have hex : (headAt r ∅ g).Nonempty := guards _ (by simp [guardList,hnot])
          have hv : headAt w false g = true := by
            unfold headAt at hex ⊢
            cases hh : g.inputs.head? with
            | none => simp [hh] at hex
            | some i => exact (initial i).mpr (by simpa [hh] using hex)
          rw [notEval g w hnot,hv]
          have hor : ¬g.op = GateOp.or := by rw [hnot]; decide
          simp [hor]
      · simpa only [ite_eq_right h] using initial j
    · intro a ha
      apply guards a
      by_cases hn : g.op = GateOp.not <;> simp [guardList,hn,ha]

private theorem initAll {n : ℕ} (i : ℕ) :
    (List.ofFn (AllOnes n)).getD i false = true ↔ ((Init n).getD i ∅).Nonempty := by
  by_cases hi : i < n
  · rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn,
      Init,List.getD_eq_getElem _ _ (by simpa using hi),List.getElem_ofFn]
    simp [AllOnes]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp [Init]; omega)]
    simp

private def EqualHere {n : ℕ} (x y : Fin n → Bool) (r : List (Finset (Fin n))) (w w' : List Bool) : Prop :=
  ∀ j, (hit x (r.getD j ∅) ↔ hit y (r.getD j ∅)) → w.getD j false = w'.getD j false

private theorem equalRun {n : ℕ} (x y : Fin n → Bool) (gs : List Gate)
    (r : List (Finset (Fin n))) (w w' : List Bool) (hops : ∀ g ∈ gs, orNor g)
    (hl : r.length = w.length) (hl' : r.length = w'.length)
    (sx : Sound x r w) (sy : Sound y r w') (hinit : EqualHere x y r w w')
    (guards : ∀ a ∈ guardList gs r, hit x a ↔ hit y a) :
    EqualHere x y (raws gs r) (evalWires gs w) (evalWires gs w') := by
  induction gs generalizing r w w' with
  | nil => exact hinit
  | cons g gs ih =>
    change EqualHere x y (raws gs (rawStep r g)) (evalWires gs (evalStep w g))
      (evalWires gs (evalStep w' g))
    apply ih
    · exact fun g' h => hops g' (List.mem_cons_of_mem g h)
    · simp [rawStep,evalStep,hl]
    · simp [rawStep,evalStep,hl']
    · exact soundStep x r w g hl sx
    · exact soundStep y r w' g hl' sy
    · intro j hsame
      simp only [rawStep,evalStep,getD_appendLast,← hl,← hl'] at hsame ⊢
      by_cases h : j = r.length
      · rw [ite_eq_left h] at hsame
        rw [ite_eq_left h,ite_eq_left h]
        rcases hops g (by simp) with hor | hnot
        · rw [ite_eq_left hor] at hsame
          by_cases hx : hit x (reads r g)
          · have h1 := soundStep x r w g hl sx r.length (by
              simpa [rawStep,getD_appendLast,hor] using hx)
            have h2 := soundStep y r w' g hl' sy r.length (by
              simpa [rawStep,getD_appendLast,hor] using hsame.mp hx)
            rw [evalStep,getD_appendLast,← hl,ite_eq_left rfl] at h1
            rw [evalStep,getD_appendLast,← hl',ite_eq_left rfl] at h2
            exact h1.trans h2.symm
          · have hy : ¬ hit y (reads r g) := fun h => hx (hsame.mpr h)
            apply Bool.eq_iff_iff.mpr
            rw [orEval g w hor, orEval g w' hor]
            refine exists_congr (fun i => and_congr_right (fun hi => ?_))
            have eh : w.getD i false = w'.getD i false := hinit i (by
              have hnoX : ¬ hit x (r.getD i ∅) := fun hh => hx ((hitReads x r g).mpr ⟨i,hi,hh⟩)
              have hnoY : ¬ hit y (r.getD i ∅) := fun hh => hy ((hitReads y r g).mpr ⟨i,hi,hh⟩)
              exact iff_of_false hnoX hnoY)
            rw [eh]
        · have he : hit x (headAt r ∅ g) ↔ hit y (headAt r ∅ g) :=
            guards _ (by simp [guardList,hnot])
          rw [notEval g w hnot,notEval g w' hnot]
          unfold headAt at he ⊢
          cases hh : g.inputs.head? with
          | none => rfl
          | some i => simpa [hh] using congrArg (fun b : Bool => !b) (hinit i (by simpa [hh] using he))
      · rw [ite_eq_right h] at hsame
        rw [ite_eq_right h,ite_eq_right h]
        exact hinit j hsame
    · intro a ha
      apply guards a
      by_cases hn : g.op = GateOp.not <;> simp [guardList,hn,ha]

private theorem initEqual {n : ℕ} (x y : Fin n → Bool) :
    EqualHere x y (Init n) (List.ofFn x) (List.ofFn y) := by
  intro j he
  by_cases hj : j < n
  · unfold Init at he
    rw [List.getD_eq_getElem _ _ (by simpa using hj),List.getElem_ofFn] at he
    rw [List.getD_eq_getElem _ _ (by simpa using hj), List.getElem_ofFn,
      List.getD_eq_getElem _ _ (by simpa using hj),List.getElem_ofFn]
    exact Bool.eq_iff_iff.mpr (by simpa [hit] using he)
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega)]

private theorem guard_length {n : ℕ} (gs : List Gate) (r : List (Finset (Fin n))) :
    (guardList gs r).length = gs.countP (fun g => decide (g.op = GateOp.not)) := by
  induction gs generalizing r with
  | nil => rfl
  | cons g gs ih => by_cases h : g.op = GateOp.not <;> simp [guardList,h,ih]

private def petTarget (x : Fin 10 → Bool) : Bool :=
  decide (∃ i j : Fin 10, x i = true ∧ x j = true ∧
    (([50,69,138,276,521,385,770,548,104,208] : List ℕ).getD i.val 0).testBit j.val = true)

open PEqualNP.Outside.L_meta_18111_aux in
private theorem target_eq (x : Fin 10 → Bool) : petTarget x = petersenF x := by
  apply Bool.eq_iff_iff.mpr
  rw [show petersenF x = PetersenTen.edgeFun PetersenTen.edges x from rfl,
    PetersenTen.edgeFun_true]
  have edge_eq : ∀ i j : Fin 10, (([50,69,138,276,521,385,770,548,104,208] : List ℕ).getD i.val 0).testBit j.val = true ↔
      (i,j) ∈ PetersenTen.edges ∨ (j,i) ∈ PetersenTen.edges := by decide +kernel
  simp only [petTarget,decide_eq_true_eq]
  constructor
  · rintro ⟨i,j,hi,hj,he⟩
    rcases (edge_eq i j).mp he with h | h
    · exact ⟨i,j,h,hi,hj⟩
    · exact ⟨j,i,h,hj,hi⟩
  · rintro ⟨i,j,he,hi,hj⟩
    exact ⟨i,j,hi,hj,(edge_eq i j).mpr (Or.inl he)⟩

private def pairIn (i j k : Fin 10) : Bool := decide (k = i ∨ k = j)

private theorem hitPair (i j : Fin 10) (s : Finset (Fin 10)) :
    hit (pairIn i j) s ↔ i ∈ s ∨ j ∈ s := by
  constructor
  · rintro ⟨k,hk,h⟩
    have he : k = i ∨ k = j := of_decide_eq_true h
    rcases he with rfl | rfl
    · exact Or.inl hk
    · exact Or.inr hk
  · rintro (hi | hj)
    · exact ⟨i,hi,decide_eq_true (Or.inl rfl)⟩
    · exact ⟨j,hj,decide_eq_true (Or.inr rfl)⟩

private theorem petNoTwins : ∀ i j : Fin 10, i ≠ j → ∃ k : Fin 10,
    petTarget (pairIn i k) ≠ petTarget (pairIn j k) := by decide +kernel

private theorem petSingleton (i : Fin 10) : petTarget (fun j => decide (j = i)) = false := by
  exact (show ∀ i : Fin 10, petTarget (fun j => decide (j = i)) = false by decide +kernel) i

private theorem petAll : petTarget (AllOnes 10) = true := by decide +kernel

private theorem allOrNor (D : Circuit) (hop : ∀ g ∈ D.gates, orNor g)
    (compute : ∀ x : Fin 10 → Bool, D.eval (List.ofFn x) = petTarget x)
    (hg : (guardList D.gates (Init 10)).length ≤ 4) : False := by
  classical
  let R := raws D.gates (Init 10)
  let guards := guardList D.gates (Init 10)
  have hlen (x : Fin 10 → Bool) : (Init 10).length = (List.ofFn x).length := by simp [Init]
  have hRaw : R.getD D.output ∅ = ∅ := by
    by_contra hne
    obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    let x : Fin 10 → Bool := fun j => decide (j = i)
    have hs := soundRun x D.gates (Init 10) (List.ofFn x) (hlen x) (initSound x) D.output
      ⟨i,hi,decide_eq_true rfl⟩
    change D.eval (List.ofFn x) = true at hs
    rw [compute x, petSingleton i] at hs
    exact Bool.noConfusion hs
  have emptyGuard : ∅ ∈ guards := by
    by_contra h
    have nempty : ∀ s ∈ guardList D.gates (Init 10), s.Nonempty := by
      intro s hs
      apply Finset.nonempty_iff_ne_empty.mpr
      rintro rfl
