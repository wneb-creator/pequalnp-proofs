    petersenF x := by
  simp only [petersenF, PetersenTen.edgeFun, PetersenTen.edges, List.any_cons, List.any_nil,
    Bool.or_false, Bool.or_assoc]

lemma notCount_eq_filter_isNotGate (C : Circuit) :
    PEqualNP.NotBracket.notCount C = (C.gates.filter fun g => isNotGate g.op).length := by
  unfold PEqualNP.NotBracket.notCount
  congr 1
  apply List.filter_congr
  intro g _
  cases g.op <;> rfl

theorem main_proof (C : Circuit) (hFan : FanInTwo C) (hSize : C.size ≤ 18)
    (hNot : 5 ≤ PEqualNP.NotBracket.notCount C)
    (hAll : ∀ x : Fin 10 → Bool, C.eval (List.ofFn x ++ [x 0 || x 2]) = petersenF x) :
    False := by
