def code (a : ℕ) : ℕ := ((witnesses[a/128]?).getD #[])[a%128]?.getD 0 - 1

def representative (c : ℕ) : Fin 26 := Fin.ofNat 26 (c/39)
def multiplier (c : ℕ) : Fin 3 := Fin.ofNat 3 (c/13%3)
def shift (c : ℕ) : Fin 13 := Fin.ofNat 13 (c%13)

def orbitMatch (a : ℕ) (i : Fin 26) (k : Fin 3) (r : Fin 13) : Prop :=
  let p := reps.getD i.val (0,0)
  ∀ v : Fin 13, bits a v = transform p.1 k r v ∧ miss a v = transform p.2 k r v

def valid (a : ℕ) : Prop :=
  let c := code a
  closed a → orbitMatch a (representative c) (multiplier c) (shift c)

instance (a : ℕ) : Decidable (closed a) := by
  unfold closed
  infer_instance

instance (a : ℕ) (i : Fin 26) (k : Fin 3) (r : Fin 13) : Decidable (orbitMatch a i k r) := by
  unfold orbitMatch
  infer_instance

instance (a : ℕ) : Decidable (valid a) := by
  unfold valid
  infer_instance

