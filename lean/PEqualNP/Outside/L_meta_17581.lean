theorem witnesses (i b : V) (ne : i ≠ b) : ∃ x y : V → Bool, x b = true ∧ y b = true ∧
    (∀ j, j ≠ i → x j = y j) ∧ pet x ≠ pet y := by
  have geom : ∀ a b : V, a ≠ b → ∃ c : V,
      pet (fun j => decide (j=b ∨ j=c)) ≠ pet (fun j => decide (j=a ∨ j=b ∨ j=c)) := by decide
  obtain ⟨c,h⟩ := geom i b ne
  exact ⟨_,_,by simp,by simp,fun j hj => by simp [hj],h⟩

structure Probe (m : Form) where
  v : V
  out : Stat
  valid : out.Valid 9
  run : ∀ y : Y, out.val (List.ofFn y) = m.run (lift v y)
  x : V → Bool
  y : V → Bool
  away : ∀ j, j ≠ v → x j = y j
  changed : pet x ≠ pet y
  tracked : m.run x ≠ m.run y → ∃ b, out = .inl b

theorem probe (m : Form) : Nonempty (Probe m) := by
  have fixed (m : Form) (v : V) (b : Bool) (h : ∀ y, m.run (lift v y) = b) : Nonempty (Probe m) := by
    obtain ⟨x,y,same,_,neq⟩ := omitted_inputs v
    exact ⟨⟨v,.inl b,trivial,fun y => (h y).symm,x,y,same,neq,fun _ => ⟨b,rfl⟩⟩⟩
  cases m with
  | fixed b => exact fixed _ 0 b (fun _ => rfl)
  | inv i => exact fixed _ i true (by simp [Form.run,lift])
  | raw i => exact fixed _ i false (by simp [Form.run,lift])
  | conj i j => exact fixed _ i false (by simp [Form.run,lift])
  | disj i j =>
    by_cases e : i = j
    · subst j; exact fixed _ i false (by simp [Form.run,lift])
    obtain ⟨x,y,xb,yb,same,neq⟩ := witnesses i j e
    have last : ∀ z : Y, Stat.val (List.ofFn z) (.inr (code i j).val) = (.disj i j : Form).run (lift i z) := by
      intro z
      simp only [Stat.val,Form.run,lift,if_pos rfl,ite_eq_right (Ne.symm e),Bool.false_or]
      rw [List.getD_eq_getElem _ _ (by simp),List.getElem_ofFn]
      simp
    exact ⟨⟨i,.inr (code i j).val,(code i j).isLt,last,x,y,same,neq,by simp [Form.run,xb,yb]⟩⟩

end Petersen7217

namespace Petersen7217
open SeedCompress PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

def frame (m : Form) (x : V → Bool) := List.ofFn x ++ [m.run x]
def initial {m} (P : Probe m) := List.ofFn (pos P.v) ++ [P.out]

theorem apart_edge (a b : V) : ∃ c d : V, c ≠ a ∧ d ≠ a ∧ c ≠ b ∧ d ≠ b ∧
    pet (fun j => decide (j = c ∨ j = d)) = true := by revert a b; decide

theorem not_form (m : Form) : ∃ x, pet x ≠ m.run x := by
  cases m with
  | fixed b =>
    cases b
    · exact ⟨fun _ => true,by decide⟩
    · exact ⟨fun _ => false,by decide⟩
  | inv i => exact ⟨fun _ => false,by change false ≠ true; decide⟩
  | raw i =>
    obtain ⟨c,d,h1,h2,_,_,h⟩ := apart_edge i i
    exact ⟨_,by rw [h]; simp [Form.run,Ne.symm h1,Ne.symm h2]⟩
  | conj i j =>
    obtain ⟨c,d,h1,h2,h3,h4,h⟩ := apart_edge i j
    exact ⟨_,by rw [h]; simp [Form.run,Ne.symm h1,Ne.symm h2]⟩
  | disj i j =>
    obtain ⟨c,d,h1,h2,h3,h4,h⟩ := apart_edge i j
    exact ⟨_,by rw [h]; simp [Form.run,Ne.symm h1,Ne.symm h2,Ne.symm h3,Ne.symm h4]⟩

theorem frame_internal (m : Form) (C : Circuit) (good : ∀ x, C.eval (frame m x) = pet x) : 11 ≤ C.output := by
  by_contra! low
  have read (x : V → Bool) : (frame m x).getD C.output false = pet x := by
    rw [← good]
    obtain ⟨t,h,_⟩ := wiresFrom_prefix C.gates (frame m x)
    change _ = (wiresFrom C.gates (frame m x)).getD C.output false
    rw [h,List.getD_append _ _ _ _ (by simpa [frame] using low)]
  by_cases early : C.output < 10
  · obtain ⟨x,h⟩ := not_form (.raw ⟨C.output,early⟩)
    have eq := read x
    rw [frame,List.getD_append _ _ _ _ (by simpa using early),word,dif_pos early] at eq
    exact h eq.symm
  · have k : C.output = 10 := by omega
    obtain ⟨x,h⟩ := not_form m
    have eq := read x
    rw [k,frame,List.getD_append_right _ _ _ _ (by simp)] at eq
    exact h (by simpa using eq.symm)

theorem init_valid {m} (P : Probe m) : ∀ s ∈ initial P, s.Valid 9 := by
  intro s hs
  simp only [initial,List.mem_append,List.mem_ofFn,List.mem_singleton] at hs
  rcases hs with ⟨i,rfl⟩ | rfl
  · unfold pos; split
    · trivial
    · exact (code _ _).isLt
  · exact P.valid

theorem init_correct {m} (P : Probe m) (y : Y) : row (initial P) [] y = frame m (lift P.v y) := by
  simp only [row,initial,frame,List.map_append,List.map_singleton,List.map_ofFn,wiresFrom,List.foldl_nil,P.run]
  congr 1
  apply congrArg List.ofFn
  funext i
  change Stat.val (List.ofFn y) (pos P.v i) = lift P.v y i
  by_cases eq : i = P.v
  · simp [eq,pos,lift,Stat.val]
  · simp only [pos,lift,ite_eq_right eq,Stat.val]
    rw [List.getD_eq_getElem _ _ (by simp),List.getElem_ofFn]

theorem frame_hit {m} (P : Probe m) (C : Circuit) (good : ∀ x, C.eval (frame m x) = pet x) :
    0 < count (initial P) C := by
  by_contra! none
  have unhit (g : Gate) (hg : g ∈ C.gates) (k : ℕ) (hk : k ∈ (normGate g).inputs) (lt : k < 11) :
      constant ((initial P).getD k (.inl false)) = false := by
    by_contra! h
    obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hg
    have pos : 0 < count (initial P) C := by
      apply Finset.card_pos.mpr
      refine ⟨j,Finset.mem_filter.mpr ⟨Finset.mem_univ _,List.any_eq_true.mpr ⟨k,hk,?_⟩⟩⟩
      simp only [Bool.and_eq_true,decide_eq_true_eq]
      exact ⟨by simpa [initial] using lt,by simpa using h⟩
    omega
  have len (x : V → Bool) : (frame m x).length = 11 := by simp [frame]
  obtain ⟨t,hx,hy⟩ := same_tail C.gates (frame m P.x) (frame m P.y) (by simp [len]) (by
    intro g hg k hk kl
    rw [len] at kl
    have ok := unhit g hg k hk kl
    by_cases early : k < 10
    · have ne : (⟨k,early⟩ : V) ≠ P.v := by
        intro eq
        rw [initial,List.getD_append _ _ _ _ (by simpa using early),List.getD_eq_getElem _ _ (by simpa using early),List.getElem_ofFn] at ok
        simp [eq,pos,constant] at ok
      unfold frame
      rw [List.getD_append _ _ _ _ (by simpa using early),List.getD_append _ _ _ _ (by simpa using early),word,word,dite_eq_left early,dite_eq_left early]
      exact P.away _ ne
    · have ko : k=10 := by omega
      have same : m.run P.x = m.run P.y := by
        by_contra diff
        obtain ⟨b,eq⟩ := P.tracked diff
        simp [ko,initial,eq,constant] at ok
      simp [ko,frame,same])
  apply P.changed
  rw [← good,← good]
  change (wiresFrom C.gates (frame m P.x)).getD _ _ = (wiresFrom C.gates (frame m P.y)).getD _ _
  have bound := frame_internal m C good
  rw [hx,hy,List.getD_append_right _ _ _ _ (by simpa [len] using bound),
      List.getD_append_right _ _ _ _ (by simpa [len] using bound),len,len]

theorem plain18 (cert : NineBound) (C : Circuit) (fan : FanInTwo C)
    (good : ∀ x : V → Bool, C.eval (List.ofFn x) = pet x) : 18 ≤ C.size := by
  obtain ⟨gs,o⟩ := C
  cases gs with
  | nil =>
    exfalso
    have zero (x : V → Bool) := good x
    by_cases h : o < 10
    · obtain ⟨x,hx⟩ := not_form (.raw ⟨o,h⟩)
      have eq : (List.ofFn x).getD o false = pet x := zero x
      rw [word,dif_pos h] at eq; exact hx eq.symm
    · have eq : (List.ofFn (fun _ : V => true)).getD o false = pet (fun _ => true) := zero (fun _ : V => true)
      rw [word,dif_neg h] at eq
      contradiction
  | cons g gs =>
    obtain ⟨m,hm⟩ := repr g (fan _ List.mem_cons_self)
    obtain ⟨P⟩ := probe m
    let T : Circuit := ⟨gs,o⟩
    have hT : FanInTwo T := fun q h => fan _ (List.mem_cons_of_mem _ h)
    have e (x) : T.eval (frame m x) = pet x := by
      have eq := good x
      change T.eval (List.ofFn x ++ [_]) = _ at eq
      rwa [hm x] at eq
    have hslice (y : Y) : T.eval (row (initial P) [] y) = nine y := by rw [init_correct,e,deleted]
    obtain ⟨B,fB,sz,ev⟩ := compile_bank (n := 9) (initial P) [] T hT (by simp)
      (init_valid P) ⟨fun _ => false,(hslice _).trans nineZero⟩
    have low := cert B fB (fun y => (ev y).trans (hslice y))
    have pay := frame_hit P T e
    change 18 ≤ gs.length + 1
    change B.size + count (initial P) T ≤ gs.length + 0 at sz
    omega
end Petersen7217

namespace Petersen7217
theorem nine_bound : NineBound := by
  intro C fan good
  by_contra! small
  exact (NineInput.directSplit NineInput.monoRoot NineInput.signedRoot)
    ⟨C,fan,by omega,good⟩
end Petersen7217
namespace ExtraPetersen
open Petersen7217 SeedCompress PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
def productBit (x : V → Bool) := x 0 && x 2
def input (q : Bool) (x : V → Bool) := List.ofFn x ++ [productBit x,if q then !productBit x else true]
def good (C : Circuit) (q : Bool) := ∀ x : V → Bool, C.eval (input q x) = pet x
def fixed (y : V → Bool) := List.ofFn y ++ [false,true]
theorem lowRead (x : V → Bool) (t : List Bool) (i : ℕ) (h : i<10) :
    (List.ofFn x ++ t).getD i false = x ⟨i,h⟩ := by
  rw [List.getD_append _ _ _ _ (by simpa),List.getD_eq_getElem _ _ (by simpa),List.getElem_ofFn]
theorem out (C : Circuit) (q : Bool) (hc : good C q) : 12 ≤ C.output := by
  by_contra! low
  have read (x : V → Bool) : (input q x).getD C.output false = pet x := by
    obtain ⟨t,ht,_⟩ := wiresFrom_prefix C.gates (input q x)
    rw [← hc]
    change _ = (wiresFrom C.gates (input q x)).getD C.output false
    rw [ht,List.getD_append _ _ _ _ (by simpa [input] using low)]
  by_cases h : C.output<10
  · let i : V := ⟨C.output,h⟩
    have no (j : V) : pet (fun v => decide (v=j)) = false := by revert j; decide
    have e := read (fun v => decide (v=i))
    rw [input,lowRead _ _ _ h,no] at e
    simp [i] at e
  · rcases (by omega : C.output = 10 ∨ C.output = 11) with h | h
    · have e := read (fun v => decide (v=0 ∨ v=2))
      rw [h] at e
      change true=false at e
      cases e
    · have e := read (fun _ => false)
      rw [h] at e
      cases q <;> contradiction

def bank (v : V) : List Stat := List.ofFn (pos v) ++ [.inl false,.inl true]
theorem bank_valid (v : V) : ∀ s ∈ bank v, s.Valid 9 := by
  intro s h
  simp only [bank,List.mem_append,List.mem_ofFn,List.mem_cons,List.not_mem_nil,or_false] at h
  rcases h with ⟨i,rfl⟩ | rfl | rfl
  · unfold pos; split
    · trivial
    · exact (code v i).isLt
  · trivial
  · trivial
theorem bank_eq (v : V) (offv : off v) (q : Bool) (y : Y) :
    row (bank v) [] y = input q (lift v y) := by
  have key : productBit (lift v y) = false := by rcases offv with rfl | rfl <;> simp [productBit,lift]
  simp only [row,bank,input,key,List.map_append,List.map_ofFn,List.map_cons,List.map_nil,wiresFrom,List.foldl_nil,Stat.val]
  have e (i : V) : (pos v i).val (List.ofFn y) = lift v y i := val_pos_simple v i y
  rw [show (Stat.val (List.ofFn y) ∘ pos v) = lift v y from funext e]
  cases q <;> rfl

theorem bound (C : Circuit) (q : Bool) (f : FanInTwo C) (hc : good C q) (v : V) (dead : off v) :
    16 + count (bank v) C ≤ C.size := by
  have e (y : Y) : C.eval (row (bank v) [] y) = nine y := by rw [bank_eq _ dead,hc,deleted]
  obtain ⟨D,hD,sz,h⟩ := compile_bank (bank v) [] C f (by simp) (bank_valid v)
    ⟨fun _ => false,(e _).trans nineZero⟩
  have n := nine_bound D hD (fun y => (h y).trans (e y))
  simp only [List.length_nil,Nat.add_zero] at sz
  omega

theorem usesRaw (C : Circuit) (q : Bool) (hc : good C q) (v : V) :
    ∃ j : Fin C.gates.length, v.val ∈ (normGate (C.gates.get j)).inputs := by
  by_contra no
  obtain ⟨x,y,away,eqPair,ne⟩ := omitted_inputs v
  have ln (z : V → Bool) : (input q z).length=12 := by simp [input]
  obtain ⟨tail,hx,hy⟩ := same_tail C.gates (input q x) (input q y) (by simp [ln]) (by
    intro g hg k hk kl
    obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hg
    by_cases h : k<10
    · rw [input,input,lowRead _ _ _ h,lowRead _ _ _ h]
      apply away
      intro eq
      exact no ⟨j,(congrArg Fin.val eq) ▸ hk⟩
    · have eq : productBit x = productBit y := eqPair
      rw [ln] at kl
      rcases (by omega : k=10 ∨ k=11) with rfl | rfl <;>
        simp [input,List.getD_append_right,eq])
  apply ne
  rw [← hc,← hc]
  change (wiresFrom C.gates (input q x)).getD _ _ = (wiresFrom C.gates (input q y)).getD _ _
  rw [hx,hy,List.getD_append_right _ _ _ _ (by simpa [ln] using out C q hc),
    List.getD_append_right _ _ _ _ (by simpa [ln] using out C q hc),ln,ln]

def readers (C : Circuit) (v : V) := Finset.univ.filter (fun j : Fin C.gates.length => hits (bank v) (C.gates.get j))
theorem hit (C : Circuit) (v : V) (j : Fin C.gates.length) (k : ℕ)
    (mem : k ∈ (normGate (C.gates.get j)).inputs) (pick : k=v.val ∨ k=10 ∨ k=11) : j ∈ readers C v := by
  apply Finset.mem_filter.mpr ⟨Finset.mem_univ _,?_⟩
  apply List.any_eq_true.mpr
  refine ⟨k,mem,?_⟩
  rcases pick with rfl | rfl | rfl
  · have h := v.isLt
    rw [bank,List.getD_append _ _ _ _ (by simpa using h),List.getD_eq_getElem _ _ (by simpa using h),List.getElem_ofFn]
    simp [pos,constant,bank]; omega
  · simp [bank,List.getD_append_right,constant]
  · simp [bank,List.getD_append_right,constant]

theorem unused (C : Circuit) (q : Bool) (f : FanInTwo C) (hc : good C q)
    (no : ∀ j : Fin C.gates.length, ∀ k ∈ (normGate (C.gates.get j)).inputs, k ≠ 10 ∧ k ≠ 11) :
    18 ≤ C.size := by
  have ev (x : V → Bool) : C.eval (fixed x) = pet x := by
    have ln : (fixed x).length = (input q x).length := by simp [fixed,input]
    obtain ⟨t,hw,hu⟩ := same_tail C.gates (fixed x) (input q x) ln (by
      intro g hg k hk kl
      obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hg
      obtain ⟨h,i⟩ := no j k hk
      have bl : k<10 := by simp [fixed] at kl; omega
      rw [fixed,input,lowRead _ _ _ bl,lowRead _ _ _ bl])
    rw [← hc]
    change (wiresFrom _ _).getD C.output _ = (wiresFrom _ _).getD C.output _
    rw [hw,hu,List.getD_append_right _ _ _ _ (by simpa [fixed] using out C q hc),
      List.getD_append_right _ _ _ _ (by simpa [input] using out C q hc),ln]
  let modes : List Stat := List.ofFn (fun i : V => (.inr i.val : Stat)) ++ [.inl false,.inl true]
  have valid : ∀ s ∈ modes, s.Valid 10 := by
    intro s hs
    simp only [modes,List.mem_append,List.mem_ofFn,List.mem_cons,List.not_mem_nil,or_false] at hs
    rcases hs with ⟨i,rfl⟩ | rfl | rfl
    · exact i.isLt
    · trivial
    · trivial
  have layout (x : V → Bool) : row modes [] x=fixed x := by
    simp only [modes,row,fixed,List.map_append,List.map_ofFn,List.map_cons,List.map_nil,Stat.val,wiresFrom,List.foldl_nil]
    congr 1
  have ok (x : V → Bool) := (congrArg C.eval (layout x)).trans (ev x)
  obtain ⟨D,hD,sz,h⟩ := compile_bank modes [] C f (by simp) valid
    ⟨fun _ => false,(ok _).trans (by decide : pet (fun _ => false) = false)⟩
  have h := plain18 nine_bound D hD (fun x => (h x).trans (ok x))
  simp at sz
  omega

theorem full (C : Circuit) (q : Bool) (f : FanInTwo C) (hc : good C q) : 18 ≤ C.size := by
  by_contra! small
  by_cases h : ∃ (j : Fin C.gates.length) (k : ℕ), k ∈ (normGate (C.gates.get j)).inputs ∧ (k=10 ∨ k=11)
  · obtain ⟨j,k,mem,hk⟩ := h
    have contact (v : V) (dead : off v) : v.val ∈ (normGate (C.gates.get j)).inputs := by
      obtain ⟨i,hi⟩ := usesRaw C q hc v
      have b := bound C q f hc v dead
      change 16 + (readers C v).card ≤ C.size at b
      have one : (readers C v).card ≤ 1 := by omega
      have eq := Finset.card_le_one.mp one _ (hit C v i _ hi (.inl rfl)) _ (hit C v j k mem (.inr hk))
      exact eq ▸ hi
    have h0 := contact 0 (.inl rfl)
    have h2 := contact 2 (.inr rfl)
    let ins := (normGate (C.gates.get j)).inputs
    have sub : ({0,2,k} : Finset ℕ) ⊆ ins.toFinset := by
      intro t ht
      simp only [Finset.mem_insert,Finset.mem_singleton] at ht
      rcases ht with rfl | rfl | rfl <;> apply List.mem_toFinset.mpr <;> assumption
    have h := (Finset.card_le_card sub).trans (List.toFinset_card_le ins)
    have legal := (normGate_nok (C.gates.get j) (f _ (List.get_mem C.gates j))).1.2
    change ins.length ≤ 2 at legal
    rcases hk with rfl | rfl <;> simp at h <;> omega
  · apply (Nat.not_lt_of_ge (unused C q f hc ?_)) small
    intro j k hk
    exact ⟨fun e => h ⟨j,k,hk,.inl e⟩,fun e => h ⟨j,k,hk,.inr e⟩⟩
end ExtraPetersen

