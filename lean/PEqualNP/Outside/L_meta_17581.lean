open SeedCompress PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
def off (v : V) : Prop := v = 0 ∨ v = 2
instance (v : V) : Decidable (off v) := inferInstanceAs (Decidable (_ ∨ _))
def pos (v i : V) : Stat := if i = v then .inl false else .inr (code v i).val
theorem val_pos_simple (v i : V) (y : Y) :
    (pos v i).val (List.ofFn y) = lift v y i := by
  by_cases eq : i = v
  · simp [pos,lift,eq,Stat.val]
  · simp only [pos,lift,ite_eq_right eq,Stat.val]
    rw [List.getD_eq_getElem _ _ (by simp),List.getElem_ofFn]
theorem same_tail (gs : List Gate) (w u : List Bool) (len : w.length = u.length)
    (agree : ∀ g ∈ gs, ∀ j ∈ (normGate g).inputs, j < w.length → w.getD j false = u.getD j false) :
    ∃ tail, wiresFrom gs w = w ++ tail ∧ wiresFrom gs u = u ++ tail := by
  induction gs generalizing w u with
  | nil => exact ⟨[], by simp [wiresFrom], by simp [wiresFrom]⟩
  | cons g gs ih =>
    let t := g.op.eval (g.inputs.map fun j => w.getD j false)
    have e : t = g.op.eval (g.inputs.map fun j => u.getD j false) := by
      dsimp only [t]
      rw [← normGate_eval g (fun j => w.getD j false),← normGate_eval g (fun j => u.getD j false)]
      congr 1
      apply List.map_congr_left
      intro j hj
      by_cases h : j < w.length
      · exact agree _ List.mem_cons_self _ hj h
      · rw [List.getD_eq_default _ _ (by omega),List.getD_eq_default _ _ (by omega)]
    obtain ⟨tail,ew,eu⟩ := ih (w++[t]) (u++[t]) (by simp [len]) (by
      intro q hq j hj _
      by_cases early : j < w.length
      · rw [List.getD_append _ _ _ _ early,List.getD_append _ _ _ _ (by omega)]
        exact agree _ (List.mem_cons_of_mem _ hq) _ hj early
      · rw [List.getD_append_right _ _ _ _ (by omega),List.getD_append_right _ _ _ _ (by omega),len])
    refine ⟨t::tail,?_,?_⟩
    · change wiresFrom gs (w++[t]) = _; rw [ew]; simp
    · change wiresFrom gs (u++[_]) = _; rw [← e,eu]; simp

def NineBound := ∀ C : Circuit, FanInTwo C → (∀ y : Y, C.eval (List.ofFn y) = nine y) → 16 ≤ C.size
