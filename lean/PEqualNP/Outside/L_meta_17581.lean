inductive Form where
  | fixed (b : Bool) | raw (i : V) | inv (i : V) | conj (a b : V) | disj (a b : V)
  deriving DecidableEq

def Form.run : Form → (V → Bool) → Bool
  | .fixed b,_ => b
  | .raw i,x => x i
  | .inv i,x => !x i
  | .conj i j,x => x i && x j
  | .disj i j,x => x i || x j

theorem word (x : V → Bool) (k : ℕ) : (List.ofFn x).getD k false =
    if h : k < 10 then x ⟨k,h⟩ else false := by
  split
  · rw [List.getD_eq_getElem _ _ (by simpa using ‹_›),List.getElem_ofFn]
  · apply List.getD_eq_default; simp; omega

theorem repr (g : Gate) (ok : Ok g) :
    ∃ m : Form, ∀ x : V → Bool, g.op.eval (g.inputs.map (fun j => (List.ofFn x).getD j false)) = m.run x := by
  obtain ⟨op,ins⟩ := g
  obtain ⟨kind,sz⟩ := ok
  change ins.length ≤ 2 at sz
  change op = .and ∨ op = .or ∨ op = .not at kind
  cases ins with
  | nil =>
    rcases kind with rfl | rfl | rfl <;> exact ⟨.fixed _,fun _ => rfl⟩
  | cons a ins =>
    cases ins with
    | nil =>
      by_cases ha : a < 10 <;> rcases kind with rfl | rfl | rfl
      · refine ⟨.raw ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
      · refine ⟨.raw ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
      · refine ⟨.inv ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
      · refine ⟨.fixed false,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
      · refine ⟨.fixed false,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
      · refine ⟨.fixed true,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha]
    | cons b rest =>
      have er : rest = [] := by
        apply List.length_eq_zero_iff.mp
        simp only [List.length_cons] at sz
        omega
      subst rest
      by_cases ha : a < 10 <;> by_cases hb : b < 10 <;> rcases kind with rfl | rfl | rfl
      · refine ⟨.conj ⟨a,ha⟩ ⟨b,hb⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.disj ⟨a,ha⟩ ⟨b,hb⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.inv ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.fixed false,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.raw ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.inv ⟨a,ha⟩,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.fixed false,?_⟩
        intro x
        simp only [List.map_cons,List.map_nil,word]
        simp [GateOp.eval,Form.run,ha,hb]
      · refine ⟨.raw ⟨b,hb⟩,?_⟩
