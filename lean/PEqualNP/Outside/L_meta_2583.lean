theorem matchingLower : ∀ (x1 : ℕ) (x2 : Finset (Fin x1 × Fin x1)) (x3 : Equiv.Perm (Fin x1)) (x4 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x5 x6 x7 x8 : Fin x1), x5 ≠ x6 → x7 ≠ x8 → ¬((x5, x7) ∈ x2 ∧ (x5, x8) ∈ x2 ∧ (x6, x7) ∈ x2 ∧ (x6, x8) ∈ x2)) → (∀ (x6 : Fin x1), (x6, x3 x6) ∈ x2) → PEqualNP.TopForm.IsAO2 (x1 + x1) x4 → (∀ (x8 : Fin (x1 + x1) → Bool), PEqualNP.MetaComplexity.circuitFun (x1 + x1) x4 x8 = Decidable.decide (∃ (x9 : Fin x1) (x10 : Fin x1), (x9, x10) ∈ x2 ∧ x8 (Fin.castAdd x1 x9) = Bool.true ∧ x8 (Fin.natAdd x1 x10) = Bool.true)) → PEqualNP.ReadK.IsReadK (x1 + x1) x4 (1 : ℕ) → x2.card + x1 ≤ x4.size + (1 : ℕ) := by
  intro n E σ C rect perm ao computes readOne
  obtain ⟨A, B, cov, bound⟩ := PEqualNP.Outside.L_meta_2583_aux.FanoLower.big n n E C rect ao computes readOne
  have hsub : (Finset.univ : Finset (Fin n)) ⊆ A ∪ B.map σ.symm.toEmbedding := by
    intro i _
    rcases cov (i, σ i) (perm i) with h | h
    · exact Finset.mem_union_left _ h
    · refine Finset.mem_union_right _ (Finset.mem_map.mpr ⟨σ i, h, ?_⟩)
      simp
  have h1 := Finset.card_le_card hsub
  have h2 := Finset.card_union_le A (B.map σ.symm.toEmbedding)
  rw [Finset.card_univ, Fintype.card_fin] at h1
  rw [Finset.card_map] at h2
  omega


open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm PEqualNP.ReadK

abbrev incidence (p l : Fin 7) : Prop := p = l ∨ p = l + 1 ∨ p = l + 3

def edges : Finset (Fin 7 × Fin 7) :=
  Finset.univ.filter fun e => incidence e.1 e.2

lemma edges_card : edges.card = 21 := by decide

lemma incidence_degree :
    ∀ l : Fin 7, (Finset.univ.filter fun p => incidence p l).card = 3 := by decide

set_option maxRecDepth 10000 in
set_option maxHeartbeats 800000 in
lemma incidence_unique_join :
    ∀ p p' : Fin 7, p ≠ p' → ∃! l : Fin 7, incidence p l ∧ incidence p' l := by
  unfold ExistsUnique
  decide

set_option maxRecDepth 10000 in
set_option maxHeartbeats 800000 in
lemma edges_no_rectangle :
    ∀ p p' l l' : Fin 7, p ≠ p' → l ≠ l' →
      ¬ ((p,l) ∈ edges ∧ (p,l') ∈ edges ∧ (p',l) ∈ edges ∧ (p',l') ∈ edges) := by
  decide

lemma identity_matching (p : Fin 7) : (p,p) ∈ edges := by
  simp [edges, incidence]

lemma readOne_lower (C : Circuit) (ao : IsAO2 14 C)
    (correct : ∀ x : Fin 14 → Bool, circuitFun 14 C x =
      decide (∃ p l : Fin 7, incidence p l ∧ x (Fin.castAdd 7 p) = true ∧
        x (Fin.natAdd 7 l) = true))
    (read : IsReadK 14 C 1) : 27 ≤ C.size := by
  have eq : ∀ x : Fin (7 + 7) → Bool, circuitFun (7 + 7) C x =
      decide (∃ p l : Fin 7, (p,l) ∈ edges ∧ x (Fin.castAdd 7 p) = true ∧
        x (Fin.natAdd 7 l) = true) := by
    simpa only [edges, Finset.mem_filter, Finset.mem_univ, true_and] using correct
  have bound := matchingLower 7 edges (Equiv.refl _) C edges_no_rectangle
    identity_matching ao eq read
  rw [edges_card] at bound
  omega

lemma no_small_replacement (C : Circuit) (small : C.size ≤ 26) :
    ¬ ∃ D : Circuit, IsAO2 14 D ∧
      (∀ y : Fin 14 → Bool, circuitFun 14 D y =
        decide (∃ p l : Fin 7, incidence p l ∧ y (Fin.castAdd 7 p) = true ∧
          y (Fin.natAdd 7 l) = true)) ∧
      D.size ≤ C.size ∧ IsReadK 14 D 1 := by
  rintro ⟨D,ao,correct,size,read⟩
  have bound := readOne_lower D ao correct read
  omega

end PEqualNP.Outside.L_meta_2583_aux.FanoLower


namespace PEqualNP.Outside.L_meta_2583_aux.Geometry

theorem point_degree_le
    {q N : ℕ} (I : Fin N → Fin N → Prop) [DecidableRel I]
    (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, (Finset.univ.filter (fun p => I p l)).card = q + 1)
    (hjoin : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    (p : Fin N) :
    (Finset.univ.filter (fun l => I p l)).card ≤ q + 1 := by
  classical
  let lines : Finset (Fin N) := Finset.univ.filter (fun l => I p l)
  let others : Finset (Fin N) := Finset.univ.erase p
  have lower : ∀ l ∈ lines,
      q ≤ (others.bipartiteAbove (fun l p' => I p' l) l).card := by
    intro l hl
    have hpl : I p l := (Finset.mem_filter.mp hl).2
    have heq : others.bipartiteAbove (fun l p' => I p' l) l =
        (Finset.univ.filter (fun p' => I p' l)).erase p := by
      ext p'
      simp [others, Finset.bipartiteAbove, and_comm]
    rw [heq, Finset.card_erase_of_mem (by simp [hpl]), hline]
    omega
  have upper : ∀ p' ∈ others,
      (lines.bipartiteBelow (fun l p' => I p' l) p').card ≤ 1 := by
    intro p' hp'
    apply Finset.card_le_one.mpr
    intro l hl l' hl'
    have hpne : p ≠ p' := (Finset.mem_erase.mp hp').1.symm
    obtain ⟨l₀, _, huniq⟩ := hjoin p p' hpne
    have hlI : I p l ∧ I p' l := by
      simpa [lines, Finset.bipartiteBelow] using hl
    have hl'I : I p l' ∧ I p' l' := by
      simpa [lines, Finset.bipartiteBelow] using hl'
    exact (huniq l hlI).trans (huniq l' hl'I).symm
  have count := Finset.card_mul_le_card_mul
    (r := fun l p' => I p' l) lower upper
  have bound : lines.card * q ≤ N - 1 := by
    simpa [others] using count
  have hNsub : N - 1 = (q + 1) * q := by
    rw [hN]
    simp [pow_two, Nat.add_mul]
  rw [hNsub] at bound
  exact (mul_le_mul_iff_left₀ (by omega : 0 < q)).mp bound

theorem cover_card_of_degrees
    {N d : ℕ} (I : Fin N → Fin N → Prop) [DecidableRel I]
    (hd : 0 < d)
    (hline : ∀ l : Fin N, d ≤ (Finset.univ.filter (fun p => I p l)).card)
    (hpoint : ∀ p : Fin N, (Finset.univ.filter (fun l => I p l)).card ≤ d)
    (A B : Finset (Fin N))
    (hcover : ∀ p l : Fin N, I p l → p ∈ A ∨ l ∈ B) :
    N ≤ A.card + B.card := by
  classical
  let uncovered : Finset (Fin N) := Finset.univ \ B
  have lower : ∀ l ∈ uncovered, d ≤ (A.bipartiteBelow I l).card := by
    intro l hl
    have hlB : l ∉ B := (Finset.mem_sdiff.mp hl).2
    have heq : A.bipartiteBelow I l = Finset.univ.filter (fun p => I p l) := by
      ext p
      simp only [Finset.mem_bipartiteBelow, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨And.right, fun hp => ⟨(hcover p l hp).resolve_right hlB, hp⟩⟩
    rw [heq]
    exact hline l
  have upper : ∀ p ∈ A, (uncovered.bipartiteAbove I p).card ≤ d := by
    intro p _
    apply le_trans (Finset.card_le_card ?_) (hpoint p)
    intro l hl
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ l,
      (Finset.mem_filter.mp hl).2⟩
  have count := Finset.card_mul_le_card_mul' (r := I) lower upper
  have hle : uncovered.card ≤ A.card := (mul_le_mul_iff_left₀ hd).mp count
  have htotal := Finset.card_sdiff_add_card_eq_card (Finset.subset_univ B)
  simp only [Finset.card_univ, Fintype.card_fin] at htotal
  change (Finset.univ \ B).card ≤ A.card at hle
  omega

theorem plane_cover_card
    {q N : ℕ} (I : Fin N → Fin N → Prop) [DecidableRel I]
    (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, (Finset.univ.filter (fun p => I p l)).card = q + 1)
    (hjoin : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    (A B : Finset (Fin N))
    (hcover : ∀ p l : Fin N, I p l → p ∈ A ∨ l ∈ B) :
    N ≤ A.card + B.card := by
  apply cover_card_of_degrees I (d := q + 1) (by omega)
  · intro l
    exact (hline l).ge
  · exact point_degree_le I hq hN hline hjoin
  · exact hcover

end PEqualNP.Outside.L_meta_2583_aux.Geometry
namespace PEqualNP.Outside.L_meta_2583_aux.PlaneBound

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm PEqualNP.ReadK

lemma readOne_lower (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I]
    (C : Circuit) (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (degree : ∀ l : Fin N, (Finset.univ.filter fun p => I p l).card = q + 1)
    (join : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    (ao : IsAO2 (N + N) C)
    (correct : ∀ x : Fin (N + N) → Bool, circuitFun (N + N) C x =
      decide (∃ p l : Fin N, I p l ∧ x (Fin.castAdd N p) = true ∧
        x (Fin.natAdd N l) = true))
    (read : IsReadK (N + N) C 1) : N * (q + 2) - 1 ≤ C.size := by
  classical
  let E := StarBuilder.incidenceEdges N I
  have rect : ∀ p p' l l' : Fin N, p ≠ p' → l ≠ l' →
      ¬ ((p,l) ∈ E ∧ (p,l') ∈ E ∧ (p',l) ∈ E ∧ (p',l') ∈ E) := by
    intro p p' l l' hp hl h
    simp only [E, StarBuilder.incidenceEdges, Finset.mem_filter,
      Finset.mem_univ, true_and] at h
    obtain ⟨l₀,_,unique⟩ := join p p' hp
    exact hl ((unique l ⟨h.1,h.2.2.1⟩).trans (unique l' ⟨h.2.1,h.2.2.2⟩).symm)
  have correctE : ∀ x : Fin (N + N) → Bool, circuitFun (N + N) C x =
      decide (∃ p l : Fin N, (p,l) ∈ E ∧ x (Fin.castAdd N p) = true ∧
        x (Fin.natAdd N l) = true) := by
    simpa only [E, StarBuilder.incidenceEdges, Finset.mem_filter,
      Finset.mem_univ, true_and] using correct
  obtain ⟨A,B,cover,bound⟩ := FanoLower.big N N E C rect ao correctE read
  have coverI (p l : Fin N) (h : I p l) : p ∈ A ∨ l ∈ B :=
    cover (p,l) (by simpa [E, StarBuilder.incidenceEdges] using h)
  have coverN := Geometry.plane_cover_card I hq hN degree join A B coverI
  have count : E.card = N * (q + 1) := StarBuilder.incidenceEdges_card q N I degree
  have total : N * (q + 2) ≤ C.size + 1 := calc
    N * (q + 2) = E.card + N := by rw [count]; ring
    _ ≤ E.card + (A.card + B.card) := Nat.add_le_add_left coverN _
    _ ≤ C.size + 1 := by omega
  omega

lemma replacement_iff_sharp (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I]
    (C : Circuit) (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (degree : ∀ l : Fin N, (Finset.univ.filter fun p => I p l).card = q + 1)
    (join : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) :
    (∃ D : Circuit, IsAO2 (N + N) D ∧
      (∀ y : Fin (N + N) → Bool, circuitFun (N + N) D y =
        decide (∃ p l : Fin N, I p l ∧ y (Fin.castAdd N p) = true ∧
          y (Fin.natAdd N l) = true)) ∧
      D.size ≤ C.size ∧ IsReadK (N + N) D 1) ↔ N * (q + 2) - 1 ≤ C.size := by
  constructor
  · rintro ⟨D,ao,correct,size,read⟩
    exact (readOne_lower q N I D hq hN degree join ao correct read).trans size
  · exact StarBuilder.normalize_of_budget q N I C degree

lemma posted_iff_sharp :
    (∀ (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I] (C : PEqualNP.CircuitLowerBounds.Circuit), 2 ≤ q → N = q ^ 2 + q + 1 → (∀ l : Fin N, (Finset.univ.filter (fun p => I p l)).card = q + 1) → (∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) → PEqualNP.TopForm.IsAO2 (N + N) C → (∀ z : Fin (N + N) → Bool, PEqualNP.MetaComplexity.circuitFun (N + N) C z = decide (∃ p l : Fin N, I p l ∧ z (Fin.castAdd N p) = true ∧ z (Fin.natAdd N l) = true)) → ∃ D : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsAO2 (N + N) D ∧ (∀ y : Fin (N + N) → Bool, PEqualNP.MetaComplexity.circuitFun (N + N) D y = decide (∃ p l : Fin N, I p l ∧ y (Fin.castAdd N p) = true ∧ y (Fin.natAdd N l) = true)) ∧ D.size ≤ C.size ∧ PEqualNP.ReadK.IsReadK (N + N) D 1) ↔
    (∀ (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I] (C : PEqualNP.CircuitLowerBounds.Circuit), 2 ≤ q → N = q ^ 2 + q + 1 → (∀ l : Fin N, (Finset.univ.filter (fun p => I p l)).card = q + 1) → (∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) → PEqualNP.TopForm.IsAO2 (N + N) C → (∀ z : Fin (N + N) → Bool, PEqualNP.MetaComplexity.circuitFun (N + N) C z = decide (∃ p l : Fin N, I p l ∧ z (Fin.castAdd N p) = true ∧ z (Fin.natAdd N l) = true)) → N * (q + 2) - 1 ≤ C.size) := by
  constructor
  · intro h q N I inst C hq hN degree join ao correct
    exact (replacement_iff_sharp q N I C hq hN degree join).mp
      (h q N I C hq hN degree join ao correct)
  · intro h q N I inst C hq hN degree join ao correct
    exact (replacement_iff_sharp q N I C hq hN degree join).mpr
      (h q N I C hq hN degree join ao correct)

end PEqualNP.Outside.L_meta_2583_aux.PlaneBound
