def rootTest (s : Nat) : Bool :=
  xsM.sublists.all fun zs =>
    decide (s + 1 < zs.length) || !(coversP pairsG s zs) || found SS NN idx s zs

set_option maxRecDepth 40000 in
set_option maxHeartbeats 0 in
lemma rootsChecked : ∀ s : Fin 8, rootTest s.val = true := by decide +kernel

lemma noCircuit : Lower dom roots goal 8 := by
  intro p bank hr ha
  by_contra! hsmall
  have hnc : ¬ IsConst dom goal := by
    have h0 : isConstB dom goal = false := by decide +kernel
    intro h
    rw [(isConstB_iff _ _).2 h] at h0
    contradiction
  obtain ⟨s, ws, hs_le, hnd, hws_sub, hrun⟩ :=
    reach_to_run (by decide +kernel) hnc hr ha
  have hperm_sub : ∃ zs, zs.Sublist xsM ∧ ws.Perm zs := by
    refine ⟨xsM.filter (fun x => decide (x ∈ ws)), List.filter_sublist, ?_⟩
    refine (List.perm_ext_iff_of_nodup hnd
      (List.Nodup.filter _ (by decide +kernel : xsM.Nodup))).2 ?_
    intro x
    simp only [List.mem_filter, decide_eq_true_eq]
    exact ⟨fun hx => ⟨hws_sub x hx, hx⟩, fun h => h.2⟩
  obtain ⟨zs, hsub, hpz⟩ := hperm_sub
