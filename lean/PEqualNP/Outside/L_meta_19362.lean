def lev : Nat → List (List Nat)
  | 0 => lev0
  | 1 => lev1
  | 2 => lev2
  | 3 => lev3
  | 4 => lev4
  | 5 => lev5
  | 6 => lev6
  | 7 => lev7
  | _ => []
def hsh : Nat → List Nat
  | 0 => hsh0
  | 1 => hsh1
  | 2 => hsh2
  | 3 => hsh3
  | 4 => hsh4
  | 5 => hsh5
  | 6 => hsh6
  | 7 => hsh7
  | _ => []

def SS (s j : Nat) : List Nat := (lev s).getD j []
def SD (s j : Nat) : List (Nat × Nat × Nat) :=
  (SS s j).map (fun w => (w, projBit r1sG w, projBit r2sG w))
lemma SD_eq (s j : Nat) :
    SD s j = (SS s j).map (fun w => (w, projBit r1sG w, projBit r2sG w)) := rfl
def NN (s : Nat) : Nat := (lev s).length
def htAt (s i : Nat) : Nat := (hsh s).getD i 0
def findH (h : Nat) : List Nat → Nat
  | [] => 0
  | x :: t => if x == h then 0 else findH h t + 1
def idxH (s h : Nat) : Nat := findH h (hsh s)
def idx (s : Nat) (zs : List Nat) : Nat := idxH s (hk 0 zs)
def cutHitH (_s _h : Nat) (_ws : List Nat) : Bool := false
lemma cutHitH_sound {u ys} (h : cutHitH u (hk 0 ys) ys = true) :
    ¬ RunD dom goalM u ys := by simp [cutHitH] at h
def ori (zs : List Nat) : List Nat := zs
lemma ori_ok {u ys} (h : RunD dom goalM u ys) : RunD dom goalM u (ori ys) := h
def Z (s : Nat) := bar dom goalM pairsG r1sG r2sG mpG SD SS NN htAt idxH ori 0 [] cutHitH s

