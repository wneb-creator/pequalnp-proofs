theorem sliceZero (h : Fin 6 → ℂ) (hs : h 4 = h 0 - h 1)
    (hp : ∀ t : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 6) =>
      (1 : ℂ) + t * h (j-i)) = 720) : h = 0 := by
  obtain ⟨h1,h2,h3,h4,h5,h6⟩ := all_coeff h hp
  unfold Q1 at h1
  rw [hs] at h1
  have ht : h 5 = -2 * h 0 - h 2 - h 3 := by linear_combination (1/720 : ℂ) * h1
  rw [hs, ht, reduced2] at h2
  rw [hs, ht, reduced3] at h3
  rw [hs, ht, reduced4] at h4
  rw [hs, ht, reduced5] at h5
  rw [hs, ht, reduced6] at h6
  obtain ⟨ha,hb,hc,hd⟩ := homogeneous_zero _ _ _ _ h2 h3 h4 h5 h6
  ext i
  fin_cases i <;> simp_all


