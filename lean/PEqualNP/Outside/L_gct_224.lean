  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero]
  change (x 1) * ((cm 2 [0, 1] x).submatrix (0 : Fin 2).succAbove Fin.castSucc).permanent + ((x 0) * ((cm 2 [0, 1] x).submatrix (1 : Fin 2).succAbove Fin.castSucc).permanent) = _
