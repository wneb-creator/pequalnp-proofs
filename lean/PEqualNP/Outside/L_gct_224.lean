set_option maxHeartbeats 0 in
private theorem val1 (x : Fin 6 → ℂ) :
    (cm 1 [0] x).permanent = (x 0) := by
  rw [Matrix.permanent_eq_elem_of_subsingleton _ 0] <;> rfl

