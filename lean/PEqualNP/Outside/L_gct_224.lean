lemma plane_reduction
    (sliceZero : ∀ (h : Fin 6 → ℂ), h 4 = h 0 - h 1 →
      (∀ t : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 6) =>
        (1 : ℂ) + t * h (j - i)) = 720) → h = 0) :
    ¬ (∃ f g : Fin 6 → ℂ, f ≠ 0 ∧ (∀ c : ℂ, g ≠ c • f) ∧
      ∀ s r : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 6) =>
        (1 : ℂ) + s * f (j - i) + r * g (j - i)) = 720) := by
  rintro ⟨f, g, hf, hg, hp⟩
  by_cases hker : sliceForm f = 0
  · apply hf
    apply sliceZero
    · unfold sliceForm at hker
      linear_combination hker
    · intro t
      simpa using hp t 0
  · let k := sliceForm g / sliceForm f
    have hk : k * sliceForm f = sliceForm g := div_mul_cancel₀ _ hker
    let h : Fin 6 → ℂ := fun i => g i - k * f i
    have hs : h 4 = h 0 - h 1 := by
      dsimp only [h]
      unfold sliceForm at hk
      linear_combination -hk
    have hline (t : ℂ) : Matrix.permanent (Matrix.of fun (i j : Fin 6) =>
        (1 : ℂ) + t * h (j - i)) = 720 := by
      calc
        _ = Matrix.permanent (Matrix.of fun (i j : Fin 6) =>
            (1 : ℂ) + (-(t * k)) * f (j - i) + t * g (j - i)) := by
          congr 1
          ext i j
          change 1 + t * (g (j-i) - k * f (j-i)) =
            1 + (-(t * k)) * f (j-i) + t * g (j-i)
          ring
        _ = 720 := hp _ _
    have hz := sliceZero h hs hline
    apply hg k
    funext i
    exact sub_eq_zero.mp (congrFun hz i)

end PEqualNP.Outside.L_gct_224

theorem PEqualNP.Outside.L_gct_224 : ¬ (∃ f g : Fin 6 → ℂ, f ≠ 0 ∧ (∀ c : ℂ, g ≠ c • f) ∧ ∀ s r : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 6) => (1 : ℂ) + s * f (j - i) + r * g (j - i)) = 720) :=
  PEqualNP.Outside.L_gct_224.plane_reduction PEqualNP.Outside.L_gct_224.sliceZero
