private theorem val3 (x : Fin 6 → ℂ) :
    (cm 2 [0, 1] x).permanent = (x 0)^2 + (x 1)*(x 5) := by
  have h0 : (cm 2 [0, 1] x).submatrix (0 : Fin 2).succAbove Fin.castSucc = cm 1 [1] x := by
    funext i k
    fin_cases i <;> rfl
  have h1 : (cm 2 [0, 1] x).submatrix (1 : Fin 2).succAbove Fin.castSucc = cm 1 [0] x := by
    funext i k
    fin_cases i <;> rfl
