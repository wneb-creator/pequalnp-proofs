private theorem all_coeff (h : Fin 6 → ℂ)
    (hp : ∀ t : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 6) => (1 : ℂ) + t * h (j-i)) = 720) :
    Q1 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 ∧ Q2 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 ∧ Q3 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 ∧ Q4 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 ∧ Q5 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 ∧ Q6 (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) = 0 := by

  have ev (t : ℂ) := (circulant_permanent (fun i => (1 : ℂ) + t*h i)).symm.trans (hp t)

  have van (t : ℂ) := (expand_t (h 0) (h 1) (h 2) (h 3) (h 4) (h 5) t).symm.trans (ev t)

  have e1 := van 1

  have e2 := van 2

  have e3 := van 3

  have e4 := van 4

  have e5 := van 5

  have e6 := van 6

  -- The six rows below invert evaluation of the nonconstant coefficients at 1,...,6.

  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩

  · linear_combination (6/1 : ℂ) * e1 + (-15/2 : ℂ) * e2 + (20/3 : ℂ) * e3 + (-15/4 : ℂ) * e4 + (6/5 : ℂ) * e5 + (-1/6 : ℂ) * e6

  · linear_combination (-87/10 : ℂ) * e1 + (117/8 : ℂ) * e2 + (-127/9 : ℂ) * e3 + (33/4 : ℂ) * e4 + (-27/10 : ℂ) * e5 + (137/360 : ℂ) * e6

  · linear_combination (29/6 : ℂ) * e1 + (-461/48 : ℂ) * e2 + (31/3 : ℂ) * e3 + (-307/48 : ℂ) * e4 + (13/6 : ℂ) * e5 + (-5/16 : ℂ) * e6

  · linear_combination (-31/24 : ℂ) * e1 + (137/48 : ℂ) * e2 + (-121/36 : ℂ) * e3 + (107/48 : ℂ) * e4 + (-19/24 : ℂ) * e5 + (17/144 : ℂ) * e6

  · linear_combination (1/6 : ℂ) * e1 + (-19/48 : ℂ) * e2 + (1/2 : ℂ) * e3 + (-17/48 : ℂ) * e4 + (2/15 : ℂ) * e5 + (-1/48 : ℂ) * e6

