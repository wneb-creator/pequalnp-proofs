private noncomputable def cm (m : ℕ) (rows : List (Fin 6)) (x : Fin 6 → ℂ) : Matrix (Fin m) (Fin m) ℂ :=
  Matrix.of fun i j => x (Fin.ofNat 6 j.val - rows.getD i.val 0)
