    (hp : okP T Z L M = true) (h : M.all (okSE [e] T Z (L - 1)) = true) : Imp [e] Z L := by
  simp only [okP, Bool.and_eq_true, List.all_eq_true, List.mem_range] at hp
  refine imp_of (Or.inr ⟨e, he, rfl, hraw⟩) hp.1.1 (Nat.le_of_ble_eq_true hp.1.2)
    (fun x hx => hT x (List.mem_of_mem_filter hx)) (Or.inr fun t ht => ⟨selT M t, hp.2 t ht, fun p hq => ?_⟩)
  simp only [selT, List.mem_map, List.mem_filter] at hq
  obtain ⟨q, ⟨hq1, hq2⟩, rfl⟩ := hq
  have h1 := List.all_eq_true.1 h q hq1
  have h2 : q.1 = t := Nat.eq_of_beq_eq_true hq2
