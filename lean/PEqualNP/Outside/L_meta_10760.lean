def ourGraph : Sig := 0xfffffffffffefffafffeffeefefeeca0fffffffffffefffafffeffeefefeeca0fffffffffffefffafffeffeefefeeca0fffffffffffefffafffeffeefefeeca0
def ourTarget (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 2) || (x 1 && x 3) || (x 0 && x 4) || (x 1 && x 4) || (x 2 && x 4) || (x 0 && x 5) || (x 1 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 5 && x 6)
lemma ourGraph_proper : proper ourGraph := by unfold proper; decide +kernel
set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
lemma ourTable : ∀ r : Row, bit r ourGraph = ourTarget (sampleSeven r) := by decide +kernel
def ourLowRow (i : Fin 7) : Row := Fin.ofNat 512 (1 <<< ([2, 3, 0, 1, 0, 0, 0] : List Nat).getD i.val 0)
def ourHighRow (i : Fin 7) : Row := Fin.ofNat 512 ((1 <<< i.val) ||| (1 <<< ([2, 3, 0, 1, 0, 0, 0] : List Nat).getD i.val 0))

set_option maxHeartbeats 1000000 in
lemma ourAllSevenRequired :
    (∀ i : Fin 7, bit (ourLowRow i) ourGraph ≠ bit (ourHighRow i) ourGraph) ∧
    (∀ i j : Fin 7, i ≠ j →
      bit (ourLowRow i) (sevenInputs.getD j.val zero) =
      bit (ourHighRow i) (sevenInputs.getD j.val zero)) := by decide +kernel

lemma ourPhysicalSigned (C : Circuit) (legal : PEqualNP.MetaComplexity.FanInTwo C)
    (computes : ∀ x : Fin 7 → Bool, C.eval (List.ofFn x)=ourTarget x) :
    ∃ k, k ≤ C.gates.countP (fun g => !isNot g) ∧ Live true ourGraph k sevenInputs.toFinset := by
  have goalEq : (execute C.gates sevenInputs).getD C.output zero = ourGraph := by
    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    let r : Row := ⟨j,hj⟩
    exact (sevenEval C legal C.output r).trans ((computes (sampleSeven r)).trans (ourTable r).symm)
  have out := get_rep (u:=true) (execute C.gates sevenInputs) C.output
  rw [goalEq] at out
  unfold Repr at out
  have pg : bit 0 ourGraph = false := by decide +kernel
  rw [nrm_id pg] at out
  obtain ⟨k,S,hk,run,sub⟩ := extract (u:=true) C.gates sevenInputs legal (by simp) ourGraph_proper
    (out.resolve_right (fun h => h ourGraph_proper))
  have ns : sevenInputs.all plainWord = true := by decide +kernel
  rw [nrm_map ns] at sub
  have idx (a : Sig) (ha : a ∈ sevenInputs) : ∃ i : Fin 7, sevenInputs.getD i.val zero = a := by
    rw [←sevenList] at ha
    exact List.mem_ofFn.mp ha
  have eq : S = sevenInputs.toFinset := by
    ext a
    constructor
    · exact fun h => List.mem_toFinset.mpr (sub a h)
    · intro ha
      obtain ⟨i,rfl⟩ := idx a (List.mem_toFinset.mp ha)
      apply raw_required run sevenInputs (sevenInputs.getD i.val zero) sub (ourLowRow i) (ourHighRow i)
        (ourAllSevenRequired.1 i)
      intro v hv hn
      obtain ⟨j,rfl⟩ := idx v hv
      apply ourAllSevenRequired.2 i j
      rintro rfl
      exact hn rfl
  exact ⟨k,hk,eq ▸ run⟩

def ourToMinor : List Move := ([101, 83] : List Nat).map swapRows ++ fixRows 4 0
def ourRemoved : List (Sig × Row × Row) := [(sevenInputs.getD 2 zero, 1, 5)]
