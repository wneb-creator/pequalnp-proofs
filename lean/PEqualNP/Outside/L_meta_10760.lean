  · subst o
    exact tb_land a b r
  by_cases h1 : o = 1
  · subst o
    exact tb_lor a b r
  by_cases h2 : o = 2
  · subst o
    change (Nat.xor a (Nat.land a b)).testBit r = _
    rw [tb_xor, tb_land]
    rfl
  · unfold nb gate
    rw [nbeq h0, nbeq h1, nbeq h2, ite_eq_right h0, ite_eq_right h1,
      ite_eq_right h2]
    exact (tb_xor b (Nat.land a b) r).trans (by rw [tb_land])

