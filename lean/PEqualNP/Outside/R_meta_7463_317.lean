    intro i hi ha hb
    obtain ⟨hA,hB,adj⟩ := edgeInfo ⟨i,hi⟩
    have absent (n : ℕ) (hn : n < 11) (on : m.val.testBit n = true) : Fin.ofNat 11 n ∉ K := by
      have hh := bits (Fin.ofNat 11 n)
      have eq : (Fin.ofNat 11 n).val = n := Nat.mod_eq_of_lt hn
      rw [eq,on] at hh
      exact of_decide_eq_true hh.symm
    by_contra hn
    exact (hK (SimpleGraph.deleteEdges_adj.mpr ⟨adj,hn⟩)).elim (absent _ hA ha) (absent _ hB hb)
  have cv : valid m.val = true := by
    let b : Fin 32 := ⟨m.val / 64, by have := m.isLt; omega⟩
    let r : Fin 64 := ⟨m.val % 64, Nat.mod_lt _ (by decide)⟩
    have eq : 64*b.val+r.val = m.val := by dsimp [b,r]; omega
    rw [← eq]
    exact cert b r
  let t := rep m.val
  change (((decide (t < 2048) && marked t) && decide (count m.val ≤ count t)) &&
    (List.range 16).all (fun i => decide (t.testBit (ends i).1 = true → t.testBit (ends i).2 = true →
      m.val.testBit (ends i).1 = true ∧ m.val.testBit (ends i).2 = true))) = true at cv
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at cv
  obtain ⟨⟨⟨ht, mark⟩, larger⟩, subset⟩ := cv
  have htHit : hits t := by
    intro i hi ha hb
    obtain ⟨pa,pb⟩ := subset i (List.mem_range.mpr hi) ha hb
    exact roots i hi pa pb
  have bound : U.card + count t ≤ D + 4 := by
    by_cases h : t < 1024
    · exact low t h (by simpa [marked,h] using mark) htHit
    · have eq : t - 1024 + 1024 = t := by omega
      have j := high (t-1024) (by omega) (by simpa [marked,h] using mark)
      rw [eq] at j
      exact j htHit
  omega
