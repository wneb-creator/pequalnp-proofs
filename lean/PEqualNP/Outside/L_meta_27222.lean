open PEqualNP.MetaComplexity Elimination.Readers

lemma f0_nc : RestrNC f0 := by
  intro p _ b
  exact f0_nc_raw p b

lemma f0_nf : NoFunnel f0 := by
  intro p q hpq _ _
  exact f0_nf_raw p q hpq

lemma pos_nc (p : Fin 8) : RestrNC (pos p) := by
  intro q _ b
  exact pos_nc_raw p q b

lemma pos_nf (p : Fin 8) : NoFunnel (pos p) := by
  intro q r hqr hq hr
  exact pos_nf_raw p q r hqr ((pos_dep_iff_raw p q).mp hq)
    ((pos_dep_iff_raw p r).mp hr)

lemma twice_lower (p q : Fin 8) (hqp : q ≠ p) (b : Bool)
    (s : Nat) (h : HasCircuitSize 8 (twice p q b) s) :
    (if b then 5 else 4) ≤ s + 1 := by
  exact (support_card_raw p q b hqp).trans
    (Live.dep_subset_lower 8 (twice p q b) (supportSet p q b)
      (fun i hi => support_dep_raw p q b i hi) s h)

lemma positive_lower (p : Fin 8) (s : Nat)
    (h : HasCircuitSize 8 (pos p) s) : 7 ≤ s := by
  have hdep : ∃ q : Fin 8, Dep (pos p) q := by
    by_cases hp : p = 0
    · exact ⟨1, (pos_dep_iff_raw p 1).mpr (by subst p; decide)⟩
    · exact ⟨0, (pos_dep_iff_raw p 0).mpr (Ne.symm hp)⟩
  obtain ⟨q, hq, hpays⟩ := fanout_step 7 (pos p) s hdep (pos_nc p) (pos_nf p) h
  have hqp : q ≠ p := (pos_dep_iff_raw p q).mp hq
  rcases hpays with ⟨_, ⟨t, ht, hc⟩⟩ | ⟨⟨t, ht, hc⟩, _⟩ | ⟨_, ⟨t, ht, hc⟩⟩
  · have hb := twice_lower p q hqp true t hc
    change 5 ≤ t + 1 at hb
    omega
  · have hb := twice_lower p q hqp false t hc
    change 4 ≤ t + 1 at hb
    omega
  · have hb := twice_lower p q hqp true t hc
    change 5 ≤ t + 1 at hb
    omega

lemma f0_lower (s : Nat) (h : HasCircuitSize 8 f0 s) : 9 ≤ s := by
  obtain ⟨p, _, hpays⟩ := fanout_step 7 f0 s ⟨0, dep0_raw 0⟩ f0_nc f0_nf h
  rcases hpays with ⟨_, ⟨t, ht, hc⟩⟩ | ⟨_, ⟨t, ht, hc⟩⟩ | ⟨_, ⟨t, ht, hc⟩⟩
  all_goals
    have hb := positive_lower p t hc
    omega

end PEqualNP.Outside.L_meta_27222_aux

