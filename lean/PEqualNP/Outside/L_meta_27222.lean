def f0 (x : Fin 8 → Bool) : Bool :=
  (x 2 && ((x 0 && x 7) || (x 1 && x 6))) ||
  (x 5 && ((x 0 && x 4) || (x 1 && x 3)))

def pos (p : Fin 8) (x : Fin 8 → Bool) : Bool :=
  f0 (Function.update x p true)

def twice (p q : Fin 8) (b : Bool) (x : Fin 8 → Bool) : Bool :=
  pos p (Function.update x q b)

set_option maxHeartbeats 10000000 in
lemma dep0_raw : ∀ i : Fin 8, ∃ x : Fin 8 → Bool,
    f0 (Function.update x i (!x i)) ≠ f0 x := by
  decide +kernel

set_option maxHeartbeats 10000000 in
lemma pos_dep_iff_raw : ∀ p q : Fin 8,
    (∃ x : Fin 8 → Bool, pos p (Function.update x q (!x q)) ≠ pos p x) ↔ q ≠ p := by
  decide +kernel

set_option maxHeartbeats 10000000 in
lemma f0_nc_raw : ∀ (p : Fin 8) (b : Bool), ∃ x y : Fin 8 → Bool,
    f0 (Function.update x p b) ≠ f0 (Function.update y p b) := by
  decide +kernel

set_option maxHeartbeats 10000000 in
lemma pos_nc_raw : ∀ (p q : Fin 8) (b : Bool), ∃ x y : Fin 8 → Bool,
    pos p (Function.update x q b) ≠ pos p (Function.update y q b) := by
  decide +kernel

def pairFunnelRaw (f : (Fin 8 → Bool) → Bool) (p q : Fin 8) : Prop :=
  ∃ a b : Bool, ∀ x : Fin 8 → Bool,
    f (Function.update (Function.update x p (!a)) q b) =
      f (Function.update (Function.update x p a) q (!b)) ∧
    f (Function.update (Function.update x p a) q (!b)) =
      f (Function.update (Function.update x p (!a)) q (!b))

set_option maxHeartbeats 10000000 in
lemma f0_nf_raw : ∀ p q : Fin 8, p ≠ q → ¬ pairFunnelRaw f0 p q := by
  unfold pairFunnelRaw
  decide +kernel

set_option maxHeartbeats 10000000 in
lemma pos_nf_raw : ∀ s p q : Fin 8, p ≠ q → p ≠ s → q ≠ s →
    ¬ pairFunnelRaw (pos s) p q := by
  unfold pairFunnelRaw
  decide +kernel

def supportMask (p q : Fin 8) (b : Bool) : Nat :=
  ([254, 254, 180, 252, 58, 250, 246, 246, 238, 230, 198, 222, 190, 190, 126, 62, 108, 252, 253, 253, 57, 249, 245, 229, 237, 237, 197, 221, 189, 61, 125, 125, 106, 250, 177, 249, 251, 251, 243, 243, 235, 235, 195, 219, 187, 179, 123, 107, 102, 246, 181, 229, 51, 243, 247, 247, 231, 231, 199, 151, 183, 183, 119, 119, 110, 230, 165, 237, 43, 235, 231, 231, 239, 239, 199, 79, 175, 175, 111, 111, 78, 222, 149, 221, 27, 219, 215, 151, 207, 79, 223, 223, 159, 159, 95, 95, 46, 190, 181, 61, 59, 179, 183, 183, 175, 175, 135, 159, 191, 191, 63, 63, 110, 62, 53, 125, 59, 107, 119, 119, 111, 111, 71, 95, 63, 63, 127, 127] : List Nat).getD
    (16 * p.val + 2 * q.val + if b then 1 else 0) 0

def supportSet (p q : Fin 8) (b : Bool) : Finset (Fin 8) :=
  Finset.univ.filter fun i => (supportMask p q b).testBit i.val

set_option maxHeartbeats 10000000 in
lemma support_card_raw : ∀ (p q : Fin 8) (b : Bool), q ≠ p →
    (if b then 5 else 4) ≤ (supportSet p q b).card := by
  decide +kernel

set_option maxHeartbeats 10000000 in
lemma support_dep_raw : ∀ (p q : Fin 8) (b : Bool) (i : Fin 8), i ∈ supportSet p q b →
    ∃ x : Fin 8 → Bool, twice p q b (Function.update x i (!x i)) ≠ twice p q b x := by
  decide +kernel

