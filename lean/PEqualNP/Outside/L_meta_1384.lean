theorem PEqualNP.Outside.L_meta_1384 : ∀ (cA cB : ℕ), (∀ (N Jn : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I] (Ckt : PEqualNP.CircuitLowerBounds.Circuit) (fa fb : Fin Jn → ℕ) (fr : ℕ), (∀ p p' l l' : Fin N, p ≠ p' → l ≠ l' → ¬ (I p l ∧ I p l' ∧ I p' l ∧ I p' l')) → PEqualNP.MetaComplexity.Monotone2 Ckt → (∀ jd : Fin Jn, (Ckt.lineDegrees (N + N) (Finset.Ico N (N + N))).getD (fa jd) 0 ≤ 2 ∧ (Ckt.lineDegrees (N + N) (Finset.Ico N (N + N))).getD (fb jd) 0 ≤ 2) → (∀ (jb : Fin Jn) (zz : Fin (N + N) → Bool), (Ckt.wires (List.ofFn zz)).getD (fa jb) false = true → (Ckt.wires (List.ofFn zz)).getD (fb jb) false = true → ∃ (pa lb : Fin N), I pa lb ∧ zz (Fin.castAdd N pa) = true ∧ zz (Fin.natAdd N lb) = true) → (Finset.univ.filter (fun e2 : Fin N × Fin N => I e2.1 e2.2 ∧ (Ckt.wires (List.ofFn (fun vq : Fin (N + N) => if vq = Fin.castAdd N e2.1 then true else if vq = Fin.natAdd N e2.2 then true else false))).getD fr false = false ∧ (∃ jc : Fin Jn, (Ckt.wires (List.ofFn (fun vq : Fin (N + N) => if vq = Fin.castAdd N e2.1 then true else if vq = Fin.natAdd N e2.2 then true else false))).getD (fa jc) false = true ∧ (Ckt.wires (List.ofFn (fun vq : Fin (N + N) => if vq = Fin.castAdd N e2.1 then true else if vq = Fin.natAdd N e2.2 then true else false))).getD (fb jc) false = true) ∧ ∀ jk : Fin Jn, (Ckt.wires (List.ofFn (fun vq : Fin (N + N) => if vq = Fin.castAdd N e2.1 then true else if vq = Fin.natAdd N e2.2 then true else false))).getD (fa jk) false = true → (Ckt.wires (List.ofFn (fun vq : Fin (N + N) => if vq = Fin.castAdd N e2.1 then true else if vq = Fin.natAdd N e2.2 then true else false))).getD (fb jk) false = true → (Ckt.wires (List.ofFn (fun vp : Fin (N + N) => decide (vp = Fin.castAdd N e2.1)))).getD (fa jk) false = false ∧ (Ckt.wires (List.ofFn (fun vp : Fin (N + N) => decide (vp = Fin.castAdd N e2.1)))).getD (fb jk) false = false)).card ≤ cA * (Ckt.size + Jn) + cB * N) → ∀ (N0 Jn0 : ℕ) (I0 : Fin N0 → Fin N0 → Prop) [DecidableRel I0] (Ckt0 : PEqualNP.CircuitLowerBounds.Circuit) (fa0 fb0 : Fin Jn0 → ℕ) (fr0 : ℕ), (∀ p0 p1 l0 l1 : Fin N0, p0 ≠ p1 → l0 ≠ l1 → ¬ (I0 p0 l0 ∧ I0 p0 l1 ∧ I0 p1 l0 ∧ I0 p1 l1)) → PEqualNP.MetaComplexity.Monotone2 Ckt0 → (∀ jd0 : Fin Jn0, (Ckt0.lineDegrees (N0 + N0) (Finset.Ico N0 (N0 + N0))).getD (fa0 jd0) 0 ≤ 2 ∧ (Ckt0.lineDegrees (N0 + N0) (Finset.Ico N0 (N0 + N0))).getD (fb0 jd0) 0 ≤ 1) → (∀ (jb0 : Fin Jn0) (zz0 : Fin (N0 + N0) → Bool), (Ckt0.wires (List.ofFn zz0)).getD (fa0 jb0) false = true → (Ckt0.wires (List.ofFn zz0)).getD (fb0 jb0) false = true → ∃ (pa0 lb0 : Fin N0), I0 pa0 lb0 ∧ zz0 (Fin.castAdd N0 pa0) = true ∧ zz0 (Fin.natAdd N0 lb0) = true) → (Finset.univ.filter (fun e20 : Fin N0 × Fin N0 => I0 e20.1 e20.2 ∧ (Ckt0.wires (List.ofFn (fun vq0 : Fin (N0 + N0) => if vq0 = Fin.castAdd N0 e20.1 then true else if vq0 = Fin.natAdd N0 e20.2 then true else false))).getD fr0 false = false ∧ (∃ jc0 : Fin Jn0, (Ckt0.wires (List.ofFn (fun vq0 : Fin (N0 + N0) => if vq0 = Fin.castAdd N0 e20.1 then true else if vq0 = Fin.natAdd N0 e20.2 then true else false))).getD (fa0 jc0) false = true ∧ (Ckt0.wires (List.ofFn (fun vq0 : Fin (N0 + N0) => if vq0 = Fin.castAdd N0 e20.1 then true else if vq0 = Fin.natAdd N0 e20.2 then true else false))).getD (fb0 jc0) false = true) ∧ ∀ jk0 : Fin Jn0, (Ckt0.wires (List.ofFn (fun vq0 : Fin (N0 + N0) => if vq0 = Fin.castAdd N0 e20.1 then true else if vq0 = Fin.natAdd N0 e20.2 then true else false))).getD (fa0 jk0) false = true → (Ckt0.wires (List.ofFn (fun vq0 : Fin (N0 + N0) => if vq0 = Fin.castAdd N0 e20.1 then true else if vq0 = Fin.natAdd N0 e20.2 then true else false))).getD (fb0 jk0) false = true → (Ckt0.wires (List.ofFn (fun vp0 : Fin (N0 + N0) => decide (vp0 = Fin.castAdd N0 e20.1)))).getD (fa0 jk0) false = false ∧ (Ckt0.wires (List.ofFn (fun vp0 : Fin (N0 + N0) => decide (vp0 = Fin.castAdd N0 e20.1)))).getD (fb0 jk0) false = false)).card ≤ 2 * cA * (Ckt0.size + Jn0) + cB * N0 := by
