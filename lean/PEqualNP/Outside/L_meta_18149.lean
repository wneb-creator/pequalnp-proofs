private def decode (digits : ℕ) (i : Fin 13) : Fin 13 :=
  Fin.ofNat 13 ((digits >>> (4 * i.val)) % 16)

private def point (k : Fin maps.size) : Fin 13 → Fin 13 :=
  decode maps[k.val].1

private def line (k : Fin maps.size) : Fin 13 → Fin 13 :=
  decode maps[k.val].2

private def goodMap (k : Fin maps.size) : Prop :=
  (∀ a b : Fin 13, point k a = point k b → a = b) ∧
  (∀ a b : Fin 13, line k a = line k b → a = b) ∧
  ∀ a b : Fin 13, incidence (point k a) (line k b) ↔ incidence a b

private instance (k : Fin maps.size) : Decidable (goodMap k) := by
  unfold goodMap
  infer_instance

set_option maxHeartbeats 0 in
set_option maxRecDepth 16384 in
private theorem maps_good : ∀ k, goodMap k := by decide

private def relabel (p q : Fin 13 → Fin 13) (u : Fin 26) : ℕ :=
  if u.val < 13 then (p (Fin.ofNat 13 u.val)).val
  else 13 + (q (Fin.ofNat 13 (u.val - 13))).val

private def tag (u v : ℕ) : ℕ :=
  26 * min u v + max u v

private def reps : List ℕ :=
