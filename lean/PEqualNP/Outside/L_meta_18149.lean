private def pick (u v : Fin 26) : Fin maps.size :=
  letI : NeZero maps.size := ⟨by decide⟩
  Fin.ofNat maps.size ((choices[u.val]! >>> (7 * v.val)) % 128)

private def covered (u v : Fin 26) : Prop :=
  let k := pick u v
  tag (relabel (point k) (line k) u) (relabel (point k) (line k) v) ∈ reps

private instance (u v : Fin 26) : Decidable (covered u v) := by
  unfold covered
  infer_instance

set_option maxHeartbeats 0 in
set_option maxRecDepth 16384 in
private theorem pairs_covered : ∀ u v, covered u v := by decide

theorem orbit (u v : Fin 26) :
    ∃ p q : Equiv.Perm (Fin 13),
      (∀ a b, incidence (p a) (q b) ↔ incidence a b) ∧
      tag (relabel p q u) (relabel p q v) ∈ reps := by
  have hg := maps_good (pick u v)
  have hp : Function.Injective (point (pick u v)) := fun _ _ h => hg.1 _ _ h
  have hq : Function.Injective (line (pick u v)) := fun _ _ h => hg.2.1 _ _ h
  let p := Equiv.ofBijective (point (pick u v)) ⟨hp, Finite.surjective_of_injective hp⟩
  let q := Equiv.ofBijective (line (pick u v)) ⟨hq, Finite.surjective_of_injective hq⟩
  exact ⟨p, q, hg.2.2, pairs_covered u v⟩

