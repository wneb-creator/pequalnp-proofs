def edge10 (x : Fin 10 → Bool) : Bool :=
  x 0 && x 1 || x 1 && x 2 || x 2 && x 3 || x 3 && x 4 || x 4 && x 0 ||
  x 0 && x 5 || x 1 && x 6 || x 2 && x 7 || x 3 && x 8 || x 4 && x 9 ||
  x 5 && x 7 || x 7 && x 9 || x 9 && x 6 || x 6 && x 8 || x 8 && x 5

def signed (b v : Bool) : Bool := if b then !v else v

theorem signed_involutive (b v : Bool) : signed b (signed b v) = v := by cases b <;> simp [signed]

def pinRow {n : Nat} (a : Fin n) (b : Bool) (x : Fin n → Bool) (i : Fin n) : Bool :=
  if i = a then b else x i

def constInit {n : Nat} (a : Fin n) (b : Bool) : List Stat :=
  List.ofFn fun i : Fin n => if i = a then Sum.inl b else Sum.inr i.val

theorem constInitInv {n : Nat} (a : Fin n) (b : Bool) (x : Fin n → Bool) :
    Inv n (List.ofFn x) (List.ofFn (pinRow a b x)) (constInit a b, []) := by
  refine ⟨by simp [constInit], ?_⟩
  intro j
  by_cases hj : j < n
  · let i : Fin n := ⟨j, hj⟩
    change ((constInit a b).getD i.val (Sum.inl false)).Valid (n + 0) ∧
      ((constInit a b).getD i.val (Sum.inl false)).val (List.ofFn x) =
        (List.ofFn (pinRow a b x)).getD i.val false
    simp only [constInit, getD_ofFn, Nat.add_zero]
    by_cases h : i = a
    · simp [pinRow,h, Stat.Valid, Stat.val]
    · simp only [pinRow,ite_eq_right h, Stat.Valid, Stat.val,getD_ofFn]
      exact ⟨hj,trivial⟩
  · change ((constInit a b).getD j (Sum.inl false)).Valid (n + 0) ∧
      ((constInit a b).getD j (Sum.inl false)).val (List.ofFn x) =
        (List.ofFn (pinRow a b x)).getD j false
    rw [List.getD_eq_default _ _ (by simpa [constInit] using Nat.le_of_not_lt hj),
      List.getD_eq_default _ _ (by simpa using Nat.le_of_not_lt hj)]
    exact ⟨trivial,rfl⟩

theorem pinConstant {n : Nat} (C : Circuit) (a : Fin n) (b : Bool) (legal : FanInTwo C)
    (hpos : ∃ x, circuitFun n C (pinRow a b x) = true)
    (hneg : ∃ x, circuitFun n C (pinRow a b x) = false) :
    ∃ D : Circuit, FanInTwo D ∧ D.size ≤ C.size ∧
      ∀ x, circuitFun n D x = circuitFun n C (pinRow a b x) := by
  let gs := C.gates.map normGate
  let acc := elim n gs (constInit a b, [])
  have nok (g : Gate) (hg : g ∈ gs) : NOk g := by
    obtain ⟨h,hh,rfl⟩ := List.mem_map.mp hg
    exact normGate_nok h (legal h hh)
  have inv (x : Fin n → Bool) : Inv n (List.ofFn x) (wiresFrom gs (List.ofFn (pinRow a b x))) acc :=
    inv_elim n _ (by simp) gs _ _ (fun g hg => (nok g hg).1) (constInitInv a b x)
  have values (x : Fin n → Bool) :
      (acc.1.getD C.output (.inl false)).val (wiresFrom acc.2 (List.ofFn x)) =
        circuitFun n C (pinRow a b x) := by
    rw [((inv x).2 C.output).2]
    change (wiresFrom (C.gates.map normGate) (List.ofFn (pinRow a b x))).getD C.output false = _
    rw [wiresFrom_norm]
    rfl
  have size : acc.2.length ≤ C.size := by
    have h := elim_len n gs (constInit a b,[])
    simpa only [acc,gs,Circuit.size,List.length_nil,zero_add,List.length_map] using h
  cases hout : acc.1.getD C.output (.inl false) with
  | inl c =>
    obtain ⟨x,hx⟩ := hpos
    obtain ⟨y,hy⟩ := hneg
    have ht := values x
    have hf := values y
    rw [hout,hx] at ht
    rw [hout,hy] at hf
    change c = true at ht
    change c = false at hf
    cases c <;> contradiction
  | inr j =>
    refine ⟨⟨acc.2,j⟩,elim_ok n gs _ (by simp),size,?_⟩
    intro x
    have v := values x
    rw [hout] at v
    exact v

def projectRow {n : Nat} (hidden : Fin (n+1)) (back : Fin (n+1) → Fin n)
    (x : Fin n → Bool) (j : Fin (n+1)) : Bool :=
  if j = hidden then false else x (back j)

theorem translateInput {n : Nat} (hidden : Fin (n+1)) (back : Fin (n+1) → Fin n)
    (C : Circuit) (legal : FanInTwo C) :
    ∃ D : Circuit, FanInTwo D ∧ D.size = C.size ∧
      ∀ x, circuitFun n D x = circuitFun (n+1) C (projectRow hidden back x) := by
  let sent := n + C.gates.length
  let reindex (i : Nat) :=
    if h : i < n+1 then if i = hidden.val then sent else (back ⟨i,h⟩).val else i-1
  let tr (g : Gate) : Gate := ⟨g.op,g.inputs.map reindex⟩
  let D : Circuit := ⟨C.gates.map tr,reindex C.output⟩
  have hFan : FanInTwo D := by
    intro g hg
    obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hg
    exact ⟨(legal a ha).1,by simpa only [tr,List.length_map] using (legal a ha).2⟩
  have hLen : D.size = C.size := List.length_map tr
  have fold :
      ∀ (gs : List Gate) (A B : List Bool), A.length = B.length+1 → n+1 ≤ A.length →
        B.length + gs.length ≤ sent →
        (∀ i, A.getD i false = B.getD (reindex i) false) →
        ∀ i, (wiresFrom gs A).getD i false =
          (wiresFrom (gs.map tr) B).getD (reindex i) false := by
    intro gs
    induction gs with
    | nil => intro A B _ _ _ h i; exact h i
    | cons g gs ih =>
      intro A B hs ha hCap he i
      let k := g.op.eval (g.inputs.map fun j => A.getD j false)
