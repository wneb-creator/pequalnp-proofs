set_option maxRecDepth 100000 in
lemma induced_path_obstruction {s : ℕ} (h : RepSizeAtMost graph s) :
    ∃ s', RepSizeAtMost P7Lower.bigA s' ∧ s' + 66 ≤ s + 7 := by
  have hR : ∀ u ∈ P7Lower.R, ∃ v ∈ P7Lower.K, graph u v = false := by decide +kernel
  have hK : ∀ v ∈ P7Lower.K, ∃ u ∈ P7Lower.R, graph u v = false := by decide +kernel
  have he : ∃ u ∈ P7Lower.R, ∃ v ∈ P7Lower.K, graph u v = true := by decide +kernel
  obtain ⟨s', hs', hi⟩ := Induced.induced 33 33 s graph P7Lower.R P7Lower.K hR hK he h
  refine ⟨s', hs', ?_⟩
  have hc : (P7Lower.R.filter (fun a => ∃ b ∈ P7Lower.K, graph a b = true)).card +
    (P7Lower.K.filter (fun b => ∃ a ∈ P7Lower.R, graph a b = true)).card = 7 := by decide +kernel
  change s' + ((forcedL graph).card + (forcedR graph).card) ≤ s + _ at hi
  rw [forced_card, hc] at hi
  exact hi

lemma lower67 {s : ℕ} (h : RepSizeAtMost graph s) : 67 ≤ s := by
  by_contra hn
  have hs : s ≤ 66 := by omega
  obtain ⟨s', hs', hi⟩ := induced_path_obstruction h
  obtain ⟨C, hm, hsize, hrep⟩ := hs'
  exact P7Lower.big_no_small C hm (by omega) hrep

end PEqualNP.Outside.L_meta_9502
