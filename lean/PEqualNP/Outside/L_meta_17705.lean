theorem checked : ∀ s ≤ cap, ∀ i < N s, verify s i=true := by
  intro s hs
  change s ≤ 11 at hs
  interval_cases s
  · intro j hj;exact False.elim (Nat.not_lt_zero _ hj)
  · intro j hj;exact False.elim (Nat.not_lt_zero _ hj)
  · intro j hj;exact False.elim (Nat.not_lt_zero _ hj)
  · intro j hj;exact False.elim (Nat.not_lt_zero _ hj)
  · intro j hj;exact False.elim (Nat.not_lt_zero _ hj)
  · exact fun j hj => @MonoBar.span_ok (verify 5) 15 0 layer5 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 6) 113 0 layer6 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 7) 487 0 layer7 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 8) 873 0 layer8 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 9) 376 0 layer9 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 10) 15 0 layer10 j (Nat.zero_le j) hj
  · exact fun j hj => @MonoBar.span_ok (verify 11) 1 0 layer11 j (Nat.zero_le j) hj
theorem sym_checked : ∀ s≤cap, ∀ i<N s, MonoBar.symbar k S N idx orient s i = true := by
  intro s hs i hi
  have z := checked s hs i hi
  cases s <;> exact z
end OrbitTheta

