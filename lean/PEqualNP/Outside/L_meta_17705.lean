namespace OrbitAdjacent
def orient (s : Nat) (ws : List Nat) :=
  let d := code s ws
  if d=0 then ws else ws.map (MonoSymm.blend (trans d))
def verify : Nat → Nat → Bool
  | 0,i => !(S 0 i == [MonoBar.goal k])
  | s+1,i =>
    let ws := S (s+1) i
    !(MonoBar.next (s+2-ws.length) ws fun zs =>
      (MonoBar.covUp k zs &&& MonoBar.lo k == MonoBar.lo k) &&
      !(let t := idx s zs
        decide (t<N s) && (orient s zs).isPerm (S s t)))

private theorem masks (d : Nat) : (trans d).Pairwise (fun a b => a.2 &&& b.2=0) ∧ MonoSymm.blend (trans d) (MonoBar.goal k)=MonoBar.goal k := by
  by_cases h1 : d=1
  · subst d;decide +kernel
  have e : trans d=trans0 := by simp [trans,h1]
  rw [e];decide +kernel
theorem orient_ok {s : Nat} {ws : List Nat} (h : MonoBar.NatRun (MonoBar.goal k) s ws) :
    MonoBar.NatRun (MonoBar.goal k) s (orient s ws) := by
  by_cases e : code s ws=0
  · simpa [orient,e] using h
  · simpa [orient,e] using MonoSymm.relabelOK _ (masks (code s ws)).1 (masks (code s ws)).2 h
end OrbitAdjacent

