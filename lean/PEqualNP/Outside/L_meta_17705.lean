theorem piece11i0 : MonoBar.span (verify 11) 1 0=true := pass11i0
theorem layer5 : MonoBar.span (verify 5) 15 0=true := piece5i0
theorem layer6 : MonoBar.span (verify 6) 113 0=true := piece6i0
theorem layer7 : MonoBar.span (verify 7) 487 0=true := (@MonoBar.span_join (verify 7) 256 0 231 piece7i0 piece7i256)
theorem layer8 : MonoBar.span (verify 8) 873 0=true := (@MonoBar.span_join (verify 8) 512 0 361 (@MonoBar.span_join (verify 8) 256 0 256 piece8i0 piece8i256) (@MonoBar.span_join (verify 8) 256 512 105 piece8i512 piece8i768))
