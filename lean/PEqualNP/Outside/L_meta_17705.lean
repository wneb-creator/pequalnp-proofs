namespace IncidenceFour
open Finset
variable {P L : Type*} [DecidableEq P] [DecidableEq L]
def Linear (A : L → Finset P) := ∀ ⦃l k⦄, l ≠ k → ∀ ⦃p q⦄, p ≠ q →
  p ∈ A l → q ∈ A l → p ∈ A k → q ∈ A k → False

theorem pair_budget (A : L → Finset P) (lin : Linear A) (S : Finset L) :
    (∑ l ∈ S, (A l).card.choose 2) ≤ (S.biUnion A).card.choose 2 := by
  classical
  let B := fun l => (A l).powersetCard 2
  have dis : (S : Set L).PairwiseDisjoint B := by
    intro l hl k hk diff
    apply Finset.disjoint_left.mpr
    intro K hK hK'
    obtain ⟨h₁,hc⟩ := Finset.mem_powersetCard.mp hK
    obtain ⟨h₂,_⟩ := Finset.mem_powersetCard.mp hK'
    obtain ⟨p,q,pq,rfl⟩ := Finset.card_eq_two.mp hc
    exact lin diff pq (h₁ (by simp)) (h₁ (by simp)) (h₂ (by simp)) (h₂ (by simp))
  have sub : S.biUnion B ⊆ (S.biUnion A).powersetCard 2 := by
    intro K hK
    obtain ⟨l,hl,h⟩ := Finset.mem_biUnion.mp hK
    obtain ⟨h₁,h₂⟩ := Finset.mem_powersetCard.mp h
    exact Finset.mem_powersetCard.mpr ⟨fun p hp => Finset.mem_biUnion.mpr ⟨l,hl,h₁ hp⟩,h₂⟩
  have h := Finset.card_le_card sub
  rw [Finset.card_biUnion dis,Finset.card_powersetCard] at h
  simpa only [B,Finset.card_powersetCard] using h

theorem hall_four (A : L → Finset P) (lin : Linear A) (S : Finset L)
    (hc : S.card ≤ 4) (heavy : ∀ l ∈ S, 2 ≤ (A l).card) :
    ∃ f : S → P, Function.Injective f ∧ ∀ l : S, f l ∈ A l := by
  classical
  apply (Finset.all_card_le_biUnion_card_iff_existsInjective' (fun l : S => A l)).mp
  intro U
  let T := U.map (Function.Embedding.subtype _)
  have eq : U.biUnion (fun l : S => A l) = T.biUnion A := by ext p; simp [T]
  rw [eq]
  have small := Finset.card_le_card (show T ⊆ S by intro l h; obtain ⟨x,_,rfl⟩ := Finset.mem_map.mp h;exact x.prop)
  have card : T.card = U.card := Finset.card_map _
  have ones : T.card ≤ ∑ l ∈ T, (A l).card.choose 2 := by
    calc T.card = ∑ _l ∈ T, 1 := by simp
         _ ≤ _ := Finset.sum_le_sum (fun l hl => by
           have hs : l ∈ S := by obtain ⟨x,_,rfl⟩ := Finset.mem_map.mp hl;exact x.prop
           exact Nat.choose_le_choose 2 (heavy l hs))
  have bound := ones.trans (pair_budget A lin T)
  by_cases h : 4 ≤ (T.biUnion A).card
  · omega
  · let u := (T.biUnion A).card
    have hu : u ≤ 3 := by dsimp [u];omega
    have smallChoose : u.choose 2 ≤ u := by interval_cases u <;> decide
    exact card ▸ bound.trans smallChoose

theorem classify_four (A : L → Finset (Fin 4)) (lin : Linear A) (S : Finset L)
    (heavy : ∀ l ∈ S, 2 ≤ (A l).card) (many : 5 ≤ S.card) :
    (S.card = 5 ∨ S.card = 6) ∧ (∀ l ∈ S, (A l).card = 2) ∧
    Set.InjOn A (S : Set L) := by
  classical
  have total := pair_budget A lin S
  have all : (S.biUnion A).card ≤ 4 := by simpa using (Finset.card_le_univ (S.biUnion A))
  have cap := total.trans (Nat.choose_le_choose 2 all)
  have weigh (T : Finset L) (sub : T ⊆ S) : T.card ≤ ∑ l ∈ T, (A l).card.choose 2 := by
    calc T.card = ∑ _l ∈ T, 1 := by simp
         _ ≤ _ := Finset.sum_le_sum (fun l hl => Nat.choose_le_choose 2 (heavy l (sub hl)))
  have max := (weigh S (fun _ h => h)).trans cap
  change S.card ≤ 6 at max
  have deg (l : L) (hl : l ∈ S) : (A l).card = 2 := by
    have h₂ := heavy l hl
    by_contra! no
    have big := Nat.choose_le_choose 2 (show 3 ≤ (A l).card by omega)
    change 3 ≤ _ at big
    have rest := weigh (S.erase l) (Finset.erase_subset _ _)
    have cr := Finset.card_erase_of_mem hl
    have su := Finset.sum_erase_add S (fun x => (A x).card.choose 2) hl
    change _ ≤ 6 at cap
    omega
  refine ⟨by omega,deg,?_⟩
  intro l hl k hk eq
  by_contra diff
  obtain ⟨p,q,pq,h⟩ := Finset.card_eq_two.mp (deg l hl)
  have hp : p ∈ A l := by rw [h];simp
  have hq : q ∈ A l := by rw [h];simp
  exact lin diff pq hp hq (eq ▸ hp) (eq ▸ hq)

end IncidenceFour

namespace IncidenceFour
open Finset
variable {P L : Type} [DecidableEq P] [DecidableEq L] [Fintype L]
def Matchable (A : L → Finset P) (S : Finset L) :=
  ∃ f : S → P, Function.Injective f ∧ ∀ l : S, f l ∈ A l

theorem extend_matching (A : L → Finset P) (H K : Finset L)
    (hh : Matchable A H) (hk : Matchable A K) :
    ∃ J, H ⊆ J ∧ K.card ≤ J.card ∧ Matchable A J := by
  classical
  obtain ⟨h,hi,hm⟩ := hh
  obtain ⟨k,ki,km⟩ := hk
  let D := (↑(Kᶜ) : Type _)
  let B (l : L) : Finset (P ⊕ D) := (A l).disjSum (if l ∈ H then ∅ else univ)
  let fallback (l : L) : P ⊕ D := if lk : l ∈ K then .inl (k ⟨l,lk⟩) else .inr ⟨l,Finset.mem_compl.mpr lk⟩
  have fi : Function.Injective fallback := by
    intro l j eq
    by_cases lk : l ∈ K <;> by_cases jk : j ∈ K
    · exact congrArg Subtype.val (ki (Sum.inl.inj (by simpa only [fallback,dif_pos lk,dif_pos jk] using eq)))
    · simp [fallback,lk,jk] at eq
    · simp [fallback,lk,jk] at eq
    · simp only [fallback,dif_neg lk,dif_neg jk,Sum.inr.injEq] at eq
      exact congrArg Subtype.val eq
  have hall (S : Finset L) : S.card ≤ (S.biUnion B).card := by
    by_cases sub : S ⊆ H
    · let map (l : S) : P ⊕ D := .inl (h ⟨l.val,sub l.prop⟩)
      have inj : Function.Injective map := fun i j e => Subtype.ext (congrArg (fun a : H => a.val) (hi (Sum.inl.inj e)))
      have sits (l : S) : map l ∈ S.biUnion B := Finset.mem_biUnion.mpr ⟨l.val,l.prop, Finset.inl_mem_disjSum.mpr (hm _)⟩
      have b := Fintype.card_le_of_injective (fun l : S => (⟨map l,sits l⟩ : ↑(S.biUnion B))) (fun _ _ e => inj (congrArg Subtype.val e))
      simpa using b
    · obtain ⟨off,mem,free⟩ := Finset.not_subset.mp sub
      apply Finset.card_le_card_of_injOn fallback _ fi.injOn
      intro l ls
      by_cases lk : l ∈ K
      · exact Finset.mem_biUnion.mpr ⟨l,ls,by simpa [fallback,lk,B] using km ⟨l,lk⟩⟩
      · exact Finset.mem_biUnion.mpr ⟨off,mem,by simp [fallback,lk,B,free]⟩
  obtain ⟨g,gi,gm⟩ := (Finset.all_card_le_biUnion_card_iff_existsInjective' B).mp hall
  let J := Finset.univ.filter fun l => (g l).isLeft = true
  have hJ (l : L) : l ∈ J ↔ (g l).isLeft = true := by simp [J]
  have heavy : H ⊆ J := by
    intro l lh
    apply (hJ _).mpr
    have mem := gm l
    cases eq : g l with
    | inl x => rfl
    | inr d => simp [B,lh,eq] at mem
  let val (l : J) : P := (g l.val).getLeft ((hJ _).mp l.prop)
  have gl (l : J) : g l.val = Sum.inl (val l) := by
    have hh := (hJ _).mp l.prop
    cases eq : g l.val with
    | inl p => simp [val,eq]
    | inr d => simp [eq] at hh
  have cj (l : ↑(Jᶜ)) : (g l.val).isRight = true := by
    have hn := Finset.mem_compl.mp l.prop
    cases eq : g l.val with
    | inl x => exact False.elim (hn ((hJ _).mpr (by simp [eq])))
    | inr d => rfl
  let dummy (l : ↑(Jᶜ)) := (g l.val).getRight (cj l)
  have gr (l : ↑(Jᶜ)) : g l.val = Sum.inr (dummy l) := by
    have hh := cj l
    cases eq : g l.val with
    | inl p => simp [eq] at hh
    | inr d => simp [dummy,eq]
  have b := Fintype.card_le_of_injective dummy (fun i j e => Subtype.ext (gi ((gr i).trans ((congrArg Sum.inr e).trans (gr j).symm))))
  change Fintype.card (↑(Jᶜ)) ≤ Fintype.card (↑(Kᶜ)) at b
  simp only [Fintype.card_coe] at b
  have cJ := Finset.card_compl_add_card J
  have cK := Finset.card_compl_add_card K
  refine ⟨J,heavy,by omega,val,?_,?_⟩
  · intro i j e
    exact Subtype.ext (gi ((gl i).trans ((congrArg Sum.inl e).trans (gl j).symm)))
  · intro l
    have mem := gm l.val
    rw [gl l] at mem
    exact Finset.inl_mem_disjSum.mp mem

end IncidenceFour

namespace IncidenceFour
open Finset SupportThree ColumnPeel
variable {m : ℕ}
abbrev E4 (m : ℕ) := Edges 4 m
def neighbors {n : ℕ} (E : Edges n m) (l : Fin m) := univ.filter fun p => (p,l)∈E
def heavy {n : ℕ} (E : Edges n m) := univ.filter fun l => 2 ≤ (neighbors E l).card

theorem graph_linear (E : E4 m) (free : C4 E) : Linear (neighbors E) := by
  intro l k ne p q diff p₁ q₁ p₂ q₂
  exact free p q l k diff ne ⟨(mem_filter.mp p₁).2,(mem_filter.mp p₂).2,(mem_filter.mp q₁).2,(mem_filter.mp q₂).2⟩

theorem matchedColumns {E M : E4 m} (sub : M ⊆ E) (row : Rows M) :
    Matchable (neighbors E) (M.image Prod.snd) := by
  classical
  let K := M.image Prod.snd
  have hit (j : K) : ∃ p, (p,j.val)∈M := by
    obtain ⟨⟨p,l⟩,he,eq⟩ := mem_image.mp j.prop
    exact ⟨p,eq ▸ he⟩
  choose f hf using hit
  refine ⟨f,?_,fun l => mem_filter.mpr ⟨mem_univ _,sub (hf l)⟩⟩
  intro i j eq
  exact Subtype.ext (congrArg Prod.snd (row _ (hf i) _ (hf j) eq))

end IncidenceFour

namespace GridCircuit
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.MetaComplexity.NestedCover PEqualNP.TopForm
def Good (base : ℕ) (gs : List Gate) := ∀ j (hj : j<gs.length),
  (gs[j].op = .and ∨ gs[j].op = .or) ∧ gs[j].inputs.length = 2 ∧ ∀ i ∈ gs[j].inputs, i < base+j
theorem good_iff (n) (C : Circuit) : Good n C.gates ↔ IsAO2 n C := by
  constructor
  · intro h
    refine ⟨?_,?_,?_⟩
    · intro g hg; obtain ⟨j,hj,rfl⟩ := List.mem_iff_getElem.mp hg; exact (h j hj).1
    · intro j hj k hk
      have eq : gateAt C j = C.gates[j] := by simp [gateAt,List.getD,hj]
      exact (h j hj).2.2 k (eq ▸ hk)
    · intro g hg; obtain ⟨j,hj,rfl⟩ := List.mem_iff_getElem.mp hg; exact (h j hj).2.1
  · rintro ⟨hm,hb,ha⟩ j hj
    have eq : gateAt C j = C.gates[j] := by simp [gateAt,List.getD,hj]
    exact ⟨hm _ (List.getElem_mem hj),ha _ (List.getElem_mem hj),fun k hk => hb j hj k (eq ▸ hk)⟩

theorem good_append {n} {a b : List Gate} (ha : Good n a) (hb : Good (n+a.length) b) : Good n (a++b) := by
  intro j hj
  by_cases h : j<a.length
  · simpa only [List.getElem_append_left h] using ha j h
  · have hy : j-a.length < b.length := by simp at hj; omega
    have h1 := hb (j-a.length) hy
    rw [show n+a.length+(j-a.length)=n+j by omega] at h1
    simpa only [List.getElem_append_right (by omega : a.length≤j)] using h1

def name {n m} (f : Fin n → Fin m) (base i : ℕ) :=
  if hi : i<n then (f ⟨i,hi⟩).val else base+(i-n)
def renameG {n m} (f : Fin n → Fin m) (base : ℕ) (g : Gate) : Gate :=
  ⟨g.op,g.inputs.map (name f base)⟩
theorem name_lt {n m} (f : Fin n → Fin m) {base j i : ℕ} (hb : m≤base) (hi : i<n+j) :
    name f base i < base+j := by
  unfold name
  split
  next h => have := (f ⟨i,h⟩).isLt; omega
  next => omega

theorem good_rename {n m base gs} (f : Fin n → Fin m) (hb : m≤base) (h : Good n gs) :
    Good base (gs.map (renameG f base)) := by
  intro j hj
  have hj' : j<gs.length := by simpa using hj
  simp only [List.getElem_map,renameG,List.length_map]
  obtain ⟨ho,hl,hi⟩ := h j hj'
  refine ⟨ho,hl,?_⟩
  intro k hk
  obtain ⟨i,hi',rfl⟩ := List.mem_map.mp hk
  exact name_lt f hb (hi i hi')

def step (w : List Bool) (g : Gate) := w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
def run (gs : List Gate) (w : List Bool) := gs.foldl step w
theorem len (gs : List Gate) (w : List Bool) : (run gs w).length = w.length+gs.length := by
  induction gs generalizing w with
  | nil => simp [run]
  | cons g gs ih =>
    change (run gs (step w g)).length = _
    rw [ih]; simp [step]; omega
theorem old (gs : List Gate) (w : List Bool) (k : ℕ) (hk : k<w.length) : (run gs w).getD k false = w.getD k false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (run gs (step w g)).getD k false = _
    rw [ih (step w g) (by simp [step]; omega)]
    exact List.getD_append _ _ _ _ hk

theorem lookup {n m} (f : Fin n → Fin m) (W : List Bool) (hw : m ≤ W.length)
    (x : Fin n → Bool) (ag : ∀ p, W.getD (f p).val false = x p) (z : List Bool) (i : Nat) :
    (W++z).getD (name f W.length i) false = (List.ofFn x++z).getD i false := by
  unfold name
  split
  next hi =>
    rw [List.getD_append _ _ _ _ (by have := (f ⟨i,hi⟩).isLt; omega),List.getD_append _ _ _ _ (by simpa)]
    simpa [List.getD,hi] using ag ⟨i,hi⟩
  next hi =>
    simp only [List.getD_eq_getElem?_getD,List.getElem?_append_right (by omega : W.length ≤ W.length+(i-n)),
      List.getElem?_append_right (by simp;omega : (List.ofFn x).length ≤ i),List.length_ofFn,Nat.add_sub_cancel_left]

theorem sim {n m} (f : Fin n → Fin m) (W : List Bool) (hw : m≤W.length)
    (x : Fin n → Bool) (ag : ∀ p, W.getD (f p).val false = x p) (gs : List Gate) (z : List Bool) :
    ∃ endBits, run gs (List.ofFn x ++ z) = List.ofFn x ++ endBits ∧
      run (gs.map (renameG f W.length)) (W++z) = W++endBits := by
  induction gs generalizing z with
  | nil => exact ⟨z,rfl,rfl⟩
  | cons g gs ih =>
    let bit := g.op.eval (g.inputs.map fun i => (List.ofFn x ++ z).getD i false)
    obtain ⟨t,h1,h2⟩ := ih (z++[bit])
    refine ⟨t,?_,?_⟩
    · simpa [run,step,bit,List.append_assoc] using h1
    · have hstep : step (W++z) (renameG f W.length g) = W++(z++[bit]) := by
        simp only [step,renameG,List.map_map,Function.comp_def,lookup f W hw x ag,List.append_assoc,bit]
      change run _ (step (W++z) (renameG f W.length g)) = _
      rw [hstep];exact h2

theorem copy_val {n m} (f : Fin n → Fin m) (W : List Bool) (hw : m≤W.length)
    (x : Fin n → Bool) (ag : ∀ p, W.getD (f p).val false = x p) (C : Circuit) :
    (run (C.gates.map (renameG f W.length)) W).getD (name f W.length C.output) false = circuitFun n C x := by
  obtain ⟨z,h1,h2⟩ := sim f W hw x ag C.gates []
  simp only [List.append_nil] at h1 h2
  change _ = (run C.gates (List.ofFn x)).getD C.output false
  rw [h1,h2,lookup _ _ hw x ag]

def Gadget {n} (f : (Fin n → Bool) → Bool) (k : ℕ) := ∃ C : Circuit, IsAO2 n C ∧
  C.output < n + C.gates.length ∧ C.size = k ∧ circuitFun n C = f

theorem output_valid {n} (C : Circuit) (yes : ∃ x, circuitFun n C x = true) :
    C.output<n+C.gates.length := by
  by_contra! h
  obtain ⟨x,hx⟩ := yes
  change (run C.gates (List.ofFn x)).getD C.output false = true at hx
  rw [List.getD_eq_default _ _ (by simpa [len] using h)] at hx;contradiction

theorem relabel {n m} (C : Circuit) (ok : IsAO2 n C) (valid : C.output<n+C.gates.length)
    (f : Fin n → Fin m) :
    Gadget (fun x => circuitFun n C (x ∘ f)) C.size := by
  let D : Circuit := ⟨C.gates.map (renameG f m),name f m C.output⟩
  refine ⟨D,(good_iff m D).mp (good_rename f le_rfl ((good_iff n C).mpr ok)),?_,?_,?_⟩
  · simpa only [D,List.length_map] using name_lt f le_rfl valid
  · simp [Circuit.size,D]
  · funext x
    have h := copy_val f (List.ofFn x) (by simp) (x ∘ f) (fun i => by simp [List.getD]) C
    change (run (C.gates.map (renameG f m)) (List.ofFn x)).getD (name f m C.output) false = _
    simpa only [List.length_ofFn] using h

def op (b : Bool) : GateOp := if b then .and else .or
def bop (b p q : Bool) : Bool := if b then p && q else p || q

theorem last_ok (base i j) (b : Bool) (hi : i<base) (hj : j<base) :
    Good base [⟨op b,[i,j]⟩] := by
  intro k hk
  have eq : k=0 := by simp at hk;omega
  subst k; cases b <;> simp [op,hi,hj]

theorem last_eval (g : Gate) (W : List Bool) : (run [g] W).getD W.length false =
    g.op.eval (g.inputs.map fun i => W.getD i false) := by simp [run,step,List.getD]

theorem append_run (a b : List Gate) (w : List Bool) : run (a++b) w = run b (run a w) := List.foldl_append

theorem join {n k l} {f g : (Fin n → Bool) → Bool} (b : Bool)
    (hA : Gadget f k) (hB : Gadget g l) : Gadget (fun x => bop b (f x) (g x)) (k+l+1) := by
  obtain ⟨A,ao,ab,asz,ae⟩ := hA
  obtain ⟨B,bo,bb,bsz,be⟩ := hB
  let base := n+A.gates.length
  let bs := B.gates.map (renameG (id : Fin n → Fin n) base)
  let bi := name (id : Fin n → Fin n) base B.output
  let ov := base+bs.length
  let newGate : Gate := ⟨op b,[A.output,bi]⟩
  let D : Circuit := ⟨A.gates ++ bs ++ [newGate],ov⟩
  have bl : bs.length = B.gates.length := by simp [bs]
  have bn : n≤base := by simp [base]
  have blo : bi<ov := by unfold ov; rw [bl]; exact name_lt id bn bb
  have alo : A.output<ov := Nat.lt_of_lt_of_le ab (Nat.le_add_right _ _)
  have og : Good base bs := good_rename id bn ((good_iff n B).mpr bo)
  have wa : n+(A.gates++bs).length=ov := by simp [ov,base,Nat.add_assoc]
  refine ⟨D,(good_iff n D).mp (good_append (good_append ((good_iff _ _).mpr ao) og)
    (wa ▸ last_ok ov A.output bi b alo blo)),?_,?_,?_⟩
  · simp [D,ov,base,List.length_append]; omega
  · change A.gates.length=k at asz
    change B.gates.length=l at bsz
    simp [Circuit.size,D,bl,asz,bsz,Nat.add_assoc]
  · funext x
    let W := run A.gates (List.ofFn x)
    let Y := run bs W
    have wl : W.length=base := by simp [W,len,base]
    have yl : Y.length=ov := by simp [Y,len,wl,ov]
    have ah : Y.getD A.output false = f x := by
      rw [show Y.getD A.output false = W.getD A.output false from old bs W A.output (wl ▸ ab)]
      exact congrFun ae x
    have inh (p : Fin n) : W.getD ((id : Fin n → Fin n) p).val false = x p := by
      change (run A.gates (List.ofFn x)).getD p.val false = x p
      rw [old A.gates _ _ (by simp)]
      simp [List.getD]
    have bv := copy_val (id : Fin n → Fin n) W (wl ▸ bn) x inh B
    have bh : Y.getD bi false = g x := by
      change (run (B.gates.map (renameG id base)) W).getD (name id base B.output) false = _
      rw [←wl]
      exact bv.trans (congrFun be x)
    change (run (A.gates++bs++[newGate]) (List.ofFn x)).getD ov false = _
    rw [append_run,append_run]
    change (run [newGate] Y).getD ov false = _
    rw [←yl,last_eval]
    simp only [newGate,List.map_cons,List.map_nil,ah,bh]
    cases b <;> simp [op,bop,GateOp.eval]

theorem atom {n} (u : Fin n) : Gadget (fun x => x u) 0 := by
  let C : Circuit := ⟨[],u.val⟩
  refine ⟨C,(good_iff _ _).mp (by intro j hj; simp [C] at hj),by simpa [C] using u.isLt,rfl,?_⟩
  funext x
  simp [circuitFun,Circuit.eval,Circuit.wires,C,List.getD]

theorem gather {n} {α : Type} (val : α → (Fin n → Bool) → Bool) (cost : α → ℕ) (l : List α)
    (exist : l≠[]) (ok : ∀ a∈l, Gadget (val a) (cost a)) :
    Gadget (fun x => l.any (fun a => val a x)) ((l.map cost).sum+(l.length-1)) := by
  induction l with
  | nil => contradiction
  | cons a l ih =>
    have head := ok a List.mem_cons_self
    by_cases hz : l=[]
    · subst l; simpa using head
    have tail := ih hz (fun u hu => ok u (List.mem_cons_of_mem _ hu))
    have both := join false head tail
    have hl : 0<l.length := List.length_pos_iff.mpr hz
    have cnt : cost a+((l.map cost).sum+(l.length-1))+1 =
        ((a::l).map cost).sum+((a::l).length-1) := by simp;omega
    rw [←cnt]
    simpa [bop] using both

def star {n} (st : Fin n × List (Fin n)) (x : Fin n → Bool) := x st.1 && st.2.any x
theorem star_ok {n} (st : Fin n × List (Fin n)) (nonempty : st.2≠[]) : Gadget (star st) st.2.length := by
  have hl : 0<st.2.length := List.length_pos_iff.mpr nonempty
  have g := gather (fun (i : Fin n) (x : Fin n → Bool) => x i) (fun _ => 0)
    st.2 nonempty (fun i _ => atom i)
  have gz : (st.2.map fun _ => (0 : ℕ)).sum=0 := by simp
  rw [gz,Nat.zero_add] at g
  have h := join true (atom st.1) g
  have cnt : 0 + (st.2.length - 1) + 1 = st.2.length := by omega
  rw [cnt] at h
  exact h

theorem sum_constant {α} (l : List α) (k : Nat) : (l.map fun _ => k).sum = l.length*k := by
  induction l with
  | nil => simp
  | cons h t ih => simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.succ_mul,ih];omega

theorem assemble {n m : ℕ} (C : Circuit) (ok : IsAO2 n C) (valid : C.output < n+C.gates.length)
    (copies : List (Fin n → Fin m)) (hc : copies ≠ []) (stars : List (Fin m × List (Fin m)))
    (hs : ∀ st ∈ stars, st.2 ≠ []) :
    ∃ D : Circuit, IsAO2 m D ∧ D.output < m+D.gates.length ∧
      D.size ≤ copies.length*C.size+(copies.length-1)+(stars.map (fun st => st.2.length)).sum+stars.length ∧
      ∀ x, circuitFun m D x = true ↔
        (∃ f ∈ copies, circuitFun n C (x ∘ f) = true) ∨
        ∃ st ∈ stars, x st.1=true ∧ ∃ leaf ∈ st.2, x leaf=true := by
  let A : List (((Fin m → Bool) → Bool) × ℕ) :=
    copies.map (fun f => (fun x => circuitFun n C (x ∘ f),C.size))
  let B : List (((Fin m → Bool) → Bool) × ℕ) := stars.map (fun st => (star st,st.2.length))
  have nne : A++B ≠ [] := by simpa [A,B] using (show ¬(copies=[] ∧ stars=[]) from fun h => hc h.1)
  have hg (q) (hq : q ∈ A++B) : Gadget q.1 q.2 := by
    rcases List.mem_append.mp hq with hh|hh
    · obtain ⟨f,_,rfl⟩ := List.mem_map.mp hh
      exact relabel C ok valid f
    · obtain ⟨st,hst,rfl⟩ := List.mem_map.mp hh
      exact star_ok st (hs st hst)
  obtain ⟨D,hd,hb,sz,eval⟩ := gather (fun q => q.1) (fun q => q.2) (A++B) nne hg
  refine ⟨D,hd,hb,?_,?_⟩
  · rw [sz]
    have hl := List.length_pos_iff.mpr hc
    simp only [A,B,List.map_append,List.map_map,Function.comp_def,List.sum_append,
      List.length_append,List.length_map,sum_constant]
    omega
  · intro x
    rw [eval]
    simp [A,B,star,List.any_eq_true]

end GridCircuit

namespace MonoGraph
open ColumnGraph LocalNormalize ColumnPeel FiniteFour SupportThree
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm
open Pin.PermInputs PEqualNP.MetaComplexity.NestedCover
def LB {n : ℕ} (f : (Fin n → Bool) → Bool) (k : ℕ) :=
  ∀ C : Circuit, IsAO2 n C → (∀ x, circuitFun n C x=f x) → k ≤ C.size

def Sharp {n m : ℕ} (E : SupportThree.Edges n m) :=
  ∀ M ⊆ E, Rows M → Cols M → LB (ef E) (E.card+M.card-1)

theorem ofLower {n} {f : (Fin n → Bool) → Bool} {k : ℕ} (h : Lower f k) : LB f k := by
  intro C ao spec
  apply h C.size
  refine ⟨C,?_,le_rfl,spec⟩
  intro g hg
  obtain op|op := ao.1 g hg
  · exact ⟨by simp [op],(ao.2.2 g hg).le⟩
  · exact ⟨by simp [op],(ao.2.2 g hg).le⟩

theorem pull {n m : ℕ} (π : Fin n → Fin m) (f : (Fin n → Bool) → Bool)
    {k} (known : LB (fun x => f (x ∘ π)) k) : LB f k := by
  intro C ao spec
  let C' := relabel n m π C
  have cs : C'.size=C.size := by
    change (C.gates.map (relGate n m π)).length = C.gates.length
    exact List.length_map _
  have ao' : IsAO2 m C' := by
    obtain ⟨ops,back,fan⟩ := ao
    refine ⟨?_,?_,?_⟩
    · intro g hg
      obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hg
      exact ops v hv
    · intro j hj t ht
      have sj : j<C.gates.length := by simpa [C',relabel] using hj
      have get : gateAt C' j = relGate n m π (gateAt C j) := by
        change (C.gates.map (relGate n m π)).getD j _ =
          relGate n m π (C.gates.getD j _)
        simp [sj]
      rw [get] at ht
      obtain ⟨z,hz,rfl⟩ := List.mem_map.mp ht
      have h := back j sj z hz
      dsimp only [wmap]
      split
      · have hπ := (π ⟨z,by assumption⟩).isLt;omega
      · omega
    · intro g hg
      obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hg
      simpa [relGate] using fan v hv
  rw [←cs]
  apply known C' ao'
  intro x
  have trans := (rel_fold n m π C.gates _ _ (rel_init n m π x)).2.2 C.output
  exact trans.trans (spec (x ∘ π))

theorem transport {I J : V → V → Prop} [DecidableRel I] [DecidableRel J]
    (P L : V → V) (ps : Function.Surjective P) (ls : Function.Surjective L)
    (eq : ∀ p l, I p l ↔ J (P p) (L l)) {k : ℕ} (hl : LB (F J) k) : LB (F I) k := by
  let enc : Fin 8 → Fin 8 := Fin.addCases (m:=4) (n:=4) (motive:=fun _ => Fin 8) (fun p => Fin.castAdd 4 (P p)) (fun l => Fin.natAdd 4 (L l))
  have same : (fun x => F I (x ∘ enc)) = F J := by
    funext x; apply Bool.eq_iff_iff.mpr
    rw [on_iff,on_iff]
    simp only [Function.comp_apply,enc,Fin.addCases_left,Fin.addCases_right]
    constructor
    · rintro ⟨p,l,e,a,b⟩; exact ⟨P p,L l,(eq p l).mp e,a,b⟩
    · rintro ⟨u,v,e,a,b⟩
      obtain ⟨p,rfl⟩ := ps u
      obtain ⟨l,rfl⟩ := ls v
      exact ⟨p,l,(eq p l).mpr e,a,b⟩
  exact pull enc (F I) (same ▸ hl)

theorem from_counts
    (opposite : LB (F (rel [1,3,5,14])) 11)
    (adjacent : LB (F (rel [1,3,6,13])) 11)
    (edge : LB (F (rel [1,6,10,12])) 10)
    (rowPath : LB (F (rel [1,6,10,13])) 11)
    (colPath : LB (F (rel [3,5,6,9])) 11)
    (theta : LB (F (rel [3,5,9,14])) 12)
    (cycle : LB (F (rel [3,5,10,12])) 11) (t : ℕ) (lo : 2≤t) (hi : t≤8) :
    LB (F (raw (pattern t))) ((indexed (raw (pattern t))).card+4-1) := by
  interval_cases t
  · exact opposite
  · exact adjacent
  · exact edge
  · exact rowPath
  · exact colPath
  · exact theta
  · exact cycle

theorem result_of_types (h : ∀ t, 2 ≤ t → t ≤ 8 →
    LB (F (raw (pattern t))) ((indexed (raw (pattern t))).card+4-1))
    (I : V → V → Prop) [DecidableRel I] (sq : Free I) (diag : ∀ p, I p p) :
    LB (F I) ((indexed I).card+4-1) := by
  rcases classified I sq diag with tree|⟨t,lo,hi,P,L,pb,lb,eq⟩
  · have r : ∀ e ∈ D, e.1=e.2 := by
      intro e he
      obtain ⟨p,_,rfl⟩ := Finset.mem_map.mp he
      rfl
    have sub : D ⊆ indexed I := by
      rintro ⟨p,l⟩ he
      have pl := r _ he
      change p=l at pl
      subst l
      exact (mem_indexed I _ _).mpr (diag p)
    have ri : SupportThree.Rows D := fun e he f hf h => Prod.ext h ((r e he).symm.trans (h.trans (r f hf)))
    have ci : SupportThree.Cols D := fun e he f hf h => Prod.ext ((r e he).trans (h.trans (r f hf).symm)) h
    have incI : inc (indexed I) = I := by funext p l; exact propext (mem_indexed I p l)
    have tree' : (graph (inc (indexed I))).IsAcyclic := by rw [incI]; exact tree
    have base := forest_unrestricted (indexed I) D tree' sub ri ci
    have same : F (fun p l => (p,l)∈indexed I) = F I := by
      funext x; simp only [F, mem_indexed]
    rw [same,show D.card=4 by simp [D]] at base
    exact ofLower base
  · have base := transport P L pb.2 lb.2 eq (h t lo hi)
    have le := edge_le P L pb.1 lb.1 eq
    intro C ao spec
    have := base C ao spec
    omega

end MonoGraph

namespace MonoGraph
open Finset ColumnPeel SupportThree FiniteFour
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm
abbrev Diagonal := ∀ (I : Fin 4 → Fin 4 → Prop) [DecidableRel I], ColumnGraph.Free I →
  (∀ i,I i i) → LB (F I) ((LocalNormalize.indexed I).card+4-1)

theorem padded {m} (known : Diagonal) (E : Edges 4 m) (free : C4 E)
    (J : Finset (Fin m)) (ne : J.Nonempty) (active : ∀ e∈E, e.2∈J)
    (f : J → Fin 4) (inj : Function.Injective f) (hit : ∀ j : J,(f j,j.val)∈E) :
    LB (ef E) (E.card+J.card-1) := by
  classical
  let b (l : Fin m) := if hl : l∈J then f ⟨l,hl⟩ else 0
  have bval (j : J) : b j.val = f j := by simp [b,j.prop]
  let W := J.attach.image f
  let K := univ \ W
  let g := fun e : Fin 4 × Fin m => (e.1,b e.2)
  let A := E.image g
  let G := A ∪ K.image (fun i : Fin 4 => (i,i))
  have wval (j : J) : f j ∈ W := mem_image.mpr ⟨j,Finset.mem_attach _ _,rfl⟩
  have used {p l : Fin 4} (e : (p,l)∈A) : l∈W := by
    obtain ⟨⟨u,v⟩,hv,eq⟩ := mem_image.mp e
    have t := active _ hv
    obtain ⟨_,rfl⟩ : u=p ∧ b v=l := ⟨congrArg Prod.fst eq,congrArg Prod.snd eq⟩
    exact (bval ⟨v,t⟩).symm ▸ wval ⟨v,t⟩
  have lookup (p : Fin 4) (j : J) : (p,f j)∈A ↔ (p,j.val)∈E := by
    constructor
    · rintro h
      obtain ⟨⟨u,v⟩,he,eq⟩ := mem_image.mp h
      have va := active _ he
      let t : J := ⟨v,va⟩
      have eqt : t=j := inj ((bval t).symm.trans (congrArg Prod.snd eq))
      have rp : u=p := congrArg Prod.fst eq
      exact rp ▸ (congrArg Subtype.val eqt) ▸ he
    · intro h
      exact mem_image.mpr ⟨(p,j.val),h,Prod.ext rfl (bval j)⟩
  have km (i : Fin 4) : i∈K ↔ i∉W := by simp [K]
  have edge (p l : Fin 4) : (p,l)∈G ↔ (p,l)∈A ∨ (l∈K ∧ p=l) := by
    simp only [G,mem_union,mem_image]
    constructor
    · rintro (h|⟨i,hi,eq⟩)
      · exact Or.inl h
      · cases eq;exact Or.inr ⟨hi,rfl⟩
    · rintro (h|⟨hl,rfl⟩)
      · exact Or.inl h
      · exact Or.inr ⟨p,hl,rfl⟩
  have only (p l : Fin 4) (hw : l∈W) (h : (p,l)∈G) : (p,l)∈A :=
    ((edge p l).mp h).elim id (fun t => False.elim ((km l).mp t.1 hw))
  have twice (p q l : Fin 4) (ne : p≠q) (x : (p,l)∈G) (y : (q,l)∈G) : l∈W := by
    by_contra h
    have u := ((edge p l).mp x).resolve_left (fun e => h (used e))
    have v := ((edge q l).mp y).resolve_left (fun e => h (used e))
    exact ne (u.2.trans v.2.symm)
  have no4 : C4 G := by
    intro p q l s pq ls ⟨a,c,d,e⟩
    have wl := twice p q l pq a d
    have ws := twice p q s pq c e
    obtain ⟨j,_,rfl⟩ := mem_image.mp wl
    obtain ⟨t,_,rfl⟩ := mem_image.mp ws
    exact free p q j.val t.val pq (fun eq => ls (congrArg f (Subtype.ext eq)))
      ⟨(lookup p j).mp (only _ _ (wval j) a),(lookup p t).mp (only _ _ (wval t) c),
       (lookup q j).mp (only _ _ (wval j) d),(lookup q t).mp (only _ _ (wval t) e)⟩
  have dia (i : Fin 4) : (i,i)∈G := by
    by_cases hw : i∈W
    · obtain ⟨j,_,rfl⟩ := mem_image.mp hw
      exact (edge _ _).mpr (Or.inl ((lookup _ j).mpr (hit j)))
    · exact (edge _ _).mpr (Or.inr ⟨(km i).mpr hw,rfl⟩)
  have cA : A.card = E.card := by
    apply card_image_of_injOn
    intro e he d hd eq
    let u : J := ⟨e.2,active e he⟩
    let v : J := ⟨d.2,active d hd⟩
    have uv : u=v := inj ((bval u).symm.trans ((congrArg Prod.snd eq).trans (bval v)))
    exact Prod.ext (congrArg (fun x : Fin 4 × Fin 4 => x.1) eq) (congrArg Subtype.val uv)
  have cs : G.card=E.card+K.card := by
    apply Eq.trans (card_union_of_disjoint ?_) ?_
    · apply disjoint_left.mpr
      rintro ⟨p,l⟩ h1 h2
      obtain ⟨i,hi,h⟩ := mem_image.mp h2
      cases h
      exact (km _).mp hi (used h1)
    · rw [cA,card_image_of_injective _ (fun _ _ eq => congrArg Prod.fst eq)]
  have wsize : W.card=J.card := by simp [W,card_image_of_injective _ inj]
  have ksize : K.card + J.card = 4 := by
    simpa only [wsize,card_univ,Fintype.card_fin] using
      (card_sdiff_add_card_eq_card (Finset.subset_univ W))
  obtain ⟨j,hj⟩ := ne
  let w : J := ⟨j,hj⟩
  intro C ao spec
  let enc : Fin (4+m) → Fin 8 := Fin.addCases (m:=4) (n:=m) (motive:=fun _ => Fin 8)
    (Fin.castAdd 4) (fun l => Fin.natAdd 4 (b l))
  let star (i : Fin 4) : Fin 8 × List (Fin 8) := (Fin.castAdd 4 i,[Fin.natAdd 4 i])
  have valid := GridCircuit.output_valid C ⟨pair (f w) j,(spec _).trans (pair_yes _ _ _ (hit w))⟩
  obtain ⟨D,aoD,_,size,eval⟩ := GridCircuit.assemble C ao valid [enc] (by simp) (K.toList.map star)
    (by intro st h;obtain ⟨i,_,rfl⟩ := List.mem_map.mp h;simp [star])
  have pay : D.size≤C.size+K.card+K.card := by
    simpa [List.map_map,Function.comp_def,star,GridCircuit.sum_constant] using size
  have eqA (x : Fin 8 → Bool) : ef E (x∘enc)=true ↔ ef A x=true := by
    rw [ef,ef,on_iff,on_iff]
    constructor
    · rintro ⟨p,l,e,u,v⟩
      exact ⟨p,b l,mem_image_of_mem g e,by simpa [enc] using u,by simpa [enc] using v⟩
    · rintro ⟨p,l,h,u,v⟩
      obtain ⟨⟨q,t⟩,e,eq⟩ := mem_image.mp h
      change (q,b t)=(p,l) at eq
      cases eq
      exact ⟨p,t,e,by simpa [enc] using u,by simpa [enc] using v⟩
  have output (x : Fin 8 → Bool) : circuitFun 8 D x=ef G x := by
    apply Bool.eq_iff_iff.mpr
    rw [eval,ef,on_iff]
    simp only [List.mem_singleton,exists_eq_left,List.mem_map,Finset.mem_toList]
    constructor
    · rintro (hold|⟨st,⟨i,hi,rfl⟩,u,z,hz,v⟩)
      · obtain ⟨p,l,h,u,v⟩ := (on_iff _ _).mp ((eqA x).mp ((spec _).symm ▸ hold))
        exact ⟨p,l,(edge p l).mpr (Or.inl h),u,v⟩
      · obtain rfl : z=Fin.natAdd 4 i := List.mem_singleton.mp hz
        exact ⟨i,i,(edge i i).mpr (Or.inr ⟨hi,rfl⟩),u,v⟩
    · rintro ⟨p,l,h,u,v⟩
      rcases (edge p l).mp h with he|⟨hl,rfl⟩
      · left
        rw [spec]
        exact (eqA x).mpr ((on_iff _ _).mpr ⟨p,l,he,u,v⟩)
      · right
        exact ⟨star p,⟨p,hl,rfl⟩,u,Fin.natAdd 4 p,by simp [star],v⟩
  have index : LocalNormalize.indexed (fun p l => (p,l)∈G) = G := by
    ext e
    exact LocalNormalize.mem_indexed _ e.1 e.2
  have lb := known (fun p l => (p,l)∈G) no4 dia D aoD output
  rw [index,cs] at lb
  omega
end MonoGraph

namespace ForcedZero
open PEqualNP.MetaComplexity Pin PEqualNP.CircuitLowerBounds PEqualNP.TopForm
def initial {n : ℕ} (v : Fin n) : List Stat :=
  List.ofFn (fun i : Fin n => if i=v then .const false else .wire i)

theorem inv_initial {n : ℕ} (v : Fin n) (x : Fin n → Bool) :
    Inv n (List.ofFn x) (List.ofFn (Function.update x v false)) (initial v,[]) := by
  refine ⟨by simp [initial],?_⟩
  intro j
  by_cases hj : j<n
  · let i : Fin n := ⟨j,hj⟩
    by_cases eq : i=v
    · subst v
      simp [initial,hj,i,wiresFrom,Stat.val,Stat.Valid]
    · simp [initial,hj,i,show (⟨j,hj⟩ : Fin n)≠v from eq,Function.update_of_ne eq,Stat.val,Stat.Valid,wiresFrom]
  · simp [initial,List.getD_eq_default,show n≤j by omega,Stat.val,Stat.Valid,List.length_ofFn]

end ForcedZero

namespace MonoCut
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity Pin
open PEqualNP.TopForm PEqualNP.MetaComplexity.NestedCover
private def Legal (n : ℕ) (gs : List Gate) := IsAO2 n ⟨gs,0⟩

private theorem appendGate {n} {gs : List Gate} (old : Legal n gs) (g : Gate)
    (op : g.op=.and ∨ g.op=.or) (arity : g.inputs.length=2)
    (refs : ∀ i∈g.inputs, i<n+gs.length) : Legal n (gs++[g]) := by
  obtain ⟨ops,before,two⟩ := old
  refine ⟨?_,?_,?_⟩
  · intro h hh
    change h∈gs++[g] at hh
    rcases List.mem_append.mp hh with prev|last
    · exact ops h prev
    · simpa only [List.mem_singleton.mp last] using op
  · intro j hj i hi
    change j<(gs++[g]).length at hj
    change i∈((gs++[g]).getD j _).inputs at hi
    by_cases hj' : j<gs.length
    · rw [List.getD_append _ _ _ _ hj'] at hi
      exact before j hj' i hi
    · have eq : j=gs.length := by simp at hj;omega
      subst j
      rw [getD_snoc_eq] at hi
      exact refs i hi
  · intro h hh
    change h∈gs++[g] at hh
    rcases List.mem_append.mp hh with prev|last
    · exact two h prev
    · simpa only [List.mem_singleton.mp last] using arity

private theorem preserveStep (n : ℕ) (acc : List Stat × List Gate) (old : Legal n acc.2)
    (valid : ∀ i, (acc.1.getD i (Stat.const false)).Valid (n+acc.2.length))
    (g : Gate) (op : g.op=.and ∨ g.op=.or) (arity : g.inputs.length=2) :
    Legal n (elimStep n acc g).2 := by
  have hh : ∃ a b, g.inputs = [a,b] := by
    rcases ha : g.inputs with _|⟨a,_|⟨b,_|⟨c,cs⟩⟩⟩ <;> simp_all
  obtain ⟨a,b,ab⟩ := hh
  have va := valid a
  have vb := valid b
  rcases op with eq|eq <;>
    cases ea : acc.1.getD a (Stat.const false) <;> cases eb : acc.1.getD b (Stat.const false) <;>
    simp only [elimStep,ab,List.map_cons,List.map_nil,ea,eb,eq,simplify,simpAnd,simpOr,
      Option.toList_none,Option.toList_some,List.append_nil] <;> try exact old
  all_goals
    rw [ea] at va
    rw [eb] at vb
    refine appendGate old _ (by simp) rfl ?_
    simpa [Stat.Valid] using And.intro va vb

private theorem preserve (n : ℕ) (gs : List Gate)
    (good : ∀ g∈gs, (g.op=.and ∨ g.op=.or) ∧ g.inputs.length=2)
    (y w : List Bool) (len : y.length=n) (acc : List Stat × List Gate)
    (inv : Inv n y w acc) (old : Legal n acc.2) : Legal n (elim n gs acc).2 := by
  induction gs generalizing w acc with
  | nil => exact old
  | cons g gs ih =>
    rw [elim_cons]
    have h := good g List.mem_cons_self
    apply ih (fun q hq => good q (List.mem_cons_of_mem _ hq)) _ _
    · exact inv_elim n y len [g] w acc (by
        intro q mem
        obtain rfl := List.mem_singleton.mp mem
        exact ⟨by tauto,h.2.le⟩) inv
    · exact preserveStep n acc old (fun i => (inv.2 i).1) g h.1 h.2

private theorem noRead {k : ℕ} (gs : List Gate) (miss : ∀g∈gs, k∉g.inputs)
    (w u : List Bool) (len : w.length=u.length) (same : ∀ i≠k, w.getD i false=u.getD i false) :
    ∀ i≠k, (wiresFrom gs w).getD i false=(wiresFrom gs u).getD i false := by
  induction gs generalizing w u with
  | nil => exact same
  | cons g gs ih =>
    apply ih (fun q hq => miss q (by simp [hq])) (w++[_]) (u++[_]) (by simp [len])
    intro i hi
    by_cases eq : i=w.length
    · subst i
      rw [getD_snoc_eq,len,getD_snoc_eq]
      congr 1
      apply List.map_congr_left
      exact fun i hm => same i (fun eq => miss g (by simp) (eq ▸ hm))
    · rw [getD_snoc_ne _ _ _ _ eq,getD_snoc_ne _ _ _ _ (by omega)]
      exact same i hi

theorem restrict_zero {n : ℕ} (v : Fin n) (f : (Fin n → Bool) → Bool) (C : Circuit)
    (ao : IsAO2 n C) (spec : ∀ x, circuitFun n C x = f x)
    (dep : ∃ x, f (Function.update x v (!x v)) ≠ f x)
    (nc : ∃ x y, f (Function.update x v false) ≠ f (Function.update y v false)) :
    ∃ D : Circuit, IsAO2 n D ∧ D.size+1 ≤ C.size ∧
      ∀ x, circuitFun n D x=f (Function.update x v false) := by
  let A := elim n C.gates (ForcedZero.initial v,[])
  have good (g : Gate) (hg : g∈C.gates) := And.intro (ao.1 g hg) (ao.2.2 g hg)
  have ok (g : Gate) (hg : g∈C.gates) : NOk g := by
    obtain ⟨op,sz⟩ := good g hg
    exact ⟨⟨by tauto,sz.le⟩,by rintro h;rcases op with t|t <;> rw [t] at h <;> contradiction⟩
  have ev (x : Fin n → Bool) : (A.1.getD C.output (Stat.const false)).val
      (wiresFrom A.2 (List.ofFn x)) = f (Function.update x v false) := by
    have h := inv_elim n (List.ofFn x) (by simp) C.gates _ _ (fun g hg => (ok g hg).1) (ForcedZero.inv_initial v x)
    exact ((h.2 C.output).2).trans (spec _)
  cases hs : A.1.getD C.output (Stat.const false) with
  | const c =>
    obtain ⟨x,y,h⟩ := nc
    exact False.elim (h (by rw [←ev x,←ev y,hs];rfl))
  | wire j =>
    have iv : (ForcedZero.initial v).getD v.val (.const false) = .const false := by simp [ForcedZero.initial,v.isLt]
    have read : ∃g∈C.gates, v.val∈g.inputs := by
      by_contra! none
      have out : C.output≠v.val := by
        intro eq
        change (elim n C.gates (ForcedZero.initial v,[])).1.getD C.output _ = _ at hs
        rw [eq,elim_getD n v.val _ C.gates _ (by simp [ForcedZero.initial])] at hs
        change (ForcedZero.initial v).getD v.val _ = _ at hs
        rw [iv] at hs;contradiction
      obtain ⟨x,diff⟩ := dep
      apply diff
      rw [←spec _,←spec _]
      apply noRead C.gates none _ _ (by simp) _ C.output out
      intro i ne
      by_cases lt : i<n
      · have h : (⟨i,lt⟩ : Fin n)≠v := fun eq => ne (congrArg Fin.val eq)
        simp [lt,h]
      · simp [lt]
    have save := elim_len_lt n v.val C.gates (ForcedZero.initial v,[]) ok
      (by simp [ForcedZero.initial]) ⟨false,iv⟩ read
    refine ⟨⟨A.2,j⟩,?_,by change A.2.length + 1 ≤ C.gates.length;simpa only [List.length_nil,Nat.zero_add] using save,?_⟩
    · let x : Fin n → Bool := fun _ => false
      have h := preserve n C.gates good _ _ (by simp) _ (ForcedZero.inv_initial v x) (by
        refine ⟨by simp [PEqualNP.EdgeOwnership.AndOrOnly],?_,by simp⟩
        intro j hj
        exact False.elim (Nat.not_lt_zero _ hj))
      exact h
    · intro x
      change (wiresFrom A.2 (List.ofFn x)).getD j false=_
      simpa only [hs,Stat.val] using ev x

open ForcedZero
theorem restrict_two {n : ℕ} (v : Fin n) (f : (Fin n → Bool) → Bool) (C : Circuit)
    (ao : IsAO2 n C) (spec : ∀ x, circuitFun n C x=f x)
    (nonconst : ∃ x y, f (Function.update x v false) ≠ f (Function.update y v false))
    (pre post : List Gate) (g : Gate) (decomp : C.gates=pre++g::post) (hg : v.val∈g.inputs)
    (cause : (∃ h∈post, v.val∈h.inputs) ∨ ((g.op=.and ∨ g.inputs=[v.val,v.val]) ∧ ∃ h∈post, n+pre.length∈h.inputs)) :
    ∃ R : Circuit, IsAO2 n R ∧ R.size+2 ≤ C.size ∧ ∀ x, circuitFun n R x=f (Function.update x v false) := by
  let A := elim n pre (initial v,[])
  let B := elimStep n A g
  let D := elim n post B
  have eqD : D=elim n C.gates (initial v,[]) := by rw [decomp,elim_append,elim_cons]
  have ok (q : Gate) (hq : q∈C.gates) : NOk q := by
    have op := ao.1 q hq
    have sz := ao.2.2 q hq
    exact ⟨⟨by tauto,by omega⟩,by rintro h; rcases op with t|t <;> rw [t] at h <;> contradiction⟩
  have okG := ok g (by rw [decomp];simp)
  have okP (q) (hq : q∈post) := ok q (by rw [decomp];simp [hq])
  have Iv : (initial v).getD v.val (Stat.const false) = Stat.const false := by simp [initial,v.isLt]
  have Al : A.1.length=n+pre.length := by simp [A,elim_fst_len,initial]
  have Av : A.1.getD v.val (Stat.const false) = Stat.const false := by
    dsimp only [A]
    rw [elim_getD n v.val _ pre _ (by simp [initial])];exact Iv
  have Ac : A.2.length ≤ pre.length := by
    simpa only [List.length_nil, Nat.zero_add] using elim_len n pre (initial v,[])
  have Bc : B.2.length = A.2.length := elimStep_none n A g okG v.val hg false Av
  have Bl : B.1.length=n+pre.length+1 := by simp [B,elimStep,Al]
  have small : D.2.length+2 ≤ C.size := by
    have hsave : D.2.length+1 ≤ B.2.length+post.length := by
      rcases cause with later|⟨op,later⟩
      · have bv : B.1.getD v.val (Stat.const false)=Stat.const false := by
          change (A.1++[_]).getD _ _ = _
          rw [getD_snoc_ne _ _ _ _ (by rw [Al]; have := v.isLt;omega),Av]
        exact elim_len_lt n v.val post B okP (by rw [Bl];have := v.isLt;omega) ⟨false,bv⟩ later
      · have c : ∃ b, B.1.getD A.1.length (.const false) = Stat.const b := by
          rcases op with op|rep
          · exact elimStep_const n A g okG v.val hg (by simpa [fixBit,op] using Av)
          · dsimp only [B,elimStep]
            rw [getD_snoc_eq]
            rcases ao.1 g (by rw [decomp];simp) with hand|hor
            · exact ⟨false,by simp only [rep,List.map_cons,List.map_nil,Av,hand,simplify,simpAnd]; rfl⟩
            · exact ⟨false,by simp only [rep,List.map_cons,List.map_nil,Av,hor,simplify,simpOr]; rfl⟩
        rw [Al] at c
        exact elim_len_lt n (n+pre.length) post B okP (by rw [Bl];omega) c later
    change _ ≤ C.gates.length
    rw [decomp,List.length_append,List.length_cons]
    omega
  have ev (x : Fin n → Bool) : (D.1.getD C.output (Stat.const false)).val
      (wiresFrom D.2 (List.ofFn x)) = f (Function.update x v false) := by
    have inv := inv_elim n (List.ofFn x) (by simp) C.gates _ _
      (fun q hq => (ok q hq).1) (inv_initial v x)
    rw [←eqD] at inv
    exact ((inv.2 C.output).2).trans (spec _)
  cases hs : D.1.getD C.output (Stat.const false) with
  | const c =>
    obtain ⟨x,y,diff⟩ := nonconst
    exact False.elim (diff (by rw [←ev x,←ev y,hs];rfl))
  | wire j =>
    refine ⟨⟨D.2,j⟩,?_,small,?_⟩
    · change Legal n D.2
      rw [eqD]
      let x : Fin n → Bool := fun _ => false
      exact preserve n C.gates (fun q hq => ⟨ao.1 q hq,ao.2.2 q hq⟩) _ _ (by simp) _
        (inv_initial v x) (by
          refine ⟨by simp [PEqualNP.EdgeOwnership.AndOrOnly],?_,by simp⟩
          intro j hj
          exact False.elim (Nat.not_lt_zero _ hj))
    · intro x
      change (wiresFrom D.2 (List.ofFn x)).getD j false = f (Function.update x v false)
      simpa only [hs,Stat.val] using ev x

open ColumnPeel
variable {n m : ℕ}
def Lower {d : ℕ} (f : (Fin d → Bool) → Bool) (k : ℕ) := ∀ (C : Circuit), IsAO2 d C → (∀ x, circuitFun d C x=f x) → k≤C.size
theorem step_lower (I : Fin n → Fin m → Prop) [DecidableRel I] (S : Finset (Fin m)) (l : Fin m)
    (hl : l ∉ S) (ha : ∃ p, I p l) (hr : ∃ p q, strip I (insert l S) p q) {k : ℕ} (_hk : 0 < k)
    (bound : Lower (F (strip I (insert l S))) k) : Lower (F (strip I S)) (k+1) := by
  intro C ao spec
  obtain ⟨p,hp⟩ := ha
  obtain ⟨a,b,hab⟩ := hr
  obtain ⟨D,hD,sz,ev⟩ := restrict_zero (Fin.natAdd n l) _ C ao spec (by
    refine ⟨pt p,?_⟩
    rw [update_point,pt_no,pair_yes _ _ _ ⟨hp,hl⟩]
    decide) (by
    refine ⟨pair a b,pt a,?_⟩
    change (fun x => F _ (Function.update x _ false)) _ ≠ (fun x => F _ (Function.update x _ false)) _
    rw [off,pt_no,pair_yes _ _ _ hab]
    decide)
  have hb := bound D hD (fun x => (ev x).trans (congrFun (off I S l) x))
  omega

theorem delete_many (I : Fin n → Fin m → Prop) [DecidableRel I] (S T : Finset (Fin m))
    (disj : Disjoint S T) (ha : ∀ l ∈ T, ∃ p, I p l) (rem : ∃ p q, strip I (S ∪ T) p q)
    {k : ℕ} (_hk : 0 < k) (bound : Lower (F (strip I (S ∪ T))) k) :
    Lower (F (strip I S)) (k+T.card) := by
  induction T using Finset.induction_on generalizing S with
  | empty =>
    have eq : F (strip I (S ∪ ∅)) = F (strip I S) := by
      funext x
      apply Bool.eq_iff_iff.mpr
      rw [on_iff,on_iff]
      simp only [strip,Finset.union_empty]
    rw [eq] at bound
    simpa using bound
  | @insert l T hlt ih =>
    have eq : insert l S ∪ T = S ∪ insert l T := by ext q; simp
    have hls : l ∉ S := fun e => Finset.disjoint_left.mp disj e (Finset.mem_insert_self _ _)
    have dj : Disjoint (insert l S) T := by
      rw [Finset.disjoint_left]
      intro q hq hT
      rcases Finset.mem_insert.mp hq with rfl|hs
      · exact hlt hT
      · exact Finset.disjoint_left.mp disj hs (Finset.mem_insert_of_mem hT)
    have hrec := ih (insert l S) dj (fun q hq => ha q (Finset.mem_insert_of_mem hq)) (eq ▸ rem) (eq ▸ bound)
    obtain ⟨a,b,hab,hb⟩ := rem
    have hr : strip I (insert l S) a b := ⟨hab,fun h => hb (by
      rcases Finset.mem_insert.mp h with rfl|hs
      · exact Finset.mem_union_right _ (Finset.mem_insert_self _ _)
      · exact Finset.mem_union_left _ hs)⟩
    have next := step_lower I S l hls (ha _ (Finset.mem_insert_self _ _)) ⟨a,b,hr⟩ (by omega) hrec
    simpa [Finset.card_insert_of_notMem hlt,Nat.add_assoc] using next

end MonoCut

namespace MonoGraph
open Finset IncidenceFour SupportThree ColumnPeel
variable {m : ℕ}
theorem retained (known : Diagonal) (E : E4 m) (free : C4 E) (J : Finset (Fin m)) (ne : J.Nonempty)
    (keep : heavy E ⊆ J) (sat : Matchable (neighbors E) J) :
    LB (ef E) (E.card+J.card-1) := by
  classical
  obtain ⟨f,inj,adj⟩ := sat
  let B := E.filter fun e => e.2∈J
  let X := E.filter fun e => e.2∉J
  let T := X.image Prod.snd
  have bc4 : C4 B := fun p q l s hp hl ⟨a,b,c,d⟩ => free p q l s hp hl
    ⟨(mem_filter.mp a).1,(mem_filter.mp b).1,(mem_filter.mp c).1,(mem_filter.mp d).1⟩
  have base := padded known B bc4 J ne (fun _ h => (mem_filter.mp h).2) f inj
    (fun j => mem_filter.mpr ⟨(mem_filter.mp (adj j)).2,j.prop⟩)
  have em (p l) : (p,l)∈B ↔ (p,l)∈E ∧ l∉T := by
    constructor
    · intro h
      obtain ⟨a,b⟩ := mem_filter.mp h
      refine ⟨a,?_⟩
      intro ht
      obtain ⟨e,he,eq⟩ := mem_image.mp ht
      exact (mem_filter.mp he).2 (eq ▸ b)
    · rintro ⟨a,b⟩
      apply mem_filter.mpr;refine ⟨a,?_⟩
      by_contra h;exact b (mem_image.mpr ⟨(p,l),mem_filter.mpr ⟨a,h⟩,rfl⟩)
  let I := fun p l => (p,l)∈E
  have ebase : F (strip I (∅ ∪ T)) = ef B := Partial9840.feq _ _ (by intro p l;simp only [Finset.empty_union,strip,I];exact (em p l).symm)
  have eall : F (strip I ∅) = ef E := Partial9840.feq _ _ (by intro p l;simp [strip,I])
  obtain ⟨j,hj⟩ := ne
  let j' : J := ⟨j,hj⟩
  have memB : (f j',j)∈B := mem_filter.mpr ⟨(mem_filter.mp (adj j')).2,hj⟩
  have bpos := card_pos.mpr (show B.Nonempty from ⟨_,memB⟩)
  have jpos := card_pos.mpr (show J.Nonempty from ⟨j,hj⟩)
  have paid  := MonoCut.delete_many I ∅ T (by simp) (by
    intro l ht;obtain ⟨⟨p,k⟩,he,eq⟩ := mem_image.mp ht;exact ⟨p,eq ▸ (mem_filter.mp he).1⟩)
    (by refine ⟨f j',j,?_⟩; simpa only [Finset.empty_union,strip,I] using (em _ _).mp memB)
    (k:=B.card+J.card-1) (by omega) (ebase ▸ base)
  rw [eall] at paid
  have xc : T.card = X.card := by
    apply card_image_of_injOn
    rintro ⟨p,l⟩ h ⟨q,k⟩ h' eq
    change l=k at eq;subst k
    have small : (neighbors E l).card ≤ 1 := by
      by_contra! large
      exact (mem_filter.mp h).2 (keep (mem_filter.mpr ⟨mem_univ _,large⟩))
    have memP : p ∈ neighbors E l := mem_filter.mpr ⟨mem_univ _,(mem_filter.mp h).1⟩
    have memQ : q ∈ neighbors E l := mem_filter.mpr ⟨mem_univ _,(mem_filter.mp h').1⟩
    exact Prod.ext ((card_le_one.mp small) p memP q memQ) rfl
  have add := card_filter_add_card_filter_not (s:=E) (fun e => e.2∈J)
  change B.card+X.card=E.card at add
  intro C ao spec;have := paid C ao spec;omega

theorem light (known : Diagonal) (E : E4 m) (free : C4 E) (light : (heavy E).card ≤ 4) : Sharp E := by
  classical
  have hm := hall_four (neighbors E) (graph_linear E free) (heavy E) light (fun _ h => (mem_filter.mp h).2)
  have all (M : E4 m) (sub : M ⊆ E) (row : Rows M) (col : Cols M) (non : M.Nonempty) :
      LB (ef E) (E.card+M.card-1) := by
    obtain ⟨J,keep,card,matchJ⟩ := extend_matching (neighbors E) (heavy E) (M.image Prod.snd) hm (matchedColumns sub row)
    have same : (M.image Prod.snd).card=M.card := card_image_of_injOn col
    have pos := card_pos.mpr non
    have res  := retained known E free J (card_pos.mp (by omega)) keep matchJ
    intro C ao spec;have := res C ao spec;omega
  intro M sub row col
  by_cases non : M.Nonempty
  · exact all M sub row col non
  by_cases has : E.Nonempty
  · obtain ⟨e,he⟩ := has
    have bound := all {e} (singleton_subset_iff.mpr he) (by simp [Rows]) (by simp [Cols]) (singleton_nonempty _)
    have emp := Finset.not_nonempty_iff_eq_empty.mp non
    intro C ao spec;have := bound C ao spec;simp [emp] at *;omega
  · have emp := Finset.not_nonempty_iff_eq_empty.mp has
    have emp' := Finset.not_nonempty_iff_eq_empty.mp non
    simp [emp,emp',LB]

end MonoGraph

namespace IncidenceFour
open SupportThree
def pattern (m : ℕ) : Edges 4 m :=
  Finset.univ.filter fun e => (([3,5,6,9,10,12] : List ℕ).getD e.2.val 0).testBit e.1.val = true

end IncidenceFour

namespace IncidenceFour.First
open SupportThree PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity Pin PEqualNP.TopForm
open PEqualNP.MetaComplexity.NestedCover
abbrev f := ef (pattern 5)
abbrev v (p : Fin 5) := 4+p.val
def col (i : ℕ) := 4 ≤ i ∧ i<9
def value (g : Gate) (w : List Bool) := g.op.eval (g.inputs.map fun i => w.getD i false)
abbrev W (pre : List Gate) (x : Fin 9 → Bool) := wiresFrom pre (List.ofFn x)
def Aside (hide : Nat → Prop) (w u : List Bool) := ∀ i, ¬ hide i → w.getD i false = u.getD i false

theorem raw (gs : List Gate) (x : Fin 9 → Bool) (i : Fin 9) : (W gs x).getD i.val false=x i := by
  rw [getD_wiresFrom _ _ _ (by simpa using i.isLt)]
  fin_cases i <;> rfl

theorem snoc {hide : Nat → Prop} {w u : List Bool} {a b : Bool} (wl : w.length=u.length)
    (h : Aside hide w u) (e : ¬hide w.length → a=b) : Aside hide (w++[a]) (u++[b]) := by
  intro i hi
  by_cases eq : i=w.length
  · subst i; rw [getD_snoc_eq,wl,getD_snoc_eq]; exact e (wl ▸ hi)
  · rw [getD_snoc_ne _ _ _ _ eq,getD_snoc_ne _ _ _ _ (by omega)]
    exact h i hi

theorem propagate (gs : List Gate) {hide : Nat → Prop} (miss : ∀ g∈gs, ∀ i∈g.inputs, ¬hide i)
    (w u : List Bool) (wl : w.length=u.length) (h : Aside hide w u) :
    Aside hide (wiresFrom gs w) (wiresFrom gs u) := by
  induction gs generalizing w u with
  | nil => exact h
  | cons g gs ih =>
    apply ih (fun t ht => miss t (by simp [ht])) (w++[value g w]) (u++[value g u]) (by simp [wl])
    apply snoc wl h
    intro _
    unfold value
    congr 1
    apply List.map_congr_left
    exact fun i hi => h i (miss g (by simp) i hi)

def toggle (p : Fin 5) (base : Fin 9 → Bool) (b : Bool) (i : Fin 9) : Bool :=
  if i.val=v p then b else base i
theorem start (p : Fin 5) (base : Fin 9 → Bool) :
    Aside (·=v p) (List.ofFn (toggle p base false)) (List.ofFn (toggle p base true)) := by
  intro i hi
  by_cases lt : i<9
  · change (W [] _).getD i false = (W [] _).getD i false
    rw [raw [] _ ⟨i,lt⟩,raw [] _ ⟨i,lt⟩];simp [toggle,hi]
  · rw [List.getD_eq_default _ _ (by simp;omega), List.getD_eq_default _ _ (by simp;omega)]

def rows (i : Fin 9) := decide (i.val<4)
def pairSeed (r : Fin 4) (q : Fin 5) (i : Fin 9) := decide (i.val=r.val ∨ i.val=v q)
theorem switching : ∀ p : Fin 5, f (toggle p rows false) ≠ f (toggle p rows true) := by decide +kernel
theorem separated : ∀ p q : Fin 5, p≠q → ∃ r : Fin 4,
    f (toggle p (pairSeed r q) false) ≠ f (toggle p (pairSeed r q) true) := by decide +kernel
theorem offYes : ∀ p : Fin 5, f (toggle p (fun _ => true) false)=true := by decide +kernel
theorem offNo : ∀ p : Fin 5, f (toggle p (fun _ => false) true)=false := by decide +kernel

theorem notraw (C : Circuit) (spec : ∀ x, circuitFun 9 C x=f x) (p : Fin 5) : C.output ≠ v p := by
  intro e
  let x := toggle p (fun _ => false) true
  have t := spec x
  change (W C.gates x).getD C.output false=f x at t
  rw [e,raw _ _ (⟨v p,by have := p.isLt; dsimp [v]; omega⟩ : Fin 9),offNo] at t
  simp [x,toggle] at t

theorem split (L : List Gate) :
    (∀ g∈L, ∀ i∈g.inputs, ¬col i) ∨
    ∃ pre post g, L=pre++g::post ∧ (∀ h∈pre,∀ i∈h.inputs,¬col i) ∧ ∃ i∈g.inputs,col i := by
  classical
  induction L with
  | nil => left;simp
  | cons h L ih =>
    by_cases hit : ∃ i∈h.inputs,col i
    · exact Or.inr ⟨[],L,h,rfl,by simp,hit⟩
    have skip : ∀ i∈h.inputs, ¬col i := fun i hi hc => hit ⟨i,hi,hc⟩
    rcases ih with all|⟨pre,post,g,dec,none,some⟩
    · left; intro g hg;rcases List.mem_cons.mp hg with rfl|mem;exact skip;exact all g mem
    · refine Or.inr ⟨h::pre,post,g,by simp [dec],?_,some⟩
      intro t ht;rcases List.mem_cons.mp ht with rfl|mem;exact skip;exact none t mem

theorem bits (g : Gate) (w : List Bool) (op : g.op=.and ∨ g.op=.or)
    (two : g.inputs.length=2) (all : ∀ i∈g.inputs,w.getD i false=true) : value g w=true := by
  rcases op with a|o
  · rw [value,a,GateOp.eval]; apply List.all_eq_true.mpr
    rw [List.forall_mem_map]
    exact all
  · rw [value,o,GateOp.eval]; have ne : g.inputs ≠ [] := by intro e;simp [e] at two
    obtain ⟨i,hi⟩ := List.exists_mem_of_ne_nil _ ne
    exact List.any_eq_true.mpr ⟨true,List.mem_map.mpr ⟨i,hi,all i hi⟩,rfl⟩

def vn (p : Fin 5) : Fin 9 := ⟨v p,by have := p.isLt;dsimp [v];omega⟩
theorem vc (p : Fin 5) : col (v p) := by have := p.isLt; dsimp [v,col];omega

theorem read_bound (C : Circuit) (ao : IsAO2 9 C) (a : List Gate) (g : Gate) (b : List Gate)
    (eq : C.gates=a++g::b) (i : Nat) (hi : i∈g.inputs) : i<9+a.length := by
  have lt : a.length<C.gates.length := by simp [eq]
  have gt : gateAt C a.length = g := by simp [gateAt,eq,List.getD_eq_getElem?_getD]
  exact ao.2.1 a.length lt i (gt ▸ hi)

theorem prefixTrue (C : Circuit) (ao : IsAO2 9 C) (pre : List Gate) (x : Fin 9 → Bool)
    (on : ∀ i : Fin 9, i.val<4 → x i=true) (tail : List Gate) (eq : C.gates=pre++tail)
    (clear : ∀ g∈pre,∀ i∈g.inputs,¬col i) (i : ℕ) (lt : i<9+pre.length) (nc : ¬col i) :
    (W pre x).getD i false=true := by
  induction pre using List.reverseRecOn generalizing tail i with
  | nil =>
    have hi : i<9 := by simpa using lt
    exact (raw [] x ⟨i,hi⟩).trans (on ⟨i,hi⟩ (by change i<4;dsimp [col] at nc;omega))
  | append_singleton a g ih =>
    have ce : C.gates = a++g::tail := by simpa using eq
    have rest := ih (g::tail) ce (fun t ht => clear t (by simp [ht]))
    have ev : W (a++[g]) x = W a x ++ [value g (W a x)] := by rw [W,wiresFrom_append];rfl
    rw [ev]
    have ln : (W a x).length=9+a.length := by simp [W,length_wiresFrom]
    by_cases last : i=(W a x).length
    · rw [last,getD_snoc_eq]
      have mem : g∈C.gates := by simp [ce]
      apply bits g _ (ao.1 g mem) (ao.2.2 g mem)
      intro j hj
      exact rest j (read_bound C ao a g tail ce j hj) (clear g (by simp) j hj)
    · rw [getD_snoc_ne _ _ _ _ last]
      apply rest i _ nc
      simp at lt;omega

theorem useRaw (C : Circuit) (spec : ∀ x, circuitFun 9 C x=f x) (p : Fin 5) :
    ¬(∀ g∈C.gates,∀ i∈g.inputs,i≠v p) := by
  intro miss
  have H := propagate C.gates miss _ _ (by simp) (start p rows) C.output (notraw C spec p)
  exact switching p (by rw [←spec,←spec];exact H)

theorem gainWhen (C : Circuit) (spec : ∀ x, circuitFun 9 C x=f x) (p : Fin 5)
    (pre post : List Gate) (g : Gate) (eq : C.gates=pre++g::post)
    (clear : ∀ h∈pre,∀ i∈h.inputs,¬col i) (after : ∀ h∈post,v p ∉h.inputs)
    (base : Fin 9 → Bool) (different : f (toggle p base false) ≠ f (toggle p base true))
    (same : value g (W pre (toggle p base false)) = value g (W pre (toggle p base true))) : False := by
  let x := toggle p base false
  let y := toggle p base true
  have miss : ∀ h∈pre, ∀ i∈h.inputs, i≠v p := fun h hh i hi e => clear h hh i hi (e ▸ vc p)
  have before := propagate pre miss _ _ (by simp) (start p base)
  have ln : (W pre x).length=(W pre y).length := by simp [W,length_wiresFrom]
  have ready := snoc ln before (fun _ => same)
  have done := propagate post (hide := (·=v p)) (fun h hh i hi e => after h hh (e ▸ hi)) _ _ (by simp [ln]) ready C.output (notraw C spec p)
  apply different
  rw [←spec,←spec]
  change (W C.gates x).getD _ _ = (W C.gates y).getD _ _
  rw [eq,W,W,wiresFrom_append,wiresFrom_append]
  exact done

theorem orb (g : Gate) (op : g.op=.or) (w : List Bool) (u : ℕ) (hit : u∈g.inputs) (bit : w.getD u false=true) :
    value g w=true := by
  rw [value,op,GateOp.eval]
  exact List.any_eq_true.mpr ⟨true,List.mem_map.mpr ⟨u,hit,bit⟩,rfl⟩

theorem orb_bad (C : Circuit) (ao : IsAO2 9 C) (spec : ∀ x, circuitFun 9 C x=f x) (p : Fin 5)
    (pre post : List Gate) (g : Gate) (eq : C.gates=pre++g::post)
    (clear : ∀ h∈pre,∀ i∈h.inputs,¬col i) (after : ∀ h∈post,v p ∉h.inputs)
    (op : g.op=.or) (u : ℕ) (hu : u∈g.inputs) (ne : u≠v p) : False := by
  by_cases c : col u
  · let q : Fin 5 := ⟨u-4,by dsimp [col] at c;omega⟩
    have uq : v q=u := by change 4+(u-4)=u;exact Nat.add_sub_of_le c.1
    have pq : p≠q := by rintro rfl;exact ne uq.symm
    obtain ⟨r,hr⟩ := separated p q pq
    apply gainWhen C spec p pre post g eq clear after _ hr
    have B (b : Bool) : value g (W pre (toggle p (pairSeed r q) b))=true := by
      apply orb g op _ u hu
      rw [←uq]; exact (raw pre _ (vn q)).trans (by
        simp [vn,toggle,pairSeed,uq,ne])
    exact (B false).trans (B true).symm
  · apply gainWhen C spec p pre post g eq clear after rows (switching p)
    have B (b : Bool) : value g (W pre (toggle p rows b))=true := by
      apply orb g op _ u hu
      apply prefixTrue C ao pre _ _ (g::post) eq clear u (read_bound C ao pre g post eq u hu) c
      intro i ir
      have d : i.val≠v p := by dsimp [v];omega
      simp [toggle,rows,ir,d]
    exact (B false).trans (B true).symm

theorem dead_bad (C : Circuit) (ao : IsAO2 9 C) (spec : ∀ x, circuitFun 9 C x=f x) (p : Fin 5)
    (pre post : List Gate) (g : Gate) (eq : C.gates=pre++g::post)
    (clear : ∀ h∈pre,∀ i∈h.inputs,¬col i) (after : ∀ h∈post,v p ∉h.inputs)
    (hit : v p∈g.inputs) (op : g.op=.and ∨ g.inputs=[v p,v p])
    (dead : ∀ h∈post,9+pre.length∉h.inputs) : False := by
  let o := 9+pre.length
  have ln (x : Fin 9→Bool) : (W pre x).length=o := by simp [W,length_wiresFrom,o]
  have out : C.output ≠ o := by
    intro e
    let x := toggle p (fun _ => true) false
    have b : (W pre x).getD (v p) false=false := (raw pre x (vn p)).trans (by simp [vn,x,toggle])
    have van : value g (W pre x)=false := by
      have and_case (a : g.op=.and) : value g (W pre x)=false := by
        rw [value,a,GateOp.eval]
        exact List.all_eq_false.mpr ⟨false,List.mem_map.mpr ⟨_,hit,b⟩,by decide⟩
      rcases op with a|rep
      · exact and_case a
      · rcases ao.1 g (by simp [eq]) with a|r
        · exact and_case a
        · rw [value,r,rep]; change ((W pre x).getD (v p) false || ((W pre x).getD (v p) false || false))=false; rw [b]; rfl
    have ev := spec x
    change (W C.gates x).getD C.output false=f x at ev
    rw [eq,W,wiresFrom_append,e,offYes] at ev
    change (wiresFrom post (W pre x++[value g (W pre x)])).getD o false=true at ev
    rw [getD_wiresFrom _ _ _ (by simp [ln]), ←ln x,getD_snoc_eq,van] at ev
    cases ev
  let x := toggle p rows false
  let y := toggle p rows true
  have miss : ∀ h∈pre, ∀ i∈h.inputs, i≠v p := fun h hh i hi e => clear h hh i hi (e ▸ vc p)
  have before := propagate pre miss _ _ (by simp) (start p rows)
  let hide := fun i => i=v p ∨ i=o
  have a : Aside hide (W pre x) (W pre y) := fun i hi => before i (fun t => hi (Or.inl t))
  have ready : Aside hide (W pre x++[value g (W pre x)]) (W pre y++[value g (W pre y)]) :=
    snoc ((ln x).trans (ln y).symm) a (fun no => False.elim (no (Or.inr (ln x))))
  have noRead : ∀ h∈post,∀ i∈h.inputs,¬hide i := by
    intro h hh i hi bad
    rcases bad with e|e
    · exact after h hh (e ▸ hi)
    · exact dead h hh (show o∈h.inputs from e ▸ hi)
  have done := propagate post noRead _ _ (by simp [ln]) ready C.output
    (fun bad => bad.elim (notraw C spec p) out)
  apply switching p
  rw [←spec,←spec]
  change (W C.gates x).getD _ _ = (W C.gates y).getD _ _
  rw [eq,W,W,wiresFrom_append,wiresFrom_append];exact done

end IncidenceFour.First
namespace IncidenceFour
open SupportThree PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm First
theorem firstColumn (C : Circuit) (ao : IsAO2 9 C) (spec : ∀ x, circuitFun 9 C x=ef (pattern 5) x) :
    ∃ (p : Fin 5) (pre post : List Gate) (g : Gate), C.gates=pre++g::post ∧ 4+p.val∈g.inputs ∧
      ((∃ h∈post,4+p.val∈h.inputs) ∨ ((g.op=.and ∨ g.inputs=[4+p.val,4+p.val]) ∧
        ∃ h∈post,9+pre.length∈h.inputs)) := by
  classical
  rcases split C.gates with none|⟨pre,post,g,eq,clear,i,hit,lo,hi⟩
  · exact False.elim (useRaw C spec 0 (fun t ht j hj e => none t ht j hj (e ▸ vc 0)))
  let p : Fin 5 := ⟨i-4,by omega⟩
  have vi : v p=i := by change 4+(i-4)=i;exact Nat.add_sub_of_le lo
  have mem : v p∈g.inputs := vi ▸ hit
  refine ⟨p,pre,post,g,eq,mem,?_⟩
  by_cases later : ∃ h∈post,v p∈h.inputs
  · exact Or.inl later
  push Not at later
  right
  have op : g.op=.and ∨ g.inputs=[v p,v p] := by
    by_contra! bad
    have og := (ao.1 g (by simp [eq])).resolve_left bad.1
    have len := ao.2.2 g (by simp [eq])
    obtain ⟨a,b,ab⟩ : ∃ a b,g.inputs=[a,b] := List.length_eq_two.mp len
    have both := bad.2
    by_cases da : a=v p
    · have db : b≠v p := by rintro rfl;exact both (by simpa [da] using ab)
      exact orb_bad C ao spec p pre post g eq clear later og b (by simp [ab]) db
    · exact orb_bad C ao spec p pre post g eq clear later og a (by simp [ab]) da
  refine ⟨op,?_⟩
  by_contra! never
  exact dead_bad C ao spec p pre post g eq clear later mem op never

end IncidenceFour

namespace IncidenceFour
open ColumnPeel SupportThree PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm
def dropColumn (j : Fin 5) := (pattern 5).filter fun e => e.2≠j
def dropMatch (j : Fin 5) : Edges 4 5 :=
  match j with
  | 0 => ([(0,1),(1,4),(2,2),(3,3)] : List (Fin 4 × Fin 5)).toFinset
  | 1 => ([(0,0),(1,4),(2,2),(3,3)] : List (Fin 4 × Fin 5)).toFinset
  | 2 => ([(0,0),(1,4),(2,1),(3,3)] : List (Fin 4 × Fin 5)).toFinset
  | 3 => ([(0,0),(1,2),(2,1),(3,4)] : List (Fin 4 × Fin 5)).toFinset
  | 4 => ([(0,0),(1,2),(2,1),(3,3)] : List (Fin 4 × Fin 5)).toFinset
instance (E : Edges 4 5) : Decidable (C4 E) := by unfold C4;infer_instance
instance (E : Edges 4 5) : Decidable (Rows E) := by unfold Rows;infer_instance
instance (E : Edges 4 5) : Decidable (Cols E) := by unfold Cols;infer_instance
theorem dropEq (j : Fin 5) : (fun x => ef (pattern 5) (Function.update x (Fin.natAdd 4 j) false)) =
    ef (dropColumn j) := by
  funext x
  apply Bool.eq_iff_iff.mpr
  rw [ef,ef,on_iff,on_iff]
  simp only [dropColumn,Finset.mem_filter]
  constructor
  · rintro ⟨p,l,hi,xp,xl⟩
    have ne : l≠j := by rintro rfl; simp at xl
    exact ⟨p,l,⟨hi,ne⟩,by simpa only [Function.update_of_ne (sep p j)] using xp,
      by simpa only [Function.update_of_ne (fun h => ne ((injL l j).mp h))] using xl⟩
  · rintro ⟨p,l,⟨hi,ne⟩,xp,xl⟩
    exact ⟨p,l,hi,by simpa only [Function.update_of_ne (sep p j)] using xp,
      by simpa only [Function.update_of_ne (fun h => ne ((injL l j).mp h))] using xl⟩

end IncidenceFour

namespace MonoGraph
open IncidenceFour ColumnPeel SupportThree PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm
theorem dropLB (known : Diagonal) (j : Fin 5) : LB (ef (dropColumn j)) 11 := by
  have data : ∀ i : Fin 5, C4 (dropColumn i) ∧ (heavy (dropColumn i)).card≤4 ∧
      dropMatch i⊆dropColumn i ∧ Rows (dropMatch i) ∧ Cols (dropMatch i) ∧
      (dropColumn i).card+(dropMatch i).card-1=11 := by decide +kernel
  obtain ⟨free,few,incl,row,col,h⟩ := data j
  exact h ▸ light known _ free few _ incl row col

theorem five (known : Diagonal) : LB (ef (pattern 5)) 13 := by
  intro C ao spec
  obtain ⟨p,pre,post,g,eq,hit,cause⟩ := firstColumn C ao spec
  obtain ⟨D,aoD,saved,h⟩ := MonoCut.restrict_two (Fin.natAdd 4 p) _ C ao spec (by
    refine ⟨fun _ => false,fun _ => true,?_⟩
    have T : ∀ p : Fin 5, ef (pattern 5) (Function.update (fun _ => false) (Fin.natAdd 4 p) false) ≠
        ef (pattern 5) (Function.update (fun _ => true) (Fin.natAdd 4 p) false) := by decide +kernel
    exact T p) pre post g eq hit cause
  have hs (x) : circuitFun 9 D x = ef (dropColumn p) x := (h x).trans (congrFun (dropEq p) x)
  have b := dropLB known p D aoD hs
  omega

end MonoGraph

namespace IncidenceFour
open Finset
private def renumber : Fin 6 → Fin 4 → Fin 4 :=
  ![![2,3,0,1], ![2,0,3,1], ![2,0,1,3], ![0,2,3,1], ![0,2,1,3], ![0,1,2,3]]

private def symmCheck (k : ℕ) : Prop :=
  ∀ T ∈ ((univ : Finset (Fin 4)).powersetCard 2).powersetCard k,
    ∃ j : Fin 6, Function.Injective (renumber j) ∧
      T.image (fun s => s.image (renumber j)) = univ.image (neighbors (pattern k))

private instance (k : ℕ) : Decidable (symmCheck k) := Finset.decidableDforallFinset

set_option maxRecDepth 8192 in
set_option maxHeartbeats 600000 in
private theorem symmFive : symmCheck 5 := by decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 600000 in
private theorem symmSix : symmCheck 6 := by decide +kernel

set_option maxRecDepth 8192 in
theorem canonical_columns {k : ℕ} (hk : k = 5 ∨ k = 6)
    (T : Finset (Finset (Fin 4))) (card : T.card = k)
    (two : ∀ s ∈ T, s.card = 2) :
    ∃ a : Fin 4 → Fin 4, Function.Injective a ∧
      T.image (fun s => s.image a) = univ.image (neighbors (pattern k)) := by
  have sc : symmCheck k := hk.elim (fun h => h ▸ symmFive) (fun h => h ▸ symmSix)
  obtain ⟨j, inj, im⟩ := sc T (mem_powersetCard.mpr
    ⟨fun s hs => mem_powersetCard.mpr ⟨subset_univ _,two s hs⟩,card⟩)
  exact ⟨renumber j,inj,im⟩

set_option maxRecDepth 8192 in
theorem pattern_distinct {k} (hk : k = 5 ∨ k = 6) : Function.Injective (neighbors (pattern k)) := by
  rcases hk with rfl | rfl <;> decide +kernel

set_option maxRecDepth 8192 in
theorem pattern_card {k} (hk : k = 5 ∨ k = 6) : (pattern k).card = 2*k := by
  rcases hk with rfl | rfl <;> decide +kernel

end IncidenceFour

namespace IncidenceFour
open Finset SupportThree ColumnPeel
variable {n m : ℕ}
def retainedEdges (E : Edges n m) (J : Finset (Fin m)) := E.filter fun e => e.2 ∈ J

end IncidenceFour

namespace Cover
theorem side {α β : Type} [DecidableEq α] [DecidableEq β] (E : Finset (α × β))
    (P : Finset α) (Q : Finset β)
    (hmin : ∀ (P' : Finset α) (Q' : Finset β), (∀ e ∈ E, e.1 ∈ P' ∨ e.2 ∈ Q') →
      P.card + Q.card ≤ P'.card + Q'.card)
    (hcov : ∀ e ∈ E, e.1 ∈ P ∨ e.2 ∈ Q) :
    ∃ f : {p // p ∈ P} → β, Function.Injective f ∧ ∀ p, (p.val, f p) ∈ E ∧ f p ∉ Q := by
  let t : {p // p ∈ P} → Finset β :=
    fun p => ((E.filter (fun e => e.1 = p.val)).image Prod.snd) \ Q
  have hall : ∀ S : Finset {p // p ∈ P}, S.card ≤ (S.biUnion t).card := by
    intro S
    have hsub : S.image Subtype.val ⊆ P := by
      intro x hx
      obtain ⟨p, _, rfl⟩ := Finset.mem_image.mp hx
      exact p.property
    have hc := hmin (P \ S.image Subtype.val) (Q ∪ S.biUnion t) (by
      intro e he
      rcases hcov e he with h | h
      · by_cases hS : e.1 ∈ S.image Subtype.val
        · right
          by_cases hq : e.2 ∈ Q
          · exact Finset.mem_union_left _ hq
          · apply Finset.mem_union_right
            obtain ⟨p, hp, hpe⟩ := Finset.mem_image.mp hS
            rw [Finset.mem_biUnion]
            refine ⟨p, hp, ?_⟩
            show e.2 ∈ ((E.filter (fun e => e.1 = p.val)).image Prod.snd) \ Q
            rw [Finset.mem_sdiff]
            exact ⟨Finset.mem_image.mpr ⟨e, Finset.mem_filter.mpr ⟨he, hpe.symm⟩, rfl⟩, hq⟩
        · left
          exact Finset.mem_sdiff.mpr ⟨h, hS⟩
      · right
        exact Finset.mem_union_left _ h)
    have h1 : (P \ S.image Subtype.val).card + (S.image Subtype.val).card = P.card :=
      Finset.card_sdiff_add_card_eq_card hsub
    have h2 : (S.image Subtype.val).card = S.card :=
      Finset.card_image_of_injective S Subtype.val_injective
    have h3 := Finset.card_union_le Q (S.biUnion t)
    omega
  obtain ⟨f, hinj, hf⟩ := (Finset.all_card_le_biUnion_card_iff_exists_injective t).mp hall
  refine ⟨f, hinj, fun p => ?_⟩
  have := hf p
  have h' : f p ∈ ((E.filter (fun e => e.1 = p.val)).image Prod.snd) \ Q := this
  rw [Finset.mem_sdiff] at h'
  obtain ⟨e, he, hef⟩ := Finset.mem_image.mp h'.1
  obtain ⟨heE, hep⟩ := Finset.mem_filter.mp he
  refine ⟨?_, h'.2⟩
  have : e = (p.val, f p) := Prod.ext hep hef
  rw [← this]
  exact heE

theorem konig {α β : Type} [DecidableEq α] [DecidableEq β] (E : Finset (α × β)) :
    ∃ (M : Finset (α × β)) (P : Finset α) (Q : Finset β), M ⊆ E ∧
      (∀ e ∈ M, ∀ e' ∈ M, e.1 = e'.1 → e = e') ∧ (∀ e ∈ M, ∀ e' ∈ M, e.2 = e'.2 → e = e') ∧
      (∀ e ∈ E, e.1 ∈ P ∨ e.2 ∈ Q) ∧ P.card + Q.card ≤ M.card := by
  classical
  have hex : ∃ k : ℕ, ∃ (P : Finset α) (Q : Finset β),
      (∀ e ∈ E, e.1 ∈ P ∨ e.2 ∈ Q) ∧ P.card + Q.card = k :=
    ⟨_, E.image Prod.fst, ∅, fun e he => Or.inl (Finset.mem_image_of_mem _ he), rfl⟩
  obtain ⟨P, Q, hcov, hk⟩ := Nat.find_spec hex
  have hmin : ∀ (P' : Finset α) (Q' : Finset β), (∀ e ∈ E, e.1 ∈ P' ∨ e.2 ∈ Q') →
      P.card + Q.card ≤ P'.card + Q'.card := by
    intro P' Q' h
    rw [hk]
    exact Nat.find_min' hex ⟨P', Q', h, rfl⟩
  obtain ⟨f, hfi, hf⟩ := side E P Q hmin hcov
  have hswap : ∀ (a : α) (b : β), (b, a) ∈ E.image Prod.swap ↔ (a, b) ∈ E := by
    intro a b
    constructor
    · intro h
      obtain ⟨e, he, hab⟩ := Finset.mem_image.mp h
      have : e = (a, b) := by
        rw [← Prod.swap_swap e, hab]; rfl
      rw [← this]; exact he
    · intro h
      exact Finset.mem_image.mpr ⟨(a, b), h, rfl⟩
  obtain ⟨g, hgi, hg⟩ := side (E.image Prod.swap) Q P (by
      intro Q' P' h
      have := hmin P' Q' (fun e he => by
        have := h (e.2, e.1) ((hswap e.1 e.2).mpr he)
        exact this.symm)
      omega) (by
      intro e he
      have h1 : (e.2, e.1) ∈ E := (hswap e.2 e.1).mp he
      exact (hcov _ h1).symm)
  have hg' : ∀ q : {q // q ∈ Q}, (g q, q.val) ∈ E ∧ g q ∉ P :=
    fun q => ⟨(hswap _ _).mp (hg q).1, (hg q).2⟩
  let M1 : Finset (α × β) := P.attach.image (fun p => (p.val, f p))
  let M2 : Finset (α × β) := Q.attach.image (fun q => (g q, q.val))
  have m1 : ∀ e ∈ M1, ∃ p : {p // p ∈ P}, e = (p.val, f p) := by
    intro e he
    obtain ⟨p, _, hp⟩ := Finset.mem_image.mp he
    exact ⟨p, hp.symm⟩
  have m2 : ∀ e ∈ M2, ∃ q : {q // q ∈ Q}, e = (g q, q.val) := by
    intro e he
    obtain ⟨q, _, hq⟩ := Finset.mem_image.mp he
    exact ⟨q, hq.symm⟩
  refine ⟨M1 ∪ M2, P, Q, ?_, ?_, ?_, hcov, ?_⟩
  · intro e he
    rcases Finset.mem_union.mp he with h | h
    · obtain ⟨p, rfl⟩ := m1 e h
      exact (hf p).1
    · obtain ⟨q, rfl⟩ := m2 e h
      exact (hg' q).1
  · intro e he e' he' h
    rcases Finset.mem_union.mp he with h1 | h1 <;> rcases Finset.mem_union.mp he' with h2 | h2
    · obtain ⟨p, rfl⟩ := m1 e h1
      obtain ⟨p', rfl⟩ := m1 e' h2
      have : p = p' := Subtype.ext h
      rw [this]
    · obtain ⟨p, rfl⟩ := m1 e h1
      obtain ⟨q, rfl⟩ := m2 e' h2
      exfalso
      apply (hg' q).2
      have h' : p.val = g q := h
      rw [← h']
      exact p.property
    · obtain ⟨q, rfl⟩ := m2 e h1
      obtain ⟨p, rfl⟩ := m1 e' h2
      exfalso
      apply (hg' q).2
      have h' : g q = p.val := h
      rw [h']
      exact p.property
    · obtain ⟨q, rfl⟩ := m2 e h1
      obtain ⟨q', rfl⟩ := m2 e' h2
      have : q = q' := hgi h
      rw [this]
  · intro e he e' he' h
    rcases Finset.mem_union.mp he with h1 | h1 <;> rcases Finset.mem_union.mp he' with h2 | h2
    · obtain ⟨p, rfl⟩ := m1 e h1
      obtain ⟨p', rfl⟩ := m1 e' h2
      have : p = p' := hfi h
      rw [this]
    · obtain ⟨p, rfl⟩ := m1 e h1
      obtain ⟨q, rfl⟩ := m2 e' h2
      exfalso
      apply (hf p).2
      have h' : f p = q.val := h
      rw [h']
      exact q.property
    · obtain ⟨q, rfl⟩ := m2 e h1
      obtain ⟨p, rfl⟩ := m1 e' h2
      exfalso
      apply (hf p).2
      have h' : q.val = f p := h
      rw [← h']
      exact q.property
    · obtain ⟨q, rfl⟩ := m2 e h1
      obtain ⟨q', rfl⟩ := m2 e' h2
      have : q = q' := Subtype.ext h
      rw [this]
  · have hd : Disjoint M1 M2 := by
      rw [Finset.disjoint_left]
      intro e h1 h2
      obtain ⟨p, rfl⟩ := m1 e h1
      obtain ⟨q, hq⟩ := m2 _ h2
      apply (hg' q).2
      have h' : p.val = g q := congrArg Prod.fst hq
      rw [← h']
      exact p.property
    have c1 : M1.card = P.card := by
      rw [Finset.card_image_of_injective _ (fun p p' h => Subtype.ext (congrArg Prod.fst h)),
        Finset.card_attach]
    have c2 : M2.card = Q.card := by
      rw [Finset.card_image_of_injective _ (fun q q' h => Subtype.ext (congrArg Prod.snd h)),
        Finset.card_attach]
    rw [Finset.card_union_of_disjoint hd, c1, c2]

end Cover

namespace IncidenceFour
open Finset SupportThree ColumnPeel
open Pin.PermInputs
variable {n m : ℕ}
theorem heavy_budget (E : Edges n m) : (heavy E).card * 2 ≤ E.card := by
  classical
  let A := (heavy E).sigma (fun l => neighbors E l)
  have inj : (↑A : Set (Σ _ : Fin m, Fin n)).InjOn (fun x => (x.2,x.1)) := by
    rintro ⟨l,p⟩ _ ⟨j,q⟩ _ e
    obtain rfl : p=q := congrArg Prod.fst e
    obtain rfl : l=j := congrArg Prod.snd e
    rfl
  have le := card_le_card_of_injOn (s:=A) (t:=E) (fun x => (x.2,x.1)) (by
    rintro ⟨l,p⟩ hp
    exact (mem_filter.mp (mem_sigma.mp hp).2).2) inj
  change ((heavy E).sigma (fun l => neighbors E l)).card ≤ E.card at le
  rw [card_sigma] at le
  calc (heavy E).card * 2 = ∑ _l ∈ heavy E, 2 := by simp
       _ ≤ ∑ l ∈ heavy E, (neighbors E l).card := sum_le_sum (fun l h => (mem_filter.mp h).2)
       _ ≤ _ := le

end IncidenceFour

namespace MonoGraph
open Finset IncidenceFour ColumnPeel SupportThree
private theorem pull_image {n m h k} (E : Edges n m) (a : Fin n → Fin h) (b : Fin m → Fin k)
    (z : ℕ) (hL : LB (ef (E.image (fun e => (a e.1,b e.2)))) z) : LB (ef E) z := by
  let σ : Fin (n+m) → Fin (h+k) := Fin.addCases (fun p => Fin.castAdd k (a p)) (fun l => Fin.natAdd h (b l))
  have eq (x : Fin (h+k) → Bool) : ef E (x ∘ σ) = ef (E.image (fun e => (a e.1,b e.2))) x := by
    apply Bool.eq_iff_iff.mpr
    simp only [ef, F, decide_eq_true_iff, Function.comp_apply, σ, Fin.addCases_left, Fin.addCases_right]
    constructor
    · rintro ⟨p,l,hp,xx,yy⟩
      exact ⟨a p,b l,Finset.mem_image_of_mem _ hp,xx,yy⟩
    · rintro ⟨i,j,hij,xx,yy⟩
      obtain ⟨⟨p,l⟩,hp,mapped⟩ := mem_image.mp hij
      cases mapped
      exact ⟨p,l,hp,xx,yy⟩
  apply pull σ (ef E)
  simpa only [eq] using hL

private theorem pull_pattern {m k} (E : E4 m) (H : Finset (Fin m))
    (hk : k = 5 ∨ k = 6) (size : H.card = k)
    (two : ∀ l ∈ H, (neighbors E l).card = 2)
    (uniq : Set.InjOn (neighbors E) (↑H : Set (Fin m)))
    (hL : LB (ef (pattern k)) (2*k+3)) :
    LB (ef (retainedEdges E H)) ((retainedEdges E H).card+3) ∧ (retainedEdges E H).card=2*k := by
  classical
  let T := H.image (neighbors E)
  have tcard : T.card = k := (card_image_of_injOn uniq).trans size
  obtain ⟨a,ainj,columns⟩ := canonical_columns hk T tcard (by
    intro s hs
    obtain ⟨l,hl,rfl⟩ := mem_image.mp hs
    exact two l hl)
  have choiceCol (l : Fin m) (hl : l∈H) :
      ∃ j, neighbors (pattern k) j = (neighbors E l).image a := by
    have hn := Finset.mem_image_of_mem (fun s : Finset (Fin 4) => s.image a)
      (show neighbors E l ∈ T from mem_image_of_mem _ hl)
    rw [columns] at hn
    obtain ⟨j,_,hj⟩ := mem_image.mp hn
    exact ⟨j,hj⟩
  let b : Fin m → Fin k := fun l => if hl : l ∈ H then (choiceCol l hl).choose else ⟨0,by omega⟩
  have bs (l) (hl : l ∈ H) : neighbors (pattern k) (b l) = (neighbors E l).image a := by
    simpa [b,hl] using (choiceCol l hl).choose_spec
  have bi : Set.InjOn b (↑H : Set (Fin m)) := by
    intro l hl j hj h
    exact uniq hl hj (Finset.image_injective ainj
      ((bs l hl).symm.trans ((congrArg (neighbors (pattern k)) h).trans (bs j hj))))
  have onto (j : Fin k) : ∃ l ∈ H, b l = j := by
    have hn := mem_image_of_mem (neighbors (pattern k)) (mem_univ j)
    rw [← columns] at hn
    obtain ⟨s,hs,he⟩ := mem_image.mp hn
    obtain ⟨l,hl,rfl⟩ := mem_image.mp hs
    exact ⟨l,hl,pattern_distinct hk ((bs l hl).trans he)⟩
  let B := retainedEdges E H
  let emb := fun e : Fin 4 × Fin m => (a e.1,b e.2)
  have im : B.image emb = pattern k := by
    ext ⟨i,j⟩
    constructor
    · intro h
      obtain ⟨⟨p,l⟩,he,hpair⟩ := mem_image.mp h
      change (a p,b l) = (i,j) at hpair
      cases hpair
      obtain ⟨edge,hl⟩ := mem_filter.mp he
      have hp : p ∈ neighbors E l := mem_filter.mpr ⟨mem_univ _,edge⟩
      have incl := mem_image_of_mem a hp
      rw [← bs l hl] at incl
      exact (mem_filter.mp incl).2
    · intro h
      obtain ⟨l,hl,rfl⟩ := onto j
      have hi : i ∈ neighbors (pattern k) (b l) := mem_filter.mpr ⟨mem_univ _,h⟩
      rw [bs l hl] at hi
      obtain ⟨p,hp,rfl⟩ := mem_image.mp hi
      exact mem_image.mpr ⟨(p,l),mem_filter.mpr ⟨(mem_filter.mp hp).2,hl⟩,rfl⟩
  have inj : Set.InjOn emb (↑B : Set (Fin 4 × Fin m)) := by
    intro e he z hz hz'
    apply Prod.ext (ainj (congrArg Prod.fst hz'))
    exact bi (mem_filter.mp he).2 (mem_filter.mp hz).2 (congrArg Prod.snd hz')
  have c : B.card = 2*k := (card_image_of_injOn inj).symm.trans
    ((congrArg Finset.card im).trans (pattern_card hk))
  refine ⟨?_,c⟩
  change LB (ef B) (B.card+3)
  rw [c]
  exact pull_image B a b _ (by change LB (ef (B.image emb)) _; rw [im]; exact hL)

variable {n m : ℕ}
private theorem smallCode (E : Edges n m) (size : (E.image Prod.fst).card≤4) :
    ∃ a : Fin n → Fin 4, Set.InjOn a (↑(E.image Prod.fst) : Set (Fin n)) := by
  classical
  let S := E.image Prod.fst
  have hh : Fintype.card (↑S : Type) ≤ 4 := by rw [Fintype.card_coe];exact size
  let b : (↑S : Type) → Fin 4 := fun p => Fin.castLE hh (Fintype.equivFin (↑S : Type) p)
  let a : Fin n → Fin 4 := fun p => if hp : p ∈ S then b ⟨p,hp⟩ else 0
  refine ⟨a,?_⟩
  intro p hp q hq eq
  have ep : p∈S := hp
  have eq' : q∈S := hq
  have ee : b ⟨p,ep⟩ = b ⟨q,eq'⟩ := by simpa [a,ep,eq'] using eq
  exact congrArg Subtype.val ((Fintype.equivFin (↑S : Type)).injective (Fin.ext (congrArg (fun z : Fin 4 => z.val) ee)))

theorem four_ten (known : Diagonal) (E : E4 m) (free : C4 E) (small : E.card≤10) : Sharp E := by
  have h := heavy_budget E
  by_cases few : (heavy E).card≤4
  · exact light known E free few
  have eq : (heavy E).card=5 := by omega
  have deg (l) (hl : l∈heavy E) : 2≤(neighbors E l).card := (mem_filter.mp hl).2
  obtain ⟨_,all,uniq⟩ := classify_four (neighbors E) (graph_linear E free) (heavy E) deg (by omega)
  obtain ⟨lb,card⟩ := pull_pattern E (heavy E) (Or.inl rfl) eq all uniq (five known)
  have same : retainedEdges E (heavy E)=E := Finset.eq_of_subset_of_card_le
    (Finset.filter_subset _ _) (by omega)
  rw [same] at lb
  intro M _ row _ C ao spec
  have size := card_le_card_of_injOn Prod.fst (t:=univ) (fun _ _ => mem_univ _) row
  change M.card≤Fintype.card (Fin 4) at size
  change M.card≤4 at size
  have := lb C ao spec
  omega

theorem pull_sharp {n m h} (a : Fin n → Fin h) (E : Edges n m) (inj : Set.InjOn a (↑(E.image Prod.fst) : Set (Fin n)))
    (known : Sharp (ren a E)) : Sharp E := by
  intro M sub row col
  have hc := known (ren a M) (Finset.image_subset_image sub) (rrows row sub inj) (rcols col)
  have e1 : (ren a E).card = E.card := Finset.card_image_of_injOn (ren_inj (fun _ v => v) inj)
  have e2 : (ren a M).card = M.card := Finset.card_image_of_injOn (ren_inj sub inj)
  rw [e1,e2] at hc
  apply pull (sigma a) (ef E)
  simpa only [efa] using hc

theorem transpose {n m} {E : Edges n m} (h : Sharp E) : Sharp (sw E) := by
  intro M sub row col
  have eq : sw (sw E) = E := by ext ⟨i,j⟩;simp only [smem]
  have sub' : sw M ⊆ E := eq ▸ Finset.image_subset_image sub
  have base := h (sw M) sub' (srow col) (scol row)
  apply pull tau (ef (sw E))
  simpa only [efsw,eq,scard] using base
theorem active_rows_ten (known : Diagonal) (E : Edges n m)
    (free : C4 E) (size : (E.image Prod.fst).card ≤ 4) (ten : E.card≤10) : Sharp E := by
  obtain ⟨a,inj⟩ := smallCode E size
  apply pull_sharp a E inj (four_ten known _ (rfree free inj) _)
  exact (Finset.card_image_le).trans ten

theorem active_four_ten (known : Diagonal) (E : Edges n m)
    (free : C4 E) (size : (E.image Prod.fst).card ≤ 4 ∨ (E.image Prod.snd).card ≤ 4)
    (ten : E.card≤10) : Sharp E := by
  rcases size with h|h
  · exact active_rows_ten known E free h ten
  · have sm : ((sw E).image Prod.fst).card ≤ 4 := by
      simpa only [sw,Finset.image_image,Function.comp_def,Prod.fst_swap] using h
    have res := transpose (active_rows_ten known (sw E) (sfree free) sm (Finset.card_image_le.trans ten))
    have eq : sw (sw E) = E := by ext ⟨i,j⟩;simp only [smem]
    exact eq ▸ res
end MonoGraph

namespace MonoGraph
theorem posted (known : Diagonal) : ∀ (x1 x2 : ℕ) (x3 : Finset (Fin x1 × Fin x2)) (x4 : PEqualNP.CircuitLowerBounds.Circuit), x3.card ≤ (10 : ℕ) → (Finset.image Prod.fst x3).card ≤ (4 : ℕ) ∨ (Finset.image Prod.snd x3).card ≤ (4 : ℕ) → ¬(SimpleGraph.fromRel fun (x7 x8 : Fin (x1 + x2)) => ∃ x9 ∈ x3, x7 = Fin.castAdd x2 x9.1 ∧ x8 = Fin.natAdd x1 x9.2).IsAcyclic → (∀ (x8 x9 : Fin x1) (x10 x11 : Fin x2), x8 ≠ x9 → x10 ≠ x11 → ¬((x8, x10) ∈ x3 ∧ (x8, x11) ∈ x3 ∧ (x9, x10) ∈ x3 ∧ (x9, x11) ∈ x3)) → PEqualNP.TopForm.IsAO2 (x1 + x2) x4 → (∀ (x10 : Fin (x1 + x2) → Bool), PEqualNP.MetaComplexity.circuitFun (x1 + x2) x4 x10 = Decidable.decide (∃ x11 ∈ x3, x10 (Fin.castAdd x2 x11.1) = Bool.true ∧ x10 (Fin.natAdd x1 x11.2) = Bool.true)) → ∃ (x11 : Finset (Fin x1)) (x12 : Finset (Fin x2)), (∀ x13 ∈ x3, x13.1 ∈ x11 ∨ x13.2 ∈ x12) ∧ x3.card + x11.card + x12.card ≤ x4.size + (1 : ℕ) := by
  intro n m E C ten small _ free ao spec
  obtain ⟨M,P,Q,sub,row,col,cover,budget⟩ := Cover.konig E
  have bound := active_four_ten known E free small ten M sub row col C ao (fun x => by
    rw [spec x]
    apply Bool.eq_iff_iff.mpr
    change (decide _ = true) ↔ (decide _ = true)
    simp only [decide_eq_true_eq]
    constructor
    · rintro ⟨⟨p,l⟩,e,u,v⟩
      exact ⟨p,l,e,u,v⟩
    · rintro ⟨p,l,e,u,v⟩
      exact ⟨(p,l),e,u,v⟩)
  exact ⟨P,Q,cover,by omega⟩
end MonoGraph

namespace MonoRun
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm

abbrev BFn (n : ℕ) := (Fin n → Bool) → Bool

def wiresFrom (gs : List Gate) (w : List Bool) : List Bool :=
  gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) w

theorem wiresFrom_append (gs gs' : List Gate) (w : List Bool) :
    wiresFrom (gs ++ gs') w = wiresFrom gs' (wiresFrom gs w) := by
  simp [wiresFrom, List.foldl_append]

theorem wiresFrom_prefix (gs : List Gate) : ∀ w : List Bool,
    ∃ t : List Bool, wiresFrom gs w = w ++ t ∧ t.length = gs.length := by
  induction gs with
  | nil => intro w; exact ⟨[], by simp [wiresFrom], rfl⟩
  | cons g gs ih =>
    intro w
    obtain ⟨t, ht, hl⟩ := ih (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
    refine ⟨g.op.eval (g.inputs.map fun i => w.getD i false) :: t, ?_, by simp [hl]⟩
    have : wiresFrom (g :: gs) w
        = wiresFrom gs (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) := rfl
    rw [this, ht]; simp

theorem length_wiresFrom (gs : List Gate) (w : List Bool) :
    (wiresFrom gs w).length = w.length + gs.length := by
  obtain ⟨t, ht, hl⟩ := wiresFrom_prefix gs w
  rw [ht]; simp [hl]

theorem getD_wiresFrom (gs : List Gate) (w : List Bool) (i : ℕ) (h : i < w.length) :
    (wiresFrom gs w).getD i false = w.getD i false := by
  obtain ⟨t, ht, _⟩ := wiresFrom_prefix gs w
  rw [ht, List.getD_append _ _ _ _ h]

theorem getD_snoc_eq {α : Type} (L : List α) (S d : α) : (L ++ [S]).getD L.length d = S := by
  simp

theorem getD_snoc_len {α : Type} (L : List α) (S d : α) (k : ℕ) (h : L.length = k) :
    (L ++ [S]).getD k d = S := by
  subst h; simp

def val (gs : List Gate) (n : ℕ) (a : ℕ) : BFn n :=
  fun x => (wiresFrom gs (List.ofFn x)).getD a false

theorem val_input (gs : List Gate) (n : ℕ) (i : Fin n) : val gs n i = fun x => x i := by
  funext x
  unfold val
  rw [getD_wiresFrom _ _ _ (by simp)]
  simp

theorem split_at {α : Type} (gs : List α) (p : ℕ) (g : α) (hp : gs[p]? = some g) :
    ∃ pre post, gs = pre ++ g :: post ∧ pre.length = p := by
  have hlt : p < gs.length := (List.getElem?_eq_some_iff.1 hp).1
  have hget : gs[p] = g := (List.getElem?_eq_some_iff.1 hp).2
  refine ⟨gs.take p, gs.drop (p + 1), ?_, by simp; omega⟩
  have h1 : gs = gs.take p ++ gs.drop p := (List.take_append_drop p gs).symm
  have h2 : gs.drop p = gs[p] :: gs.drop (p + 1) := List.drop_eq_getElem_cons hlt
  exact h1.trans (by rw [h2, hget])

theorem val_gate (n : ℕ) (gs : List Gate) (p : ℕ) (g : Gate) (hp : gs[p]? = some g)
    (hlt : ∀ a ∈ g.inputs, a < n + p) (x : Fin n → Bool) :
    val gs n (n + p) x = g.op.eval (g.inputs.map fun a => val gs n a x) := by
  obtain ⟨pre, post, rfl, hlen⟩ := split_at gs p g hp
  unfold val
  have h1 : wiresFrom (pre ++ g :: post) (List.ofFn x) = wiresFrom post
      (wiresFrom pre (List.ofFn x) ++
        [g.op.eval (g.inputs.map fun i => (wiresFrom pre (List.ofFn x)).getD i false)]) := by
    rw [wiresFrom_append]; rfl
  have hl : (wiresFrom pre (List.ofFn x)).length = n + p := by
    rw [length_wiresFrom]; simp [hlen]
  rw [h1, getD_wiresFrom _ _ _ (by simp [hl]), getD_snoc_len _ _ _ _ hl]
  congr 1
  apply List.map_congr_left
  intro a ha
  have hal := hlt a ha
  have e1 := getD_wiresFrom post (wiresFrom pre (List.ofFn x) ++
        [g.op.eval (g.inputs.map fun i => (wiresFrom pre (List.ofFn x)).getD i false)]) a
        (by simp [hl]; omega)
  rw [e1, List.getD_append _ _ _ _ (by omega)]

def CleanG (m : ℕ) (g : Gate) : Prop :=
  (g.op = GateOp.and ∨ g.op = GateOp.or) ∧
    ∃ j k, j < m ∧ k < m ∧ g.inputs = [j,k]

def CleanL (n : ℕ) (gs : List Gate) : Prop :=
  ∀ p g, gs[p]? = some g → CleanG (n + p) g

theorem cleanG_lt {m g} (h : CleanG m g) : ∀ a ∈ g.inputs, a < m := by
  obtain ⟨_, j, k, hj, hk, ins⟩ := h
  simpa [ins] using And.intro hj hk

theorem ao_clean {n C} (h : IsAO2 n C) : CleanL n C.gates := by
  intro p g hp
  have hlt := (List.getElem?_eq_some_iff.1 hp).1
  have hget := (List.getElem?_eq_some_iff.1 hp).2
  have hg : g ∈ C.gates := hget ▸ List.getElem_mem _
  obtain ⟨j,k,ins⟩ := List.length_eq_two.mp (h.2.2 g hg)
  have eq : PEqualNP.MetaComplexity.NestedCover.gateAt C p = g := by
    change C.gates.getD p _ = g
    simpa [hlt] using hget
  have hb := h.2.1 p hlt
  rw [eq,ins] at hb
  exact ⟨h.1 g hg,j,k,hb j (by simp),hb k (by simp),ins⟩

def kept {α : Type} (b : Bool) (x : α) (xs : List α) : List α :=
  if b then x :: xs else xs

def Run {α : Type} (inv : α → α) (meet join : α → α → α) (y : α) (t : ℕ) (ws : List α) : Prop :=
  ∀ P : ℕ → List α → Prop, P 0 [y] →
    (∀ {s xs zs}, List.Perm xs zs → P s xs → P s zs) →
    (∀ {s a r} (neg save : Bool), P s ((if neg then inv a else a) :: kept save a r) →
      P (s+1) (a :: r)) →
    (∀ {s a b r} (c ka kb : Bool),
      P s ((if c then meet a b else join a b) :: kept ka a (kept kb b r)) →
      P (s+1) (a :: b :: r)) → P t ws

theorem Run.done {α inv meet join y} : @Run α inv meet join y 0 [y] := fun _ d _ _ _ => d

theorem Run.perm {α inv meet join y s xs zs} (p : List.Perm xs zs)
    (h : @Run α inv meet join y s xs) : Run inv meet join y s zs :=
  fun P d q u b => q p (h P d q u b)

theorem Run.one {α inv meet join y s a r} (neg save : Bool)
    (h : @Run α inv meet join y s ((if neg then inv a else a) :: kept save a r)) :
    Run inv meet join y (s+1) (a :: r) := fun P d q u b => u neg save (h P d q u b)

theorem Run.two {α inv meet join y s a b r} (c ka kb : Bool)
    (h : @Run α inv meet join y s ((if c then meet a b else join a b) :: kept ka a (kept kb b r))) :
    Run inv meet join y (s+1) (a :: b :: r) := fun P d q u v => v c ka kb (h P d q u v)

theorem Run.fold {α inv meet join y} {P : ∀ t ws, @Run α inv meet join y t ws → Prop}
    (done : P 0 [y] Run.done)
    (perm : ∀ {s xs zs} (hp : List.Perm xs zs) (h : Run inv meet join y s xs),
      P s xs h → P s zs (Run.perm hp h))
    (one : ∀ {s a r} (neg save : Bool)
      (h : Run inv meet join y s ((if neg then inv a else a) :: kept save a r)),
      P _ _ h → P _ _ (Run.one neg save h))
    (two : ∀ {s a b r} (c ka kb : Bool)
      (h : Run inv meet join y s ((if c then meet a b else join a b) :: kept ka a (kept kb b r))),
      P _ _ h → P _ _ (Run.two c ka kb h))
    {t ws} (h : Run inv meet join y t ws) : P t ws h := by
  have hex := h (fun s xs => ∃ h' : Run inv meet join y s xs, P s xs h')
    ⟨Run.done, done⟩
    (fun hp ⟨h', ih⟩ => ⟨Run.perm hp h', perm hp h' ih⟩)
    (fun n k ⟨h', ih⟩ => ⟨Run.one n k h', one n k h' ih⟩)
    (fun c a b ⟨h', ih⟩ => ⟨Run.two c a b h', two c a b h' ih⟩)
  exact hex.elim fun _ hp => hp

theorem kept_map {α β : Type} (e : α → β) (b : Bool) (x : α) (xs : List α) :
    (kept b x xs).map e = kept b (e x) (xs.map e) := by cases b <;> simp [kept]

theorem mem_kept {α : Type} (b : Bool) (x a : α) (xs : List α) :
    a ∈ kept b x xs ↔ (b = true ∧ a = x) ∨ a ∈ xs := by cases b <;> simp [kept]

theorem nodup_kept {α : Type} (b : Bool) (x : α) (xs : List α) (h : xs.Nodup) (hx : x ∉ xs) :
    (kept b x xs).Nodup := by
  cases b
  · simpa [kept] using h
  · simpa [kept] using And.intro hx h

theorem Run.map {α β : Type} (e : α → β) {inv : α → α} {meet join : α → α → α}
    {inv' : β → β} {meet' join' : β → β → β}
    (hi : ∀ a, e (inv a) = inv' (e a)) (hm : ∀ a b, e (meet a b) = meet' (e a) (e b))
    (hj : ∀ a b, e (join a b) = join' (e a) (e b))
    {y : α} {s : ℕ} {ws : List α} (h : Run inv meet join y s ws) :
    Run inv' meet' join' (e y) s (ws.map e) := by
  induction h using Run.fold with
  | done => exact Run.done
  | perm hp _ ih => exact Run.perm (hp.map e) ih
  | @one s a rest neg save _ ih =>
    have e1 : ((if neg then inv a else a) :: kept save a rest).map e
        = (if neg then inv' (e a) else e a) :: kept save (e a) (rest.map e) := by
      cases neg <;> simp [kept_map, hi]
    rw [e1] at ih
    exact Run.one neg save ih
  | @two s a b rest conj ka kb _ ih =>
    have e1 : ((if conj then meet a b else join a b) :: kept ka a (kept kb b rest)).map e
        = (if conj then meet' (e a) (e b) else join' (e a) (e b))
            :: kept ka (e a) (kept kb (e b) (rest.map e)) := by
      cases conj <;> simp [kept_map, hm, hj]
    rw [e1] at ih
    exact Run.two conj ka kb ih

def Reach (n : ℕ) (gs : List Gate) (o a : ℕ) : Prop :=
  ∀ P : ℕ → Prop, P o →
    (∀ q g, gs[q]? = some g → P (n + q) → ∀ u ∈ g.inputs, P u) → P a

theorem reach_self (n : ℕ) (gs : List Gate) (o : ℕ) : Reach n gs o o :=
  fun _ ho _ => ho

theorem reach_step {n : ℕ} {gs : List Gate} {o q u : ℕ} {g : Gate}
    (hq : gs[q]? = some g) (hr : Reach n gs o (n + q)) (hu : u ∈ g.inputs) :
    Reach n gs o u :=
  fun P ho hs => hs q g hq (hr P ho hs) u hu

theorem reach_cases {n : ℕ} {gs : List Gate} {o a : ℕ} (h : Reach n gs o a) :
    a = o ∨ ∃ q g, gs[q]? = some g ∧ a ∈ g.inputs ∧ Reach n gs o (n + q) := by
  apply h (fun x => x = o ∨ ∃ q g, gs[q]? = some g ∧ x ∈ g.inputs ∧ Reach n gs o (n + q))
  · exact Or.inl rfl
  · intro q g hq hP u hu
    refine Or.inr ⟨q, g, hq, hu, ?_⟩
    rcases hP with rfl | ⟨q', g', hq', hin', hr'⟩
    · exact reach_self n gs (n + q)
    · exact reach_step hq' hr' hin'

def Live (n : ℕ) (gs : List Gate) (o p a : ℕ) : Prop :=
  a = o ∨ ∃ q, p ≤ q ∧ ∃ g, gs[q]? = some g ∧ a ∈ g.inputs ∧ Reach n gs o (n + q)

open Classical in
noncomputable def liveList (gs : List Gate) (n o p : ℕ) : List ℕ :=
  (List.range (n + p)).filter (fun a => decide (Live n gs o p a))

theorem mem_liveList (gs : List Gate) (n o p a : ℕ) :
    a ∈ liveList gs n o p ↔ a < n + p ∧ Live n gs o p a := by
  simp [liveList]

theorem nodup_liveList (gs : List Gate) (n o p : ℕ) : (liveList gs n o p).Nodup :=
  List.Nodup.filter _ List.nodup_range

abbrev meetF {n : ℕ} : BFn n → BFn n → BFn n := fun a b x => a x && b x
abbrev joinF {n : ℕ} : BFn n → BFn n → BFn n := fun a b x => a x || b x

theorem live_succ_reach (n : ℕ) (gs : List Gate) (o : ℕ) (hcl : CleanL n gs)
    (p : ℕ) (g : Gate) (hg : gs[p]? = some g) (hr : Reach n gs o (n + p)) (a : ℕ) :
    a ∈ liveList gs n o (p + 1) ↔
      a = n + p ∨ (a ∈ liveList gs n o p ∧ (a ∈ g.inputs → Live n gs o (p + 1) a)) := by
  rw [mem_liveList, mem_liveList]
  constructor
  · rintro ⟨hlt, hl⟩
    by_cases ha : a = n + p
    · exact Or.inl ha
    · refine Or.inr ⟨⟨by omega, ?_⟩, fun _ => hl⟩
      rcases hl with h | ⟨q, hq, g', hg', hin, hrq⟩
      · exact Or.inl h
      · exact Or.inr ⟨q, by omega, g', hg', hin, hrq⟩
  · rintro (rfl | ⟨⟨hlt, hl⟩, himp⟩)
    · refine ⟨by omega, ?_⟩
      rcases reach_cases hr with h | ⟨q, g', hg', hin, hrq⟩
      · exact Or.inl h
      · refine Or.inr ⟨q, ?_, g', hg', hin, hrq⟩
        have := cleanG_lt (hcl q g' hg') _ hin
        omega
    · refine ⟨by omega, ?_⟩
      rcases hl with h | ⟨q, hq, g', hg', hin, hrq⟩
      · exact Or.inl h
      · by_cases hqp : q = p
        · subst hqp
          rw [hg] at hg'
          cases hg'
          exact himp hin
        · exact Or.inr ⟨q, by omega, g', hg', hin, hrq⟩

theorem live_succ_dead (n : ℕ) (gs : List Gate) (o : ℕ)
    (p : ℕ) (hnr : ¬ Reach n gs o (n + p)) (a : ℕ) :
    a ∈ liveList gs n o (p + 1) ↔ a ∈ liveList gs n o p := by
  rw [mem_liveList, mem_liveList]
  constructor
  · rintro ⟨hlt, hl⟩
    have hne : a ≠ n + p := by
      rintro rfl
      rcases hl with rfl | ⟨q, _, g', hg', hin, hrq⟩
      · exact hnr (reach_self n gs _)
      · exact hnr (reach_step hg' hrq hin)
    refine ⟨by omega, ?_⟩
    rcases hl with h | ⟨q, hq, g', hg', hin, hrq⟩
    · exact Or.inl h
    · exact Or.inr ⟨q, by omega, g', hg', hin, hrq⟩
  · rintro ⟨hlt, hl⟩
    refine ⟨by omega, ?_⟩
    rcases hl with h | ⟨q, hq, g', hg', hin, hrq⟩
    · exact Or.inl h
    · by_cases hqp : q = p
      · subst hqp; exact absurd hrq hnr
      · exact Or.inr ⟨q, by omega, g', hg', hin, hrq⟩

open Classical in
theorem run_live (n : ℕ) (gs : List Gate) (o : ℕ) (hcl : CleanL n gs) (ho : o < n + gs.length) :
    ∀ d p, p + d = gs.length →
      ∃ d', d' ≤ d ∧
        Run (@id (BFn n)) meetF joinF (val gs n o) d' ((liveList gs n o p).map (val gs n)) := by
  intro d
  induction d with
  | zero =>
    intro p hp
    have hperm : [o].Perm (liveList gs n o p) := by
      refine (List.perm_ext_iff_of_nodup (List.nodup_singleton o) (nodup_liveList _ _ _ _)).2 ?_
      intro a
      rw [mem_liveList, List.mem_singleton]
      constructor
      · rintro rfl; exact ⟨by omega, Or.inl rfl⟩
      · rintro ⟨_, h | ⟨q, hq, g', hg', _, _⟩⟩
        · exact h
        · have := (List.getElem?_eq_some_iff.1 hg').1; omega
    exact ⟨0, le_rfl, Run.perm (hperm.map (val gs n)) Run.done⟩
  | succ d ih =>
    intro p hp
    have hplt : p < gs.length := by omega
    obtain ⟨g, hg⟩ : ∃ g, gs[p]? = some g := ⟨gs[p], List.getElem?_eq_getElem hplt⟩
    obtain ⟨d', hd', IH⟩ := ih (p + 1) (by omega)
    by_cases hr : Reach n gs o (n + p)
    · have hstep := live_succ_reach n gs o hcl p g hg hr
      have hin : ∀ a ∈ g.inputs, a ∈ liveList gs n o p := fun a ha =>
        (mem_liveList _ _ _ _ _).2 ⟨cleanG_lt (hcl p g hg) a ha, Or.inr ⟨p, le_rfl, g, hg, ha, hr⟩⟩
      have hnew : ∀ a ∈ liveList gs n o p, a ≠ n + p := fun a ha =>
        Nat.ne_of_lt ((mem_liveList _ _ _ _ _).1 ha).1
      have hvg := val_gate n gs p g hg (cleanG_lt (hcl p g hg))
      have hnd0 := nodup_liveList gs n o p
      have single : ∀ (j : ℕ) (neg : Bool), (∀ a, a ∈ g.inputs ↔ a = j) →
          val gs n (n + p) = (if neg then id (val gs n j) else val gs n j) →
          Run (@id (BFn n)) meetF joinF (val gs n o) (d' + 1)
            ((liveList gs n o p).map (val gs n)) := by
        intro j neg hmem hval
        have hj := hin j ((hmem j).2 rfl)
        have hp1 : (liveList gs n o p).Perm (j :: (liveList gs n o p).erase j) :=
          List.perm_cons_erase hj
        have hnr : ((liveList gs n o p).erase j).Nodup := hnd0.erase j
        have hp2 : (liveList gs n o (p + 1)).Perm
            ((n + p) :: kept (decide (Live n gs o (p + 1) j)) j ((liveList gs n o p).erase j)) := by
          refine (List.perm_ext_iff_of_nodup (nodup_liveList _ _ _ _) ?_).2 ?_
          · refine List.nodup_cons.2 ⟨?_, nodup_kept _ _ _ hnr (by simp [hnd0.mem_erase_iff])⟩
            rw [mem_kept]
            rintro (⟨_, h⟩ | h)
            · exact hnew j hj h.symm
            · exact hnew _ (List.mem_of_mem_erase h) rfl
          · intro a
            rw [hstep a, List.mem_cons, mem_kept, hnd0.mem_erase_iff, hmem a]
            simp only [decide_eq_true_eq]
            constructor
            · rintro (h | ⟨h1, h2⟩)
              · exact Or.inl h
              · by_cases haj : a = j
                · exact Or.inr (Or.inl ⟨haj ▸ h2 haj, haj⟩)
                · exact Or.inr (Or.inr ⟨haj, h1⟩)
            · rintro (h | ⟨h1, rfl⟩ | ⟨h1, h2⟩)
              · exact Or.inl h
              · exact Or.inr ⟨hj, fun _ => h1⟩
              · exact Or.inr ⟨h2, fun h => absurd h h1⟩
        have IH' := Run.perm (hp2.map (val gs n)) IH
        rw [List.map_cons, kept_map, hval] at IH'
        exact Run.perm (hp1.map (val gs n)).symm (Run.one neg _ IH')
      refine ⟨d' + 1, by omega, ?_⟩
      obtain ⟨hop, j, k, hj, hk, hinp⟩ := hcl p g hg
      by_cases hjk : j = k
      · subst hjk
        apply single j false
        · intro a; simp [hinp]
        · funext x; rw [hvg x, hinp]; rcases hop with hop | hop <;> rw [hop] <;> simp [GateOp.eval]
      · have hjm := hin j (by simp [hinp])
        have hkm := hin k (by simp [hinp])
        have hke : k ∈ (liveList gs n o p).erase j :=
          (hnd0.mem_erase_iff).2 ⟨fun e => hjk e.symm, hkm⟩
        have hnr : ((liveList gs n o p).erase j).Nodup := hnd0.erase j
        have hnr2 : (((liveList gs n o p).erase j).erase k).Nodup := hnr.erase k
        have hp1 : (liveList gs n o p).Perm
            (j :: k :: ((liveList gs n o p).erase j).erase k) :=
          (List.perm_cons_erase hjm).trans ((List.perm_cons_erase hke).cons j)
        have hmr : ∀ a, a ∈ ((liveList gs n o p).erase j).erase k ↔
            a ≠ k ∧ a ≠ j ∧ a ∈ liveList gs n o p := by
          intro a; rw [hnr.mem_erase_iff, hnd0.mem_erase_iff]
        have hp2 : (liveList gs n o (p + 1)).Perm
            ((n + p) :: kept (decide (Live n gs o (p + 1) j)) j
              (kept (decide (Live n gs o (p + 1) k)) k
                (((liveList gs n o p).erase j).erase k))) := by
          refine (List.perm_ext_iff_of_nodup (nodup_liveList _ _ _ _) ?_).2 ?_
          · refine List.nodup_cons.2 ⟨?_, nodup_kept _ _ _ (nodup_kept _ _ _ hnr2 ?_) ?_⟩
            · rw [mem_kept, mem_kept]
              rintro (⟨_, h⟩ | ⟨_, h⟩ | h)
              · exact hnew j hjm h.symm
              · exact hnew k hkm h.symm
              · exact hnew _ ((hmr _).1 h).2.2 rfl
            · rw [hmr]; simp
            · rw [mem_kept, hmr]
              rintro (⟨_, h⟩ | h)
              · exact hjk h
              · exact h.2.1 rfl
          · intro a
            rw [hstep a, List.mem_cons, mem_kept, mem_kept, hmr a]
            simp only [decide_eq_true_eq, hinp, List.mem_cons, List.not_mem_nil, or_false]
            constructor
            · rintro (h | ⟨h1, h2⟩)
              · exact Or.inl h
              · by_cases haj : a = j
                · exact Or.inr (Or.inl ⟨haj ▸ h2 (Or.inl haj), haj⟩)
                · by_cases hak : a = k
                  · exact Or.inr (Or.inr (Or.inl ⟨hak ▸ h2 (Or.inr hak), hak⟩))
                  · exact Or.inr (Or.inr (Or.inr ⟨hak, haj, h1⟩))
            · rintro (h | ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, h2, h3⟩)
              · exact Or.inl h
              · exact Or.inr ⟨hjm, fun _ => h1⟩
              · exact Or.inr ⟨hkm, fun _ => h1⟩
              · exact Or.inr ⟨h3, fun h => by rcases h with h | h <;> contradiction⟩
        have IH' := Run.perm (hp2.map (val gs n)) IH
        have hval : val gs n (n + p) = (if decide (g.op = GateOp.and)
            then meetF (val gs n j) (val gs n k) else joinF (val gs n j) (val gs n k)) := by
          funext x; rw [hvg x, hinp]
          rcases hop with hop | hop <;> rw [hop] <;> simp [GateOp.eval]
        rw [List.map_cons, kept_map, kept_map, hval] at IH'
        exact Run.perm (hp1.map (val gs n)).symm (Run.two _ _ _ IH')
    · have hp : (liveList gs n o (p + 1)).Perm (liveList gs n o p) :=
        (List.perm_ext_iff_of_nodup (nodup_liveList _ _ _ _) (nodup_liveList _ _ _ _)).2
          (live_succ_dead n gs o p hr)
      exact ⟨d', by omega, Run.perm (hp.map (val gs n)) IH⟩

theorem derive {n : ℕ} {f : BFn n} (C : Circuit) (ao : IsAO2 n C)
    (spec : ∀ x, circuitFun n C x = f x)
    (hit : ∃ x, f x = true) :
    ∃ t ≤ C.size, ∃ ws : List (BFn n),
      ws.Sublist (List.ofFn fun (i : Fin n) => (fun x : Fin n → Bool => x i)) ∧
        Run id meetF joinF f t ws := by
  have ho : C.output < n + C.gates.length := by
    by_contra! h
    obtain ⟨x,hx⟩ := hit
    have hx' := (spec x).trans hx
    change (wiresFrom C.gates (List.ofFn x)).getD C.output false = true at hx'
    rw [List.getD_eq_default _ _ (by simpa [length_wiresFrom] using h)] at hx'
    contradiction
  obtain ⟨t,le,run⟩ := run_live n C.gates C.output (ao_clean ao) ho C.gates.length 0 (by omega)
  refine ⟨t,le,(liveList C.gates n C.output 0).map (val C.gates n),?_,?_⟩
  · have e : (List.ofFn fun (i : Fin n) => (fun x : Fin n → Bool => x i))
        = (List.range n).map (val C.gates n) := by
      apply List.ext_getElem
      · simp
      · intro i h1 h2
        simp only [List.getElem_ofFn, List.getElem_map, List.getElem_range]
        exact (val_input C.gates n ⟨i, by simpa using h1⟩).symm
    rw [e]
    exact (List.filter_sublist).map _
  · have eq : val C.gates n C.output = f := funext spec
    exact eq ▸ run
theorem run_len {α inv meet join y s xs} (h : @Run α inv meet join y s xs) :
    xs.length ≤ s + 1 := by
  induction h using Run.fold with
  | done => simp
  | perm hp _ ih => rwa [← hp.length_eq]
  | one neg save h ih => cases save <;> simp_all [kept] <;> omega
  | two conj ka kb h ih => cases ka <;> cases kb <;> simp_all [kept] <;> omega

def pt (n : ℕ) (v : ℕ) : Fin n → Bool := fun i => v.testBit i

def encL {n : ℕ} (a : BFn n) : List ℕ → ℕ
  | [] => 0
  | v :: t => Nat.bit (a (pt n v)) (encL a t)

theorem encL_testBit {n : ℕ} (a : BFn n) : ∀ (l : List ℕ) (j : ℕ),
    (encL a l).testBit j = (l.map fun v => a (pt n v)).getD j false
  | [], j => by simp [encL]
  | v :: t, 0 => by simp [encL]
  | v :: t, j + 1 => by simp [encL, Nat.testBit_bit_succ, encL_testBit a t j]

theorem encL_and {n : ℕ} (a b : BFn n) (l : List ℕ) :
    encL (meetF a b) l = encL a l &&& encL b l := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_and, encL_testBit, encL_testBit, encL_testBit]
  by_cases h : j < l.length
  · simp [h]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      List.getD_eq_default _ _ (by simp; omega)]
    rfl

theorem encL_or {n : ℕ} (a b : BFn n) (l : List ℕ) :
    encL (joinF a b) l = encL a l ||| encL b l := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_or, encL_testBit, encL_testBit, encL_testBit]
  by_cases h : j < l.length
  · simp [h]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      List.getD_eq_default _ _ (by simp; omega)]
    rfl

abbrev NatRun := Run (id : ℕ → ℕ) (· &&& ·) (· ||| ·)

theorem derive_bits {n : ℕ} {f : BFn n} (C : Circuit) (ao : IsAO2 n C)
    (spec : ∀ x, circuitFun n C x = f x) (hit : ∃ x, f x = true) (rows : List ℕ) :
    ∃ t ≤ C.size, ∃ ws : List ℕ,
      ws.Sublist (List.ofFn fun (i : Fin n) => encL (fun x => x i) rows) ∧
        NatRun (encL f rows) t ws := by
  obtain ⟨t,le,fs,sub,run⟩ := derive C ao spec hit
  let enc : BFn n → ℕ := fun f => encL f rows
  refine ⟨t,le,fs.map enc,?_,?_⟩
  · simpa only [List.map_ofFn, Function.comp_def, enc] using sub.map enc
  · exact run.map enc (fun _ => rfl) (fun a b => encL_and a b rows)
      (fun a b => encL_or a b rows)
end MonoRun

namespace MonoBar
open MonoRun

abbrev NatRun (y : Nat) := Run id (· &&& ·) (· ||| ·) y
def lo (k : Nat) := 2^k-1
def goal (k : Nat) := lo k <<< k
def diffUp (k w : Nat) : Nat := (w >>> k) &&& (w ^^^ lo k)

def covUp (k : Nat) : List Nat → Nat
  | [] => 0
  | a :: t => diffUp k a ||| covUp k t

theorem covUp_bit (k i : Nat) (hi : i < k) (ws : List Nat) : (covUp k ws).testBit i = true ↔
    ∃ a ∈ ws, a.testBit i = false ∧ a.testBit (k+i) = true := by
  induction ws with
  | nil => simp [covUp]
  | cons a t ih => simp [covUp, diffUp, lo, hi, ih, and_comm]

theorem bits_le {y t ws} (run : NatRun y t ws) (i j : Nat)
    (hw : ∀ a ∈ ws, a.testBit i ≤ a.testBit j) : y.testBit i ≤ y.testBit j := by
  induction run using Run.fold with
  | done => exact hw _ (by simp)
  | perm p _ ih => exact ih (fun a ha => hw a (p.mem_iff.mp ha))
  | @one s a r neg save _ ih =>
    apply ih
    intro w h
    have mem : w = a ∨ w ∈ r := by cases neg <;> cases save <;> simp_all [kept]
    exact hw w (List.mem_cons.mpr mem)
  | @two s a b r c ka kb _ ih =>
    apply ih
    intro w h
    rcases List.mem_cons.mp h with eq | tail
    · subst w
      have aa := hw a List.mem_cons_self
      have bb := hw b (List.mem_cons_of_mem _ List.mem_cons_self)
      cases c <;> simp only [Bool.false_eq_true,ite_false,ite_true,Nat.testBit_or,Nat.testBit_and] <;>
        first | exact Bool.or_le_or aa bb | exact Bool.and_le_and aa bb | grind
    · apply hw
      cases ka <;> cases kb <;> simp_all [kept] <;> tauto

theorem required_up {k s ws} (h : NatRun (goal k) s ws) :
    (covUp k ws &&& lo k) = lo k := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_and]
  by_cases hi : i < k
  · have hy : ¬ (goal k).testBit (k+i) ≤ (goal k).testBit i := by
      simp [goal, lo, Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one, hi, show ¬ k ≤ i by omega]
    have hc : (covUp k ws).testBit i = true := by
      apply (covUp_bit k i hi ws).2
      by_contra! hh
      apply hy
      apply bits_le h
      intro a ha
      specialize hh a ha
      cases hx : a.testBit i <;> cases hy : a.testBit (k+i) <;> simp_all
    simp [hc]
  · simp [lo, Nat.testBit_two_pow_sub_one, hi]

theorem keep_perm {α : Type} {xs ys : List α} (p : xs.Perm ys) (b : Bool) (a : α) :
    (kept b a xs).Perm (kept b a ys) := by cases b <;> simpa [kept] using p

def nextAux (slack : Nat) (ws : List Nat) (f : Nat → List Nat → Bool) : Bool :=
  ws.any fun a =>
    let ra := ws.erase a
    (slack ≥ 1 && (f 0 (a::ra) || (slack ≥ 2 && f 0 (a::a::ra)))) ||
    ra.any fun b =>
      a ≤ b && (let r := ra.erase b
        [false,true].any fun conj =>
          let w := if conj then a &&& b else a ||| b
          f 0 (w :: r) || (slack ≥ 1 && (f 0 (w :: a :: r) || f 0 (w :: b :: r))) ||
            (slack ≥ 2 && f 0 (w :: a :: b :: r)))
def next (slack : Nat) (ws : List Nat) (f : List Nat → Bool) : Bool := nextAux slack ws (fun _ => f)
theorem next_one {k a rest} {neg save : Bool} {s ws} (p : (a :: rest).Perm ws)
    (h : NatRun (goal k) s ((if neg then id a else a) :: kept save a rest))
    (f : Nat → List Nat → Bool)
    (hf : ∀ (t : Nat) ys, NatRun (goal k) s ys → f t ys = true) :
    nextAux (s+2-ws.length) ws f = true := by
  have ha := p.mem_iff.1 List.mem_cons_self
  have pr : rest.Perm (ws.erase a) := (p.trans (List.perm_cons_erase ha)).cons_inv
  have hh := run_len h
  have hl := p.length_eq
  simp only [List.length_cons] at hl hh
  have hsl : 1 ≤ s+2-ws.length := by cases save <;> simp [kept] at hh <;> omega
  apply List.any_eq_true.2 ⟨a, ha, ?_⟩
  rw [Bool.or_eq_true]; left
  rw [Bool.and_eq_true]; refine ⟨decide_eq_true hsl, ?_⟩

  have ht (t : Nat) := hf t _ (Run.perm ((keep_perm pr save a).cons _) h)
  simp only [id_eq,ite_self] at ht
  cases save with
  | false => simp [kept] at ht; simp [ht]
  | true =>
    simp [kept] at ht hh
    have hsl2 : 2 ≤ s+2-ws.length := by omega
    simp [ht, hsl2]

theorem next_two_sorted {k a b rest} {conj ka kb : Bool} {s ws} (hab : a ≤ b)
    (p : (a :: b :: rest).Perm ws)
    (h : NatRun (goal k) s
      ((if conj then a &&& b else a ||| b) :: kept ka a (kept kb b rest)))
    (f : Nat → List Nat → Bool)
    (hf : ∀ (t : Nat) ys, NatRun (goal k) s ys → f t ys = true) :
    nextAux (s+2-ws.length) ws f = true := by
  have ha := p.mem_iff.1 List.mem_cons_self
  have pp := (p.trans (List.perm_cons_erase ha)).cons_inv
  have hb := pp.mem_iff.1 List.mem_cons_self
  have pr := (pp.trans (List.perm_cons_erase hb)).cons_inv
  have hh := run_len h
  have hl := p.length_eq
  simp only [List.length_cons] at hl hh
  apply List.any_eq_true.2 ⟨a, ha, ?_⟩
  rw [Bool.or_eq_true]; right
  apply List.any_eq_true.2 ⟨b, hb, ?_⟩
  rw [Bool.and_eq_true]; refine ⟨decide_eq_true hab, ?_⟩
  apply List.any_eq_true.2 ⟨conj, by cases conj <;> simp, ?_⟩
  have ht (t : Nat) := hf t _ (Run.perm ((keep_perm (keep_perm pr kb b) ka a).cons _) h)
  cases ka <;> cases kb <;> simp [kept] at ht hh <;>
    simp only [ht, Bool.true_or, Bool.or_true, Bool.and_true, Bool.true_and] <;>
    first | (simp [show 2 ≤ s+2-ws.length by omega]) | (simp [show 1 ≤ s+2-ws.length by omega])

theorem next_two {k a b rest} {conj ka kb : Bool} {s ws}
    (p : (a :: b :: rest).Perm ws)
    (h : NatRun (goal k) s
      ((if conj then a &&& b else a ||| b) :: kept ka a (kept kb b rest)))
    (f : Nat → List Nat → Bool)
    (hf : ∀ (t : Nat) ys, NatRun (goal k) s ys → f t ys = true) :
    nextAux (s+2-ws.length) ws f = true := by
  rcases le_total a b with hab | hba
  · exact next_two_sorted hab p h f hf
  · apply next_two_sorted (conj := conj) (ka := kb) (kb := ka) hba ((List.Perm.swap _ _ _).trans p) _ f hf
    have he : (if conj then a &&& b else a ||| b) = (if conj then b &&& a else b ||| a) := by
      cases conj <;> simp [Nat.and_comm, Nat.or_comm]
    rw [he] at h
    apply Run.perm (List.Perm.cons _ ?_) h
    cases ka <;> cases kb <;> simp [kept]
    exact List.Perm.swap _ _ _

theorem zero_done {α inv meet join y t ws} (h : @Run α inv meet join y t ws) :
    t = 0 → ws = [y] := by
  induction h using Run.fold with
  | done => simp
  | perm p h ih => intro ht; rw [ih ht] at p; exact List.perm_singleton.1 p.symm
  | one => simp
  | two => simp

theorem next_complete {k t ws} (h : NatRun (goal k) t ws) :
    ∀ s, t = s+1 → ∀ zs, ws.Perm zs → ∀ f : Nat → List Nat → Bool,
      (∀ (t : Nat) ys, NatRun (goal k) s ys → f t ys = true) →
      nextAux (s+2-zs.length) zs f = true := by
  induction h using Run.fold with
  | done => simp
  | perm p h ih => intro s he zs q; exact ih s he zs (p.trans q)
  | one neg save h ih => intro s he zs p f hf; cases he; exact next_one p h f hf
  | two conj ka kb h ih => intro s he zs p f hf; cases he; exact next_two p h f hf

def span (f : Nat → Bool) : Nat → Nat → Bool
  | 0, _ => true
  | n+1, i => f i && span f n (i+1)

theorem span_ok {f n o} (h : span f n o = true) : ∀ i, o ≤ i → i < o+n → f i = true := by
  induction n generalizing o with
  | zero => omega
  | succ n ih =>
    simp only [span, Bool.and_eq_true] at h
    intro i hi hj
    rcases Nat.eq_or_lt_of_le hi with rfl | hi
    · exact h.1
    · exact ih h.2 i (by omega) (by omega)

theorem span_join {f a o b} (ha : span f a o = true) (hb : span f b (o+a) = true) :
    span f (a+b) o = true := by
  induction a generalizing o with
  | zero => simpa using hb
  | succ a ih =>
    simp only [span, Bool.and_eq_true] at ha
    rw [Nat.succ_add, span, Bool.and_eq_true]
    exact ⟨ha.1, ih ha.2 (by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hb)⟩

theorem extend_run {α inv meet join y s t a r} (h : @Run α inv meet join y s (a::r))
    (hle : s ≤ t) : Run inv meet join y t (a::r) := by
  induction t, hle using Nat.le_induction with
  | base => exact h
  | succ t hle ih => exact Run.one false false ih

def found (S : Nat → Nat → List Nat) (N : Nat → Nat) (idx : Nat → List Nat → Nat)
    (s : Nat) (zs : List Nat) : Bool :=
  decide (idx s zs < N s) && zs.isPerm (S s (idx s zs))

def bar (k : Nat) (S : Nat → Nat → List Nat) (N : Nat → Nat) (idx : Nat → List Nat → Nat) : Nat → Nat → Bool
  | 0,i => !(S 0 i == [goal k])
  | s+1,i =>
    let ws := S (s+1) i
    !(next (s+2-ws.length) ws fun zs => (covUp k zs &&& lo k == lo k) && !(found S N idx s zs))

theorem bar_sound {k S N idx} {s i : Nat} (hb : bar k S N idx s i = true)
    (h : NatRun (goal k) s (S s i)) : ∃ q<s, ∃ j<N q, NatRun (goal k) q (S q j) := by
  cases s with
  | zero => simp [bar,zero_done h rfl] at hb
  | succ s =>
    by_contra! hn
    let F (_ : Nat) (zs : List Nat) := (covUp k zs &&& lo k == lo k) && !(found S N idx s zs)
    have hF (tag : Nat) (zs) (hz : NatRun (goal k) s zs) : F tag zs = true := by
      simp only [F,required_up hz,beq_self_eq_true,Bool.true_and,found]
      simp only [Bool.not_eq_true', Bool.and_eq_false_imp, decide_eq_true_eq]
      intro hj
      by_contra! hp
      have p := List.isPerm_iff.1 (Bool.eq_true_of_not_eq_false hp)
      exact hn s (by omega) _ hj (Run.perm p hz)
    have hnxt := next_complete h s rfl _ (List.Perm.refl _) F hF
    change !(nextAux _ _ F) = true at hb
    rw [hnxt] at hb
    contradiction

theorem bar_all {k S N idx} {cap : Nat}
    (hc : ∀ s≤cap, ∀ i<N s, bar k S N idx s i = true) :
    ∀ s≤cap, ∀ i<N s, ¬NatRun (goal k) s (S s i) := by
  intro s
  induction s using Nat.strong_induction_on with
  | ind s ih =>
    intro hs i hi run
    obtain ⟨q,hq,j,hj,hr⟩ := bar_sound (hc _ hs _ hi) run
    exact ih q hq (by omega) j hj hr
end MonoBar

namespace MonoBar
open MonoRun
def symfound (S : Nat → Nat → List Nat) (N : Nat → Nat) (idx : Nat → List Nat → Nat) (orient : Nat → List Nat → List Nat)
    (s : Nat) (zs : List Nat) : Bool :=
  decide (idx s zs < N s) && (orient s zs).isPerm (S s (idx s zs))

def symbar (k : Nat) (S : Nat → Nat → List Nat) (N : Nat → Nat) (idx : Nat → List Nat → Nat) (orient : Nat → List Nat → List Nat) : Nat → Nat → Bool
  | 0,i => !(S 0 i == [goal k])
  | s+1,i =>
    let ws := S (s+1) i
    !(next (s+2-ws.length) ws fun zs => (covUp k zs &&& lo k == lo k) && !(symfound S N idx orient s zs))

theorem symbar_sound {k S N idx orient} {s i : Nat} (hr : ∀ q zs, NatRun (goal k) q zs → NatRun (goal k) q (orient q zs))
    (hb : symbar k S N idx orient s i = true)
    (h : NatRun (goal k) s (S s i)) : ∃ q<s, ∃ j<N q, NatRun (goal k) q (S q j) := by
  cases s with
  | zero => simp [symbar,zero_done h rfl] at hb
  | succ s =>
    by_contra! hn
    let F (_ : Nat) (zs : List Nat) := (covUp k zs &&& lo k == lo k) && !(symfound S N idx orient s zs)
    have hF (tag : Nat) (zs) (hz : NatRun (goal k) s zs) : F tag zs = true := by
      simp only [F,required_up hz,beq_self_eq_true,Bool.true_and,symfound]
      simp only [Bool.not_eq_true', Bool.and_eq_false_imp, decide_eq_true_eq]
      intro hj
      by_contra! hp
      have p := List.isPerm_iff.1 (Bool.eq_true_of_not_eq_false hp)
      exact hn s (by omega) _ hj (Run.perm p (hr s zs hz))
    have hnxt := next_complete h s rfl _ (List.Perm.refl _) F hF
    change !(nextAux _ _ F) = true at hb
    rw [hnxt] at hb
    contradiction

theorem symbar_all {k S N idx orient} {cap : Nat}
    (hr : ∀ q zs, NatRun (goal k) q zs → NatRun (goal k) q (orient q zs))
    (hc : ∀ s≤cap, ∀ i<N s, symbar k S N idx orient s i = true) :
    ∀ s≤cap, ∀ i<N s, ¬NatRun (goal k) s (S s i) := by
  intro s
  induction s using Nat.strong_induction_on with
  | ind s ih =>
    intro hs i hi run
    obtain ⟨q,hq,j,hj,hr⟩ := symbar_sound hr (hc _ hs _ hi) run
    exact ih q hq (by omega) j hj hr
end MonoBar

namespace MonoBase
open MonoRun
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm

theorem prove_symbase (n k cap : ℕ) (f : BFn n) (rows xs : List ℕ)
    (S : ℕ → ℕ → List ℕ) (N : ℕ → ℕ) (idx : ℕ → List ℕ → ℕ) (orient : ℕ → List ℕ → List ℕ)
    (hit : ∃ x, f x = true)
    (hxs : (List.ofFn fun (i : Fin n) => encL (fun x => x i) rows) = xs)
    (hgoal : encL f rows = MonoBar.goal k)
    (proper : ∀ zs ∈ xs.sublists, zs ≠ xs → (MonoBar.covUp k zs &&& MonoBar.lo k) ≠ MonoBar.lo k)
    (ne : xs ≠ []) (root : S cap 0 = xs) (existsRoot : 0 < N cap)
    (hr : ∀ q zs, MonoBar.NatRun (MonoBar.goal k) q zs → MonoBar.NatRun (MonoBar.goal k) q (orient q zs))
    (checked : ∀ s ≤ cap, ∀ i < N s, MonoBar.symbar k S N idx orient s i = true) :
    ∀ C : Circuit, IsAO2 n C → (∀ x, circuitFun n C x = f x) → cap+1 ≤ C.size := by
  intro C ao spec
  by_contra! small
  obtain ⟨t,le,ws,sub,run⟩ := derive_bits C ao spec hit rows
  rw [hgoal] at run
  rw [hxs] at sub
  have eq : ws = xs := by
    by_contra different
    exact proper ws (List.mem_sublists.mpr sub) different (MonoBar.required_up run)
  subst ws
  have padded : MonoBar.NatRun (MonoBar.goal k) cap xs := by
    cases xs with
    | nil => contradiction
    | cons a rest => exact MonoBar.extend_run run (by omega)
  exact MonoBar.symbar_all hr checked cap le_rfl 0 existsRoot (root ▸ padded)
end MonoBase

namespace MonoSymm

def blend (pairs : List (ℕ × ℕ)) (w : ℕ) := pairs.foldr
  (fun p rest => (if w.testBit p.1 then p.2 else 0) ||| rest) 0

theorem bit (pairs : List (ℕ × ℕ)) (w i : ℕ) :
    (blend pairs w).testBit i = true ↔
      ∃ p ∈ pairs, w.testBit p.1 = true ∧ p.2.testBit i = true := by
  induction pairs with
  | nil => simp [blend]
  | cons p tail ih =>
    change (((if w.testBit p.1 then p.2 else 0) ||| blend tail w).testBit i = true) ↔ _
    cases h : w.testBit p.1 <;> simp [ih,h]

theorem unique (pairs : List (ℕ × ℕ))
    (sep : pairs.Pairwise (fun a b => a.2 &&& b.2 = 0)) (i : ℕ) :
    ∀ a ∈ pairs, ∀ b ∈ pairs, a.2.testBit i = true → b.2.testBit i = true → a=b := by
  induction pairs with
  | nil => simp
  | cons p ps ih =>
    obtain ⟨head,tail⟩ := List.pairwise_cons.mp sep
    have dis (q) (hq : q∈ps) (hp : p.2.testBit i=true) (h : q.2.testBit i=true) : False := by
      have e := congrArg (fun w : ℕ => w.testBit i) (head q hq)
      simp [Nat.testBit_and,hp,h] at e
    intro a ha b hb h₁ h₂
    rcases List.mem_cons.mp ha with h|ha'
    · subst a
      rcases List.mem_cons.mp hb with h|hb'
      · exact h.symm
      · exact (dis _ hb' h₁ h₂).elim
    · rcases List.mem_cons.mp hb with h|hb'
      · subst b
        exact (dis _ ha' h₂ h₁).elim
      · exact ih tail _ ha' _ hb' h₁ h₂

theorem join (pairs : List (ℕ × ℕ)) (a b : ℕ) :
    blend pairs (a ||| b) = blend pairs a ||| blend pairs b := by
  apply Nat.eq_of_testBit_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  simp only [Nat.testBit_or,Bool.or_eq_true,bit]
  aesop

theorem meet (pairs : List (ℕ × ℕ)) (sep : pairs.Pairwise (fun a b => a.2 &&& b.2 = 0))
    (a b : ℕ) : blend pairs (a &&& b) = blend pairs a &&& blend pairs b := by
  apply Nat.eq_of_testBit_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  simp only [Nat.testBit_and,Bool.and_eq_true,bit]
  constructor
  · rintro ⟨p,mem,⟨ha,hb⟩,yes⟩
    exact ⟨⟨p,mem,ha,yes⟩,⟨p,mem,hb,yes⟩⟩
  · rintro ⟨⟨p,hp,ha,pm⟩,⟨q,hq,hb,qm⟩⟩
    obtain rfl := unique pairs sep i p hp q hq pm qm
    exact ⟨p,hp,⟨ha,hb⟩,pm⟩

theorem relabelOK {k s : ℕ} {ws : List ℕ} (pairs : List (ℕ × ℕ))
    (sep : pairs.Pairwise (fun a b => a.2 &&& b.2 = 0)) (fix : blend pairs (MonoBar.goal k) = MonoBar.goal k)
    (run : MonoBar.NatRun (MonoBar.goal k) s ws) : MonoBar.NatRun (MonoBar.goal k) s (ws.map (blend pairs)) := by
  have h := run.map (inv' := id) (blend pairs) (by intro a; rfl) (meet pairs sep) (join pairs)
  rw [fix] at h
  exact h
end MonoSymm

