  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 1 (by decide)).2.2.2
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 2 (by decide)).1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 2 (by decide)).2.1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 2 (by decide)).2.2.1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 2 (by decide)).2.2.2
  · simpa [CSat, value, Bool.or_eq_true, or_assoc] using output_nonempty p hf
  · have h := hf 3 (by decide)
