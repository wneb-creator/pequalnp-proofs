namespace GadgetBridge

abbrev Lit := ℕ × Bool

def value (a : ℕ → Bool) (l : Lit) : Bool := a l.1 == l.2

def negate (l : Lit) : Lit := (l.1, !l.2)

def CSat (a : ℕ → Bool) (c : List Lit) : Prop := ∃ l ∈ c, value a l = true

def andClauses (z : ℕ) (xs : List Lit) : List (List Lit) :=
  xs.map (fun x => [(z, false), x]) ++ [[(z, true)] ++ xs.map negate]

def orClauses (z : ℕ) (xs : List Lit) : List (List Lit) :=
  xs.map (fun x => [(z, true), negate x]) ++ [[(z, false)] ++ xs]

lemma value_negate (a : ℕ → Bool) (l : Lit) : value a (negate l) = !(value a l) := by
  rcases l with ⟨i,b⟩
  cases h : a i <;> cases b <;> simp [value, negate, h]

lemma andClauses_sat (a : ℕ → Bool) (z : ℕ) (xs : List Lit)
    (hz : a z = xs.all (value a)) : ∀ c ∈ andClauses z xs, CSat a c := by
  intro c hc
  rcases List.mem_append.mp hc with hc | hc
  · obtain ⟨x,hx,rfl⟩ := List.mem_map.mp hc
    cases ha : a z
    · exact ⟨(z,false), by simp, by simp [value,ha]⟩
    · have hh := List.all_eq_true.mp (ha ▸ hz.symm) x hx
      exact ⟨x, by simp, hh⟩
  · have he : c = [(z,true)] ++ xs.map negate := by simpa using hc
    subst c
    cases ha : a z
    · have hn : ¬ ∀ x ∈ xs, value a x = true := by
        intro hall
        have ht := List.all_eq_true.mpr hall
        rw [← hz, ha] at ht
        contradiction
      push Not at hn
      obtain ⟨x,hx,hv⟩ := hn
      refine ⟨negate x, ?_, ?_⟩
      · exact List.mem_append_right _ (List.mem_map.mpr ⟨x,hx,rfl⟩)
      · rw [value_negate]
        cases h : value a x <;> simp_all
    · exact ⟨(z,true), by simp, by simp [value,ha]⟩

lemma orClauses_sat (a : ℕ → Bool) (z : ℕ) (xs : List Lit)
    (hz : a z = xs.any (value a)) : ∀ c ∈ orClauses z xs, CSat a c := by
  intro c hc
  rcases List.mem_append.mp hc with hc | hc
  · obtain ⟨x,hx,rfl⟩ := List.mem_map.mp hc
    cases ha : a z
    · have hxv : value a x = false := by
        by_contra hn
        have hxtrue : value a x = true := by cases h : value a x <;> simp_all
        have ht : xs.any (value a) = true := List.any_eq_true.mpr ⟨x,hx,hxtrue⟩
        rw [← hz, ha] at ht
        contradiction
      refine ⟨negate x, by simp, ?_⟩
      rw [value_negate, hxv]
      rfl
    · exact ⟨(z,true), by simp, by simp [value,ha]⟩
  · have he : c = [(z,false)] ++ xs := by simpa using hc
    subst c
    cases ha : a z
    · exact ⟨(z,false), by simp, by simp [value,ha]⟩
    · obtain ⟨x,hx,hv⟩ := List.any_eq_true.mp (ha ▸ hz.symm)
      exact ⟨x,List.mem_append_right _ hx,hv⟩


abbrev Node := Bool × List Lit

def nodeValue (n : Node) (a : ℕ → Bool) : Bool :=
  if n.1 then n.2.all (value a) else n.2.any (value a)

def step (w : List Bool) (n : Node) : List Bool :=
  w ++ [nodeValue n (fun i => w.getD i false)]

def rules : ℕ → List Node → List (List Lit)
  | _, [] => []
  | k, n :: ns => (if n.1 then andClauses k n.2 else orClauses k n.2) ++ rules (k+1) ns

def WF : ℕ → List Node → Prop
  | _, [] => True
  | k, n :: ns => (∀ l ∈ n.2, l.1 < k) ∧ WF (k+1) ns

lemma nodeValue_congr (n : Node) (a b : ℕ → Bool)
    (h : ∀ l ∈ n.2, a l.1 = b l.1) : nodeValue n a = nodeValue n b := by
  have hh : ∀ l ∈ n.2, value a l = value b l := by
    intro l hl
    simp only [value, h l hl]
  have hm : n.2.map (value a) = n.2.map (value b) := List.map_congr_left hh
  unfold nodeValue
  split
  · simpa using congrArg (fun l : List Bool => l.all id) hm
  · simpa using congrArg (fun l : List Bool => l.any id) hm

lemma run_getD (ns : List Node) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (ns.foldl step w).getD i false = w.getD i false := by
  induction ns generalizing w with
  | nil => rfl
  | cons n ns ih =>
    simp only [List.foldl_cons]
    have hlt : i < (step w n).length := by simp [step]; omega
    rw [ih (step w n) hlt]
    simp [step, List.getD_eq_getElem?_getD, List.getElem?_append_left hi]

lemma head_value (n : Node) (ns : List Node) (w : List Bool)
    (hw : ∀ l ∈ n.2, l.1 < w.length) :
    ((n :: ns).foldl step w).getD w.length false =
      nodeValue n (fun i => ((n :: ns).foldl step w).getD i false) := by
  have hlt : w.length < (step w n).length := by simp [step]
  have hget := run_getD ns (step w n) w.length hlt
  have hbase : (step w n).getD w.length false = nodeValue n (fun i => w.getD i false) := by
    simp [step, List.getD_eq_getElem?_getD]
  have he := nodeValue_congr n (fun i => w.getD i false)
    (fun i => ((n :: ns).foldl step w).getD i false) (fun l hl => (run_getD _ _ _ (hw l hl)).symm)
  simpa only [List.foldl_cons, hbase] using hget.trans (hbase.trans he)

lemma rules_sat (ns : List Node) (w : List Bool) (hw : WF w.length ns) :
    ∀ c ∈ rules w.length ns, CSat (fun i => (ns.foldl step w).getD i false) c := by
  induction ns generalizing w with
  | nil => simp [rules]
  | cons n ns ih =>
    have hf : ∀ l ∈ n.2, l.1 < w.length := hw.1
    have ht : WF (step w n).length ns := by simpa [step] using hw.2
    intro c hc
    rcases List.mem_append.mp hc with hc | hc
    · have he := head_value n ns w hf
      cases hn : n.1
      · apply orClauses_sat _ w.length n.2 (by simpa [nodeValue, hn] using he) c
        simpa [hn] using hc
      · apply andClauses_sat _ w.length n.2 (by simpa [nodeValue, hn] using he) c
        simpa [hn] using hc
    · have hh := ih (step w n) ht c
      apply hh
      simpa [step] using hc

end GadgetBridge


namespace GadgetBridge

def choose (p : ℕ → Bool) (g j : ℕ) : Bool := p (1 + 3*g+j)
def selected (p : ℕ → Bool) (j s k : ℕ) : Bool := p (10+j*(j+27)+s*(14+j)+k)
def outputSelected (p : ℕ → Bool) (j : ℕ) : Bool := p (100+j)

def freePair (p : ℕ → Bool) (r g : ℕ) : Bool :=
  let pairs : List (List (ℕ × ℕ)) := [[(1,4),(1,5),(4,5)],[(3,5),(3,6),(5,6)],[(4,6),(4,7),(6,7)]]
  ((pairs.getD g []).zipIdx).any fun q =>
    choose p g q.2 && (r.testBit (q.1.1-1) || r.testBit (q.1.2-1))

def base (p : ℕ → Bool) (r k : ℕ) : Bool :=
  if k < 7 then r.testBit k else if k < 10 then freePair p r (k-7) else
  if k = 10 then r.testBit 0 || r.testBit 3 || r.testBit 4 else
  if k = 11 then r.testBit 2 || r.testBit 4 || r.testBit 5 else
  if k = 12 then r.testBit 3 || r.testBit 5 || r.testBit 6 else false

def terms (p : ℕ → Bool) (j s : ℕ) (w : ℕ → Bool) : Bool :=
  (List.range (14+j)).all fun k => !selected p j s k || w k

def gate0 (p : ℕ → Bool) (r : ℕ) : Bool :=
  terms p 0 0 (base p r) || terms p 0 1 (base p r)

def wire1 (p : ℕ → Bool) (r k : ℕ) : Bool :=
  if k = 14 then gate0 p r else base p r k

def gate1 (p : ℕ → Bool) (r : ℕ) : Bool :=
  terms p 1 0 (wire1 p r) || terms p 1 1 (wire1 p r)

def wire2 (p : ℕ → Bool) (r k : ℕ) : Bool :=
  if k = 15 then gate1 p r else wire1 p r k

def gate2 (p : ℕ → Bool) (r : ℕ) : Bool :=
  terms p 2 0 (wire2 p r) || terms p 2 1 (wire2 p r)

def wire (p : ℕ → Bool) (r k : ℕ) : Bool :=
  if k = 16 then gate2 p r else wire2 p r k

def side (p : ℕ → Bool) (r j s : ℕ) : Bool := terms p j s (wire p r)

def output (p : ℕ → Bool) (r : ℕ) : Bool :=
  (List.range 3).all fun j => !outputSelected p j || wire p r (14+j)

lemma terms_congr (p : ℕ → Bool) (j s : ℕ) (a b : ℕ → Bool)
    (h : ∀ k, k < 14+j → a k = b k) : terms p j s a = terms p j s b := by
  have hm : (List.range (14+j)).map (fun k => !selected p j s k || a k) =
      (List.range (14+j)).map (fun k => !selected p j s k || b k) := by
    apply List.map_congr_left
    intro k hk
    rw [h k (List.mem_range.mp hk)]
  simpa [terms] using congrArg (fun l : List Bool => l.all id) hm

lemma wire_base (p : ℕ → Bool) (r k : ℕ) (hk : k < 14) : wire p r k = base p r k := by
  simp [wire, wire2, wire1, show k ≠ 16 by omega, show k ≠ 15 by omega, show k ≠ 14 by omega]

lemma wire_first (p : ℕ → Bool) (r k : ℕ) (hk : k < 15) : wire p r k = wire1 p r k := by
  simp [wire, wire2, show k ≠ 16 by omega, show k ≠ 15 by omega]

lemma wire_second (p : ℕ → Bool) (r k : ℕ) (hk : k < 16) : wire p r k = wire2 p r k := by
  simp [wire, show k ≠ 16 by omega]

lemma wire_gate0 (p : ℕ → Bool) (r : ℕ) : wire p r 14 = (side p r 0 0 || side p r 0 1) := by
  rfl

lemma wire_gate1 (p : ℕ → Bool) (r : ℕ) : wire p r 15 = (side p r 1 0 || side p r 1 1) := by
  rfl

lemma wire_gate2 (p : ℕ → Bool) (r : ℕ) : wire p r 16 = (side p r 2 0 || side p r 2 1) := by
  rfl

end GadgetBridge

