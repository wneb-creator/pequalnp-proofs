def nodeClauses (n : ℕ × Bool × List Lit) : List (List Lit) :=
  if n.2.1 then andClauses n.1 n.2.2 else orClauses n.1 n.2.2

lemma nodeClauses_sat (p : ℕ → Bool) (n : ℕ × Bool × List Lit) (hn : n ∈ nodes) :
    ∀ c ∈ nodeClauses n, CSat (assignment p) c := by
  have he := nodes_eq p n hn
  rcases n with ⟨z,b,xs⟩
  cases b
  · exact orClauses_sat _ _ _ he
  · exact andClauses_sat _ _ _ he

