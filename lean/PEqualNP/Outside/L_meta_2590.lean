def encLit (l : Lit) : ℕ := 2 * l.1 + if l.2 then 0 else 1

lemma encLit_value (a : ℕ → Bool) (l : Lit) : GadgetLRAT.litVal a (encLit l) = value a l := by
  rcases l with ⟨i,b⟩
  cases b <;> simp [encLit, GadgetLRAT.litVal, value, Nat.add_div]

