set_option maxHeartbeats 0 in
lemma formula_eq : formula.map (List.map encLit) = GadgetLRAT.gadgetF := by decide +kernel

lemma no_three_or (p : ℕ → Bool) (hc : ChoiceOK p) : ¬ Computes p := by
  intro hf
  apply GadgetLRAT.gadget_unsat
  refine ⟨assignment p, ?_⟩
  intro c hm
  rw [← formula_eq] at hm
  obtain ⟨d,hd,rfl⟩ := List.mem_map.mp hm
  obtain ⟨l,hl,hv⟩ := formula_sat p hc hf d hd
  refine ⟨encLit l, List.mem_map.mpr ⟨l,hl,rfl⟩, ?_⟩
  rw [encLit_value]
  exact hv

end GadgetBridge
namespace C6.DagTools
def gop : Bool → Bool → Bool → Bool
  | true, a, b => a && b
  | false, a, b => a || b

@[local simp] lemma gop_true (a b : Bool) : gop true a b = (a && b) := rfl

@[local simp] lemma gop_false (a b : Bool) : gop false a b = (a || b) := rfl

abbrev Dag := List (Bool × ℕ × ℕ)

def tag (D : Dag) (j : ℕ) : Bool := (D.getD j (false, 0, 0)).1

def opA (D : Dag) (j : ℕ) : ℕ := (D.getD j (false, 0, 0)).2.1

def opB (D : Dag) (j : ℕ) : ℕ := (D.getD j (false, 0, 0)).2.2

def wstep (w : List Bool) (g : Bool × ℕ × ℕ) : List Bool :=
  w ++ [gop g.1 (w.getD g.2.1 false) (w.getD g.2.2 false)]

def wl (D : Dag) (w : List Bool) : List Bool := D.foldl wstep w

def val (D : Dag) {n : ℕ} (x : Fin n → Bool) (w : ℕ) : Bool :=
  (wl D (List.ofFn x)).getD w false

def Strict (n : ℕ) (D : Dag) : Prop :=
  ∀ j, j < D.length → opA D j < n + j ∧ opB D j < n + j ∧ opA D j ≠ opB D j

end C6.DagTools

namespace FreeAndNormalize

def term (S : Finset Nat) (w : List Bool) : Bool :=
  decide (∀ i ∈ S, w.getD i false = true)

lemma term_union (A B : Finset Nat) (w : List Bool) :
    term (A ∪ B) w = (term A w && term B w) := by
  apply Bool.eq_iff_iff.mpr
  simp only [term, decide_eq_true_eq, Bool.and_eq_true, Finset.mem_union]
  constructor
  · intro h
    exact ⟨fun i hi => h i (Or.inl hi), fun i hi => h i (Or.inr hi)⟩
  · rintro ⟨ha, hb⟩ i (hi | hi)
    · exact ha i hi
    · exact hb i hi

lemma term_singleton (i : Nat) (w : List Bool) :
    term {i} w = w.getD i false := by
  apply Bool.eq_iff_iff.mpr
  simp [term]

lemma term_append_same (S : Finset Nat) (w t : List Bool)
    (h : ∀ i ∈ S, i < w.length) : term S (w ++ t) = term S w := by
  apply Bool.eq_iff_iff.mpr
  simp only [term, decide_eq_true_eq]
  constructor <;> intro hw i hi
  · simpa only [List.getD, List.getElem?_append_left (h i hi)] using hw i hi
  · simpa only [List.getD, List.getElem?_append_left (h i hi)] using hw i hi

lemma map_getD_lt (R : List (Finset Nat)) (w : List Bool) (i : Nat)
    (h : i < R.length) :
    term (R.getD i ∅) w = (R.map (fun S => term S w)).getD i false := by
  simp only [List.getD, List.getElem?_map, List.getElem?_eq_getElem h,
    Option.map_some, Option.getD_some]

lemma getD_mem_of_lt (R : List (Finset Nat)) (i : Nat) (h : i < R.length) :
    R.getD i ∅ ∈ R := by
  simpa only [List.getD, List.getElem?_eq_getElem h, Option.getD_some] using
    List.getElem_mem h

lemma initial_map (w : List Bool) :
    (((List.range w.length).map (fun i => ({i} : Finset Nat))).map
      (fun S => term S w)) = w := by
  apply List.ext_getElem
  · simp
  · intro i hi hj
    simp [term_singleton, List.getD, List.getElem?_eq_getElem hj]

lemma initial_support (n : Nat) :
    ∀ S ∈ (List.range n).map (fun i => ({i} : Finset Nat)),
      ∀ i ∈ S, i < n := by
  intro S hS i hi
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hS
  have hij : i = j := Finset.mem_singleton.mp hi
  subst i
  exact List.mem_range.mp hj

end FreeAndNormalize

namespace FreeAndNormalize

open C6.DagTools

abbrev Program := List (Finset Nat × Finset Nat)
abbrev Reps := List (Finset Nat)
abbrev State := Program × Reps

def nfStep (w : List Bool) (p : Finset Nat × Finset Nat) : List Bool :=
  w ++ [term p.1 w || term p.2 w]

def nfEval (P : Program) (w : List Bool) : List Bool := P.foldl nfStep w

def WellFormed (n : Nat) (P : Program) : Prop :=
  ∀ j, j < P.length → ∀ k ∈ (P.getD j (∅, ∅)).1 ∪ (P.getD j (∅, ∅)).2, k < n + j

def Supported (n : Nat) (P : Program) (R : Reps) : Prop :=
  ∀ S ∈ R, ∀ k ∈ S, k < n + P.length

def step (n : Nat) (st : State) (g : Bool × Nat × Nat) : State :=
  let A := st.2.getD g.2.1 ∅
  let B := st.2.getD g.2.2 ∅
  if g.1 then
    (st.1, st.2 ++ [A ∪ B])
  else
    (st.1 ++ [(A, B)], st.2 ++ [{n + st.1.length}])

def flattenAux (n : Nat) (D : Dag) (st : State) : State := D.foldl (step n) st

def initial (n : Nat) : State := ([], (List.range n).map fun i => ({i} : Finset Nat))

def flatten (n : Nat) (D : Dag) : State := flattenAux n D (initial n)

def orCount : Dag → Nat
  | [] => 0
  | g :: D => (if g.1 then 0 else 1) + orCount D

lemma nfEval_append (P Q : Program) (w : List Bool) :
    nfEval (P ++ Q) w = nfEval Q (nfEval P w) := by
  simp [nfEval, List.foldl_append]

lemma nfEval_length (P : Program) (w : List Bool) :
    (nfEval P w).length = w.length + P.length := by
  induction P generalizing w with
  | nil => simp [nfEval]
  | cons p P ih =>
    change (nfEval P (nfStep w p)).length = _
    rw [ih]
    simp [nfStep]
    omega

lemma step_reps_length (n : Nat) (st : State) (g : Bool × Nat × Nat) :
    (step n st g).2.length = st.2.length + 1 := by
  cases h : g.1 <;> simp [step, h]

lemma step_program_length (n : Nat) (st : State) (g : Bool × Nat × Nat) :
    (step n st g).1.length = st.1.length + (if g.1 then 0 else 1) := by
  cases h : g.1 <;> simp [step, h]

lemma strict_head {m : Nat} {g : Bool × Nat × Nat} {D : Dag}
    (h : Strict m (g :: D)) : g.2.1 < m ∧ g.2.2 < m := by
  have hh := h 0 (by simp)
  simpa [opA, opB] using And.intro hh.1 hh.2.1

lemma strict_tail {m : Nat} {g : Bool × Nat × Nat} {D : Dag}
    (h : Strict m (g :: D)) : Strict (m + 1) D := by
  intro j hj
  have hh := h (j + 1) (by simp; omega)
  simpa [opA, opB, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hh

lemma step_supported {n : Nat} {P : Program} {R : Reps} (g : Bool × Nat × Nat)
    (hR : Supported n P R) (ha : g.2.1 < R.length) (hb : g.2.2 < R.length) :
    Supported n (step n (P, R) g).1 (step n (P, R) g).2 := by
  have hA := hR _ (getD_mem_of_lt R g.2.1 ha)
  have hB := hR _ (getD_mem_of_lt R g.2.2 hb)
  intro S hS k hk
  cases ht : g.1 with
  | false =>
    simp only [step, ht, Bool.false_eq_true, ↓reduceIte, List.mem_append,
      List.mem_singleton] at hS
    simp only [step, ht, Bool.false_eq_true, ↓reduceIte, List.length_append,
      List.length_cons, List.length_nil]
    rcases hS with hS | rfl
    · have := hR S hS k hk
      omega
    · simp only [Finset.mem_singleton] at hk
      omega
  | true =>
    simp only [step, ht, ↓reduceIte, List.mem_append, List.mem_singleton] at hS
    simp only [step, ht, ↓reduceIte]
    rcases hS with hS | rfl
    · exact hR S hS k hk
    · rcases Finset.mem_union.mp hk with hk | hk
      · exact hA k hk
      · exact hB k hk

lemma wellFormed_append {n : Nat} {P : Program} {A B : Finset Nat}
    (hP : WellFormed n P) (hA : ∀ k ∈ A, k < n + P.length)
    (hB : ∀ k ∈ B, k < n + P.length) : WellFormed n (P ++ [(A, B)]) := by
  intro j hj k hk
  by_cases hjP : j < P.length
  · have he : (P ++ [(A, B)]).getD j (∅, ∅) = P.getD j (∅, ∅) := by
      simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hjP]
    rw [he] at hk
    exact hP j hjP k hk
  · have hj' : j = P.length := by
      simp only [List.length_append, List.length_cons, List.length_nil] at hj
      omega
    subst j
    simp only [List.getD_eq_getElem?_getD] at hk
    simp at hk
    exact hk.elim (hA k) (hB k)

lemma step_wellFormed {n : Nat} {P : Program} {R : Reps} (g : Bool × Nat × Nat)
    (hP : WellFormed n P) (hR : Supported n P R)
    (ha : g.2.1 < R.length) (hb : g.2.2 < R.length) :
    WellFormed n (step n (P, R) g).1 := by
  cases ht : g.1 with
  | true => simpa [step, ht] using hP
  | false =>
    simp only [step, ht, Bool.false_eq_true, ↓reduceIte]
    exact wellFormed_append hP (hR _ (getD_mem_of_lt R g.2.1 ha))
      (hR _ (getD_mem_of_lt R g.2.2 hb))

lemma step_correct {n : Nat} {P : Program} {R : Reps} (g : Bool × Nat × Nat)
    (input old : List Bool) (hlen : input.length = n)
    (hR : Supported n P R)
    (hmap : R.map (fun S => term S (nfEval P input)) = old)
    (ha : g.2.1 < R.length) (hb : g.2.2 < R.length) :
    (step n (P, R) g).2.map
      (fun S => term S (nfEval (step n (P, R) g).1 input)) = wstep old g := by
  let z := nfEval P input
  have hz : z.length = n + P.length := by simp [z, nfEval_length, hlen]
  have hA := map_getD_lt R z g.2.1 ha
  have hB := map_getD_lt R z g.2.2 hb
  rw [hmap] at hA hB
  cases ht : g.1 with
  | true =>
    simp only [step, ht, ↓reduceIte, List.map_append, List.map_cons, List.map_nil]
    change R.map (fun S => term S z) ++ [term (R.getD g.2.1 ∅ ∪ R.getD g.2.2 ∅) z] = _
    rw [term_union, hA, hB, hmap]
    simp [wstep, ht, gop]
  | false =>
    let v := term (R.getD g.2.1 ∅) z || term (R.getD g.2.2 ∅) z
    have he : nfEval (P ++ [(R.getD g.2.1 ∅, R.getD g.2.2 ∅)]) input = z ++ [v] := by
      simp [nfEval, nfStep, z, v]
    have hstable : R.map (fun S => term S (z ++ [v])) = R.map (fun S => term S z) := by
      apply List.map_congr_left
      intro S hS
      exact term_append_same S z [v] (fun i hi => by rw [hz]; exact hR S hS i hi)
    simp only [step, ht, Bool.false_eq_true, ↓reduceIte]
    rw [he]
    simp only [List.map_append, List.map_cons, List.map_nil]
    rw [hstable, hmap, term_singleton, ← hz]
    have hlast : (z ++ [v]).getD z.length false = v := by
      simp [List.getD_eq_getElem?_getD]
    rw [hlast]
    simp only [wstep, ht, gop]
    dsimp [v]
    rw [hA, hB]

lemma flattenAux_spec (n : Nat) (D : Dag) :
    ∀ (P : Program) (R : Reps) (input old : List Bool),
      Strict R.length D → input.length = n → WellFormed n P → Supported n P R →
      R.map (fun S => term S (nfEval P input)) = old →
      WellFormed n (flattenAux n D (P, R)).1 ∧
      Supported n (flattenAux n D (P, R)).1 (flattenAux n D (P, R)).2 ∧
      (flattenAux n D (P, R)).2.map
        (fun S => term S (nfEval (flattenAux n D (P, R)).1 input)) = wl D old ∧
      (flattenAux n D (P, R)).2.length = R.length + D.length ∧
      (flattenAux n D (P, R)).1.length = P.length + orCount D := by
  induction D with
  | nil =>
    intro P R input old hD hlen hP hR hmap
    simpa [flattenAux, wl, orCount] using And.intro hP
      (And.intro hR (And.intro hmap (And.intro (rfl : R.length = R.length) (rfl : P.length = P.length))))
  | cons g D ih =>
    intro P R input old hD hlen hP hR hmap
    obtain ⟨ha, hb⟩ := strict_head hD
    have htail : Strict (step n (P, R) g).2.length D := by
      rw [step_reps_length]
      exact strict_tail hD
    have h := ih (step n (P, R) g).1 (step n (P, R) g).2 input (wstep old g)
      htail hlen (step_wellFormed g hP hR ha hb) (step_supported g hR ha hb)
      (step_correct g input old hlen hR hmap ha hb)
    change WellFormed n (flattenAux n D (step n (P, R) g)).1 ∧ _
    refine ⟨h.1, h.2.1, ?_, ?_, ?_⟩
    · exact h.2.2.1
    · change (flattenAux n D ((step n (P, R) g).1, (step n (P, R) g).2)).2.length = _
      rw [h.2.2.2.1, step_reps_length]
      simp
      omega
    · change (flattenAux n D ((step n (P, R) g).1, (step n (P, R) g).2)).1.length = _
      rw [h.2.2.2.2, step_program_length]
      simp only [orCount]
      omega

lemma orCount_eq_filter (D : Dag) : orCount D = (D.filter fun g => !g.1).length := by
  induction D with
  | nil => rfl
  | cons g D ih =>
    cases ht : g.1 <;> simp [orCount, ht, ih, Nat.add_comm]

lemma flatten_spec {n : Nat} (D : Dag) (hD : Strict n D)
    (input : List Bool) (hlen : input.length = n) :
    WellFormed n (flatten n D).1 ∧
    Supported n (flatten n D).1 (flatten n D).2 ∧
    (flatten n D).2.map (fun S => term S (nfEval (flatten n D).1 input)) = wl D input ∧
    (flatten n D).2.length = n + D.length ∧
    (flatten n D).1.length = orCount D := by
  have hm : ((List.range n).map fun i => ({i} : Finset Nat)).map
      (fun S => term S (nfEval [] input)) = input := by
    simpa only [nfEval, List.foldl_nil, ← hlen] using initial_map input
  have h := flattenAux_spec n D [] ((List.range n).map fun i => ({i} : Finset Nat))
    input input (by simpa using hD) hlen
    (by intro j hj; simp at hj)
    (by simpa only [Supported, List.length_nil, Nat.add_zero] using initial_support n) hm
  simpa only [flatten, initial, List.length_map, List.length_range,
    List.length_nil, Nat.zero_add] using h

lemma exists_or_factor_normal_form {n : Nat} (D : Dag) (hD : Strict n D)
    (out : Nat) (hout : out < n + D.length) :
    ∃ P : Program, ∃ S : Finset Nat,
      WellFormed n P ∧ P.length = (D.filter fun g => !g.1).length ∧
      (∀ k ∈ S, k < n + P.length) ∧
      ∀ x : Fin n → Bool, term S (nfEval P (List.ofFn x)) = val D x out := by
  let st := flatten n D
  have hbase := flatten_spec D hD (List.replicate n false) (by simp)
  have houtR : out < st.2.length := by
    dsimp [st]
    rw [hbase.2.2.2.1]
    exact hout
  refine ⟨st.1, st.2.getD out ∅, hbase.1, ?_, ?_, ?_⟩
  · exact hbase.2.2.2.2.trans (orCount_eq_filter D)
  · exact hbase.2.1 _ (getD_mem_of_lt st.2 out houtR)
  · intro x
    have hx := flatten_spec D hD (List.ofFn x) (by simp)
    have hm := map_getD_lt st.2 (nfEval st.1 (List.ofFn x)) out houtR
    rw [hx.2.2.1] at hm
    exact hm

lemma term_nfEval_prefix (P : Program) (S : Finset Nat) (w : List Bool)
    (hS : ∀ i ∈ S, i < w.length) : term S (nfEval P w) = term S w := by
  induction P generalizing w with
  | nil => rfl
  | cons p P ih =>
    change term S (nfEval P (nfStep w p)) = _
    rw [ih (nfStep w p) (fun i hi => by
      have h := hS i hi
      simp only [nfStep, List.length_append, List.length_cons, List.length_nil]
      omega)]
    exact term_append_same S w [term p.1 w || term p.2 w] hS

lemma wellFormed_pad {n : Nat} (P : Program) (f : Nat)
    (hf : f < n) (hP : WellFormed n P) (m : Nat) :
    WellFormed n (P ++ List.replicate m (({f} : Finset Nat), {f})) := by
  induction m generalizing P with
  | zero => simpa using hP
  | succ m ih =>
    rw [List.replicate_succ]
    have he : P ++ (({f} : Finset Nat), {f}) :: List.replicate m ({f}, {f}) =
        (P ++ [({f}, {f})]) ++ List.replicate m ({f}, {f}) := by simp
    rw [he]
    apply ih
    apply wellFormed_append hP
    · intro k hk
      simp only [Finset.mem_singleton] at hk
      omega
    · intro k hk
      simp only [Finset.mem_singleton] at hk
      omega

lemma exists_three_or_normal_form (D : Dag) (hD : Strict 14 D)
    (hcount : (D.filter fun g => !g.1).length ≤ 3)
    (out : Nat) (hout : out < 14 + D.length) :
    ∃ P : Program, ∃ S : Finset Nat,
      WellFormed 14 P ∧ P.length = 3 ∧ (∀ k ∈ S, k < 17) ∧
      ∀ x : Fin 14 → Bool, term S (nfEval P (List.ofFn x)) = val D x out := by
  obtain ⟨P, S, hP, hlen, hS, heval⟩ := exists_or_factor_normal_form D hD out hout
  have hsmall : P.length ≤ 3 := by omega
  refine ⟨P ++ List.replicate (3 - P.length) (({13} : Finset Nat), {13}), S,
    wellFormed_pad P 13 (by decide) hP _, ?_, ?_, ?_⟩
  · simp only [List.length_append, List.length_replicate]
    omega
  · intro k hk
    have h := hS k hk
    omega
  · intro x
    rw [nfEval_append, term_nfEval_prefix _ S _ (fun k hk => by
      simpa only [nfEval_length, List.length_ofFn] using hS k hk)]
    exact heval x

end FreeAndNormalize

namespace FreeAndNormalize

lemma nfEval_getD_lt (P : Program) (w : List Bool) (i : Nat) (hi : i < w.length) :
    (nfEval P w).getD i false = w.getD i false := by
  have h := term_nfEval_prefix P {i} w (by
    intro k hk
    have hk' : k = i := Finset.mem_singleton.mp hk
    simpa only [hk'] using hi)
  simpa only [term_singleton] using h

lemma nfEval_gate_full {n : Nat} (P : Program) (w : List Bool)
    (hW : w.length = n) (hP : WellFormed n P) (j : Nat) (hj : j < P.length) :
    (nfEval P w).getD (n + j) false =
      (term (P.getD j (∅, ∅)).1 (nfEval P w) ||
        term (P.getD j (∅, ∅)).2 (nfEval P w)) := by
  let g := P.getD j (∅, ∅)
  let pre := nfEval (P.take j) w
  have hpre : pre.length = n + j := by
    simp [pre, nfEval_length, hW, Nat.min_eq_left (Nat.le_of_lt hj)]
  have hg : g = P[j] := by
    simp [g, List.getElem?_eq_getElem hj]
  have hsplit : P = (P.take j ++ [g]) ++ P.drop (j + 1) := by
    rw [hg, List.take_append_getElem hj]
    exact (List.take_append_drop (j + 1) P).symm
  let v := term g.1 pre || term g.2 pre
  have hfull : nfEval P w = nfEval (P.drop (j + 1)) (pre ++ [v]) := by
    conv_lhs => rw [hsplit]
    rw [nfEval_append, nfEval_append]
    rfl
  have hA : ∀ k ∈ g.1, k < pre.length := by
    intro k hk
    rw [hpre]
    exact hP j hj k (Finset.mem_union.mpr (Or.inl hk))
  have hB : ∀ k ∈ g.2, k < pre.length := by
    intro k hk
    rw [hpre]
    exact hP j hj k (Finset.mem_union.mpr (Or.inr hk))
  have hstable (S : Finset Nat) (hS : ∀ k ∈ S, k < pre.length) :
      term S (nfEval P w) = term S pre := by
    rw [hfull, term_nfEval_prefix _ S _ (by
      intro k hk
      have hh := hS k hk
      simp only [List.length_append, List.length_cons, List.length_nil]
      omega)]
    exact term_append_same S pre [v] hS
  change (nfEval P w).getD (n + j) false =
    (term g.1 (nfEval P w) || term g.2 (nfEval P w))
  rw [hstable g.1 hA, hstable g.2 hB, hfull]
  rw [nfEval_getD_lt _ _ _ (by
    simp only [List.length_append, List.length_cons, List.length_nil, hpre]
    omega)]
  rw [← hpre]
  simp [List.getD, v]

end FreeAndNormalize

namespace FreeAndPack

open FreeAndNormalize GadgetBridge

def factors (P : Program) (j s : Nat) : Finset Nat :=
  if s = 0 then (P.getD j (∅, ∅)).1 else (P.getD j (∅, ∅)).2

def packed (q : Nat → Bool) (P : Program) (S : Finset Nat) (i : Nat) : Bool :=
  if i < 10 then q i else
  if i < 24 then decide (i - 10 ∈ factors P 0 0) else
  if i < 38 then decide (i - 24 ∈ factors P 0 1) else
  if i < 53 then decide (i - 38 ∈ factors P 1 0) else
  if i < 68 then decide (i - 53 ∈ factors P 1 1) else
  if i < 84 then decide (i - 68 ∈ factors P 2 0) else
  if i < 100 then decide (i - 84 ∈ factors P 2 1) else
  if i < 103 then decide (14 + (i - 100) ∈ S) else false

lemma packed_choose (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (g j : Nat) (hg : g < 3) (hj : j < 3) :
    choose (packed q P S) g j = choose q g j := by
  have h : 1 + 3 * g + j < 10 := by omega
  simp only [choose, packed, h, ↓reduceIte]

lemma packed_selected (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (j s k : Nat) (hj : j < 3) (hs : s < 2) (hk : k < 14 + j) :
    selected (packed q P S) j s k = decide (k ∈ factors P j s) := by
  interval_cases j <;> interval_cases s <;>
    dsimp [selected, packed] <;> split_ifs <;> simp_all <;> omega

lemma packed_outputSelected (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (j : Nat) (hj : j < 3) :
    outputSelected (packed q P S) j = decide (14 + j ∈ S) := by
  unfold outputSelected packed
  split_ifs <;> first | omega | simp_all

lemma packed_freePair (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (r g : Nat) (hg : g < 3) :
    freePair (packed q P S) r g = freePair q r g := by
  interval_cases g <;> rfl

lemma packed_base (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (r k : Nat) : base (packed q P S) r k = base q r k := by
  unfold base
  split_ifs
  · rfl
  · apply packed_freePair
    omega
  all_goals rfl

lemma term_range (A : Finset Nat) (w : List Bool) (m : Nat)
    (hA : ∀ k ∈ A, k < m) :
    term A w = (List.range m).all (fun k => !decide (k ∈ A) || w.getD k false) := by
  apply Bool.eq_iff_iff.mpr
  simp only [term, decide_eq_true_eq, List.all_eq_true, List.mem_range, Bool.or_eq_true]
  constructor
  · intro h k hk
    by_cases hka : k ∈ A
    · exact Or.inr (h k hka)
    · exact Or.inl (by simp [hka])
  · intro h k hk
    exact (h k (hA k hk)).resolve_left (fun hn => by simp [hk] at hn)

lemma packed_terms (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (j s : Nat) (hj : j < 3) (hs : s < 2) (w : List Bool)
    (hA : ∀ k ∈ factors P j s, k < 14 + j) :
    terms (packed q P S) j s (fun k => w.getD k false) = term (factors P j s) w := by
  rw [term_range _ _ _ hA]
  have hm : (List.range (14 + j)).map
      (fun k => !selected (packed q P S) j s k || w.getD k false) =
      (List.range (14 + j)).map (fun k => !decide (k ∈ factors P j s) || w.getD k false) := by
    apply List.map_congr_left
    intro k hk
    rw [packed_selected q P S j s k hj hs (List.mem_range.mp hk)]
  simpa [terms] using congrArg (fun l : List Bool => l.all id) hm

lemma factors_bound (P : Program) (hP : WellFormed 14 P) (j s : Nat)
    (hj : j < P.length) : ∀ k ∈ factors P j s, k < 14 + j := by
  intro k hk
  apply hP j hj k
  unfold factors at hk
  split_ifs at hk
  · exact Finset.mem_union_left _ hk
  · exact Finset.mem_union_right _ hk

lemma wire_gate_any (p : Nat → Bool) (r j : Nat) (hj : j < 3) :
    wire p r (14 + j) = (terms p j 0 (wire p r) || terms p j 1 (wire p r)) := by
  interval_cases j
  · exact wire_gate0 p r
  · exact wire_gate1 p r
  · exact wire_gate2 p r

lemma packed_wire (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (hP : WellFormed 14 P) (hlen : P.length = 3) (r k : Nat) (hk : k < 17) :
    (nfEval P (List.ofFn fun i : Fin 14 => base q r i)).getD k false =
      wire (packed q P S) r k := by
  let input := List.ofFn fun i : Fin 14 => base q r i
  let w := nfEval P input
  let f : Nat → Bool := fun k => w.getD k false
  have hbase : ∀ i, i < 14 → f i = base (packed q P S) r i := by
    intro i hi
    dsimp [f, w, input]
    rw [nfEval_getD_lt P _ i (by simpa using hi)]
    rw [packed_base]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, hi,
      ↓reduceDIte, Option.getD_some]
  have hgate : ∀ j, j < 3 →
      f (14 + j) = (terms (packed q P S) j 0 f || terms (packed q P S) j 1 f) := by
    intro j hj
    have hjP : j < P.length := by omega
    have he := nfEval_gate_full P input (by simp [input]) hP j hjP
    change w.getD (14 + j) false = (terms (packed q P S) j 0 (fun k => w.getD k false) ||
      terms (packed q P S) j 1 (fun k => w.getD k false))
    rw [packed_terms q P S j 0 hj (by decide) w (factors_bound P hP j 0 hjP),
      packed_terms q P S j 1 hj (by decide) w (factors_bound P hP j 1 hjP)]
    simpa [factors, w] using he
  have hwire : ∀ i, i < 17 → f i = wire (packed q P S) r i := by
    intro i
    induction i using Nat.strong_induction_on with
    | ind i ih =>
      intro hi
      by_cases hib : i < 14
      · exact (hbase i hib).trans (wire_base (packed q P S) r i hib).symm
      · have hj : i - 14 < 3 := by omega
        have he : i = 14 + (i - 14) := by omega
        rw [he, hgate _ hj, wire_gate_any _ r _ hj]
        apply congrArg₂ Bool.or
        · apply terms_congr
          intro a ha
          exact ih a (by omega) (by omega)
        · apply terms_congr
          intro a ha
          exact ih a (by omega) (by omega)
  exact hwire k hk

lemma packed_correct (q : Nat → Bool) (P : Program) (S : Finset Nat)
    (hP : WellFormed 14 P) (hlen : P.length = 3)
    (hS : ∀ k ∈ S, 14 ≤ k ∧ k < 17) (r : Nat) :
    output (packed q P S) r = term S (nfEval P (List.ofFn fun i : Fin 14 => base q r i)) := by
  apply Bool.eq_iff_iff.mpr
  simp only [output, List.all_eq_true, List.mem_range, term, decide_eq_true_eq]
  constructor
  · intro h k hk
    have hkB := hS k hk
    have hj : k - 14 < 3 := by omega
    have he : 14 + (k - 14) = k := by omega
    have hv := h (k - 14) hj
    rw [packed_outputSelected q P S _ hj, he] at hv
    simp only [hk, decide_true, Bool.not_true, Bool.false_or] at hv
    rw [packed_wire q P S hP hlen r k hkB.2]
    exact hv
  · intro h j hj
    rw [packed_outputSelected q P S j hj]
    by_cases hm : 14 + j ∈ S
    · have hv := h (14 + j) hm
      rw [packed_wire q P S hP hlen r (14 + j) (by omega)] at hv
      simp [hm, hv]
    · simp [hm]

end FreeAndPack
namespace GadgetBridge
open FreeAndNormalize FreeAndPack C6.DagTools

lemma base_misses (q : Nat → Bool) (k : Nat) (hk : k < 14) :
    ∃ r < 128, target r = true ∧ base q r k = false := by
  interval_cases k
  · exact ⟨6, by decide, by decide, by rfl⟩
  · exact ⟨12, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · refine ⟨6, by decide, by decide, ?_⟩
    simp [base, freePair, choose, Nat.testBit]
  · refine ⟨3, by decide, by decide, ?_⟩
    simp [base, freePair, choose, Nat.testBit]
  · refine ⟨3, by decide, by decide, ?_⟩
    simp [base, freePair, choose, Nat.testBit]
  · exact ⟨6, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩
  · exact ⟨3, by decide, by decide, by rfl⟩

lemma packed_choiceOK (q : Nat → Bool) (hq : ChoiceOK q)
    (P : Program) (S : Finset Nat) : ChoiceOK (packed q P S) := by
  intro g hg
  simpa only [packed_choose q P S g 0 hg (by decide),
    packed_choose q P S g 1 hg (by decide), packed_choose q P S g 2 hg (by decide)]
    using hq g hg

lemma residual_or_lower_bound (q : Nat → Bool) (hq : ChoiceOK q)
    (D : Dag) (hD : Strict 14 D) (out : Nat) (hout : out < 14 + D.length)
    (hcompute : ∀ r < 128, val D (fun i : Fin 14 => base q r i) out = target r) :
    4 ≤ (D.filter fun g => !g.1).length := by
  by_contra hn
  have hcount : (D.filter fun g => !g.1).length ≤ 3 := by omega
  obtain ⟨P,S,hP,hlen,hS,heval⟩ := exists_three_or_normal_form D hD hcount out hout
  have hS' : ∀ k ∈ S, 14 ≤ k ∧ k < 17 := by
    intro k hk
    refine ⟨?_, hS k hk⟩
    by_contra hsmall
    have hsmall : k < 14 := by omega
    obtain ⟨r,hr,hpos,hfalse⟩ := base_misses q k hsmall
    have ht : term S (nfEval P (List.ofFn fun i : Fin 14 => base q r i)) = true :=
      (heval _).trans ((hcompute r hr).trans hpos)
    have hh : ∀ i ∈ S, (nfEval P (List.ofFn fun a : Fin 14 => base q r a)).getD i false = true :=
      of_decide_eq_true ht
    have hv := hh k hk
    rw [nfEval_getD_lt P _ k (by simpa using hsmall)] at hv
    simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, hsmall,
      ↓reduceDIte, Option.getD_some] at hv
    rw [hfalse] at hv
    contradiction
  apply no_three_or (packed q P S) (packed_choiceOK q hq P S)
  intro r hr
  rw [packed_correct q P S hP hlen hS' r, heval]
  exact hcompute r hr

end GadgetBridge

