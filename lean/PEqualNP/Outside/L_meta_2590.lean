def target (r : ℕ) : Bool :=
  ([(0,1),(0,5),(1,2),(2,3),(1,6),(6,4)] : List (ℕ × ℕ)).any fun e => r.testBit e.1 && r.testBit e.2

def ChoiceOK (p : ℕ → Bool) : Prop := ∀ g < 3,
  (choose p g 0 || choose p g 1 || choose p g 2) = true ∧
  (!choose p g 0 || !choose p g 1) = true ∧
  (!choose p g 0 || !choose p g 2) = true ∧
  (!choose p g 1 || !choose p g 2) = true

def Computes (p : ℕ → Bool) : Prop := ∀ r < 128, output p r = target r

lemma output_nonempty (p : ℕ → Bool) (h : Computes p) :
    (p 100 || p 101 || p 102) = true := by
  have hh := h 0 (by decide)
  cases h0 : p 100 <;> cases h1 : p 101 <;> cases h2 : p 102 <;>
    simp [output, outputSelected, List.range_succ, target, h0, h1, h2] at hh ⊢

