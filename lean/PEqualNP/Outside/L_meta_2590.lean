lemma extras_sat (p : ℕ → Bool) (hc : ChoiceOK p) (hf : Computes p) :
    ∀ c ∈ extras, CSat (assignment p) c := by
  intro c hm
  simp only [extras, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 0 (by decide)).1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 0 (by decide)).2.1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 0 (by decide)).2.2.1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 0 (by decide)).2.2.2
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 1 (by decide)).1
  · simpa [CSat, value, choose, Bool.or_eq_true, or_assoc] using (hc 1 (by decide)).2.1
