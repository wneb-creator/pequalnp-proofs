lemma groups_extra : ∀ g ∈ groups, g.2.2 ∈ extras := by decide +kernel

def formula : List (List Lit) := extras.take 13 ++ groups.flatMap fun g =>
  ((nodes.filter fun n => g.1 ≤ n.1 && n.1 ≤ g.2.1).flatMap nodeClauses) ++ [g.2.2]

lemma formula_sat (p : ℕ → Bool) (hc : ChoiceOK p) (hf : Computes p) :
    ∀ c ∈ formula, CSat (assignment p) c := by
  intro c hm
  rcases List.mem_append.mp hm with hm | hm
  · exact extras_sat p hc hf c (List.mem_of_mem_take hm)
  · obtain ⟨g,hg,hm⟩ := List.mem_flatMap.mp hm
    rcases List.mem_append.mp hm with hm | hm
    · obtain ⟨n,hn,hm⟩ := List.mem_flatMap.mp hm
      exact nodeClauses_sat p n (List.mem_filter.mp hn).1 c hm
    · have he : c = g.2.2 := by simpa using hm
      subst c
      exact extras_sat p hc hf _ (groups_extra g hg)

