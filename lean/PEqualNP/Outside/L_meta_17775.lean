import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_17775

private abbrev V := Fin 21

private def points (m : ℕ) : Finset V :=
  Finset.univ.filter fun v => (BitVec.ofNat 21 m).getLsbD v.val

private def key (m : ℕ) : ℕ :=
  let w := BitVec.ofNat 21 m
  ((w.rotateLeft (20 : V).val) ||| ((w.rotateLeft (0 : V).val) ||| ((w.rotateLeft (5 : V).val) |||
    ((w.rotateLeft (7 : V).val) ||| (w.rotateLeft (17 : V).val))))).toNat

set_option maxRecDepth 10000 in
private theorem subVal : ∀ v d : V, (v - d).val =
    if v.val < d.val then 21 - d.val + v.val else v.val - d.val := by decide +kernel

private theorem rotated (m : ℕ) (v d : V) :
    ((BitVec.ofNat 21 m).rotateLeft d.val).getLsbD v.val = true ↔
    ∃ a ∈ points m, a + d = v := by
  have he : ((BitVec.ofNat 21 m).rotateLeft d.val).getLsbD v.val =
      (BitVec.ofNat 21 m).getLsbD (v - d).val := by
    rw [BitVec.getLsbD_rotateLeft, Nat.mod_eq_of_lt d.isLt, subVal]
    by_cases h : v.val < d.val <;> simp [h, v.isLt]
  rw [he]
  constructor
  · intro h
    exact ⟨v - d, by simpa [points] using h, sub_add_cancel v d⟩
  · rintro ⟨a, ha, rfl⟩
    simpa [points] using ha

private theorem keyBit (m : ℕ) (v : V) : (key m).testBit v.val = true ↔
    ∃ a ∈ points m, ∃ k : Fin 5, a + (![20,0,5,7,17] : Fin 5 → V) k = v := by
  simp only [key, BitVec.testBit_toNat, BitVec.getLsbD_or, Bool.or_eq_true,
    rotated m v (20 : V), rotated m v (0 : V), rotated m v (5 : V),
    rotated m v (7 : V), rotated m v (17 : V)]
  constructor
  · rintro (⟨a,ha,h⟩ | ⟨a,ha,h⟩ | ⟨a,ha,h⟩ | ⟨a,ha,h⟩ | ⟨a,ha,h⟩)
    · exact ⟨a,ha,0,h⟩
    · exact ⟨a,ha,1,h⟩
    · exact ⟨a,ha,2,h⟩
    · exact ⟨a,ha,3,h⟩
    · exact ⟨a,ha,4,h⟩
  · rintro ⟨a,ha,k,h⟩
    fin_cases k
    · exact Or.inl ⟨a,ha,h⟩
    · exact Or.inr (Or.inl ⟨a,ha,h⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨a,ha,h⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨a,ha,h⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨a,ha,h⟩)))

private theorem keyEq (m n : ℕ)
    (h : (fun v : V => ∃ a ∈ points m, ∃ k : Fin 5, a + (![20,0,5,7,17] : Fin 5 → V) k = v) =
         (fun v : V => ∃ a ∈ points n, ∃ k : Fin 5, a + (![20,0,5,7,17] : Fin 5 → V) k = v)) :
    key m = key n := by
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 21
  · let v : V := ⟨i,hi⟩
    change (key m).testBit v.val = (key n).testBit v.val
    apply Bool.eq_iff_iff.mpr
    rw [keyBit, keyBit]
    exact Iff.of_eq (congrFun h v)
  · have hpow : 2^21 ≤ 2^i := Nat.pow_le_pow_right (by decide) (by omega)
    have hlt (r : ℕ) : key r < 2^21 := BitVec.isLt _
    rw [Nat.testBit_eq_false_of_lt ((hlt m).trans_le hpow), Nat.testBit_eq_false_of_lt ((hlt n).trans_le hpow)]

