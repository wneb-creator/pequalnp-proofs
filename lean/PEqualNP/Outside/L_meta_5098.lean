import Mathlib.Data.List.Perm.Subperm
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_5098

open PEqualNP.CircuitLowerBounds

abbrev S (n : Nat) := BitVec n × BitVec n

def zero {n} : S n := (0,0)
def sep {n} (a : S n) := a.1 ^^^ a.2
def cover {n} : List (S n) → BitVec n
  | [] => 0
  | a :: l => sep a ||| cover l

def mix {n} (i : Fin 4) (a b : S n) : S n :=
  if i = 0 then (a.1 &&& b.1, a.2 &&& b.2)
  else if i = 1 then (a.1 &&& ~~~b.1, a.2 &&& ~~~b.2)
  else if i = 2 then (~~~a.1 &&& b.1, ~~~a.2 &&& b.2)
  else (a.1 ||| b.1, a.2 ||| b.2)

def picks {α : Type} : List α → List (α × List α)
  | [] => []
  | a :: l => (a,l) :: (picks l).map (fun p => (p.1,a::p.2))

lemma picks_of_perm {α : Type} {a : α} {l r : List α} (h : l.Perm (a :: r)) :
    ∃ t, (a,t) ∈ picks l ∧ t.Perm r := by
  induction l generalizing r with
  | nil => have := h.length_eq; simp at this
  | cons b l ih =>
    by_cases eq : a = b
    · subst b
      exact ⟨l, by simp [picks], List.Perm.cons_inv h⟩
    · have hm := h.mem_iff.mpr List.mem_cons_self
      have ha : a ∈ l := (List.mem_cons.mp hm).resolve_left eq
      obtain ⟨u,v,hl⟩ := List.append_of_mem ha
      have hp : l.Perm (a :: (u ++ v)) := hl ▸ List.perm_middle
      obtain ⟨t,ht,hr⟩ := ih hp
      refine ⟨b :: t, ?_, ?_⟩
      · simp only [picks, List.mem_cons, List.mem_map]
        exact Or.inr ⟨(a,t),ht,rfl⟩
      · have h₁ : l.Perm (a :: t) := hp.trans (hr.symm.cons a)
        exact List.Perm.cons_inv (((h₁.cons b).trans (List.Perm.swap _ _ _)).symm.trans h)

def key {n} (s : S n) := s.1.toNat * 2^n + s.2.toNat

def tryMix {n} (next : List (S n) → Bool) (a b : S n) (rest : List (S n)) : Bool :=
  decide (key a ≤ key b) &&
  [0,1,2,3].any (fun i : Fin 4 =>
    let t := mix i a b
    t != zero && t != a && t != b && next (t :: rest))

def search {n} : Nat → Nat → List (S n) → Bool
  | 0, _, w => w.any (fun s => sep s == BitVec.allOnes n)
  | d+1, k, w =>
    cover w == BitVec.allOnes n &&
    (w.any (fun s => sep s == BitVec.allOnes n) ||
    (0 < k && w.any (fun a => search d (k-1) (a :: w))) ||
    (picks w).any (fun p => (picks p.2).any
      (fun q => tryMix (search d k) p.1 q.1 q.2)))

def Blind {n} (w : List (S n)) := ∃ j : Fin n, ∀ a ∈ w, a.1[j.val] = a.2[j.val]

lemma cover_bit {n} (w : List (S n)) (j : Fin n) :
    (cover w)[j.val] = true ↔ ∃ a ∈ w, a.1[j.val] ≠ a.2[j.val] := by
  induction w with
  | nil => simp [cover]
  | cons a l ih =>
    simp only [cover, BitVec.getElem_or, Bool.or_eq_true, ih, sep, BitVec.getElem_xor,
      List.mem_cons, exists_eq_or_imp]
    cases a.1[j.val] <;> cases a.2[j.val] <;> simp

lemma blind_of_cover {n} {w : List (S n)} (h : cover w ≠ BitVec.allOnes n) : Blind w := by
  by_contra! hn
  apply h
  apply BitVec.eq_of_getElem_eq
  intro i hi
  rw [BitVec.getElem_allOnes]
  apply (cover_bit _ ⟨i,hi⟩).2
  by_contra! e
  exact hn ⟨⟨i,hi⟩,e⟩

lemma mix_bit {n} (i : Fin 4) (a b : S n) (j : Fin n)
    (ha : a.1[j.val] = a.2[j.val]) (hb : b.1[j.val] = b.2[j.val]) :
    (mix i a b).1[j.val] = (mix i a b).2[j.val] := by
  unfold mix
  split_ifs <;> simp only [BitVec.getElem_and, BitVec.getElem_or, BitVec.getElem_not, ha,hb]

def Dead {n} (k : Nat) (w : List (S n)) : Prop :=
  Blind w ∨ ∃ z e, z.Perm (w ++ e) ∧ search (z.length + 2*k) k z = false

lemma dead_search {n} {w : List (S n)} {k : Nat}
    (h : search (w.length+2*k) k w = false) : Dead k w :=
  Or.inr ⟨w,[],by simp,h⟩

lemma dead_weaken {n k} {w v : List (S n)} (hp : w.Subperm v) (h : Dead k v) : Dead k w := by
  rcases h with ⟨j,hj⟩ | ⟨z,e,hz,hs⟩
  · exact Or.inl ⟨j,fun a ha => hj a (hp.subset ha)⟩
  · obtain ⟨t,ht,hsub⟩ := List.subperm_iff.mp hp
    obtain ⟨u,hu⟩ := hsub.exists_perm_append
    refine Or.inr ⟨z,u++e,?_,hs⟩
    simpa [List.append_assoc] using hz.trans ((ht.symm.trans hu).append_right e)

lemma dead_consume {n k} {a : S n} {w : List (S n)} (h : Dead (k+1) (a::w)) :
    Dead k (a::a::w) := by
  rcases h with ⟨j,hj⟩ | ⟨z,e,hz,hs⟩
  · exact Or.inl ⟨j,by simpa using hj⟩
  · by_cases hc : cover z = BitVec.allOnes n
    · have ha := hz.mem_iff.mpr (List.mem_cons_self (a := a) (l := w++e))
      have he : z.length + 2*(k+1) = (a::z).length + 2*k + 1 := by simp; omega
      rw [he,search] at hs
      simp only [hc, beq_self_eq_true, Bool.true_and, Bool.or_eq_false_iff,
        decide_true, Nat.zero_lt_succ, Nat.add_sub_cancel] at hs
      have hn := List.any_eq_false.mp hs.1.2 a ha
      exact Or.inr ⟨a::z,e,hz.cons a,by simpa using hn⟩
    · rcases blind_of_cover hc with ⟨j,hj⟩
      left
      refine ⟨j,fun t ht => hj t (hz.mem_iff.mpr ?_)⟩
      simp at ht ⊢
      tauto

lemma dead_mix_ordered {n k} {a b : S n} {w : List (S n)} (i : Fin 4) (ord : key a ≤ key b)
    (h : Dead k (a::b::w)) (hzero : mix i a b ≠ zero) :
    Dead k (mix i a b :: w) := by
  by_cases ea : mix i a b = a
  · rw [ea]
    exact dead_weaken ((List.sublist_cons_self b w).cons_cons a |>.subperm) h
  by_cases eb : mix i a b = b
  · rw [eb]
    exact dead_weaken List.subperm_cons_self h
  have blind (hb : Blind (a::b::w)) : Blind (mix i a b :: w) := by
    obtain ⟨j,hj⟩ := hb
    refine ⟨j,?_⟩
    simp only [List.forall_mem_cons] at hj ⊢
    exact ⟨mix_bit i a b j hj.1 hj.2.1,hj.2.2⟩
  rcases h with hb | ⟨z,e,hz,hs⟩
  · exact Or.inl (blind hb)
  · by_cases hc : cover z = BitVec.allOnes n
    · obtain ⟨r,hr,pr⟩ := picks_of_perm hz
      obtain ⟨s,ht,pt⟩ := picks_of_perm pr
      have hl := hz.length_eq
      have hl' := pt.length_eq
      have he : z.length + 2*k = (mix i a b :: s).length + 2*k + 1 := by
        simp at hl hl' ⊢; omega
      rw [he,search] at hs
      simp only [hc, beq_self_eq_true, Bool.true_and, Bool.or_eq_false_iff] at hs
      have h₁ := List.any_eq_false.mp hs.2 _ hr
      have h₂ := List.any_eq_false.mp (Bool.eq_false_iff.mpr h₁) _ ht
      have hi := (by decide : ∀ j : Fin 4, j ∈ ([0,1,2,3] : List (Fin 4))) i
      simp only [tryMix,ord,decide_true,Bool.true_and] at h₂
      have h₃ := List.any_eq_false.mp (Bool.eq_false_iff.mpr h₂) i hi
      simp [hzero,ea,eb] at h₃
      exact Or.inr ⟨_,e,pt.cons _,h₃⟩
    · rcases blind_of_cover hc with ⟨j,hj⟩
      exact Or.inl (blind ⟨j,fun t ht => hj t (hz.mem_iff.mpr (List.mem_append_left _ ht))⟩)

lemma mix_swap {n} (a b : S n) (i : Fin 4) : ∃ j, mix i a b = mix j b a := by
  have one (h : i = 0) : ∃ j, mix i a b = mix j b a := ⟨0,by simp [h,mix,BitVec.and_comm]⟩
  have two (h : i = 1) : ∃ j, mix i a b = mix j b a := ⟨2,by simp [h,mix,BitVec.and_comm]⟩
  have three (h : i = 2) : ∃ j, mix i a b = mix j b a := ⟨1,by simp [h,mix,BitVec.and_comm]⟩
  have four (h : i = 3) : ∃ j, mix i a b = mix j b a := ⟨3,by simp [h,mix,BitVec.or_comm]⟩
  have hs := (by decide : ∀ j : Fin 4, j=0 ∨ j=1 ∨ j=2 ∨ j=3) i
  rcases hs with h|h|h|h <;> solve | exact one h | exact two h | exact three h | exact four h

lemma dead_mix {n k} {a b : S n} {w : List (S n)} (i : Fin 4)
    (h : Dead k (a::b::w)) (hzero : mix i a b ≠ zero) :
    Dead k (mix i a b :: w) := by
  rcases le_total (key a) (key b) with h₁|h₂
  · exact dead_mix_ordered i h₁ h hzero
  · obtain ⟨j,e⟩ := mix_swap a b i
    rw [e] at hzero ⊢
    exact dead_mix_ordered j h₂ (dead_weaken (List.Perm.swap _ _ _).subperm h) hzero

def token {n} (a : S n) : List (S n) := if a = zero then [] else [a]

lemma dead_token_mix {n k} {a b : S n} {w : List (S n)} (i : Fin 4)
    (h : Dead k (token a ++ token b ++ w)) : Dead k (token (mix i a b) ++ w) := by
  by_cases ea : a = zero
  · subst a
    have e : mix i zero b = zero ∨ mix i zero b = b := by
      unfold mix zero
      split_ifs <;> simp
    rcases e with e | e
    · rw [e]
      exact dead_weaken (by simpa [token] using (List.suffix_append (token b) w).sublist.subperm) h
    · simpa [e,token] using h
  by_cases eb : b = zero
  · subst b
    have e : mix i a zero = zero ∨ mix i a zero = a := by
      unfold mix zero
      split_ifs <;> simp
    rcases e with e | e
    · rw [e]
      exact dead_weaken (by simpa [token] using (List.suffix_append (token a) w).sublist.subperm) h
    · simpa [e,token] using h
  simp only [token,if_neg ea,if_neg eb,List.singleton_append] at h
  by_cases ec : mix i a b = zero
  · simpa [token,ec] using dead_weaken
      (List.subperm_cons_self.trans (List.subperm_cons_self (a := a) (l := b::w))) h
  · simpa [token,ec] using dead_mix i h ec

lemma dead_nohit {n k} {a : S n} {w : List (S n)} (h : Dead k (a::w)) :
    sep a ≠ BitVec.allOnes n := by
  intro hit
  have f (hb : Blind (a::w)) : False := by
    obtain ⟨j,hj⟩ := hb
    have he := congrArg (fun s : BitVec n => s[j.val]) hit
    simp [sep,hj a (by simp)] at he
  rcases h with hb | ⟨z,e,hz,hs⟩
  · exact f hb
  · have ha : a ∈ z := hz.mem_iff.mpr (by simp)
    have hl := hz.length_eq
    cases hd : z.length + 2*k with
    | zero => simp at hl; omega
    | succ d =>
      rw [hd,search] at hs
      by_cases hc : cover z = BitVec.allOnes n
      · simp only [hc,beq_self_eq_true,Bool.true_and,Bool.or_eq_false_iff] at hs
        exact (List.any_eq_false.mp hs.1.1 a ha) (by simpa using hit)
      · obtain ⟨j,hj⟩ := blind_of_cover hc
        exact f ⟨j,fun s hm => hj s (hz.mem_iff.mpr (List.mem_append_left _ hm))⟩

abbrev V (n : Nat) := Bool × S n
def low {n} : V n := (false,zero)
def flip {n} (a : V n) : V n := (!a.1,a.2)
def combine {n} (isOr : Bool) (a b : V n) : V n :=
  let p := xor a.1 isOr
  let q := xor b.1 isOr
  let i : Fin 4 := if p then (if q then 3 else 2) else (if q then 1 else 0)
  (xor (p && q) isOr,mix i a.2 b.2)

def readBit {n} (side : Bool) (j : Fin n) (v : V n) : Bool :=
  xor v.1 (if side then v.2.1[j.val] else v.2.2[j.val])

lemma read_low {n} (side : Bool) (j : Fin n) : readBit side j low = false := by
  cases side <;> simp [readBit,low,zero]

lemma read_flip {n} (side : Bool) (j : Fin n) (v : V n) :
    readBit side j (flip v) = !(readBit side j v) := by
  unfold readBit flip
  cases v.1 <;> simp

set_option maxHeartbeats 1500000 in
lemma read_combine {n} (side o : Bool) (j : Fin n) (a b : V n) :
    readBit side j (combine o a b) =
      (if o then readBit side j a || readBit side j b else readBit side j a && readBit side j b) := by
  rcases a with ⟨p,a⟩
  rcases b with ⟨q,b⟩
  cases side <;> cases o <;> cases p <;> cases q
  · change xor false ((a.2 &&& b.2)[j.val]) = (xor false a.2[j.val] && xor false b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor false ((a.2 &&& ~~~b.2)[j.val]) = (xor false a.2[j.val] && xor true b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor false ((~~~a.2 &&& b.2)[j.val]) = (xor true a.2[j.val] && xor false b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor true ((a.2 ||| b.2)[j.val]) = (xor true a.2[j.val] && xor true b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor false ((a.2 ||| b.2)[j.val]) = (xor false a.2[j.val] || xor false b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor true ((~~~a.2 &&& b.2)[j.val]) = (xor false a.2[j.val] || xor true b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor true ((a.2 &&& ~~~b.2)[j.val]) = (xor true a.2[j.val] || xor false b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor true ((a.2 &&& b.2)[j.val]) = (xor true a.2[j.val] || xor true b.2[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.2[j.val] <;> cases b.2[j.val] <;> rfl
  · change xor false ((a.1 &&& b.1)[j.val]) = (xor false a.1[j.val] && xor false b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor false ((a.1 &&& ~~~b.1)[j.val]) = (xor false a.1[j.val] && xor true b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor false ((~~~a.1 &&& b.1)[j.val]) = (xor true a.1[j.val] && xor false b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor true ((a.1 ||| b.1)[j.val]) = (xor true a.1[j.val] && xor true b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor false ((a.1 ||| b.1)[j.val]) = (xor false a.1[j.val] || xor false b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor true ((~~~a.1 &&& b.1)[j.val]) = (xor false a.1[j.val] || xor true b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor true ((a.1 &&& ~~~b.1)[j.val]) = (xor true a.1[j.val] || xor false b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl
  · change xor true ((a.1 &&& b.1)[j.val]) = (xor true a.1[j.val] || xor true b.1[j.val])
    simp only [BitVec.getElem_and,BitVec.getElem_or,BitVec.getElem_not]
    cases a.1[j.val] <;> cases b.1[j.val] <;> rfl

def gateVal {n} (g : Gate) (W : List (V n)) : V n :=
  match g.inputs with
  | [] => (g.op.eval [],zero)
  | u :: us =>
    let a := W.getD u low
    match g.op, us with
    | .not, _ => flip a
    | .and, v :: _ => combine false a (W.getD v low)
    | .or, v :: _ => combine true a (W.getD v low)
    | _, _ => a

def Good (g : Gate) : Prop :=
  (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2

lemma read_lookup {n} (side : Bool) (j : Fin n) (W : List (V n)) (u : Nat) :
    readBit side j (W.getD u low) = (W.map (readBit side j)).getD u false := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
  cases W[u]? <;> simp [read_low]

lemma read_gate {n} (side : Bool) (j : Fin n) (g : Gate) (W : List (V n)) (hg : Good g) :
    readBit side j (gateVal g W) =
      g.op.eval (g.inputs.map fun u => (W.map (readBit side j)).getD u false) := by
  obtain ⟨op,ins⟩ := g
  rcases hg with ⟨ops,hlen⟩
  change op = _ ∨ op = _ ∨ op = _ at ops
  change ins.length ≤ 2 at hlen
  rcases ops with rfl | rfl | rfl <;> cases ins with
  | nil => cases side <;> simp [gateVal,readBit,zero,GateOp.eval]
  | cons u us =>
    cases us with
    | nil => simp [gateVal,read_flip,read_lookup,GateOp.eval, -List.getD_eq_getElem?_getD]
    | cons v vs =>
      cases vs with
      | nil => simp [gateVal,read_flip,read_combine,read_lookup,GateOp.eval, -List.getD_eq_getElem?_getD]
      | cons t ts => simp at hlen

def run {n} (gs : List Gate) (W : List (V n)) :=
  gs.foldl (fun A g => A ++ [gateVal g A]) W

lemma read_run {n} (side : Bool) (j : Fin n) (gs : List Gate) (W : List (V n))
    (hg : ∀ g ∈ gs, Good g) : (run gs W).map (readBit side j) =
    gs.foldl (fun A (g : Gate) => A ++ [g.op.eval (g.inputs.map fun u => A.getD u false)])
      (W.map (readBit side j)) := by
  induction gs generalizing W with
  | nil => rfl
  | cons g gs ih =>
    rw [show run (g::gs) W = run gs (W ++ [gateVal g W]) from rfl,ih _ (by simpa using (List.forall_mem_cons.mp hg).2)]
    simp [read_gate _ _ _ _ (hg g (by simp))]

lemma dead_lower {n k K} {w : List (S n)} (hk : k ≤ K) (h : Dead K w) : Dead k w := by
  induction hk with
  | refl => exact h
  | step hle ih =>
    apply ih
    cases w with
    | nil =>
      apply dead_search
      cases (0 + 2 * _) <;> simp [search,picks]
    | cons a w => exact dead_weaken List.subperm_cons_self (dead_consume h)

def copies {n} (r : Nat) (s : S n) : List (S n) := (List.replicate r s).flatMap token

lemma copies_zero {n} (r : Nat) : copies r (zero : S n) = [] := by
  induction r with
  | zero => rfl
  | succ r ih => simpa [copies,List.replicate_succ,token] using ih

lemma grow {n} (a : S n) (w : List (S n)) (r k : Nat) :
    Dead (k+(r-1)) (token a ++ w) → Dead k (copies r a ++ w) := by
  by_cases e : a = zero
  · subst a
    intro h
    simpa [copies_zero,token] using dead_lower (Nat.le_add_right k (r-1)) h
  simp only [token,if_neg e,List.singleton_append]
  induction r generalizing k with
  | zero => intro h; exact dead_weaken List.subperm_cons_self h
  | succ r ih =>
    cases r with
    | zero => simp [copies,token,e]
    | succ r =>
      intro h
      have hp := ih (k+1) (by convert h using 1 <;> omega)
      simp [copies,List.replicate_succ,token,e] at hp ⊢
      exact dead_consume hp

def need {n} (W : List (V n)) (R : List Nat) : List (S n) :=
  R.flatMap (fun u => token (W.getD u low).2)

lemma get_birth {α : Type} (W : List α) (a d : α) (u : Nat) :
    (W++[a]).getD u d = if u = W.length then a else W.getD u d := by
  simp only [List.getD_eq_getElem?_getD]
  by_cases hl : u < W.length
  · rw [List.getElem?_append_left hl,if_neg (by omega)]
  · rw [List.getElem?_append_right (by omega),List.getElem?_eq_none (by omega : W.length ≤ u)]
    by_cases he : u = W.length
    · simp [he]
    · have hs : u-W.length ≥ 1 := by omega
      rw [List.getElem?_eq_none (by simpa using hs)]
      simp [he]

lemma need_birth {n} (W : List (V n)) (a : V n) (R : List Nat) :
    (need (W++[a]) R).Perm (copies (R.count W.length) a.2 ++ need W R) := by
  induction R with
  | nil => simp [need,copies]
  | cons u R ih =>
    change (token ((W++[a]).getD u low).2 ++ need (W++[a]) R).Perm _
    rw [get_birth]
    by_cases e : u = W.length
    · subst u
      have eg : W.getD W.length low = low := by simp
      simpa [need,List.count_cons_self,copies,List.replicate_succ,eg,low,token,List.append_assoc]
        using ih.append_left (token a.2)
    · apply List.perm_iff_count.mpr
      intro v
      have hc := ih.count_eq v
      simp [need] at hc
      simp [e,need,List.count_cons,Ne.symm e,hc,List.count_append]
      omega

lemma gate_dead {n k} (W : List (V n)) (w : List (S n)) (g : Gate) (hg : Good g) :
    Dead k (need W g.inputs ++ w) → Dead k (token (gateVal g W).2 ++ w) := by
  obtain ⟨op,ins⟩ := g
  obtain ⟨ops,hlen⟩ := hg
  change op = _ ∨ op = _ ∨ op = _ at ops
  change ins.length ≤ 2 at hlen
  rcases ops with rfl | rfl | rfl <;> cases ins with
  | nil => simp [gateVal,need,token]
  | cons u us =>
    cases us with
    | nil => simp [gateVal,need,flip]
    | cons v vs =>
      cases vs with
      | nil =>
        first
        | intro h
          apply dead_token_mix
          simpa [need,List.append_assoc] using h
        | intro h
          apply dead_weaken _ h
          apply List.subperm_iff_count.mpr
          intro t
          simp [need,gateVal,flip]
      | cons z zs => simp at hlen

def fees (fee : Nat → Nat) (j : Nat) : Nat → Nat
  | 0 => 0
  | l+1 => fee j + fees fee (j+1) l

lemma fees_add (fee : Nat → Nat) (j a b : Nat) :
    fees fee j (a+b) = fees fee j a + fees fee (j+a) b := by
  induction a generalizing j with
  | zero => simp [fees]
  | succ a ih =>
    rw [Nat.succ_add,fees,fees,ih]
    simp [Nat.add_assoc,Nat.add_left_comm,Nat.add_comm]

lemma bootstrap {n} (fee : Nat → Nat) (R : List Nat) (k : Nat) (pre xs : List (V n))
    (bounds : ∀ i (hi : i < xs.length), xs[i].2 ≠ zero → R.count (pre.length+i) ≤ fee (pre.length+i)+1)
    (h : Dead (fees fee pre.length xs.length + k) (xs.flatMap (fun v => token v.2) ++ need pre R)) :
    Dead k (need (pre++xs) R) := by
  induction xs generalizing pre with
  | nil => simpa [fees] using h
  | cons a xs ih =>
    let j := pre.length
    let b := fees fee (j+1) xs.length+k
    let rest := xs.flatMap (fun v => token v.2) ++ need pre R
    have hp : Dead (b + fee j) (token a.2 ++ rest) := by
      simpa [b,j,rest,fees,List.append_assoc,Nat.add_comm,Nat.add_left_comm,Nat.add_assoc] using h
    have hdup : Dead b (copies (R.count j) a.2 ++ rest) := by
      by_cases e : a.2 = zero
      · simpa [copies_zero,token,e] using dead_lower (Nat.le_add_right b (fee j)) hp
      · apply grow
        apply dead_lower _ hp
        have := bounds 0 (by simp) (by simpa using e)
        simp [j] at this ⊢
        omega
    rw [show pre ++ a :: xs = (pre++[a])++xs by simp]
    apply ih (pre++[a])
    · intro i hi e
      simpa [Nat.add_assoc,Nat.add_left_comm,Nat.add_comm] using bounds (i+1) (by simpa) (by simpa using e)
    · simp only [List.length_append,List.length_singleton]
      apply dead_weaken _ hdup
      apply List.subperm_iff_count.mpr
      intro z
      have he := (need_birth pre a R).count_eq z
      simp [rest,j,List.count_append,he]
      omega

lemma run_dead {n} (fee : Nat → Nat) (W : List (V n)) (gs : List Gate) (out : Nat)
    (hg : ∀ g ∈ gs, Good g)
    (bound : ∀ i < gs.length, ((gs.flatMap Gate.inputs)++[out]).count (W.length+i) ≤ fee (W.length+i)+1)
    (h : Dead (fees fee W.length gs.length) (need W (gs.flatMap Gate.inputs++[out]))) :
    Dead 0 (token ((run gs W).getD out low).2) := by
  induction gs generalizing W with
  | nil => simpa [fees,run,need] using h
  | cons g gs ih =>
    let R := gs.flatMap Gate.inputs++[out]
    let a := gateVal g W
    let b := fees fee (W.length+1) gs.length
    have hp : Dead (b+fee W.length) (need W g.inputs ++ need W R) := by
      simpa [R,b,fees,need,List.append_assoc,Nat.add_comm] using h
    have h₁ := gate_dead W (need W R) g (hg _ (by simp)) hp
    have hcount : R.count W.length ≤ fee W.length + 1 := by
      have := bound 0 (by simp)
      simp [R,List.count_append] at this ⊢; omega
    have h₂ := grow a.2 (need W R) (R.count W.length) b (dead_lower (by omega) h₁)
    apply ih (W++[a]) (fun g' hm => hg g' (by simp [hm]))
    · intro i hi
      have := bound (i+1) (by simpa)
      simp [List.count_append,Nat.add_assoc,Nat.add_left_comm,Nat.add_comm] at this ⊢
      omega
    · simpa [b,R] using dead_weaken (need_birth W a R).subperm h₂

lemma read_bound (gs : List Gate) (len : gs.length = 14) (hf : ∀ g ∈ gs, Good g)
    (hn : ∀ g ∈ gs, g.op = .not → g.inputs.length ≤ 1)
    (a b : Fin gs.length) (hab : a ≠ b) (ha : (gs.get a).op = .not) (hb : (gs.get b).op = .not) :
    (gs.flatMap Gate.inputs).length ≤ 26 := by
  let L (i : Fin gs.length) := (gs.get i).inputs.length
  have one (i : Fin gs.length) :
      L i + (if i=a then 1 else 0) + (if i=b then 1 else 0) ≤ 2 := by
    by_cases ea : i = a
    · subst i
      have := hn _ (List.get_mem _ _) ha
      simp [L,hab]; omega
    by_cases eb : i = b
    · subst i
      have := hn _ (List.get_mem _ _) hb
      simp [L,ea]; omega
    simpa [L,ea,eb] using (hf _ (List.get_mem gs i)).2
  have hs := Finset.sum_le_sum (s := Finset.univ) (fun i _ => one i)
  simp [Finset.sum_add_distrib,len] at hs
  have e : (gs.flatMap Gate.inputs).length = ∑ i, L i := by
    rw [List.length_flatMap,← Fin.sum_ofFn]
    conv_lhs => arg 1; arg 2; rw [← List.ofFn_get gs]
    rw [List.map_ofFn]
    rfl
  omega

def wireFee (R : List Nat) (x i : Nat) := if i=x then 0 else R.count i - 1

lemma fees_sum (fee : Nat → Nat) (l j : Nat) :
    fees fee j l = ∑ i : Fin l, fee (j + i.val) := by
  induction l generalizing j with
  | zero => simp [fees]
  | succ l ih =>
    rw [fees,Fin.sum_univ_succ,ih]
    simp [Nat.add_left_comm,Nat.add_comm,Nat.add_assoc]

lemma budget (R : List Nat) (x : Nat) (hx : x < 24) (hl : R.length ≤ 27)
    (hall : ∀ i < 24, i ∈ R) (hdup : 2 ≤ R.count x) : fees (wireFee R x) 0 24 ≤ 2 := by
  let s := Finset.range 24
  have hx' : x ∈ s := Finset.mem_range.mpr hx
  have hsub : s ⊆ R.toFinset := fun i hi => List.mem_toFinset.mpr (hall i (Finset.mem_range.mp hi))
  have hsum : ∑ i ∈ s, R.count i ≤ R.length := by
    rw [← List.sum_toFinset_count_eq_length R]
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub (by simp)
  have hh : ∑ i ∈ s, (wireFee R x i + 1 + (if i=x then 1 else 0)) ≤ ∑ i ∈ s, R.count i := by
    apply Finset.sum_le_sum
    intro i hi
    have pos := List.count_pos_iff.mpr (hall i (Finset.mem_range.mp hi))
    by_cases e : i=x
    · subst i; simpa [wireFee] using hdup
    · simp only [wireFee,if_neg e,Nat.add_zero]; omega
  simp [Finset.sum_add_distrib,hx',s,hx] at hh
  rw [fees_sum]
  simp only [Nat.zero_add,Fin.sum_univ_eq_sum_range]
  dsimp [s] at hsum
  omega

def raw (m : Nat) := (List.ofFn fun i : Fin 9 => m.testBit i.val) ++ [m.testBit 0 || m.testBit 2]
def target (m : Nat) := [3,6,12,17,24,33,66,132,160,264,288,320].any fun e => m &&& e == e

def Valid {n} (W : List (V n)) (tests : List (Nat × Nat)) : Prop :=
  ∀ j : Fin n, let p := tests.getD j.val (0,0)
    p.1 < 512 ∧ p.2 < 512 ∧ target p.1 = true ∧ target p.2 = false ∧
    W.map (readBit true j) = raw p.1 ∧ W.map (readBit false j) = raw p.2

lemma all_separated {n} (C : Circuit) (W : List (V n)) (ts : List (Nat × Nat)) (v : Valid W ts)
    (hg : ∀ g ∈ C.gates, Good g) (ok : ∀ m < 512, C.eval (raw m) = target m) :
    sep ((run C.gates W).getD C.output low).2 = BitVec.allOnes n := by
  apply BitVec.eq_of_getElem_eq
  intro j hj
  let t : Fin n := ⟨j,hj⟩
  obtain ⟨hp,hn,yp,yn,mp,mn⟩ := v t
  have row (s : Bool) (m : Nat) (hm : W.map (readBit s t) = raw m) :
      readBit s t ((run C.gates W).getD C.output low) = C.eval (raw m) := by
    rw [read_lookup,read_run _ _ _ _ hg,hm]
    rfl
  have hp' := (row true _ mp).trans ((ok _ hp).trans yp)
  have hn' := (row false _ mn).trans ((ok _ hn).trans yn)
  generalize (run C.gates W).getD C.output low = u at hp' hn' ⊢
  rcases u with ⟨p,a,b⟩
  cases p <;> simp [readBit,t] at hp' hn' <;> simp [sep,hp',hn']

lemma need_nil {n} (R : List Nat) : need ([] : List (V n)) R = [] := by
  induction R with
  | nil => rfl
  | cons i R ih => simpa [need,low,token] using ih

lemma zero_misses {n : Nat} (hn : 0 < n) : sep (zero : S n) ≠ BitVec.allOnes n := by
  intro h
  have he := congrArg (fun s : BitVec n => s[0]'hn) h
  simpa [sep,zero] using he

set_option maxHeartbeats 600000 in
lemma exclude {n} (C : Circuit) (x : Nat) (hx : x < 10) (W : List (V n)) (ts : List (Nat × Nat))
    (nPos : 0 < n) (hlen : W.length = 10) (absent : (W.getD x low).2 = zero)
    (hv : Valid W ts) (hard : Dead 2 (W.flatMap (fun v => token v.2)))
    (hg : ∀ g ∈ C.gates, Good g) (sz : C.gates.length = 14) (out : C.output = 23)
    (len : (C.gates.flatMap Gate.inputs).length ≤ 26)
    (hall : ∀ i < 23, i ∈ C.gates.flatMap Gate.inputs)
    (ok : ∀ m < 512, C.eval (raw m) = target m) :
    (C.gates.flatMap Gate.inputs).count x ≤ 1 := by
  by_contra! hdup
  let R := C.gates.flatMap Gate.inputs ++ [C.output]
  let fee := wireFee R x
  have hc : fees fee 0 24 ≤ 2 := by
    apply budget R x (by omega) (by simp only [R,List.length_append,List.length_singleton]; omega)
    · intro i hi
      by_cases e : i=23
      · simp [R,out,e]
      · exact List.mem_append_left _ (hall _ (by omega))
    · simp [R,List.count_append]; omega
  have start := bootstrap fee R (fees fee 10 14) ([] : List (V n)) W
  have h₀ : Dead (fees fee W.length C.gates.length) (need W R) := by
    rw [hlen,sz]
    apply start
    · intro i hi en
      simp only [List.length_nil,Nat.zero_add]
      have e : i ≠ x := by
        rintro rfl
        apply en
        simpa [List.getD_eq_getElem?_getD,hi] using absent
      simp [fee,wireFee,e]
      omega
    · simp only [need_nil,List.append_nil,List.length_nil,hlen]
      apply dead_lower _ hard
      exact (fees_add fee 0 10 14) ▸ hc
  have hbad := run_dead fee W C.gates C.output hg (by
    intro i hi
    have e : W.length+i ≠ x := by omega
    change R.count _ ≤ wireFee R x _ + 1
    simp [wireFee,e]; omega) h₀
  let a := ((run C.gates W).getD C.output low).2
  have hit := all_separated C W ts hv hg ok
  change sep a = _ at hit
  have e : a ≠ zero := by
    intro he
    exact zero_misses nPos (he ▸ hit)
  change Dead 0 (token a) at hbad
  rw [token,if_neg e] at hbad
  exact dead_nohit hbad hit


def step {n} (next : Nat → List (S n) → Bool) (k : Nat) (w : List (S n)) : Bool :=
  cover w == BitVec.allOnes n &&
    (w.any (fun s => sep s == BitVec.allOnes n) ||
    (0 < k && w.any (fun a => next (k-1) (a :: w))) ||
    (picks w).any (fun p => (picks p.2).any
      (fun q => tryMix (next k) p.1 q.1 q.2)))

lemma picked_perm {α} {w : List α} {a r} (h : (a,r) ∈ picks w) : w.Perm (a::r) := by
  induction w generalizing r with
  | nil => simp [picks] at h
  | cons b w ih =>
    simp only [picks,List.mem_cons,List.mem_map] at h
    rcases h with e|⟨⟨x,t⟩,ht,e⟩
    · cases e; rfl
    · cases e
      exact ((ih ht).cons b).trans (List.Perm.swap _ _ _)

lemma cover_perm {n} {u v : List (S n)} (hp : u.Perm v) : cover u = cover v := by
  induction hp with
  | nil => rfl
  | cons a _ ih => simp [cover,ih]
  | swap a b w => simp only [cover,← BitVec.or_assoc,BitVec.or_comm (sep a) (sep b)]
  | trans _ _ h₁ h₂ => exact h₁.trans h₂

lemma step_transfer {n} {P Q : Nat → List (S n) → Bool} {u v : List (S n)} {k}
    (hp : u.Perm v) (next : ∀ k {l r}, l.Perm r → P k l = true → Q k r = true) :
    step P k u = true → step Q k v = true := by
  simp only [step,Bool.and_eq_true,Bool.or_eq_true,List.any_eq_true,beq_iff_eq,
    decide_eq_true_eq,cover_perm hp]
  rintro ⟨cv,(hit|⟨pk,a,ha,h⟩)|⟨⟨a,s⟩,hs,⟨b,r⟩,hr,ht⟩⟩
  · obtain ⟨z,hz,h⟩ := hit
    exact ⟨cv,Or.inl (Or.inl ⟨z,hp.mem_iff.mp hz,h⟩)⟩
  · exact ⟨cv,Or.inl (Or.inr ⟨pk,a,hp.mem_iff.mp ha,next _ (hp.cons _) h⟩)⟩
  · obtain ⟨t,ht₁,h₁⟩ := picks_of_perm (hp.symm.trans (picked_perm hs))
    obtain ⟨t',ht₂,h₂⟩ := picks_of_perm (h₁.trans (picked_perm hr))
    refine ⟨cv,Or.inr ⟨(a,t),ht₁,(b,t'),ht₂,?_⟩⟩
    simp only [tryMix,Bool.and_eq_true,List.any_eq_true] at ht ⊢
    obtain ⟨ord,i,hi,guard,hg⟩ := ht
    exact ⟨ord,i,hi,guard,next _ (h₂.symm.cons _) hg⟩

lemma search_perm {n} (d : Nat) {k} {u v : List (S n)} (hp : u.Perm v) :
    search d k u = true → search d k v = true := by
  induction d generalizing k u v with
  | zero =>
    simp only [search,List.any_eq_true]
    rintro ⟨a,ha,h⟩
    exact ⟨a,hp.mem_iff.mp ha,h⟩
  | succ d ih => exact step_transfer hp (fun _ {l r} h => ih h)

abbrev State (n : Nat) := Nat × List (S n)

def Safe {n} (s : State n) := ∀ d, search d s.1 s.2 = false

lemma dead_of_safe {n k} {w : List (S n)} (s : State n) (hs : Safe s)
    (hk : s.1 = k) (hp : w.Perm s.2) : Dead k w := by
  apply dead_search
  apply Bool.eq_false_iff.mpr
  intro h
  have ht := search_perm (w.length + 2*k) hp h
  have hf := hs (w.length + 2*k)
  rw [hk] at hf
  exact Bool.false_ne_true (hf.symm.trans ht)

def listed {n} (ls : List (State n)) (k : Nat) (w : List (S n)) : Bool :=
  ls.any (fun s => s.1 == k && w.isPerm s.2)

def attempt {n} (next : List (State n)) (k : Nat) (w : List (S n)) : Bool :=
  cover w == BitVec.allOnes n && !listed next k w

def verified {n} (s : State n) (next : List (State n)) : Bool :=
  !(s.2.any (fun a => sep a == BitVec.allOnes n)) && !step (attempt next) s.1 s.2

lemma hit_covered {n} {w : List (S n)} {s : S n} (hs : s ∈ w)
    (hit : sep s = BitVec.allOnes n) : cover w = BitVec.allOnes n := by
  apply BitVec.eq_of_getElem_eq
  intro j hj
  rw [BitVec.getElem_allOnes]
  apply (cover_bit w ⟨j,hj⟩).2
  refine ⟨s,hs,?_⟩
  intro h
  have he := congrArg (fun t : BitVec n => t[j]'hj) hit
  simp [sep,h] at he

lemma search_covered {n k} (d : Nat) {w : List (S n)} (h : search d k w = true) :
    cover w = BitVec.allOnes n := by
  cases d with
  | zero =>
    obtain ⟨s,hs,hit⟩ := List.any_eq_true.mp h
    exact hit_covered hs (beq_iff_eq.mp hit)
  | succ d => exact beq_iff_eq.mp (Bool.and_eq_true_iff.mp h).1

lemma row_sound {n} {s : State n} {ls : List (State n)}
    (test : verified s ls = true) (safe : ∀ v ∈ ls, Safe v) : Safe s := by
  simp only [verified,Bool.and_eq_true,Bool.not_eq_true'] at test
  intro d
  cases d with
  | zero => exact test.1
  | succ d =>
    apply Bool.eq_false_iff.mpr
    intro h
    apply Bool.eq_false_iff.mp test.2
    apply step_transfer (List.Perm.refl _) _ h
    intro k l r hp hl
    have hr := search_perm d hp hl
    simp only [attempt,search_covered d hr,beq_self_eq_true,Bool.true_and,Bool.not_eq_true']
    apply Bool.eq_false_iff.mpr
    intro hlisted
    obtain ⟨v,hv,hv'⟩ := List.any_eq_true.mp hlisted
    obtain ⟨hk,hm⟩ := Bool.and_eq_true_iff.mp hv'
    have ep := List.isPerm_iff.mp hm
    have vtrue := search_perm d ep hr
    rw [← beq_iff_eq.mp hk,safe v hv d] at vtrue
    contradiction

def field (w i a : Nat) := (a >>> (w*i)) % (2^w)

def packed (w i : Nat) (a : List Nat) := field w (i % 32) (a.getD (i/32) 0)

def dictionary (n : Nat) (dict : List Nat) (i : Nat) : S n :=
  let z := packed (2*n) i dict
  (BitVec.ofNat n (z >>> n), BitVec.ofNat n z)

def wiresFrom {n} (dict : Nat → S n) : Nat → Nat → List (S n)
  | 0, _ => []
  | f+1, z => if z=0 then [] else dict (z % 2048) :: wiresFrom dict f (z >>> 11)

def entry {n} (dict : Nat → S n) (rows : List Nat) (width count i : Nat) : State n :=
  if i<count then
    let z := packed width i rows
    (z % 4,wiresFrom dict 12 (z >>> 2))
  else (0,[])

def refs {n} (prev : Nat → State n) (offsets arcs : List Nat) (i : Nat) :=
  let a := packed 16 i offsets
  let b := packed 16 (i+1) offsets
  (List.range' a (b-a)).map (fun j => prev (packed 11 j arcs))

def emptySafe {n} : Safe ((0,[]) : State n) := by
  intro d
  cases d <;> simp [search,picks]

def chunks (f : Nat → Bool) (size start : Nat) : Nat → Prop
  | 0 => True
  | t+1 => (List.range' start size).all f = true ∧ chunks f size (start+size) t

lemma chunks_ok (f : Nat → Bool) (size start c i : Nat) (h : chunks f size start c)
    (lo : start ≤ i) (hi : i < start + size*c) : f i = true := by
  induction c generalizing start with
  | zero => simp at hi; omega
  | succ c ih =>
    by_cases lt : i < start+size
    · exact List.all_eq_true.mp h.1 i (by simpa [List.mem_range'_1] using And.intro lo lt)
    · apply ih (start+size) h.2 (by omega)
      rw [Nat.mul_succ] at hi
      omega

lemma certify {n} (dict : Nat → S n) (rows offsets arcs : List Nat) (width count size c : Nat)
    (prev : Nat → State n) (prevOK : ∀ i, Safe (prev i))
    (enough : count ≤ size*c)
    (checks : chunks (fun i => verified (entry dict rows width count i) (refs prev offsets arcs i)) size 0 c) :
    ∀ i, Safe (entry dict rows width count i) := by
  intro i
  by_cases h : i < count
  · apply row_sound (chunks_ok _ _ _ _ _ checks (by omega) (by omega))
    intro v hv
    obtain ⟨j,_,rfl⟩ := List.mem_map.mp hv
    exact prevOK _
  · simpa [entry,h] using (emptySafe (n := n))

abbrev NState := Nat × List Nat

def delta (n t : Nat) := (t >>> n) ^^^ t

def diffs (n : Nat) : List Nat → Nat
  | [] => 0
  | a :: w => delta n a ||| diffs n w

def listedN (ns : List NState) (k : Nat) (w : List Nat) :=
  ns.any (fun s => s.1 == k && w.isPerm s.2)

def combinationOK (n miss k a b : Nat) (rest : List Nat) (ns : List NState) (t : Nat) :=
  ((delta n t) &&& miss) != miss || t == 0 || t == a || t == b || listedN ns k (t::rest)

def pairOK (n mask k : Nat) (ns : List NState) (a b : Nat) (r : List Nat) :=
  let miss := mask ^^^ (mask &&& diffs n r)
  let both := a &&& b
  let good := combinationOK n miss k a b r ns
  good both && good (a ^^^ both) && good (b ^^^ both) && good (a ||| b)

def otherPairs {α} (p : α → α → List α → Bool) (a : α) (pre : List α) : List α → Bool
  | [] => true
  | b::bs => p a b (pre ++ bs) && otherPairs p a (b::pre) bs

def allPairs {α} (p : α → α → List α → Bool) (pre : List α) : List α → Bool
  | [] => true
  | a::as => otherPairs p a pre as && allPairs p (a::pre) as

def fastVerified (n : Nat) (s : NState) (ns : List NState) :=
  let mask := 2^n - 1
  !(s.2.any (fun a => delta n a &&& mask == mask)) &&
  ((s.1 == 0 || s.2.all (fun a => listedN ns (s.1-1) (a::s.2))) &&
  allPairs (pairOK n mask s.1 ns) [] s.2)

def rawDictionary (n : Nat) (dict : List Nat) (i : Nat) := packed (2*n) i dict

def rawFrom (dict : Nat → Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | f+1, z => if z=0 then [] else dict (z % 2048) :: rawFrom dict f (z >>> 11)

def rawEntry (dict : Nat → Nat) (rows : List Nat) (width count i : Nat) : NState :=
  if i<count then
    let z := packed width i rows
    (z % 4,rawFrom dict 12 (z >>> 2))
  else (0,[])

def rawRefs (prev : Nat → NState) (offsets arcs : List Nat) (i : Nat) :=
  let a := packed 16 i offsets
  let b := packed 16 (i+1) offsets
  (List.range' a (b-a)).map (fun j => prev (packed 11 j arcs))

def unpack (n z : Nat) : S n := (BitVec.ofNat n (z >>> n), BitVec.ofNat n z)
def unpackState (n : Nat) (s : NState) : State n := (s.1, s.2.map (unpack n))

lemma unpack_zero (n : Nat) : unpack n 0 = zero := by simp [unpack,zero]

lemma delta_sep (n z : Nat) : BitVec.ofNat n (delta n z) = sep (unpack n z) := by
  simp [delta,unpack,sep]

lemma diffs_cover (n : Nat) (w : List Nat) : BitVec.ofNat n (diffs n w) = cover (w.map (unpack n)) := by
  induction w with
  | nil => rfl
  | cons a w ih => simp only [diffs,List.map_cons,cover,BitVec.ofNat_or,delta_sep,ih]

lemma miss_hit (n z : Nat) (w : List Nat)
    (h : cover ((z::w).map (unpack n)) = BitVec.allOnes n) :
    let m := (2^n-1) ^^^ ((2^n-1) &&& diffs n w)
    delta n z &&& m = m := by
  dsimp only
  apply Nat.eq_of_testBit_eq
  intro j
  simp only [Nat.testBit_and,Nat.testBit_xor,Nat.testBit_two_pow_sub_one]
  by_cases hj : j < n
  · have hb := congrArg (fun t : BitVec n => t[j]'hj) h
    simp only [List.map_cons,cover,← delta_sep,← diffs_cover,BitVec.getElem_or,
      BitVec.getElem_allOnes,BitVec.getElem_eq_testBit_toNat,BitVec.toNat_ofNat,
      Nat.testBit_mod_two_pow,decide_eq_true hj,Bool.true_and] at hb
    simp only [decide_eq_true hj,Bool.true_and]
    cases ez : (delta n z).testBit j <;> cases ew : (diffs n w).testBit j <;> simp_all
  · simp [hj]

lemma mask_hit (n z : Nat) (h : sep (unpack n z) = BitVec.allOnes n) :
    delta n z &&& (2^n-1) = 2^n-1 := by
  simpa [BitVec.toNat_ofNat,BitVec.toNat_allOnes,Nat.and_two_pow_sub_one_eq_mod] using
    congrArg BitVec.toNat ((delta_sep n z).trans h)

def mixesN (a b : Nat) := [a &&& b, a ^^^ (a &&& b), b ^^^ (a &&& b), a ||| b]

lemma mix_unpack (n a b : Nat) (i : Fin 4) :
    ∃ t ∈ mixesN a b, unpack n t = mix i (unpack n a) (unpack n b) := by
  have eqAnd (x y : BitVec n) : x ^^^ (x &&& y) = x &&& ~~~y := by
    apply BitVec.eq_of_getElem_eq
    intro j hj
    simp only [BitVec.getElem_xor,BitVec.getElem_and,BitVec.getElem_not]
    cases x[j] <;> cases y[j] <;> rfl
  have hi := (by decide : ∀ j : Fin 4, j=0 ∨ j=1 ∨ j=2 ∨ j=3) i
  rcases hi with rfl|rfl|rfl|rfl
  · exact ⟨a &&& b,by simp [mixesN],by simp [unpack,mix,Nat.shiftRight_and_distrib]⟩
  · exact ⟨a ^^^ (a &&& b),by simp [mixesN],by simp [unpack,mix,Nat.shiftRight_and_distrib,Nat.shiftRight_xor_distrib,eqAnd]⟩
  · refine ⟨b ^^^ (a &&& b),by simp [mixesN],?_⟩
    simp only [unpack,Nat.shiftRight_and_distrib,Nat.shiftRight_xor_distrib,BitVec.ofNat_and,BitVec.ofNat_xor]
    unfold mix
    simp only [↓reduceIte,Fin.reduceEq]
    congr 1 <;> rw [BitVec.and_comm,eqAnd,BitVec.and_comm]
  · exact ⟨a ||| b,by simp [mixesN],by simp [unpack,mix,Nat.shiftRight_or_distrib]⟩

lemma picks_map' {α β} (f : α → β) (w : List α) :
    picks (w.map f) = (picks w).map (fun p => (f p.1, p.2.map f)) := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [picks,ih,List.map_map,Function.comp_def]

lemma otherPairs_sound (p : Nat → Nat → List Nat → Bool) (a b : Nat) (pre xs tail : List Nat)
    (hs : xs.Perm (b::tail)) (h : otherPairs p a pre xs = true) :
    ∃ r, r.Perm (pre++tail) ∧ p a b r = true := by
  induction xs generalizing pre tail with
  | nil => have := hs.length_eq; simp at this
  | cons c xs ih =>
    obtain ⟨test,rec⟩ := Bool.and_eq_true_iff.mp h
    by_cases e : b=c
    · subst c
      exact ⟨_,(hs.cons_inv).append_left pre,test⟩
    · have hm : c ∈ tail := (List.mem_cons.mp (hs.mem_iff.mp List.mem_cons_self)).resolve_left (Ne.symm e)
      have pe := List.perm_cons_erase hm
      have rem : xs.Perm (b::tail.erase c) :=
        (hs.trans ((pe.cons b).trans (List.Perm.swap _ _ _))).cons_inv
      obtain ⟨r,hr,ok⟩ := ih (c::pre) _ rem rec
      refine ⟨r,hr.trans ?_,ok⟩
      exact (List.perm_middle.symm).trans (pe.symm.append_left pre)

lemma pairs_sound (p : Nat → Nat → List Nat → Bool) (a b : Nat) (pre xs tail : List Nat)
    (hs : xs.Perm (a::b::tail)) (h : allPairs p pre xs = true) :
    ∃ r, r.Perm (pre++tail) ∧ (p a b r = true ∨ p b a r = true) := by
  induction xs generalizing pre tail with
  | nil => have := hs.length_eq; simp at this
  | cons c xs ih =>
    obtain ⟨test,rec⟩ := Bool.and_eq_true_iff.mp h
    by_cases ea : c=a
    · subst c
      obtain ⟨r,hr,ht⟩ := otherPairs_sound _ a b pre xs tail hs.cons_inv test
      exact ⟨r,hr,Or.inl ht⟩
    by_cases eb : c=b
    · subst c
      obtain ⟨r,hr,ht⟩ := otherPairs_sound _ b a pre xs tail (hs.trans (List.Perm.swap _ _ _)).cons_inv test
      exact ⟨r,hr,Or.inr ht⟩
    have hm : c ∈ tail := by
      have hc := hs.mem_iff.mp (List.mem_cons_self (a := c) (l := xs))
      simpa [ea,eb] using hc
    have pe := List.perm_cons_erase hm
    have rem : xs.Perm (a::b::tail.erase c) := by
      apply List.Perm.cons_inv (a := c)
      exact hs.trans (((pe.cons b).cons a).trans (((List.Perm.swap _ _ _).cons a).trans (List.Perm.swap _ _ _)))
    obtain ⟨r,hr,ok⟩ := ih (c::pre) _ rem rec
    exact ⟨r,hr.trans (List.perm_middle.symm.trans (pe.symm.append_left pre)),ok⟩

lemma pair_cases {n mask k a b r ns} (h : pairOK n mask k ns a b r = true) :
    ∀ t ∈ mixesN a b, combinationOK n (mask ^^^ (mask &&& diffs n r)) k a b r ns t = true := by
  simpa only [pairOK,mixesN,Bool.and_eq_true,List.forall_mem_cons,List.not_mem_nil,
    IsEmpty.forall_iff,implies_true,and_true,and_assoc] using h

lemma from_listed {n k ns w} (h : listedN ns k w = true) :
    listed (ns.map (unpackState n)) k (w.map (unpack n)) = true := by
  obtain ⟨s,hs,e⟩ := List.any_eq_true.mp h
  obtain ⟨hk,hp⟩ := Bool.and_eq_true_iff.mp e
  exact List.any_eq_true.mpr ⟨_,List.mem_map.mpr ⟨s,hs,rfl⟩,
    Bool.and_eq_true_iff.mpr ⟨hk,List.isPerm_iff.mpr ((List.isPerm_iff.mp hp).map _)⟩⟩

lemma listed_perm {n k} {ns : List (State n)} {w v : List (S n)} (hp : w.Perm v)
    (h : listed ns k w = true) : listed ns k v = true := by
  obtain ⟨s,hs,e⟩ := List.any_eq_true.mp h
  obtain ⟨hk,hp'⟩ := Bool.and_eq_true_iff.mp e
  exact List.any_eq_true.mpr ⟨s,hs,Bool.and_eq_true_iff.mpr
    ⟨hk,List.isPerm_iff.mpr (hp.symm.trans (List.isPerm_iff.mp hp'))⟩⟩

lemma fast_implies (n : Nat) (s : NState) (ns : List NState) (h : fastVerified n s ns = true) :
    verified (unpackState n s) (ns.map (unpackState n)) = true := by
  obtain ⟨k,w⟩ := s
  simp only [fastVerified,Bool.and_eq_true,Bool.or_eq_true,Bool.not_eq_true',beq_iff_eq] at h
  have nohit : ((w.map (unpack n)).any (fun a => sep a == BitVec.allOnes n)) = false := by
    apply List.any_eq_false.mpr
    intro a ha e
    obtain ⟨u,hu,rfl⟩ := List.mem_map.mp ha
    exact (List.any_eq_false.mp h.1 _ hu) (beq_iff_eq.mpr (mask_hit n u (beq_iff_eq.mp e)))
  simp only [verified,unpackState,nohit,Bool.not_false,Bool.true_and,Bool.not_eq_true']
  apply Bool.eq_false_iff.mpr
  intro yes
  simp only [step,nohit,Bool.false_or,Bool.and_eq_true,Bool.or_eq_true,List.any_eq_true,decide_eq_true_eq] at yes
  obtain ⟨_,⟨pos,a,ha,bad⟩|⟨⟨a,v⟩,hv,⟨b,r⟩,hr,bad⟩⟩ := yes
  · obtain ⟨u,hu,rfl⟩ := List.mem_map.mp ha
    have pok := h.2.1.resolve_left (by omega)
    have good := from_listed (n := n) (List.all_eq_true.mp pok _ hu)
    exact Bool.false_ne_true ((Bool.eq_false_of_not_eq_true' (Bool.and_eq_true_iff.mp bad).2).symm.trans good)
  · simp only [picks_map',List.mem_map] at hv
    obtain ⟨⟨u,tail⟩,hu,eq⟩ := hv
    cases eq
    simp only [picks_map',List.mem_map] at hr
    obtain ⟨⟨v,rest⟩,hv,eq⟩ := hr
    cases eq
    have hw := (picked_perm hu).trans ((picked_perm hv).cons u)
    obtain ⟨rr,pm,hcases⟩ := pairs_sound _ u v [] _ _ hw h.2.2
    have perm : rr.Perm rest := pm
    simp only [tryMix,Bool.and_eq_true,List.any_eq_true,bne_iff_ne,attempt,beq_iff_eq,Bool.not_eq_true'] at bad
    obtain ⟨_,i,_,⟨⟨nz,na⟩,nb⟩,hc,unlisted⟩ := bad
    obtain ⟨t,ht,eq⟩ := mix_unpack n u v i
    have hzero : t ≠ 0 := by rintro rfl; exact nz (eq.symm.trans (unpack_zero _))
    have hne1 : t ≠ u := by rintro rfl; exact na eq.symm
    have hne2 : t ≠ v := by rintro rfl; exact nb eq.symm
    have full : cover ((t::rr).map (unpack n)) = BitVec.allOnes n := by
      simpa only [List.map_cons,cover,eq,cover_perm (perm.map (unpack n))] using
        (show sep (mix i (unpack n u) (unpack n v)) ||| cover (rest.map (unpack n)) = BitVec.allOnes n from hc)
    have mh := miss_hit n t rr full
    have listedt : listedN ns k (t::rr) = true := by
      rcases hcases with ac|ac
      · simpa [combinationOK,mh,hzero,hne1,hne2] using pair_cases ac t ht
      · have rev : t ∈ mixesN v u := by
          simpa [mixesN,Nat.and_comm,Nat.or_comm,or_assoc,or_left_comm,or_comm] using ht
        simpa [combinationOK,mh,hzero,hne1,hne2] using pair_cases ac t rev
    have finalListed := listed_perm ((perm.map (unpack n)).cons (unpack n t)) (from_listed (n := n) listedt)
    rw [eq] at finalListed
    exact Bool.false_ne_true (unlisted.symm.trans finalListed)

lemma rawCertify (n : Nat) (dict : Nat → Nat) (rows offsets arcs : List Nat) (width count size c : Nat)
    (prev : Nat → NState) (prevOK : ∀ i, Safe (unpackState n (prev i)))
    (enough : count ≤ size*c)
    (checks : chunks (fun i => fastVerified n (rawEntry dict rows width count i)
      (rawRefs prev offsets arcs i)) size 0 c) :
    ∀ i, Safe (unpackState n (rawEntry dict rows width count i)) := by
  intro i
  by_cases h : i<count
  · apply row_sound (fast_implies _ _ _ (chunks_ok _ _ _ _ _ checks (by omega) (by omega)))
    intro v hv
    obtain ⟨ss,hs,rfl⟩ := List.mem_map.mp hv
    obtain ⟨j,_,rfl⟩ := List.mem_map.mp hs
    exact prevOK _
  · simpa [rawEntry,h,unpackState] using (emptySafe (n := n))

