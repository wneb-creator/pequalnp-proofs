lemma bChoice (b x : Bool) : Bool.rec x true b = (Bool.rec false true b || x) := by
  cases b <;> rfl

lemma nots_cons (f : Nat → Nat → List W → Bool) (m g e n z q : Nat)
    (v r : List W) (a : W) :
    nots f m g e n z q v (a :: r) =
      (nots f m g e n z q v [a] || nots f m g e n z q v r) := by
  simp only [nots]
  exact bChoice _ _

lemma nots_false_of_singletons (f : Nat → Nat → List W → Bool) (m g e n z q : Nat)
    (v r : List W) (h : ∀ a ∈ r, nots f m g e n z q v [a] = false) :
    nots f m g e n z q v r = false := by
  induction r with
  | nil => rfl
  | cons a r ih =>
    rw [nots_cons, h a (by simp), ih (by simpa using fun b hb => h b (by simp [hb]))]
    rfl

noncomputable def entry (g B K t p : Nat) (f : Nat → List W → Bool) (v : List W) : Bool :=
  Bool.rec false (Bool.rec false
    (child f g (fun h => h v) (Nat.sub B (sumc v)))
    (Nat.ble v.length (Nat.sub (Nat.succ K) t))) (hasP p v)

noncomputable def setup (E Q : List (Nat × Nat)) (Z K t : Nat)
    (f : Nat → List W → Bool) : Bool :=
  let l := lz Z
  let m := mz Z
  let P := PZ Q
  let g := pL (Q.map fun _ => 16)
  let B := pL (Q.map fun e => 16 + (K - e.2))
  let p := pwr E Z
  frc (avl P m (rawL E)) (fun v => st l fun l => st m fun _m => st g fun g =>
    st B fun B => st p fun p =>
      anySub (pos t) l v 0 (fun r => entry g B K t p f r))

lemma etaOr (a b : Bool) : Bool.rec false true (Bool.rec b true a) = (a || b) := by
  cases a <;> cases b <;> rfl

lemma etaEta (a : Bool) : Bool.rec false true (Bool.rec false true a) = a := by
  cases a <;> rfl

