open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open PEqualNP.Outside.L_meta_18178_aux.PermInputs
open SimpleGraph

noncomputable def F {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (x : Fin n → Bool) :
    Bool :=
  @decide ((∃ a ∈ A, x a = true) ∨ ∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true)
    (Classical.propDecidable _)

theorem F_true {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (x : Fin n → Bool) :
    F G A x = true ↔
      ((∃ a ∈ A, x a = true) ∨ ∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true) := by
  unfold F
  exact @decide_eq_true_iff _ (Classical.propDecidable _)

theorem F_eq {n : ℕ} (G G' : SimpleGraph (Fin n)) (A A' : Finset (Fin n)) (x y : Fin n → Bool)
    (h : ((∃ a ∈ A, x a = true) ∨ ∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true) ↔
      ((∃ a ∈ A', y a = true) ∨ ∃ i j : Fin n, G'.Adj i j ∧ y i = true ∧ y j = true)) :
    F G A x = F G' A' y := by
  rw [Bool.eq_iff_iff, F_true, F_true]
  exact h

theorem F_zero {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) :
    F G A (fun _ => false) = false := by
  rw [Bool.eq_false_iff, ne_eq, F_true]
  simp

theorem F_nc {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n))
    (h : A.Nonempty ∨ ∃ i j : Fin n, G.Adj i j) :
    ∃ x y : Fin n → Bool, F G A x ≠ F G A y := by
  refine ⟨fun _ => true, fun _ => false, ?_⟩
  rw [F_zero]
  have : F G A (fun _ => true) = true := by
    rw [F_true]
    rcases h with ⟨a, ha⟩ | ⟨i, j, hij⟩
    · exact Or.inl ⟨a, ha, rfl⟩
    · exact Or.inr ⟨i, j, hij, rfl, rfl⟩
  rw [this]
  simp

theorem F_dep {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (u v : Fin n)
    (huv : G.Adj u v) (hv : v ∉ A) :
    ∃ x : Fin n → Bool, F G A (Function.update x u (!x u)) ≠ F G A x := by
  have hne : u ≠ v := huv.ne
  refine ⟨Function.update (fun _ => false) v true, ?_⟩
  have h1 : F G A (Function.update (Function.update (fun _ => false) v true) u
      (!(Function.update (fun _ => false) v true u))) = true := by
    rw [F_true]
    right
    refine ⟨u, v, huv, ?_, ?_⟩
    · simp [Function.update_of_ne hne]
    · simp [Function.update_of_ne hne.symm]
  have h2 : F G A (Function.update (fun _ => false) v true) = false := by
    rw [Bool.eq_false_iff, ne_eq, F_true]
    rintro (⟨a, ha, hx⟩ | ⟨i, j, hij, hi, hj⟩)
    · by_cases hav : a = v
      · exact hv (hav ▸ ha)
      · simp [Function.update_of_ne hav] at hx
    · have hiv : i = v := by
        by_contra h; simp [Function.update_of_ne h] at hi
      have hjv : j = v := by
        by_contra h; simp [Function.update_of_ne h] at hj
      exact hij.ne (hiv.trans hjv.symm)
  rw [h1, h2]
  simp

theorem F_dep_A {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (a : Fin n)
    (ha : a ∈ A) :
    ∃ x : Fin n → Bool, F G A (Function.update x a (!x a)) ≠ F G A x := by
  refine ⟨fun _ => false, ?_⟩
  rw [F_zero]
  have : F G A (Function.update (fun _ => false) a (!false)) = true := by
    rw [F_true]
    exact Or.inl ⟨a, ha, by simp⟩
  rw [this]
  simp

theorem restrict_false {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (l p : Fin n)
    (hlA : l ∉ A) (hleaf : ∀ w, G.Adj l w → w = p) (x : Fin n → Bool) :
    F G A (Function.update x l false) = F (G.deleteEdges {s(l, p)}) A x := by
  apply F_eq
  apply or_congr
  · constructor
    · rintro ⟨a, ha, h⟩
      have hal : a ≠ l := fun e => hlA (e ▸ ha)
      exact ⟨a, ha, by rwa [Function.update_of_ne hal] at h⟩
    · rintro ⟨a, ha, h⟩
      have hal : a ≠ l := fun e => hlA (e ▸ ha)
      exact ⟨a, ha, by rwa [Function.update_of_ne hal]⟩
  · constructor
    · rintro ⟨i, j, hij, hi, hj⟩
      have hil : i ≠ l := by rintro rfl; simp at hi
      have hjl : j ≠ l := by rintro rfl; simp at hj
      refine ⟨i, j, ?_, by rwa [Function.update_of_ne hil] at hi,
        by rwa [Function.update_of_ne hjl] at hj⟩
      rw [deleteEdges_adj]
      refine ⟨hij, ?_⟩
      simp [Sym2.eq_iff, hil, hjl]
    · rintro ⟨i, j, hij, hi, hj⟩
      rw [deleteEdges_adj] at hij
      obtain ⟨hij, hne⟩ := hij
      have hil : i ≠ l := by
        rintro rfl
        have := hleaf j hij
        subst this
        exact hne rfl
      have hjl : j ≠ l := by
        rintro rfl
        have := hleaf i hij.symm
        subst this
        exact hne (Sym2.eq_swap)
      exact ⟨i, j, hij, by rwa [Function.update_of_ne hil], by rwa [Function.update_of_ne hjl]⟩

theorem restrict_true {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (l p q : Fin n)
    (hlA : l ∉ A) (hlp : G.Adj l p) (hleaf : ∀ w, G.Adj l w → w = p)
    (hp : ∀ w, G.Adj p w → w = l ∨ w = q) (x : Fin n → Bool) :
    F G A (Function.update x l true) = F (G.deleteEdges {s(p, l), s(p, q)}) (insert p A) x := by
  have hpl : p ≠ l := hlp.ne.symm
  have hA : ∀ a ∈ A, Function.update x l true a = x a := fun a ha =>
    Function.update_of_ne (by rintro rfl; exact hlA ha) _ _

  have hG1 : ∀ i j, (G.deleteEdges {s(p, l), s(p, q)}).Adj i j → i ≠ p ∧ i ≠ l := by
    intro i j hij
    rw [deleteEdges_adj] at hij
    obtain ⟨hij, hne⟩ := hij
    constructor
    · rintro rfl
      rcases hp j hij with rfl | rfl
      · exact hne (by simp)
      · exact hne (by simp)
    · rintro rfl
      have := hleaf j hij
      subst this
      exact hne (by simp [Sym2.eq_swap])
  apply F_eq
  constructor
  · rintro (⟨a, ha, h⟩ | ⟨i, j, hij, hi, hj⟩)
    · exact Or.inl ⟨a, Finset.mem_insert_of_mem ha, by rwa [hA a ha] at h⟩
    · by_cases hip : i = p
      · subst hip
        exact Or.inl ⟨i, Finset.mem_insert_self _ _, by rwa [Function.update_of_ne hpl] at hi⟩
      by_cases hjp : j = p
      · subst hjp
        exact Or.inl ⟨j, Finset.mem_insert_self _ _, by rwa [Function.update_of_ne hpl] at hj⟩
      have hil : i ≠ l := by
        rintro rfl; exact hjp (hleaf j hij)
      have hjl : j ≠ l := by
        rintro rfl; exact hip (hleaf i hij.symm)
      right
      refine ⟨i, j, ?_, by rwa [Function.update_of_ne hil] at hi,
        by rwa [Function.update_of_ne hjl] at hj⟩
      rw [deleteEdges_adj]
      refine ⟨hij, ?_⟩
      simp [Sym2.eq_iff, hip, hjp]
  · rintro (⟨a, ha, h⟩ | ⟨i, j, hij, hi, hj⟩)
    · rcases Finset.mem_insert.1 ha with rfl | ha
      · right
        exact ⟨l, a, hlp, by simp, by rwa [Function.update_of_ne hpl]⟩
      · exact Or.inl ⟨a, ha, by rwa [hA a ha]⟩
    · right
      have hi' := hG1 i j hij
      have hj' := hG1 j i hij.symm
      rw [deleteEdges_adj] at hij
      exact ⟨i, j, hij.1, by rwa [Function.update_of_ne hi'.2],
        by rwa [Function.update_of_ne hj'.2]⟩

def Cov {n : ℕ} (G : SimpleGraph (Fin n)) (T : Finset (Fin n)) : Prop :=
  ∀ i j, G.Adj i j → i ∈ T ∨ j ∈ T

theorem cov_insert {n : ℕ} (G : SimpleGraph (Fin n)) (S : Set (Sym2 (Fin n))) (p : Fin n)
    (hS : ∀ e ∈ S, p ∈ e) (T : Finset (Fin n)) (hT : Cov (G.deleteEdges S) T) :
    Cov G (insert p T) := by
  intro i j hij
  by_cases he : s(i, j) ∈ S
  · have := hS _ he
    rcases Sym2.mem_iff.1 this with rfl | rfl
    · exact Or.inl (Finset.mem_insert_self _ _)
    · exact Or.inr (Finset.mem_insert_self _ _)
  · rcases hT i j ((deleteEdges_adj).2 ⟨hij, he⟩) with h | h
    · exact Or.inl (Finset.mem_insert_of_mem h)
    · exact Or.inr (Finset.mem_insert_of_mem h)

theorem cov_swap {n : ℕ} (G : SimpleGraph (Fin n)) (l p l' : Fin n) (k : ℕ)
    (hll' : l' ≠ l) (hl'p : G.Adj p l') (hleaf' : ∀ w, G.Adj l' w → w = p)
    (hk : ∀ T, Cov G T → k ≤ T.card) (T : Finset (Fin n))
    (hT : Cov (G.deleteEdges {s(l, p)}) T) : k ≤ T.card := by
  have hS : ∀ e ∈ ({s(l, p)} : Set (Sym2 (Fin n))), p ∈ e := by
    intro e he
    rw [Set.mem_singleton_iff] at he
    subst he
    exact Sym2.mem_mk_right _ _
  by_cases hpT : p ∈ T
  · have := hk _ (cov_insert G _ p hS T hT)
    rwa [Finset.insert_eq_of_mem hpT] at this
  · have hl'T : l' ∈ T := by
      have hpl' : p ≠ l' := hl'p.ne
      rcases hT p l' ((deleteEdges_adj).2 ⟨hl'p, by
          simp [Sym2.eq_iff, hll', hpl'.symm]⟩) with h | h
      · exact absurd h hpT
      · exact h
    have hcov : Cov G (insert p (T.erase l')) := by
      intro i j hij
      by_cases hip : i = p
      · exact Or.inl (hip ▸ Finset.mem_insert_self _ _)
      by_cases hjp : j = p
      · exact Or.inr (hjp ▸ Finset.mem_insert_self _ _)
      have h0 : (G.deleteEdges {s(l, p)}).Adj i j :=
        (deleteEdges_adj).2 ⟨hij, by simp [Sym2.eq_iff, hip, hjp]⟩
      rcases hT i j h0 with h | h
      · have hil' : i ≠ l' := by
          rintro rfl; exact hjp (hleaf' j hij)
        exact Or.inl (Finset.mem_insert_of_mem (Finset.mem_erase.2 ⟨hil', h⟩))
      · have hjl' : j ≠ l' := by
          rintro rfl; exact hip (hleaf' i hij.symm)
        exact Or.inr (Finset.mem_insert_of_mem (Finset.mem_erase.2 ⟨hjl', h⟩))
    have h1 := hk _ hcov
    have h2 := Finset.card_insert_le p (T.erase l')
    have h3 := Finset.card_erase_add_one hl'T
    omega

theorem ncard_del1 {n : ℕ} (G : SimpleGraph (Fin n)) (l p : Fin n) (h : G.Adj l p) :
    (G.deleteEdges {s(l, p)}).edgeSet.ncard + 1 = G.edgeSet.ncard := by
  rw [edgeSet_deleteEdges]
  exact Set.ncard_sdiff_singleton_add_one (G.mem_edgeSet.2 h)

theorem ncard_del2 {n : ℕ} (G : SimpleGraph (Fin n)) (l p q : Fin n) (h : G.Adj l p) :
    G.edgeSet.ncard ≤ (G.deleteEdges {s(p, l), s(p, q)}).edgeSet.ncard + 2 ∧
      (G.deleteEdges {s(p, l), s(p, q)}).edgeSet.ncard < G.edgeSet.ncard := by
  rw [edgeSet_deleteEdges]
  constructor
  · have h1 := Set.ncard_le_ncard_sdiff_add_ncard G.edgeSet ({s(p, l), s(p, q)} : Set (Sym2 (Fin n)))
    have h2 := Set.ncard_insert_le (s(p, l)) ({s(p, q)} : Set (Sym2 (Fin n)))
    rw [Set.ncard_singleton] at h2
    omega
  · have hmem : s(l, p) ∈ G.edgeSet := G.mem_edgeSet.2 h
    have hsub : G.edgeSet \ {s(p, l), s(p, q)} ⊆ G.edgeSet \ {s(l, p)} := by
      intro e he
      refine ⟨he.1, ?_⟩
      intro he'
      apply he.2
      rw [Set.mem_singleton_iff] at he'
      rw [he', Sym2.eq_swap]
      exact Set.mem_insert _ _
    have h1 := Set.ncard_le_ncard hsub
    have h2 := Set.ncard_sdiff_singleton_lt_of_mem hmem
    omega

theorem noedge_ncard {n : ℕ} (G : SimpleGraph (Fin n)) (h : ∀ i j, ¬ G.Adj i j) :
    G.edgeSet.ncard = 0 := by
  have : G.edgeSet = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.2
    intro e
    induction e using Sym2.ind with
    | _ i j => exact fun he => h i j (G.mem_edgeSet.1 he)
  rw [this, Set.ncard_empty]

theorem del_p_adj {n : ℕ} (G : SimpleGraph (Fin n)) (l p q : Fin n)
    (hp : ∀ w, G.Adj p w → w = l ∨ w = q) (i j : Fin n)
    (hij : (G.deleteEdges {s(p, l), s(p, q)}).Adj i j) : i ≠ p := by
  rw [deleteEdges_adj] at hij
  obtain ⟨hij, hne⟩ := hij
  rintro rfl
  rcases hp j hij with rfl | rfl
  · exact hne (by simp)
  · exact hne (by simp)

theorem claimQ : ∀ (m n : ℕ) (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (k s : ℕ),
    G.edgeSet.ncard = m → Acyclic G → (∀ i j, G.Adj i j → i ∉ A) →
    (∀ T, Cov G T → k ≤ T.card) → (A.Nonempty ∨ ∃ i j, G.Adj i j) →
    HasCircuitSize n (F G A) s → A.card + m + k ≤ s + 1 := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro n G A k s hm hac hinv hk hne hC
  by_cases hE : ∃ i j, G.Adj i j
  swap
  · push_neg at hE
    have hk0 : k ≤ (∅ : Finset (Fin n)).card := hk ∅ (fun i j h => absurd h (hE i j))
    have hm0 : m = 0 := by rw [← hm]; exact noedge_ncard G hE
    have := dep_lower_set n (F G A) A (fun a ha => F_dep_A G A a ha) s hC
    simp at hk0
    omega
  obtain ⟨l, p, hlp, hleaf, hcase⟩ := forest_good_leaf G hac hE
  obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by have := l.2; omega⟩
  have hlA : l ∉ A := hinv l p hlp
  have hpA : p ∉ A := hinv p l hlp.symm
  have hdepl := F_dep G A l p hlp hpA
  have hdepp := F_dep G A p l hlp.symm hlA
  have hs1 : 2 ≤ s + 1 := by
    have := dep_lower_set _ (F G A) {l, p} (by
      intro i hi
      rcases Finset.mem_insert.1 hi with rfl | hi
      · exact hdepl
      · rw [Finset.mem_singleton] at hi
        subst hi
        exact hdepp) s hC
    rwa [Finset.card_pair hlp.ne] at this
  set G0 := G.deleteEdges {s(l, p)} with hG0
  have hm0 : G0.edgeSet.ncard + 1 = m := by rw [← hm]; exact ncard_del1 G l p hlp
  have hac0 : Acyclic G0 := hac.anti (deleteEdges_le _)
  have hinv0 : ∀ i j, G0.Adj i j → i ∉ A := fun i j h => hinv i j ((deleteEdges_adj).1 h).1
  have hS0 : ∀ e ∈ ({s(l, p)} : Set (Sym2 (Fin (n' + 1)))), p ∈ e := by
    intro e he
    rw [Set.mem_singleton_iff] at he
    subst he
    exact Sym2.mem_mk_right _ _
  have hrf : (fun x => F G A (Function.update x l false)) = F G0 A :=
    funext (restrict_false G A l p hlA hleaf)
  rcases hcase with ⟨q, hq⟩ | ⟨l', hl'l, hpl', hleaf'⟩
  · set G1 := G.deleteEdges {s(p, l), s(p, q)} with hG1
    by_cases h0 : A.Nonempty ∨ ∃ i j, G0.Adj i j
    · have hrt : (fun x => F G A (Function.update x l true)) = F G1 (insert p A) :=
        funext (restrict_true G A l p q hlA hlp hleaf hq)
      have hnc : ∀ b : Bool, ∃ x y : Fin (n' + 1) → Bool,
          F G A (Function.update x l b) ≠ F G A (Function.update y l b) := by
        intro b
        cases b
        · obtain ⟨x, y, hxy⟩ := F_nc G0 A h0
          refine ⟨x, y, ?_⟩
          have e1 := congrFun hrf x
          have e2 := congrFun hrf y
          rw [e1, e2]; exact hxy
        · obtain ⟨x, y, hxy⟩ := F_nc G1 (insert p A) (Or.inl (Finset.insert_nonempty _ _))
          refine ⟨x, y, ?_⟩
          have e1 := congrFun hrt x
          have e2 := congrFun hrt y
          rw [e1, e2]; exact hxy
      obtain ⟨b, s', hs', hC'⟩ := gate_elim_at n' (F G A) l s hdepl hnc hC
      cases b
      · rw [hrf] at hC'
        have hk0 : ∀ T, Cov G0 T → k - 1 ≤ T.card := fun T hT => by
          have := hk _ (cov_insert G _ p hS0 T hT)
          have := Finset.card_insert_le p T
          omega
        have := ih G0.edgeSet.ncard (by omega) _ G0 A (k - 1) s' rfl hac0 hinv0 hk0 h0 hC'
        omega
      · rw [hrt] at hC'
        have hS1 : ∀ e ∈ ({s(p, l), s(p, q)} : Set (Sym2 (Fin (n' + 1)))), p ∈ e := by
          intro e he
          rcases he with rfl | he
          · exact Sym2.mem_mk_left _ _
          · rw [Set.mem_singleton_iff] at he
            subst he
            exact Sym2.mem_mk_left _ _
        have hk1 : ∀ T, Cov G1 T → k - 1 ≤ T.card := fun T hT => by
          have := hk _ (cov_insert G _ p hS1 T hT)
          have := Finset.card_insert_le p T
          omega
        have hac1 : Acyclic G1 := hac.anti (deleteEdges_le _)
        have hinv1 : ∀ i j, G1.Adj i j → i ∉ insert p A := by
          intro i j h hi
          rcases Finset.mem_insert.1 hi with heq | hi
          · exact del_p_adj G l p q hq i j h heq
          · exact hinv i j ((deleteEdges_adj).1 h).1 hi
        obtain ⟨hc1, hc2⟩ := ncard_del2 G l p q hlp
        rw [← hG1] at hc1 hc2
        have := ih G1.edgeSet.ncard (by omega) _ G1 (insert p A) (k - 1) s' rfl hac1 hinv1
          hk1 (Or.inl (Finset.insert_nonempty _ _)) hC'
        rw [Finset.card_insert_of_notMem hpA] at this
        omega
    · push_neg at h0
      obtain ⟨hA0, hG00⟩ := h0
      have hm1 : m = 1 := by
        have := noedge_ncard G0 hG00
        omega
      have hk1 : k ≤ ({p} : Finset (Fin (n' + 1))).card := by
        apply hk
        intro i j hij
        have h1 := hG00 i j
        rw [deleteEdges_adj] at h1
        push_neg at h1
        have h2 := h1 hij
        rw [Set.mem_singleton_iff, Sym2.eq_iff] at h2
        rcases h2 with ⟨_, rfl⟩ | ⟨rfl, _⟩
        · exact Or.inr (Finset.mem_singleton_self _)
        · exact Or.inl (Finset.mem_singleton_self _)
      rw [Finset.card_singleton] at hk1
      subst hA0
      simp only [Finset.card_empty]
      omega
  · obtain ⟨s0, rfl⟩ : ∃ s0, s = s0 + 1 := ⟨s - 1, by omega⟩
    have hpl'0 : G0.Adj p l' := (deleteEdges_adj).2 ⟨hpl', by
      simp [Sym2.eq_iff, hl'l, hpl'.ne.symm]⟩
    have hnc0 : ∃ x y : Fin (n' + 1) → Bool,
        F G A (Function.update x l false) ≠ F G A (Function.update y l false) := by
      obtain ⟨x, y, hxy⟩ := F_nc G0 A (Or.inr ⟨p, l', hpl'0⟩)
      refine ⟨x, y, ?_⟩
      have e1 := congrFun hrf x
      have e2 := congrFun hrf y
      rw [e1, e2]; exact hxy
    have hC' := one_gate_at n' (F G A) l false s0 hdepl hnc0 hC
    rw [hrf] at hC'
    have hk0 : ∀ T, Cov G0 T → k ≤ T.card := cov_swap G l p l' k hl'l hpl' hleaf' hk
    have := ih G0.edgeSet.ncard (by omega) _ G0 A k s0 rfl hac0 hinv0 hk0
      (Or.inr ⟨p, l', hpl'0⟩) hC'
    omega

theorem forest_bound : ∀ (n k s : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj],
    Acyclic G → (∃ i j : Fin n, G.Adj i j) →
    (∀ T : Finset (Fin n), (∀ i j : Fin n, G.Adj i j → i ∈ T ∨ j ∈ T) → k ≤ T.card) →
    HasCircuitSize n
      (fun x : Fin n → Bool => decide (∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true)) s →
    G.edgeFinset.card + k ≤ s + 1 := by
  intro n k s G _ hac hE hk hC
  have hf : (fun x : Fin n → Bool =>
      decide (∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true)) = F G ∅ := by
    funext x
    rw [Bool.eq_iff_iff, F_true, decide_eq_true_iff]
    simp
  rw [hf] at hC
  have := claimQ _ n G ∅ k s rfl hac (by simp) (fun T hT => hk T hT) (Or.inr hE) hC
  have he : G.edgeFinset.card = G.edgeSet.ncard := by
    rw [← Set.ncard_coe_finset, coe_edgeFinset]
  rw [Finset.card_empty] at this
  omega

end PEqualNP.Outside.L_meta_18178_aux.Forest

namespace PEqualNP.Outside.L_meta_18178_aux

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open SimpleGraph

variable {m n : ℕ}

private theorem leftIndex (a : Fin m) : (Fin.castAdd n a).val < m := a.isLt

private theorem rightIndex (b : Fin n) : m ≤ (Fin.natAdd m b).val := by
  change m ≤ m + b.val
  omega

private theorem bothSides (a : Fin m) (b : Fin n) : Fin.castAdd n a ≠ Fin.natAdd m b := by
  intro h
  exact Nat.not_lt_of_ge (rightIndex b) (h ▸ leftIndex a)

private def graph (E : Finset (Fin m × Fin n)) : SimpleGraph (Fin (m+n)) where
  Adj u v := ∃ a b, (a,b) ∈ E ∧
    ((u = Fin.castAdd n a ∧ v = Fin.natAdd m b) ∨
      (v = Fin.castAdd n a ∧ u = Fin.natAdd m b))
  symm := ⟨by rintro u v ⟨a,b,h,hw⟩; exact ⟨a,b,h,hw.symm⟩⟩
  loopless := ⟨by
    rintro u ⟨a,b,_,(⟨ha,hb⟩ | ⟨ha,hb⟩)⟩
    all_goals exact bothSides a b (ha.symm.trans hb)⟩

private theorem graphLR (E : Finset (Fin m × Fin n)) (a : Fin m) (b : Fin n) :
    (graph E).Adj (Fin.castAdd n a) (Fin.natAdd m b) ↔ (a,b) ∈ E := by
  constructor
  · rintro ⟨c,d,h,(⟨ha,hb⟩ | ⟨ha,hb⟩)⟩
    · have hv := congrArg Fin.val ha
      have ac : a = c := Fin.ext hv
      have bd : b = d := by
        apply Fin.ext
        have hv := congrArg Fin.val hb
        change m + b.val = m + d.val at hv
        omega
      rwa [ac,bd]
    · exact False.elim (bothSides a d hb)
  · exact fun h => ⟨a,b,h,Or.inl ⟨rfl,rfl⟩⟩

private theorem sideFlip (E : Finset (Fin m × Fin n)) {u v : Fin (m+n)}
    (e : (graph E).Adj u v) : u.val < m ↔ ¬ v.val < m := by
  rcases e with ⟨a,b,_,(⟨rfl,rfl⟩ | ⟨rfl,rfl⟩)⟩
  · exact iff_of_true (leftIndex a) (Nat.not_lt_of_ge (rightIndex b))
  · exact iff_of_false (Nat.not_lt_of_ge (rightIndex b)) (not_not_intro (leftIndex a))

private theorem walkSides {E : Finset (Fin m × Fin n)} {u v : Fin (m+n)}
    (p : (graph E).Walk u v) (hu : u.val < m) (i : ℕ) (hi : i ≤ p.length) :
    (p.getVert i).val < m ↔ i % 2 = 0 := by
  induction i with
  | zero => simpa using hu
  | succ i ih =>
    have h := sideFlip E (p.adj_getVert_succ (by omega : i < p.length))
    have old := ih (by omega)
    constructor
    · intro hn
      by_contra he
      have hi2 : i % 2 = 0 := by omega
      exact (h.mp (old.mpr hi2)) hn
    · intro he
      by_contra hn
      have hi2 := old.mp (h.mpr hn)
      omega

private abbrev asLeft (v : Fin (m+n)) (h : v.val < m) : Fin m := ⟨v.val,h⟩

private abbrev asRight (v : Fin (m+n)) (h : m ≤ v.val) : Fin n :=
  ⟨v.val-m,by have := v.isLt; omega⟩

private theorem asLeftBack (v : Fin (m+n)) (h : v.val < m) :
    Fin.castAdd n (asLeft v h) = v := rfl

private theorem asRightBack (v : Fin (m+n)) (h : m ≤ v.val) :
    Fin.natAdd m (asRight v h) = v := by
  apply Fin.ext
  change m + (v.val-m) = v.val
  omega

private theorem cycleStartLeft {E : Finset (Fin m × Fin n)} {u : Fin (m+n)}
    (p : (graph E).Walk u u) (hc : p.IsCycle) :
    ∃ v ∈ p.support, v.val < m := by
  by_cases h : u.val < m
  · exact ⟨u,p.start_mem_support,h⟩
  · have e := p.adj_getVert_succ (i := 0) (by have := hc.three_le_length; omega)
    have left : (p.getVert 1).val < m := by
      have flip := sideFlip E e.symm
      exact flip.mpr (by simpa using h)
    exact ⟨p.getVert 1, p.getVert_mem_support _,left⟩

private theorem noCycle (E : Finset (Fin m × Fin n)) (small : m ≤ 3)
    (noFour : ∀ a b : Fin m, ∀ i j : Fin n, a ≠ b → i ≠ j →
      ¬((a,i) ∈ E ∧ (a,j) ∈ E ∧ (b,i) ∈ E ∧ (b,j) ∈ E))
    (noSix : ¬(m = 3 ∧ ∀ a : Fin m, ∃ b : Fin n, ∀ c : Fin m, (c,b) ∈ E ↔ c ≠ a)) :
    Acyclic (graph E) := by
  intro start original horig
  obtain ⟨u,hu,hleft⟩ := cycleStartLeft original horig
  let p := original.rotate u hu
  have hp : p.IsCycle := horig.rotate hu
  have lower := hp.three_le_length
  have even : p.length % 2 = 0 := (walkSides p hleft p.length (Nat.le_refl _)).mp
    (by simpa using hleft)
  have upper : p.length ≤ 6 := by
    by_contra! hlen
    let left (a : Fin 4) : Fin m :=
      asLeft (p.getVert (2*a.val)) ((walkSides p hleft _ (by have := a.isLt; omega)).mpr (by omega))
    have inj : Function.Injective left := by
      intro a b h
      have hv := congrArg Fin.val h
      have hab : p.getVert (2*a.val) = p.getVert (2*b.val) := Fin.ext hv
      have ea := a.isLt
      have eb := b.isLt
      have hpos := hp.getVert_injOn' (by simp; omega : 2*a.val ∈ {i | i ≤ p.length-1})
        (by simp; omega : 2*b.val ∈ {i | i ≤ p.length-1}) hab
      exact Fin.ext (by omega)
    have hm : 4 ≤ m := by simpa using Fintype.card_le_of_injective left inj
    omega
  let L (i : ℕ) (h : i ≤ p.length) (e : i % 2 = 0) : Fin m :=
    asLeft (p.getVert i) ((walkSides p hleft _ h).mpr e)
  let R (i : ℕ) (h : i ≤ p.length) (e : i % 2 = 1) : Fin n :=
    asRight (p.getVert i) (by
      apply Nat.le_of_not_lt
      intro hi
      have := (walkSides p hleft _ h).mp hi
      omega)
  have lBack (i h e) : Fin.castAdd n (L i h e) = p.getVert i := by apply asLeftBack
  have rBack (i h e) : Fin.natAdd m (R i h e) = p.getVert i := by apply asRightBack
  have eqStep (i j : ℕ) (hi : i < p.length) (hj : j < p.length)
      (he : p.getVert i = p.getVert j) : i = j :=
    hp.getVert_injOn' (by simp; omega) (by simp; omega) he
  have Lne (i j : ℕ) (hi : i < p.length) (hj : j < p.length)
      (ei : i % 2 = 0) (ej : j % 2 = 0) (hne : i ≠ j) :
      L i hi.le ei ≠ L j hj.le ej := by
    intro h
    apply hne
    apply eqStep i j hi hj
    rw [← lBack i hi.le ei,← lBack j hj.le ej,h]
  have Rne (i j : ℕ) (hi : i < p.length) (hj : j < p.length)
      (ei : i % 2 = 1) (ej : j % 2 = 1) (hne : i ≠ j) :
      R i hi.le ei ≠ R j hj.le ej := by
    intro h
    apply hne
    apply eqStep i j hi hj
    rw [← rBack i hi.le ei,← rBack j hj.le ej,h]
  have eLR (i : ℕ) (hi : i < p.length) (ei : i % 2 = 0) :
      (L i hi.le ei, R (i+1) (by omega) (by omega)) ∈ E := by
    rw [← graphLR E, lBack i hi.le ei,rBack (i+1) (by omega) (by omega)]
    exact p.adj_getVert_succ hi
  have eRL (i : ℕ) (hi : i < p.length) (ei : i % 2 = 1) :
      (L (i+1) (by omega) (by omega), R i hi.le ei) ∈ E := by
    rw [← graphLR E, lBack (i+1) (by omega) (by omega),rBack i hi.le ei]
    exact (p.adj_getVert_succ hi).symm
  have lEnd (hl : p.length % 2 = 0) :
      L p.length (Nat.le_refl _) hl = L 0 (Nat.zero_le _) rfl := by
    apply Fin.ext
    change (p.getVert p.length).val = (p.getVert 0).val
    simp
  by_cases h4 : p.length = 4
  · let a := L 0 (by omega) (by decide)
    let b := L 2 (by omega) (by decide)
    let i := R 1 (by omega) (by decide)
    let j := R 3 (by omega) (by decide)
    have ea : L 4 (by omega) (by decide) = a := by simpa [h4,a] using lEnd even
    have ej : (a,j) ∈ E := by rw [← ea]; exact eRL 3 (by omega) (by decide)
    exact noFour a b i j (Lne 0 2 (by omega) (by omega) rfl rfl (by decide))
      (Rne 1 3 (by omega) (by omega) rfl rfl (by decide))
      ⟨eLR 0 (by omega) (by decide),ej,eRL 1 (by omega) (by decide),eLR 2 (by omega) (by decide)⟩
  · have h6 : p.length = 6 := by omega
    let a := L 0 (by omega) (by decide)
    let b := L 2 (by omega) (by decide)
    let c := L 4 (by omega) (by decide)
    let i := R 1 (by omega) (by decide)
    let j := R 3 (by omega) (by decide)
    let k := R 5 (by omega) (by decide)
    have ab : a ≠ b := Lne 0 2 (by omega) (by omega) rfl rfl (by decide)
    have ac : a ≠ c := Lne 0 4 (by omega) (by omega) rfl rfl (by decide)
    have bc : b ≠ c := Lne 2 4 (by omega) (by omega) rfl rfl (by decide)
    have ij : i ≠ j := Rne 1 3 (by omega) (by omega) rfl rfl (by decide)
    have ik : i ≠ k := Rne 1 5 (by omega) (by omega) rfl rfl (by decide)
    have jk : j ≠ k := Rne 3 5 (by omega) (by omega) rfl rfl (by decide)
    have ai : (a,i) ∈ E := eLR 0 (by omega) rfl
    have bi : (b,i) ∈ E := eRL 1 (by omega) rfl
    have bj : (b,j) ∈ E := eLR 2 (by omega) rfl
    have cj : (c,j) ∈ E := eRL 3 (by omega) rfl
    have ck : (c,k) ∈ E := eLR 4 (by omega) rfl
    have ea : L 6 (by omega) (by decide) = a := by simpa [h6,a] using lEnd even
    have ak : (a,k) ∈ E := by rw [← ea]; exact eRL 5 (by omega) rfl
    have na : (a,j) ∉ E := fun e => noFour a b i j ab ij ⟨ai,e,bi,bj⟩
    have nb : (b,k) ∉ E := fun e => noFour a b i k ab ik ⟨ai,ak,bi,e⟩
    have nc : (c,i) ∉ E := fun e => noFour b c i j bc ij ⟨bi,bj,e,cj⟩
    have three : 3 ≤ m := by
      let A : Finset (Fin m) := {a,b,c}
      have hcA : A.card = 3 := by simp [A,Finset.card_insert_of_notMem,ab,ac,bc]
      simpa [hcA] using Finset.card_le_univ A
    have rest (x : Fin m) : x = a ∨ x = b ∨ x = c := by
      by_contra! h
      let A : Finset (Fin m) := {x,a,b,c}
      have hcA : A.card = 4 := by simp [A,Finset.card_insert_of_notMem,ab,ac,bc,h.1,h.2.1,h.2.2]
      have hm : 4 ≤ m := by simpa [hcA] using Finset.card_le_univ A
      omega
    apply noSix
    refine ⟨by omega,?_⟩
    intro x
    rcases rest x with rfl | rfl | rfl
    · refine ⟨j,?_⟩
      intro y
      rcases rest y with rfl | rfl | rfl
      · simp [na]
      · simp [bj,ab.symm]
      · simp [cj,ac.symm]
    · refine ⟨k,?_⟩
      intro y
      rcases rest y with rfl | rfl | rfl
      · simp [ak,ab]
      · simp [nb]
      · simp [ck,bc.symm]
    · refine ⟨i,?_⟩
      intro y
      rcases rest y with rfl | rfl | rfl
      · simp [ai,ac]
      · simp [bi,bc]
      · simp [nc]

private def edgeEmb : (Fin m × Fin n) ↪ Sym2 (Fin (m+n)) where
  toFun k := s(Fin.castAdd n k.1,Fin.natAdd m k.2)
  inj' := by
    intro a b h
    rcases Sym2.eq_iff.mp h with ⟨hl,hr⟩ | ⟨hl,hr⟩
    · exact Prod.ext ((Fin.castAddEmb n).injective hl) ((Fin.natAddEmb m).injective hr)
    · exact False.elim (bothSides a.1 b.2 hl)

private theorem edgeCard (E : Finset (Fin m × Fin n)) [DecidableRel (graph E).Adj] :
    (graph E).edgeFinset.card = E.card := by
  have e : (graph E).edgeFinset = E.map edgeEmb := by
    ext k
    induction k using Sym2.inductionOn with
    | _ u v =>
      rw [Finset.mem_map,SimpleGraph.mem_edgeFinset]
      constructor
      · rintro ⟨a,b,he,⟨rfl,rfl⟩ | ⟨rfl,rfl⟩⟩
        · exact ⟨(a,b),he,rfl⟩
        · exact ⟨(a,b),he,Sym2.eq_iff.mpr (Or.inr ⟨rfl,rfl⟩)⟩
      · rintro ⟨⟨a,b⟩,he,hs⟩
        change s(Fin.castAdd n a,Fin.natAdd m b) = s(u,v) at hs
        rcases Sym2.eq_iff.mp hs with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
        · exact (graphLR E a b).mpr he
        · exact ((graphLR E a b).mpr he).symm
  rw [e,Finset.card_map]

private theorem splitCover (S : Finset (Fin (m+n))) :
    ∃ A : Finset (Fin m), ∃ B : Finset (Fin n),
      (∀ a : Fin m, a ∈ A ↔ Fin.castAdd n a ∈ S) ∧
      (∀ b : Fin n, b ∈ B ↔ Fin.natAdd m b ∈ S) ∧
      A.card + B.card = S.card := by
  let A := Finset.univ.filter fun a : Fin m => Fin.castAdd n a ∈ S
  let B := Finset.univ.filter fun b : Fin n => Fin.natAdd m b ∈ S
  have memA (a : Fin m) : a ∈ A ↔ Fin.castAdd n a ∈ S := by simp [A]
  have memB (b : Fin n) : b ∈ B ↔ Fin.natAdd m b ∈ S := by simp [B]
  refine ⟨A,B,memA,memB,?_⟩
  have union : A.map (Fin.castAddEmb n) ∪ B.map (Fin.natAddEmb m) = S := by
    ext u
    constructor
    · intro h
      rcases Finset.mem_union.mp h with ha | hb
      · rcases Finset.mem_map.mp ha with ⟨a,haA,rfl⟩
        exact (memA _).mp haA
      · rcases Finset.mem_map.mp hb with ⟨b,hbB,rfl⟩
        exact (memB _).mp hbB
    · refine Fin.addCases (m := m) (n := n) ?_ ?_ u
      · intro a ha
        exact Finset.mem_union_left _ (Finset.mem_map.mpr ⟨a,(memA _).mpr ha,rfl⟩)
      · intro b hb
        exact Finset.mem_union_right _ (Finset.mem_map.mpr ⟨b,(memB _).mpr hb,rfl⟩)
  have disj : Disjoint (A.map (Fin.castAddEmb n)) (B.map (Fin.natAddEmb m)) := by
    rw [Finset.disjoint_left]
    intro x ha hb
    rcases Finset.mem_map.mp ha with ⟨a,_,ha⟩
    rcases Finset.mem_map.mp hb with ⟨b,_,hb⟩
    exact bothSides a b (ha.trans hb.symm)
  rw [← union,Finset.card_union_of_disjoint disj,Finset.card_map,Finset.card_map]

private def Cover (G : SimpleGraph (Fin (m+n))) (S : Finset (Fin (m+n))) :=
  ∀ i j, G.Adj i j → i ∈ S ∨ j ∈ S

private theorem minCover (G : SimpleGraph (Fin (m+n))) :
    ∃ S : Finset (Fin (m+n)), Cover G S ∧
      ∀ T : Finset (Fin (m+n)), Cover G T → S.card ≤ T.card := by
  classical
  let cs := Finset.univ.filter (Cover G)
  have belongs (T : Finset (Fin (m+n))) : T ∈ cs ↔ Cover G T := by simp [cs]
  have hn : cs.Nonempty := ⟨Finset.univ,(belongs _).mpr (fun _ _ _ => Or.inl (Finset.mem_univ _))⟩
  obtain ⟨S,hs,hmin⟩ := Finset.exists_min_image cs Finset.card hn
  exact ⟨S,(belongs _).mp hs,fun T ht => hmin T ((belongs _).mpr ht)⟩

end PEqualNP.Outside.L_meta_18178_aux

