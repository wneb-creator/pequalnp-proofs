open SimpleGraph

def Acyclic {V : Type*} (G : SimpleGraph V) : Prop :=
  ∀ ⦃v : V⦄ (c : G.Walk v v), ¬ c.IsCycle

theorem Acyclic.anti {V : Type*} {G H : SimpleGraph V} (hsub : G ≤ H)
    (h : Acyclic H) : Acyclic G := by
  intro v p hc
  let f : G →g H := ⟨id, fun h => hsub h⟩
  exact h (p.map f) (hc.map Function.injective_id)

theorem Acyclic.subsingleton_path {V : Type*} {G : SimpleGraph V}
    (h : Acyclic G) (u v : V) : Subsingleton (G.Path u v) := by
  refine ⟨fun p q => ?_⟩
  have := p.isPath.exists_isCycle_of_ne q.isPath
  grind [Acyclic, Subtype.coe_inj]

theorem Acyclic.eq_snd_of_adj_start {V : Type*} {G : SimpleGraph V} (h : Acyclic G)
    {u v w : V} {p : G.Walk u v} (hp : p.IsPath)
    (hadj : G.Adj u w) (hsupp : w ∈ p.support) : w = p.snd := by
  classical
  have := h.subsingleton_path u w |>.elim ⟨_, hp.takeUntil hsupp⟩ <| .singleton hadj
  grind [p.getVert_length_takeUntil hsupp, Path.singleton_coe, Walk.length]

end PEqualNP.Outside.L_meta_18178_aux

