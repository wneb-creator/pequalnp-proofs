namespace TraceBudget

open UnionBudget

def orValues (trace : List (Bool × Nat)) : List Nat :=
  (trace.filter Prod.fst).map Prod.snd

def FalseBase (base : Finset Nat) (trace : List (Bool × Nat)) : Prop :=
  ∀ entry ∈ trace, entry.1 = false → entry.2 ∈ base

def TraceProduced (base : Finset Nat) (trace : List (Bool × Nat)) : Prop :=
  ∀ (before after : List (Bool × Nat)) (value : Nat),
    trace = before ++ (true, value) :: after →
    ∃ a ∈ base ∪ (before.map Prod.snd).toFinset,
    ∃ b ∈ base ∪ (before.map Prod.snd).toFinset, value = a ||| b

lemma orValues_length (trace : List (Bool × Nat)) :
    (orValues trace).length = trace.countP Prod.fst := by
  simp only [orValues, List.length_map, List.countP_eq_length_filter]

lemma source_values {base : Finset Nat} {trace : List (Bool × Nat)}
    (hf : FalseBase base trace) :
    base ∪ (trace.map Prod.snd).toFinset ⊆ base ∪ (orValues trace).toFinset := by
  intro x hx
  rcases Finset.mem_union.mp hx with hx | hx
  · exact Finset.mem_union_left _ hx
  obtain ⟨⟨flag, value⟩, hm, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hx)
  cases flag with
  | false => exact Finset.mem_union_left _ (hf _ hm rfl)
  | true =>
    apply Finset.mem_union_right
    apply List.mem_toFinset.mpr
    exact List.mem_map.mpr ⟨(true, value), List.mem_filter.mpr ⟨hm, rfl⟩, rfl⟩

lemma produced_append {base : Finset Nat} {outputs : List Nat} {value : Nat}
    (hp : Produced base outputs)
    (hv : ∃ a ∈ base ∪ outputs.toFinset, ∃ b ∈ base ∪ outputs.toFinset,
      value = a ||| b) : Produced base (outputs ++ [value]) := by
  intro i hi
  by_cases ho : i < outputs.length
  · obtain ⟨a, ha, b, hb, heq⟩ := hp i ho
    refine ⟨a, ?_, b, ?_, ?_⟩
    · simpa only [List.take_append_of_le_length (Nat.le_of_lt ho)] using ha
    · simpa only [List.take_append_of_le_length (Nat.le_of_lt ho)] using hb
    · simpa only [List.getElem_append_left ho] using heq
  · have he : i = outputs.length := by
      simp only [List.length_append, List.length_singleton] at hi
      omega
    subst i
    simpa using hv

lemma trace_to_produced {base : Finset Nat} {trace : List (Bool × Nat)}
    (hp : TraceProduced base trace) (hf : FalseBase base trace) :
    Produced base (orValues trace) := by
  induction trace using List.reverseRecOn with
  | nil => simp [orValues, Produced]
  | append_singleton before entry ih =>
    have hfp : FalseBase base before := by
      intro e he heflag
      exact hf e (List.mem_append_left _ he) heflag
    have hpp : TraceProduced base before := by
      intro earlier later value he
      apply hp earlier (later ++ [entry]) value
      rw [he]
      simp only [List.append_assoc, List.cons_append]
    have hb := ih hpp hfp
    rcases entry with ⟨flag, value⟩
    cases flag with
    | false => simpa [orValues, List.filter_append] using hb
    | true =>
      have last := hp before [] value (by simp)
      obtain ⟨a, ha, b, hb', heq⟩ := last
      have hv : ∃ a ∈ base ∪ (orValues before).toFinset,
          ∃ b ∈ base ∪ (orValues before).toFinset, value = a ||| b :=
        ⟨a, source_values hfp ha, b, source_values hfp hb', heq⟩
      simpa [orValues, List.filter_append] using produced_append hb hv

lemma traceProduced_of_indexed {base : Finset Nat} {trace : List (Bool × Nat)}
    (hp : ∀ (i : Nat) (hi : i < trace.length), (trace.get ⟨i, hi⟩).1 = true →
      ∃ a ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      ∃ b ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      (trace.get ⟨i, hi⟩).2 = a ||| b) : TraceProduced base trace := by
  intro before after value he
  subst trace
  have hi : before.length < (before ++ (true, value) :: after).length := by simp
  have h := hp before.length hi (by simp)
  simpa using h

lemma trace_to_produced_indexed {base : Finset Nat} {trace : List (Bool × Nat)}
    (hp : ∀ (i : Nat) (hi : i < trace.length), (trace.get ⟨i, hi⟩).1 = true →
      ∃ a ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      ∃ b ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      (trace.get ⟨i, hi⟩).2 = a ||| b) (hf : FalseBase base trace) :
    Produced base (orValues trace) ∧
      (orValues trace).length = trace.countP Prod.fst := by
  exact ⟨trace_to_produced (traceProduced_of_indexed hp) hf, orValues_length trace⟩

-- A true flag marks a retained OR production, regardless of the original gate kind.
-- A false flag marks an omitted entry whose value was already available.
def FalseAvailable (base : Finset Nat) (trace : List (Bool × Nat)) : Prop :=
  ∀ (before after : List (Bool × Nat)) (value : Nat),
    trace = before ++ (false, value) :: after →
    value ∈ base ∪ (before.map Prod.snd).toFinset

lemma falseAvailable_prefix {base : Finset Nat} {before after : List (Bool × Nat)}
    (hf : FalseAvailable base (before ++ after)) : FalseAvailable base before := by
  intro earlier later value he
  apply hf earlier (later ++ after) value
  rw [he]
  simp only [List.append_assoc, List.cons_append]

lemma retained_sources_append {base : Finset Nat} {before after : List (Bool × Nat)} :
    base ∪ (orValues before).toFinset ⊆ base ∪ (orValues (before ++ after)).toFinset := by
  intro x hx
  rcases Finset.mem_union.mp hx with hx | hx
  · exact Finset.mem_union_left _ hx
  apply Finset.mem_union_right
  apply List.mem_toFinset.mpr
  have hm : x ∈ orValues before ++ orValues after :=
    List.mem_append_left _ (List.mem_toFinset.mp hx)
  simpa only [orValues, List.filter_append, List.map_append] using hm

lemma source_values_available {base : Finset Nat} {trace : List (Bool × Nat)}
    (hf : FalseAvailable base trace) :
    base ∪ (trace.map Prod.snd).toFinset ⊆ base ∪ (orValues trace).toFinset := by
  induction trace using List.reverseRecOn with
  | nil => simp [orValues]
  | append_singleton before entry ih =>
    have hfp := falseAvailable_prefix hf
    intro x hx
    rcases Finset.mem_union.mp hx with hx | hx
    · exact Finset.mem_union_left _ hx
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hx)
    rcases List.mem_append.mp he with he | he
    · apply retained_sources_append
      apply ih hfp
      exact Finset.mem_union_right _ (List.mem_toFinset.mpr (List.mem_map.mpr ⟨e, he, rfl⟩))
    · have heq : e = entry := List.mem_singleton.mp he
      subst e
      rcases entry with ⟨flag, value⟩
      cases flag with
      | false =>
        apply retained_sources_append
        exact ih hfp (hf before [] value (by simp))
      | true =>
        apply Finset.mem_union_right
        apply List.mem_toFinset.mpr
        simp [orValues, List.filter_append]

lemma trace_to_produced_available {base : Finset Nat} {trace : List (Bool × Nat)}
    (hp : TraceProduced base trace) (hf : FalseAvailable base trace) :
    Produced base (orValues trace) := by
  induction trace using List.reverseRecOn with
  | nil => simp [orValues, Produced]
  | append_singleton before entry ih =>
    have hfp := falseAvailable_prefix hf
    have hpp : TraceProduced base before := by
      intro earlier later value he
      apply hp earlier (later ++ [entry]) value
      rw [he]
      simp only [List.append_assoc, List.cons_append]
    have hb := ih hpp hfp
    rcases entry with ⟨flag, value⟩
    cases flag with
    | false => simpa [orValues, List.filter_append] using hb
    | true =>
      obtain ⟨a, ha, b, hb', heq⟩ := hp before [] value (by simp)
      have hv : ∃ a ∈ base ∪ (orValues before).toFinset,
          ∃ b ∈ base ∪ (orValues before).toFinset, value = a ||| b :=
        ⟨a, source_values_available hfp ha, b, source_values_available hfp hb', heq⟩
      simpa [orValues, List.filter_append] using produced_append hb hv

lemma falseAvailable_of_falseBase {base : Finset Nat} {trace : List (Bool × Nat)}
    (hf : FalseBase base trace) : FalseAvailable base trace := by
  intro before after value he
  apply Finset.mem_union_left
  apply hf (false, value)
  · rw [he]
    simp
  · rfl

lemma falseAvailable_of_indexed {base : Finset Nat} {trace : List (Bool × Nat)}
    (hf : ∀ (i : Nat) (hi : i < trace.length), (trace.get ⟨i, hi⟩).1 = false →
      (trace.get ⟨i, hi⟩).2 ∈ base ∪ ((trace.take i).map Prod.snd).toFinset) :
    FalseAvailable base trace := by
  intro before after value he
  subst trace
  have hi : before.length < (before ++ (false, value) :: after).length := by simp
  have h := hf before.length hi (by simp)
  simpa using h

lemma trace_to_produced_indexed_available {base : Finset Nat} {trace : List (Bool × Nat)}
    (hp : ∀ (i : Nat) (hi : i < trace.length), (trace.get ⟨i, hi⟩).1 = true →
      ∃ a ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      ∃ b ∈ base ∪ ((trace.take i).map Prod.snd).toFinset,
      (trace.get ⟨i, hi⟩).2 = a ||| b)
    (hf : ∀ (i : Nat) (hi : i < trace.length), (trace.get ⟨i, hi⟩).1 = false →
      (trace.get ⟨i, hi⟩).2 ∈ base ∪ ((trace.take i).map Prod.snd).toFinset) :
    Produced base (orValues trace) ∧
      (orValues trace).length = trace.countP Prod.fst := by
  exact ⟨trace_to_produced_available (traceProduced_of_indexed hp)
    (falseAvailable_of_indexed hf), orValues_length trace⟩

lemma required_retained {base required : Finset Nat} {trace : List (Bool × Nat)}
    (hf : FalseAvailable base trace) (hd : Disjoint required base)
    (hr : required ⊆ (trace.map Prod.snd).toFinset) :
    required ⊆ (orValues trace).toFinset := by
  intro x hx
  have hs := source_values_available hf (Finset.mem_union_right base (hr hx))
  rcases Finset.mem_union.mp hs with hb | ho
  · exact False.elim (Finset.disjoint_left.mp hd hx hb)
  · exact ho

end TraceBudget

namespace TraceBudget

lemma no_five_retained_production (f : List Nat) (trace : List (Bool × Nat))
    (hcatalog : f ∈ FiniteFamilies.families4 ++ FiniteFamilies.families5)
    (hp : TraceProduced FiniteFamilies.base.toFinset trace)
    (hf : FalseAvailable FiniteFamilies.base.toFinset trace)
    (hd : Disjoint f.toFinset FiniteFamilies.base.toFinset)
    (hr : f.toFinset ⊆ (trace.map Prod.snd).toFinset)
    (hlen : trace.countP Prod.fst ≤ 5) : False := by
  apply FiniteFamilies.no_five_or_production f (orValues trace) hcatalog
  · exact trace_to_produced_available hp hf
  · exact required_retained hf hd hr
  · simpa only [orValues_length] using hlen

end TraceBudget

namespace Normalization

def RowRel (target old new : Bool) : Prop :=
  (old = true → new = true) ∧ (target = false → old = new)

def StateRel (target : Fin 40 → Bool)
    (old new : Nat → Fin 40 → Bool) : Prop :=
  ∀ i r, RowRel (target r) (old i r) (new i r)

def gate (g : Bool × Nat × Nat) (s : Nat → Fin 40 → Bool) : Fin 40 → Bool :=
  fun r => if g.1 then s g.2.1 r && s g.2.2 r else s g.2.1 r || s g.2.2 r

def run : List (Bool × Nat × Nat) → Nat →
    (Nat → Fin 40 → Bool) → Nat → Fin 40 → Bool
  | [], _, s => s
  | g :: gs, k, s => run gs (k + 1) (Function.update s k (gate g s))

lemma and_rel (t a b c d : Bool) (ha : RowRel t a c) (hb : RowRel t b d) :
    RowRel t (a && b) (c && d) := by
  cases t <;> cases a <;> cases b <;> cases c <;> cases d <;>
    simp_all [RowRel]

lemma or_rel (t a b c d : Bool) (ha : RowRel t a c) (hb : RowRel t b d) :
    RowRel t (a || b) (c || d) := by
  cases t <;> cases a <;> cases b <;> cases c <;> cases d <;>
    simp_all [RowRel]

lemma gate_rel (target : Fin 40 → Bool) (old new : Nat → Fin 40 → Bool)
    (h : StateRel target old new) (g : Bool × Nat × Nat) (r : Fin 40) :
    RowRel (target r) (gate g old r) (gate g new r) := by
  unfold gate
  split
  · exact and_rel _ _ _ _ _ (h _ _) (h _ _)
  · exact or_rel _ _ _ _ _ (h _ _) (h _ _)

lemma update_rel (target : Fin 40 → Bool) (old new : Nat → Fin 40 → Bool)
    (h : StateRel target old new) (k : Nat) (a b : Fin 40 → Bool)
    (hab : ∀ r, RowRel (target r) (a r) (b r)) :
    StateRel target (Function.update old k a) (Function.update new k b) := by
  intro i r
  by_cases hik : i = k
  · subst i
    simpa using hab r
  · simpa [Function.update_of_ne hik] using h i r

lemma run_rel (target : Fin 40 → Bool) (gs : List (Bool × Nat × Nat))
    (k : Nat) (old new : Nat → Fin 40 → Bool) (h : StateRel target old new) :
    StateRel target (run gs k old) (run gs k new) := by
  induction gs generalizing k old new with
  | nil => exact h
  | cons g gs ih =>
    exact ih (k + 1) _ _ (update_rel target old new h k _ _ (gate_rel target old new h g))

lemma clean_and_to_identity (t a b : Bool) (hc : t = false → a = false) :
    RowRel t (a && b) (a || a) := by
  cases t <;> cases a <;> cases b <;> simp_all [RowRel]

lemma replace_clean_and (target : Fin 40 → Bool) (s : Nat → Fin 40 → Bool)
    (k a b : Nat) (tail : List (Bool × Nat × Nat))
    (hc : ∀ r, target r = false → s a r = false) :
    StateRel target
      (run tail (k + 1) (Function.update s k (gate (true, a, b) s)))
      (run tail (k + 1) (Function.update s k (gate (false, a, a) s))) := by
  apply run_rel
  apply update_rel
  · intro i r
    exact ⟨id, fun _ => rfl⟩
  · intro r
    simpa [gate] using clean_and_to_identity (target r) (s a r) (s b r) (hc r)

lemma exact_target (target old new : Fin 40 → Bool)
    (hrel : ∀ r, RowRel (target r) (old r) (new r)) (h : old = target) :
    new = target := by
  subst old
  funext r
  have hr := hrel r
  cases ht : target r <;> simp_all [RowRel]

lemma dominated_and_to_identity (t a b : Bool)
    (hdom : t = false → a = true → b = true) :
    RowRel t (a && b) (a || a) := by
  cases t <;> cases a <;> cases b <;> simp_all [RowRel]

lemma replace_dominated_and (target : Fin 40 → Bool) (s : Nat → Fin 40 → Bool)
    (k a b : Nat) (tail : List (Bool × Nat × Nat))
    (hdom : ∀ r, target r = false → s a r = true → s b r = true) :
    StateRel target
      (run tail (k + 1) (Function.update s k (gate (true, a, b) s)))
      (run tail (k + 1) (Function.update s k (gate (false, a, a) s))) := by
  apply run_rel
  apply update_rel
  · intro i r
    exact ⟨id, fun _ => rfl⟩
  · intro r
    simpa [gate] using dominated_and_to_identity (target r) (s a r) (s b r) (hdom r)

lemma run_append (before after : List (Bool × Nat × Nat))
    (k : Nat) (s : Nat → Fin 40 → Bool) :
    run (before ++ after) k s = run after (k + before.length) (run before k s) := by
  induction before generalizing k s with
  | nil => simp [run]
  | cons g before ih =>
    simpa [run, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      ih (k + 1) (Function.update s k (gate g s))

lemma replace_dominated_and_exact (target : Fin 40 → Bool)
    (initial : Nat → Fin 40 → Bool) (start output a b : Nat)
    (before tail : List (Bool × Nat × Nat))
    (hdom : ∀ r, target r = false → run before start initial a r = true →
      run before start initial b r = true)
    (hexact : run (before ++ (true, a, b) :: tail) start initial output = target) :
    run (before ++ (false, a, a) :: tail) start initial output = target := by
  rw [run_append, run] at hexact ⊢
  exact exact_target target _ _
    (fun r => replace_dominated_and target (run before start initial)
      (start + before.length) a b tail hdom output r) hexact

lemma replace_dominated_and_count (before tail : List (Bool × Nat × Nat))
    (a b : Nat) :
    (before ++ (false, a, a) :: tail).countP Prod.fst + 1 =
      (before ++ (true, a, b) :: tail).countP Prod.fst := by
  simp [List.countP_append]
  omega

def SourcesValid (allowed : Nat → Prop) : List (Bool × Nat × Nat) → Nat → Prop
  | [], _ => True
  | g :: gs, k => g.2.1 < k ∧ g.2.2 < k ∧ allowed g.2.1 ∧ allowed g.2.2 ∧
      SourcesValid allowed gs (k + 1)

lemma replace_dominated_and_valid (allowed : Nat → Prop)
    (before tail : List (Bool × Nat × Nat)) (start a b : Nat)
    (h : SourcesValid allowed (before ++ (true, a, b) :: tail) start) :
    SourcesValid allowed (before ++ (false, a, a) :: tail) start := by
  induction before generalizing start with
  | nil =>
    simp only [List.nil_append, SourcesValid] at h ⊢
    exact ⟨h.1, h.1, h.2.2.1, h.2.2.1, h.2.2.2.2⟩
  | cons g before ih =>
    simp only [List.cons_append, SourcesValid] at h ⊢
    exact ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, ih (start + 1) h.2.2.2.2⟩

lemma negative_incomparable_of_minimal_and (target : Fin 40 → Bool)
    (initial : Nat → Fin 40 → Bool) (start output a b : Nat)
    (before tail : List (Bool × Nat × Nat)) (allowed : Nat → Prop)
    (hvalid : SourcesValid allowed (before ++ (true, a, b) :: tail) start)
    (hexact : run (before ++ (true, a, b) :: tail) start initial output = target)
    (hmin : ∀ candidate : List (Bool × Nat × Nat),
      candidate.length = (before ++ (true, a, b) :: tail).length →
      SourcesValid allowed candidate start →
      run candidate start initial output = target →
      (before ++ (true, a, b) :: tail).countP Prod.fst ≤ candidate.countP Prod.fst) :
    ¬ (∀ r, target r = false → run before start initial a r = true →
      run before start initial b r = true) := by
  intro hdom
  have hc := hmin (before ++ (false, a, a) :: tail) (by simp)
    (replace_dominated_and_valid allowed before tail start a b hvalid)
    (replace_dominated_and_exact target initial start output a b before tail hdom hexact)
  have hn := replace_dominated_and_count before tail a b
  omega

lemma swap_and_valid (allowed : Nat → Prop)
    (before tail : List (Bool × Nat × Nat)) (start a b : Nat)
    (h : SourcesValid allowed (before ++ (true, a, b) :: tail) start) :
    SourcesValid allowed (before ++ (true, b, a) :: tail) start := by
  induction before generalizing start with
  | nil =>
    simp only [List.nil_append, SourcesValid] at h ⊢
    exact ⟨h.2.1, h.1, h.2.2.2.1, h.2.2.1, h.2.2.2.2⟩
  | cons g before ih =>
    simp only [List.cons_append, SourcesValid] at h ⊢
    exact ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, ih (start + 1) h.2.2.2.2⟩

lemma negative_profiles_incomparable (target : Fin 40 → Bool)
    (initial : Nat → Fin 40 → Bool) (start output a b : Nat)
    (before tail : List (Bool × Nat × Nat)) (allowed : Nat → Prop)
    (hvalid : SourcesValid allowed (before ++ (true, a, b) :: tail) start)
    (hexact : run (before ++ (true, a, b) :: tail) start initial output = target)
    (hmin : ∀ candidate : List (Bool × Nat × Nat),
      candidate.length = (before ++ (true, a, b) :: tail).length →
      SourcesValid allowed candidate start →
      run candidate start initial output = target →
      (before ++ (true, a, b) :: tail).countP Prod.fst ≤ candidate.countP Prod.fst) :
    (¬ ∀ r, target r = false → run before start initial a r = true →
      run before start initial b r = true) ∧
    (¬ ∀ r, target r = false → run before start initial b r = true →
      run before start initial a r = true) := by
  refine ⟨negative_incomparable_of_minimal_and target initial start output a b
    before tail allowed hvalid hexact hmin, ?_⟩
  have hs : run (before ++ (true, b, a) :: tail) start initial output = target := by
    rw [run_append, run] at hexact ⊢
    have hg : gate (true, b, a) (run before start initial) =
        gate (true, a, b) (run before start initial) := by
      funext r
      exact Bool.and_comm _ _
    rw [hg]
    exact hexact
  apply negative_incomparable_of_minimal_and target initial start output b a
    before tail allowed (swap_and_valid allowed before tail start a b hvalid) hs
  intro candidate hlen hv he
  have hh := hmin candidate (by simpa using hlen) hv he
  simpa only [List.countP_append, List.countP_cons] using hh

lemma negative_separator (target left right : Fin 40 → Bool)
    (h : ¬ ∀ r, target r = false → left r = true → right r = true) :
    ∃ r, target r = false ∧ left r = true ∧ right r = false := by
  by_contra hn
  apply h
  intro r ht hl
  cases hr : right r with
  | false => exact False.elim (hn ⟨r, ht, hl, hr⟩)
  | true => rfl


lemma duplicate_gate_kind_change (s : Nat → Fin 40 → Bool) (a : Nat) (op other : Bool) :
    gate (op, a, a) s = gate (other, a, a) s := by
  funext r
  simp [gate]

lemma change_kind_valid (allowed : Nat → Prop)
    (before tail : List (Bool × Nat × Nat)) (start a b : Nat) (op other : Bool)
    (h : SourcesValid allowed (before ++ (op, a, b) :: tail) start) :
    SourcesValid allowed (before ++ (other, a, b) :: tail) start := by
  induction before generalizing start with
  | nil => exact h
  | cons g before ih =>
    simp only [List.cons_append, SourcesValid] at h ⊢
    exact ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, ih (start + 1) h.2.2.2.2⟩

lemma or_inputs_distinct_of_minimal_or (target : Fin 40 → Bool)
    (initial : Nat → Fin 40 → Bool) (start output a b : Nat)
    (before tail : List (Bool × Nat × Nat)) (allowed : Nat → Prop)
    (hvalid : SourcesValid allowed (before ++ (false, a, b) :: tail) start)
    (hexact : run (before ++ (false, a, b) :: tail) start initial output = target)
    (hmin : ∀ candidate : List (Bool × Nat × Nat),
      candidate.length = (before ++ (false, a, b) :: tail).length →
      SourcesValid allowed candidate start →
      run candidate start initial output = target →
      (before ++ (false, a, b) :: tail).countP (fun g => !g.1) ≤
        candidate.countP (fun g => !g.1)) : a ≠ b := by
  intro he
  subst b
  have hs : run (before ++ (true, a, a) :: tail) start initial output = target := by
    rw [run_append, run] at hexact ⊢
    rw [duplicate_gate_kind_change (run before start initial) a true false]
    exact hexact
  have hc := hmin (before ++ (true, a, a) :: tail) (by simp)
    (change_kind_valid allowed before tail start a a false true hvalid) hs
  have hn : (before ++ (true, a, a) :: tail).countP (fun g => !g.1) + 1 =
      (before ++ (false, a, a) :: tail).countP (fun g => !g.1) := by
    simp [List.countP_append]
    omega
  omega

lemma and_inputs_distinct_of_minimal_and (target : Fin 40 → Bool)
    (initial : Nat → Fin 40 → Bool) (start output a b : Nat)
    (before tail : List (Bool × Nat × Nat)) (allowed : Nat → Prop)
    (hvalid : SourcesValid allowed (before ++ (true, a, b) :: tail) start)
    (hexact : run (before ++ (true, a, b) :: tail) start initial output = target)
    (hmin : ∀ candidate : List (Bool × Nat × Nat),
      candidate.length = (before ++ (true, a, b) :: tail).length →
      SourcesValid allowed candidate start →
      run candidate start initial output = target →
      (before ++ (true, a, b) :: tail).countP Prod.fst ≤ candidate.countP Prod.fst) : a ≠ b := by
  intro he
  subst b
  exact negative_incomparable_of_minimal_and target initial start output a a
    before tail allowed hvalid hexact hmin (fun _ _ h => h)
end Normalization

