PEqualNP.Outside.L_meta_1031.OneJunk.Close.one_junk_cover_cost (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]
  (C : PEqualNP.CircuitLowerBounds.Circuit) (htri : ∀ (a b c : Fin n), G.Adj a b → G.Adj b c → ¬G.Adj c a)
  (h4 : PEqualNP.TopForm.NoFourCycle G) (hL : PEqualNP.TopForm.IsLeastAO G C)
  (hjunk1 : (PEqualNP.TopForm.junk G C).card = 1) : PEqualNP.Outside.L_meta_1031.OneJunk.Close.CoverCost G C
def PEqualNP.Outside.L_meta_1031.OneJunk.Close.CoverCost : {n : ℕ} →
  (G : SimpleGraph (Fin n)) → [DecidableRel G.Adj] → PEqualNP.CircuitLowerBounds.Circuit → Prop :=
fun {n} G [DecidableRel G.Adj] C => ∃ T, (∀ e ∈ G.edgeFinset, ∃ v ∈ T, v ∈ e) ∧ G.edgeFinset.card + T.card ≤ C.size + 1
'PEqualNP.Outside.L_meta_1031.OneJunk.Close.one_junk_cover_cost' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
