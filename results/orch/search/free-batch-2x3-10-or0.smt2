(set-logic QF_BV)
(set-option :timeout 30000)
(set-option :produce-models true)
(define-fun f0 () (_ BitVec 6) (_ bv14 6))
(define-fun f1 () (_ BitVec 6) (_ bv21 6))
(define-fun f2 () (_ BitVec 6) (_ bv41 6))
(define-fun f3 () (_ BitVec 6) (_ bv50 6))
(define-fun f4 () (_ BitVec 6) (_ bv60 6))
(declare-const outs0 Bool)
(declare-const outs1 Bool)
(declare-const outs2 Bool)
(declare-const outs3 Bool)
(declare-const outs4 Bool)
(assert (or outs0 outs1 outs2 outs3 outs4))
(define-fun out () (_ BitVec 6) (bvand (ite outs0 f0 (_ bv63 6)) (ite outs1 f1 (_ bv63 6)) (ite outs2 f2 (_ bv63 6)) (ite outs3 f3 (_ bv63 6)) (ite outs4 f4 (_ bv63 6))))
(assert (= out (_ bv3 6)))
(check-sat)
