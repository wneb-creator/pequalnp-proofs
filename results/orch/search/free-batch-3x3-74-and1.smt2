(set-logic QF_BV)
(set-option :timeout 30000)
(set-option :produce-models true)
(define-fun f0 () (_ BitVec 7) (_ bv28 7))
(define-fun f1 () (_ BitVec 7) (_ bv41 7))
(define-fun f2 () (_ BitVec 7) (_ bv42 7))
(define-fun f3 () (_ BitVec 7) (_ bv83 7))
(define-fun f4 () (_ BitVec 7) (_ bv100 7))
(define-fun f5 () (_ BitVec 7) (_ bv120 7))
(declare-const a0s0 Bool)
(declare-const a0s1 Bool)
(declare-const a0s2 Bool)
(declare-const a0s3 Bool)
(declare-const a0s4 Bool)
(declare-const a0s5 Bool)
(assert (or a0s0 a0s1 a0s2 a0s3 a0s4 a0s5))
(define-fun a0 () (_ BitVec 7) (bvor (ite a0s0 f0 (_ bv0 7)) (ite a0s1 f1 (_ bv0 7)) (ite a0s2 f2 (_ bv0 7)) (ite a0s3 f3 (_ bv0 7)) (ite a0s4 f4 (_ bv0 7)) (ite a0s5 f5 (_ bv0 7))))
(assert (not (and (or a0s0 a0s1 a0s2) (or a0s3 a0s4 a0s5))))
(declare-const b0s0 Bool)
(declare-const b0s1 Bool)
(declare-const b0s2 Bool)
(declare-const b0s3 Bool)
(declare-const b0s4 Bool)
(declare-const b0s5 Bool)
(assert (or b0s0 b0s1 b0s2 b0s3 b0s4 b0s5))
(define-fun b0 () (_ BitVec 7) (bvor (ite b0s0 f0 (_ bv0 7)) (ite b0s1 f1 (_ bv0 7)) (ite b0s2 f2 (_ bv0 7)) (ite b0s3 f3 (_ bv0 7)) (ite b0s4 f4 (_ bv0 7)) (ite b0s5 f5 (_ bv0 7))))
(assert (not (and (or b0s0 b0s1 b0s2) (or b0s3 b0s4 b0s5))))
(assert (bvule a0 b0))
(define-fun f6 () (_ BitVec 7) (bvand a0 b0))
(declare-const outs6 Bool)
(assert outs6)
(define-fun out () (_ BitVec 7) (ite outs6 f6 (_ bv0 7)))
(assert (not (and false false)))
(assert (= out (_ bv7 7)))
(check-sat)
