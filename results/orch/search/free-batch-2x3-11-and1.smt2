(set-logic QF_BV)
(set-option :timeout 30000)
(set-option :produce-models true)
(define-fun f0 () (_ BitVec 6) (_ bv13 6))
(define-fun f1 () (_ BitVec 6) (_ bv26 6))
(define-fun f2 () (_ BitVec 6) (_ bv35 6))
(define-fun f3 () (_ BitVec 6) (_ bv52 6))
(define-fun f4 () (_ BitVec 6) (_ bv56 6))
(declare-const a0s0 Bool)
(declare-const a0s1 Bool)
(declare-const a0s2 Bool)
(declare-const a0s3 Bool)
(declare-const a0s4 Bool)
(assert (or a0s0 a0s1 a0s2 a0s3 a0s4))
(define-fun a0 () (_ BitVec 6) (bvor (ite a0s0 f0 (_ bv0 6)) (ite a0s1 f1 (_ bv0 6)) (ite a0s2 f2 (_ bv0 6)) (ite a0s3 f3 (_ bv0 6)) (ite a0s4 f4 (_ bv0 6))))
(assert (not (and (or a0s0 a0s1) (or a0s2 a0s3 a0s4))))
(declare-const b0s0 Bool)
(declare-const b0s1 Bool)
(declare-const b0s2 Bool)
(declare-const b0s3 Bool)
(declare-const b0s4 Bool)
(assert (or b0s0 b0s1 b0s2 b0s3 b0s4))
(define-fun b0 () (_ BitVec 6) (bvor (ite b0s0 f0 (_ bv0 6)) (ite b0s1 f1 (_ bv0 6)) (ite b0s2 f2 (_ bv0 6)) (ite b0s3 f3 (_ bv0 6)) (ite b0s4 f4 (_ bv0 6))))
(assert (not (and (or b0s0 b0s1) (or b0s2 b0s3 b0s4))))
(assert (bvule a0 b0))
(define-fun f5 () (_ BitVec 6) (bvand a0 b0))
(declare-const outs5 Bool)
(assert outs5)
(define-fun out () (_ BitVec 6) (ite outs5 f5 (_ bv0 6)))
(assert (not (and false false)))
(assert (= out (_ bv7 6)))
(check-sat)
