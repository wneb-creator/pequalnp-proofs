GATE CONST0 0 O=CONST0;
GATE CONST1 1 O=CONST1;
GATE BUF 0 O=A;
PIN * NONINV 1 999 0 0 0 0
GATE NOT 1 O=!A;
PIN * INV 1 999 1 0 1 0
GATE AND2 1 O=A*B;
PIN * NONINV 1 999 1 0 1 0
GATE OR2 1 O=A+B;
PIN * NONINV 1 999 1 0 1 0
GATE NAND2 2 O=!(A*B);
PIN * INV 1 999 2 0 2 0
GATE NOR2 2 O=!(A+B);
PIN * INV 1 999 2 0 2 0
