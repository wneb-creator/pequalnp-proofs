(set-logic QF_BV)
(set-option :timeout 30000)
(set-option :produce-models true)
(define-fun f0 () (_ BitVec 7) (_ bv30 7))
(define-fun f1 () (_ BitVec 7) (_ bv41 7))
(define-fun f2 () (_ BitVec 7) (_ bv81 7))
(define-fun f3 () (_ BitVec 7) (_ bv98 7))
(define-fun f4 () (_ BitVec 7) (_ bv100 7))
(declare-const a0s0 Bool)
(declare-const a0s1 Bool)
(declare-const a0s2 Bool)
(declare-const a0s3 Bool)
(declare-const a0s4 Bool)
(assert (or a0s0 a0s1 a0s2 a0s3 a0s4))
(define-fun a0 () (_ BitVec 7) (bvand (ite a0s0 f0 (_ bv127 7)) (ite a0s1 f1 (_ bv127 7)) (ite a0s2 f2 (_ bv127 7)) (ite a0s3 f3 (_ bv127 7)) (ite a0s4 f4 (_ bv127 7))))
(declare-const b0s0 Bool)
(declare-const b0s1 Bool)
(declare-const b0s2 Bool)
(declare-const b0s3 Bool)
(declare-const b0s4 Bool)
(assert (or b0s0 b0s1 b0s2 b0s3 b0s4))
(define-fun b0 () (_ BitVec 7) (bvand (ite b0s0 f0 (_ bv127 7)) (ite b0s1 f1 (_ bv127 7)) (ite b0s2 f2 (_ bv127 7)) (ite b0s3 f3 (_ bv127 7)) (ite b0s4 f4 (_ bv127 7))))
(assert (bvule a0 b0))
(define-fun f5 () (_ BitVec 7) (bvor a0 b0))
(declare-const outs0 Bool)
(declare-const outs1 Bool)
(declare-const outs2 Bool)
(declare-const outs3 Bool)
(declare-const outs4 Bool)
(declare-const outs5 Bool)
(assert (or outs0 outs1 outs2 outs3 outs4 outs5))
(define-fun out () (_ BitVec 7) (bvand (ite outs0 f0 (_ bv127 7)) (ite outs1 f1 (_ bv127 7)) (ite outs2 f2 (_ bv127 7)) (ite outs3 f3 (_ bv127 7)) (ite outs4 f4 (_ bv127 7)) (ite outs5 f5 (_ bv127 7))))
(assert (= out (_ bv7 7)))
(check-sat)
