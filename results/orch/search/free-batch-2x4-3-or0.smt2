(set-logic QF_BV)
(set-option :timeout 30000)
(set-option :produce-models true)
(define-fun f0 () (_ BitVec 4) (_ bv7 4))
(define-fun f1 () (_ BitVec 4) (_ bv12 4))
(define-fun f2 () (_ BitVec 4) (_ bv9 4))
(define-fun f3 () (_ BitVec 4) (_ bv10 4))
(define-fun f4 () (_ BitVec 4) (_ bv12 4))
(define-fun f5 () (_ BitVec 4) (_ bv12 4))
(declare-const outs0 Bool)
(declare-const outs1 Bool)
(declare-const outs2 Bool)
(declare-const outs3 Bool)
(declare-const outs4 Bool)
(declare-const outs5 Bool)
(assert (or outs0 outs1 outs2 outs3 outs4 outs5))
(define-fun out () (_ BitVec 4) (bvand (ite outs0 f0 (_ bv15 4)) (ite outs1 f1 (_ bv15 4)) (ite outs2 f2 (_ bv15 4)) (ite outs3 f3 (_ bv15 4)) (ite outs4 f4 (_ bv15 4)) (ite outs5 f5 (_ bv15 4))))
(assert (= out (_ bv3 4)))
(check-sat)
