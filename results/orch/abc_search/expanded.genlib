GATE ZERO 0 Y=CONST0;
GATE ONE 1 Y=CONST1;
GATE BUF 0 Y=A; PIN * NONINV 1 999 0 0 0 0
GATE INV 1 Y=!A; PIN * INV 1 999 1 0 1 0
GATE AND2 1 Y=A*B; PIN * NONINV 1 999 1 0 1 0
GATE OR2 1 Y=A+B; PIN * NONINV 1 999 1 0 1 0
GATE NAND2 2 Y=!(A*B); PIN * INV 1 999 1 0 1 0
GATE NOR2 2 Y=!(A+B); PIN * INV 1 999 1 0 1 0
GATE ANDNOT2 2 Y=A*!B; PIN * UNKNOWN 1 999 1 0 1 0
GATE ORNOT2 2 Y=A+!B; PIN * UNKNOWN 1 999 1 0 1 0
GATE XOR2 4 Y=(A+B)*!(A*B); PIN * UNKNOWN 1 999 1 0 1 0
GATE XNOR2 4 Y=A*B+!(A+B); PIN * UNKNOWN 1 999 1 0 1 0
GATE AND3 2 Y=A*B*C; PIN * NONINV 1 999 1 0 1 0
GATE OR3 2 Y=A+B+C; PIN * NONINV 1 999 1 0 1 0
GATE AND4 3 Y=A*B*C*D; PIN * NONINV 1 999 1 0 1 0
GATE OR4 3 Y=A+B+C+D; PIN * NONINV 1 999 1 0 1 0
GATE AO21 2 Y=A*B+C; PIN * NONINV 1 999 1 0 1 0
GATE OA21 2 Y=(A+B)*C; PIN * NONINV 1 999 1 0 1 0
GATE AO22 3 Y=A*B+C*D; PIN * NONINV 1 999 1 0 1 0
GATE OA22 3 Y=(A+B)*(C+D); PIN * NONINV 1 999 1 0 1 0
GATE AOI21 3 Y=!(A*B+C); PIN * INV 1 999 1 0 1 0
GATE OAI21 3 Y=!((A+B)*C); PIN * INV 1 999 1 0 1 0
GATE AOI22 4 Y=!(A*B+C*D); PIN * INV 1 999 1 0 1 0
GATE OAI22 4 Y=!((A+B)*(C+D)); PIN * INV 1 999 1 0 1 0
GATE MUX2 4 Y=A*B+!A*C; PIN * UNKNOWN 1 999 1 0 1 0
GATE MAJ3 4 Y=A*B+(A+B)*C; PIN * NONINV 1 999 1 0 1 0
