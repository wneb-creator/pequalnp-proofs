ring r=0,(a,b,x,y,z),dp;
option(redSB);
ideal I=x*y*z - 2,-a^2*z^2 - 2*a^2*z + 2*a^2 - x^2 - 2*x + 2,-a*b*z^2 - 2*a*b*z + 2*a*b,-b^2*z^2 - 2*b^2*z + 2*b^2 - y^2 - 2*y + 2,a^4*z^4 - 4*a^4*z^3 + 8*a^4*z^2 - 8*a^4*z + 4*a^4 - 2*a^2*x^2*z^2 + 4*a^2*x^2*z - 4*a^2*x^2 + 4*a^2*x*z^2 - 8*a^2*x*z + 8*a^2*x - 4*a^2*z^2 + 8*a^2*z - 4*a^2 + x^4 - 4*x^3 + 8*x^2 - 8*x + 4,a^3*b*z^4 - 4*a^3*b*z^3 + 8*a^3*b*z^2 - 8*a^3*b*z + 4*a^3*b - a*b*x^2*z^2 + 2*a*b*x^2*z - 2*a*b*x^2 + 2*a*b*x*z^2 - 4*a*b*x*z + 4*a*b*x - 2*a*b*z^2 + 4*a*b*z - 2*a*b,3*a^2*b^2*z^4 - 12*a^2*b^2*z^3 + 24*a^2*b^2*z^2 - 24*a^2*b^2*z + 12*a^2*b^2 - a^2*y^2*z^2 + 2*a^2*y^2*z - 2*a^2*y^2 + 2*a^2*y*z^2 - 4*a^2*y*z + 4*a^2*y - 2*a^2*z^2 + 4*a^2*z - 2*a^2 - b^2*x^2*z^2 + 2*b^2*x^2*z - 2*b^2*x^2 + 2*b^2*x*z^2 - 4*b^2*x*z + 4*b^2*x - 2*b^2*z^2 + 4*b^2*z - 2*b^2 - x^2*y^2 + 2*x^2*y - 2*x^2 + 2*x*y^2 - 4*x*y + 4*x - 2*y^2 + 4*y - 2,a*b^3*z^4 - 4*a*b^3*z^3 + 8*a*b^3*z^2 - 8*a*b^3*z + 4*a*b^3 - a*b*y^2*z^2 + 2*a*b*y^2*z - 2*a*b*y^2 + 2*a*b*y*z^2 - 4*a*b*y*z + 4*a*b*y - 2*a*b*z^2 + 4*a*b*z - 2*a*b,b^4*z^4 - 4*b^4*z^3 + 8*b^4*z^2 - 8*b^4*z + 4*b^4 - 2*b^2*y^2*z^2 + 4*b^2*y^2*z - 4*b^2*y^2 + 4*b^2*y*z^2 - 8*b^2*y*z + 8*b^2*y - 4*b^2*z^2 + 8*b^2*z - 4*b^2 + y^4 - 4*y^3 + 8*y^2 - 8*y + 4;
matrix T;ideal G=liftstd(I,T);
short=0;print("SIZE");size(G);print("BASIS");G;
int i;for(i=1;i<=nrows(T);i++){print("COEFF");i;print(string(T[i,1]));}
print("IDENTITY_VALID");(matrix(I)*T==matrix(G));print("COMPLETED_CERTIFICATE");quit;
