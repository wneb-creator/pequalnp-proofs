ring r=0,(a,b,x,y,z),dp;
option(redSB);
ideal I=x*y*z - 2,-a^2*y^2 + 2*a^2 - 2*a*z - z^2 + 2,-a*b*y^2 + 2*a*b - a*y - b*z - x,-b^2*y^2 + 2*b^2 - 2*b*y - x^2 + 2,a^4*y^4 - 4*a^4*y^2 + 4*a^4 + 4*a^3*y^2*z - 8*a^3*z - 2*a^2*y^2*z^2 - 4*a^2*y^2 + 8*a^2*z^2 - 4*a^2 - 4*a*z^3 + 8*a*z + z^4 - 4*z^2 + 4,a^3*b*y^4 - 4*a^3*b*y^2 + 4*a^3*b - a^3*y^3 + 2*a^3*y + 3*a^2*b*y^2*z - 6*a^2*b*z + a^2*x*y^2 + 2*a^2*x - 2*a^2*y*z - a*b*y^2*z^2 - 2*a*b*y^2 + 4*a*b*z^2 - 2*a*b - 2*a*x*z + a*y*z^2 + 2*a*y - b*z^3 + 2*b*z + x*z^2 - 2*x,3*a^2*b^2*y^4 - 12*a^2*b^2*y^2 + 12*a^2*b^2 - 6*a^2*b*y^3 + 12*a^2*b*y - a^2*x^2*y^2 - 2*a^2*x^2 + 4*a^2*y^2 - 2*a^2 + 6*a*b^2*y^2*z - 12*a*b^2*z + 4*a*b*x*y^2 + 8*a*b*x - 8*a*b*y*z + 2*a*x^2*z - 4*a*x*y + 4*a*z - b^2*y^2*z^2 - 2*b^2*y^2 + 4*b^2*z^2 - 2*b^2 - 4*b*x*z + 2*b*y*z^2 + 4*b*y - x^2*z^2 + 4*x^2 - 2*z^2 - 2,a*b^3*y^4 - 4*a*b^3*y^2 + 4*a*b^3 - 3*a*b^2*y^3 + 6*a*b^2*y - a*b*x^2*y^2 - 2*a*b*x^2 + 4*a*b*y^2 - 2*a*b + a*x^2*y - 2*a*y + b^3*y^2*z - 2*b^3*z + b^2*x*y^2 + 2*b^2*x - 2*b^2*y*z + b*x^2*z - 2*b*x*y + 2*b*z - x^3 + 2*x,b^4*y^4 - 4*b^4*y^2 + 4*b^4 - 4*b^3*y^3 + 8*b^3*y - 2*b^2*x^2*y^2 - 4*b^2*x^2 + 8*b^2*y^2 - 4*b^2 + 4*b*x^2*y - 8*b*y + x^4 - 4*x^2 + 4;
matrix T;ideal G=liftstd(I,T);
short=0;print("SIZE");size(G);print("BASIS");G;
int i;for(i=1;i<=nrows(T);i++){print("COEFF");i;print(string(T[i,1]));}
print("IDENTITY_VALID");(matrix(I)*T==matrix(G));print("COMPLETED_CERTIFICATE");quit;
