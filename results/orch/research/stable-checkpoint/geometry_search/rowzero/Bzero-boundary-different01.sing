ring r=0,(a,b,c,d),dp;
option(redSB);
ideal I=-a^2 - 4*a*c - c^2 - 1,-a*b - 2*a*d - 2*b*c - c*d,-b^2 - 4*b*d - d^2 + 2,5*a^2*c^2 + 4*a*c^3 + 4*a*c + c^4 + c^2 + 1,5*a^2*c*d + 5*a*b*c^2 + 6*a*c^2*d + 2*a*d + 2*b*c^3 + 2*b*c + 2*c^3*d + c*d,5*a^2*d^2 + 20*a*b*c*d + 12*a*c*d^2 - 4*a*c + 5*b^2*c^2 + 12*b*c^2*d + 4*b*d + 6*c^2*d^2 - 3*c^2 + d^2 - 3,5*a*b*d^2 + 2*a*d^3 - 2*a*d + 5*b^2*c*d + 6*b*c*d^2 - 2*b*c + 2*c*d^3 - 3*c*d,5*b^2*d^2 + 4*b*d^3 - 4*b*d + d^4 - 3*d^2 + 2;
ideal G=std(I);
print("BASIS_SIZE");size(G);print("DIMENSION");dim(G);print("BASIS");G;quit;
