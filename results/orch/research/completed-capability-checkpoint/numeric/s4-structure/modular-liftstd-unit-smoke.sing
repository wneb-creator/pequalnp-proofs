LIB "modular.lib";
proc primeOK(int p,alias list args){return(1);}
proc keepAll(alias list modresults){return(list());}
proc pOK(string command,alias list args,alias def result,int p){return(1);}
proc exactTest(string command,alias list args,alias def result)
{
 matrix D=matrix(args[1])*result-matrix(args[2]);
 ideal residual=D;return(size(residual)==0);
}
proc liftStdUnit(ideal I,ideal E)
{
 matrix T;ideal G=liftstd(I,T);
 int n=size(I);matrix C[n][1];int i;int j;int found=0;
 for(j=1;j<=size(G);j++)
 {
  if(G[j]!=0 && deg(G[j])==0)
  {
   for(i=1;i<=n;i++){C[i,1]=T[i,j]/G[j];}
   found=1;break;
  }
 }
 if(found==0){ERROR("No constant ideal basis element");}
 matrix D=matrix(I)*C-matrix(E);ideal residual=D;
 if(size(residual)!=0){ERROR("Transformation unit identity failed");}
 return(C);
}
ring R=0,(x,y),dp;
ideal I=2*x2+2,3*x;ideal E=1;
matrix C=modular("liftStdUnit",list(I,E),primeOK,keepAll,pOK,exactTest);
print("MODULAR_LIFTSTD_UNIT_CERTIFICATE");C;
print("MODULAR_LIFTSTD_UNIT_RAW_RESIDUAL");matrix(I)*C-matrix(E);
quit;
