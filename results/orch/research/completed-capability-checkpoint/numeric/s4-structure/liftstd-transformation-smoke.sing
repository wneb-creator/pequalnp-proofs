ring r=1000000007,(x,y),dp;
ideal I=2*x^2+2,3*x;
matrix T;
ideal G=liftstd(I,T);
print("BASIS");G;
print("TRANSFORMATION");T;
matrix residual=matrix(I)*T-matrix(G);
print("EXACT_TRANSFORMATION_RESIDUAL");residual;
int i;poly C1;poly C2;poly p;
int found=0;
for(i=1;i<=size(G);i++){
 if(G[i]!=0 && deg(G[i])==0){
  C1=T[1,i]/G[i];C2=T[2,i]/G[i];
  p=C1*I[1]+C2*I[2]-1;
  print("EXACT_UNIT_RESIDUAL");p;C1;C2;
  if(p==0){found=1;}
 }
}
print("FOUND");found;
quit;
