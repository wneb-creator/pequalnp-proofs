ring r=0,(a,b,c,d),dp;
option(redSB);
ideal I=-a^2 - c^2 + 2,-a*b - 2*a - c*d,-b^2 - 4*b - d^2 - 1,c^4 - 3*c^2 + 2,2*a*c^2 - 2*a + 2*c^3*d - 3*c*d,5*a^2 + 8*a*c*d + 4*b*c^2 - 4*b + 6*c^2*d^2 + c^2 - 3*d^2 - 3,5*a*b + 2*a*d^2 + 2*a + 4*b*c*d + 2*c*d^3 + c*d,5*b^2 + 4*b*d^2 + 4*b + d^4 + d^2 + 1;
matrix T;ideal G=liftstd(I,T);print("BASIS_SIZE");size(G);print("BASIS");G;
if(size(G)==1 && G[1]==1){print("CERTIFICATE_START");int j;for(j=1;j<=nrows(T);j++){print(string(T[j,1]));}print("CERTIFICATE_END");print("VERIFIED");matrix(I)*T==matrix(G);}
quit;
