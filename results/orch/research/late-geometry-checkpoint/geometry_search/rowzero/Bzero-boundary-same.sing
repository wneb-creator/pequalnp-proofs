ring r=0,(a,b,c,d),dp;
option(redSB);
ideal I=-a^2 - 4*a - c^2 - 1,-a*b - 2*b - c*d - 2*c,-b^2 - d^2 - 4*d - 1,5*a^2 + 4*a + 1,5*a*b + 4*a*c + 2*b + 2*c,8*a*d + 4*a + 5*b^2 + 8*b*c + 5*c^2 + 4*d + 1,4*b*d + 2*b + 5*c*d + 2*c,5*d^2 + 4*d + 1;
ideal G=std(I);
print("BASIS_SIZE");size(G);print("DIMENSION");dim(G);print("BASIS");G;quit;
