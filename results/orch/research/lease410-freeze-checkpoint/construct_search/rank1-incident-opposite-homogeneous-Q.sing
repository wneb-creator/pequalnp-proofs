LIB "modular.lib";
proc primeOK(int p,alias list args){return(1);}
proc keepAll(alias list modresults){return(list());}
proc pOK(string command,alias list args,alias def result,int p){return(1);}
proc exactTest(string command,alias list args,alias def result)
{
  matrix D=matrix(args[1])*result-matrix(args[2]);
  ideal residual=D;
  return(size(residual)==0);
}

proc homogeneousGraphUnit(ideal I,ideal E)
{
  print("PRIME_HOMOGENEOUS_START");char(basering);
  int n=size(I);matrix A[n+1][n];int i;int j;int bound;
  for(i=1;i<=n;i++){A[1,i]=homog(I[i],h);A[i+1,i]=1;}
  module M=module(A);module G=M;matrix B;matrix C[n][1];
  int oldBound=degBound;int found=0;poly p;poly q;
  for(bound=8;bound<=10;bound++)
  {
    print("HOMOGENEOUS_BOUND_START");bound;degBound=bound;G=slimgb(G+M);
    print("HOMOGENEOUS_BOUND_COMPLETE");bound;B=matrix(G);
    for(j=1;j<=ncols(B);j++)
    {
      p=B[1,j];q=p;
      q=subst(q,x0,0);
      q=subst(q,x1,0);
      q=subst(q,x2,0);
      q=subst(q,x4,0);
      q=subst(q,x6,0);
      q=subst(q,x8,0);
      q=subst(q,x3,0);
      q=subst(q,x5,0);
      q=subst(q,x7,0);
      q=subst(q,x9,0);
      q=subst(q,zz,0);
      if(p!=0 && p==q && subst(p,h,1)!=0)
      {
        for(i=1;i<=n;i++){C[i,1]=subst(B[i+1,j],h,1)/subst(p,h,1);}
        found=1;break;
      }
    }
    if(found){break;}
  }
  degBound=oldBound;
  if(found==0){ERROR("No pure homogenizer component through degree10");}
  matrix D=matrix(I)*C-matrix(E);ideal residual=D;
  if(size(residual)!=0){ERROR("Homogeneous graph identity failed");}
  print("PRIME_UNIT_IDENTITY_VALID");return(C);
}
