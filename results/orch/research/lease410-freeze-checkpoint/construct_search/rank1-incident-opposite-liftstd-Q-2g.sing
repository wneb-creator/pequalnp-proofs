LIB "modular.lib";
proc primeOK(int p,alias list args){return(1);}
proc keepAll(alias list modresults){return(list());}
proc pOK(string command,alias list args,alias def result,int p){return(1);}
proc exactTest(string command,alias list args,alias def result)
{
  matrix D=matrix(args[1])*result-matrix(args[2]);
  ideal residual=D;
  return(size(residual)==0);
}

proc focusedLiftstd(ideal I,ideal E)
{
  print("PRIME_LIFTSTD_START");char(basering);
  matrix T;ideal G=liftstd(I,T);
  print("PRIME_LIFTSTD_COMPLETE");size(G);
  int n=size(I);matrix C[n][1];int i;int j;int found=0;
  for(j=1;j<=size(G);j++)
  {
    if(G[j]!=0 && deg(G[j])==0)
    {
      for(i=1;i<=n;i++){C[i,1]=T[i,j]/G[j];}
      found=1;break;
    }
  }
  if(found==0){ERROR("No constant in ideal basis");}
  matrix D=matrix(I)*C-matrix(E);ideal residual=D;
  if(size(residual)!=0){ERROR("Transformation identity failed");}
  print("PRIME_UNIT_IDENTITY_VALID");print("FP_MODULUS");char(basering);
print("FP_INDEX");1;print("FP_POLYNOMIAL");C[1,1];
print("FP_INDEX");2;print("FP_POLYNOMIAL");C[2,1];
print("FP_INDEX");3;print("FP_POLYNOMIAL");C[3,1];
print("FP_INDEX");4;print("FP_POLYNOMIAL");C[4,1];
print("FP_INDEX");5;print("FP_POLYNOMIAL");C[5,1];
print("FP_INDEX");6;print("FP_POLYNOMIAL");C[6,1];
print("FP_INDEX");7;print("FP_POLYNOMIAL");C[7,1];
print("FP_INDEX");8;print("FP_POLYNOMIAL");0;
print("FP_INDEX");9;print("FP_POLYNOMIAL");C[8,1];
print("FP_INDEX");10;print("FP_POLYNOMIAL");C[9,1];
print("FP_INDEX");11;print("FP_POLYNOMIAL");C[10,1];
print("FP_INDEX");12;print("FP_POLYNOMIAL");C[11,1];
print("FP_INDEX");13;print("FP_POLYNOMIAL");C[12,1];
print("FP_VECTOR_END");return(C);
}
