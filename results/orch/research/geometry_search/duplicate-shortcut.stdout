MIXED [((3, 1), (-4*sqrt(2) - 4)*(B - C)*(B + C*(3 - 2*sqrt(2)) - 4 + 2*sqrt(2))), ((2, 1), (-4*sqrt(2) - 4)*(B - C)*(B + C*(3 - 2*sqrt(2)) - 4 + 2*sqrt(2)))]
BRANCH equal B
COEFF 2 -8*(B**2 + 6*B + 3)
COEFF 3 -16*B*(B + 1)**2
COEFF 4 4*(B**4 - 8*B**3 + 4*B + 1)
GB GroebnerBasis([1], E, B, domain='QQ<sqrt(2)>', order='lex')
