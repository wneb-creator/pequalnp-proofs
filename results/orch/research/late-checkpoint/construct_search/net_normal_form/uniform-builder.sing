ring R=(0,b,c,d),(k,l,m,s,t),dp;
short=0;
number e=(1+b+c+d-c*d)/(b-1);
number f=-1-b-c-d-e;
number aa=f;
number bb=b*e;
number cc=c*d;
number uu=1+f;
number vv=b+e;
number ww=c+d;
number pp=1-f;
number qq=b-e;
number rr=c-d;
number delta=uu*(bb-cc)+vv*(cc-aa)+ww*(aa-bb);
number tau0=d*e*f;
number tau1=b*c*f;
number tau2=c*e;
number tau3=b*d;
number ell0=-2*(tau0+tau1);
number ell1=-2*(tau0+tau2);
number ell2=2*(tau1+tau2);
number row0=1+b+c;
number row1=1+d+e;
number row2=b+d+f;
number row3=c+e+f;
number ds=-tau0/tau2;
number dt=-tau1/tau2;
number fs=(row0+row2*ds)^2+ds*e^2+tau0/(tau1+tau2)*(row0^2+row2^2*ds);
number ft=(row1+row2*dt)^2+dt*c^2;
number fst=2*(row0+row2*ds)*(row1+row2*dt)+f^2+dt*e^2+ds*c^2+tau0/(tau1+tau2)*(row1^2+row2^2*dt);
number b00=-2*tau0*(tau0+2*tau1+tau2)/(tau1+tau2);
number b01=-2*tau1;
number b10=-2*tau0*(tau0+tau2)/(tau1+tau2);
number b11=2*tau1;
number bdet=8*tau0*tau1*tau3/(tau1+tau2);
poly tx=-fs*s/2+(k-fst/4)*t;
poly ty=(-k-fst/4)*s-ft*t/2;
poly mx=(b11*tx-b10*ty)/bdet;
poly my=(-b01*tx+b00*ty)/bdet;
poly mz=(-(row0^2+row2^2*ds)*s/2-(row1^2+row2^2*dt)*t/2-ell0*mx-ell1*my)/ell2;
poly zz=l*s+m*t;
mx=mx-pp/(2*aa)*zz;
my=my-qq/(2*bb)*zz;
mz=mz-rr/(2*cc)*zz;
poly D0=s+zz;
poly D1=t+zz;
poly D2=ds*s+dt*t+zz;
poly D3=zz;
poly traceD=D0+D1+D2+D3;
poly EE=(row0*D0+row1*D1+row2*D2+row3*D3)/2;
poly GG=-traceD/2-pp*mx-qq*my-rr*mz;
poly lx=((vv-ww)*EE-(bb-cc)*GG)/(-delta);
poly ly=(-(uu-ww)*EE+(aa-cc)*GG)/(-delta);
poly lz=-lx-ly;
poly oa=lx+mx;
poly ob=b*(ly+my);
poly oc=c*(lz+mz);
poly od=d*(lz-mz);
poly oe=e*(ly-my);
poly of=f*(lx-mx);
poly orow0=oa+ob+oc;
poly orow1=oa+od+oe;
poly orow2=ob+od+of;
poly orow3=oc+oe+of;
poly Ro=aa*(lx^2-mx^2)+bb*(ly^2-my^2)+cc*(lz^2-mz^2);
poly Q=4*Ro-D0^2-D1^2-D2^2-D3^2-traceD^2/2-4*(D0*orow0+D1*orow1+D2*orow2+D3*orow3);
poly Ttwo=-ell0*lx*mx-ell1*ly*my-ell2*lz*mz-ell2*mx*my-ell1*mx*mz-ell0*my*mz;
poly Ctwo=2*(D0*D1*f+D0*D2*e+D0*D3*d+D1*D2*c+D1*D3*b+D2*D3+D0*row0*orow0+D1*row1*orow1+D2*row2*orow2+D3*row3*orow3+Ttwo);
poly q00=subst(subst(Q,s,1),t,0);
poly q11=subst(subst(Q,s,0),t,1);
poly q01=subst(subst(Q,s,1),t,1)-q00-q11;
poly c00=subst(subst(Ctwo,s,1),t,0);
poly c11=subst(subst(Ctwo,s,0),t,1);
poly c01=subst(subst(Ctwo,s,1),t,1)-c00-c11;
print("EQUATION");print(string(cleardenom(q00)));
print("EQUATION");print(string(cleardenom(q01)));
print("EQUATION");print(string(cleardenom(q11)));
print("EQUATION");print(string(cleardenom(c00)));
print("EQUATION");print(string(cleardenom(c01)));
print("EQUATION");print(string(cleardenom(c11)));
print("HOLLOW_CUBIC");print(string(numerator(tau0+tau1+tau2+tau3)));
number guard=(b-1)*b*c*d*numerator(e)*numerator(f)*numerator(delta)*numerator(tau1+tau2);
print("GUARD");print(string(guard));
print("DONE");
quit;
