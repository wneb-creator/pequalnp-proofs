ring R=0,(z,a,B,c,D),dp;
short=0;
option(redSB);
ideal I=2*B*c + 2*B + 2*D*a + 2*D - a*c - 2*a - 2*c,2*B^3 + 3*B^2*a - 6*B*a + 6*B + a^3 + 6*a^2 + 3*a,2*D^3 + 3*D^2*c - 6*D*c + 6*D + c^3 + 6*c^2 + 3*c,3*B^2 + 6*B*D + 2*B*a - 2*B*c + 3*D^2 - 2*D*a + 2*D*c + a^2 - 2*a*c + c^2,z*a*c-1;

poly Defect=-32*(2*B^2*D^2*a - 2*B^2*D^2*c - B^2*D*a*c - 6*B^2*D*a + 4*B^2*D*c^2 + 6*B^2*D*c - B^2*a*c^2 - B^2*a*c - 2*B^2*c^3 - 6*B^2*c^2 - 4*B*D^2*a^2 + B*D^2*a*c - 6*B*D^2*a + 6*B*D^2*c + 8*B*D*a^2 + 2*B*D*a - 8*B*D*c^2 - 2*B*D*c + B*a^2*c^2 - B*a*c^3 + B*a*c + 2*B*c^3 + 2*B*c^2 + 2*D^2*a^3 + D^2*a^2*c + 6*D^2*a^2 + D^2*a*c + D*a^3*c - 2*D*a^3 - D*a^2*c^2 - 2*D*a^2 - D*a*c + a^3*c - a^2*c - a*c^3 + a*c^2);
ideal J=I+ideal(Defect);
print("LIFT_START");
matrix Cert=lift(J,ideal(1));
matrix Check=matrix(J)*Cert;
print("EXACT_IDENTITY");int(Check[1,1]==1);
int i;int terms=0;for(i=1;i<=nrows(Cert);i++){terms=terms+size(Cert[i,1]);}
print("TOTAL_CERTIFICATE_TERMS");terms;
if(terms<20000){for(i=1;i<=size(J);i++){print("GENERATOR");print(string(J[i]));print("COEFFICIENT");print(string(Cert[i,1]));}}else{print("CERTIFICATE_TOO_LARGE");}
print("DONE");quit;
