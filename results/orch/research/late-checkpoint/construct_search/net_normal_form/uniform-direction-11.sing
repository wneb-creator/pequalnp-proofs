ring R=(0,b,c),(d,k,l),dp;
number s=1;number t=1;
short=0;
poly e=(1+b+c+d-c*d)/(b-1);
poly f=-1-b-c-d-e;
poly ch=d*e*f+b*c*f+c*e+b*d;
ideal HI=std(ideal(ch));
proc red(poly x){return(reduce(x,HI));}
proc inv(poly x){matrix M=lift(ideal(ch,x),ideal(1));return(red(M[2,1]));}
proc denoms(poly x){while(x!=0){print("DENOM");print(string(denominator(leadcoef(x))));x=x-lead(x);}}
denoms(HI[1]);
poly aa=red(f);
poly bb=red(b*e);
poly cc=red(c*d);
poly uu=red(1+f);
poly vv=red(b+e);
poly ww=red(c+d);
poly pp=red(1-f);
poly qq=red(b-e);
poly rr=red(c-d);
poly delta=red(uu*(bb-cc)+vv*(cc-aa)+ww*(aa-bb));
poly tau0=red(d*e*f);
poly tau1=red(b*c*f);
poly tau2=red(c*e);
poly tau3=red(b*d);
poly ell0=red(-2*(tau0+tau1));
poly ell1=red(-2*(tau0+tau2));
poly ell2=red(2*(tau1+tau2));
poly row0=red(1+b+c);
poly row1=red(1+d+e);
poly row2=red(b+d+f);
poly row3=red(c+e+f);
print("INVERSES_START");
poly iaa=inv(aa);denoms(iaa);
poly ibb=inv(bb);denoms(ibb);
poly icc=inv(cc);denoms(icc);
poly itau2=inv(tau2);denoms(itau2);
poly isum12=inv(tau1+tau2);denoms(isum12);
poly idelta=inv(delta);denoms(idelta);
poly ibdet=red((tau1+tau2)*inv(tau0)*inv(tau1)*inv(tau3)/8);denoms(ibdet);
print("INVERSES_DONE");
poly ds=red(-tau0*itau2);
poly dt=red(-tau1*itau2);
poly fs=red((row0+row2*ds)^2+ds*e^2+tau0*isum12*(row0^2+row2^2*ds));
poly ft=red((row1+row2*dt)^2+dt*c^2);
poly fst=red(2*(row0+row2*ds)*(row1+row2*dt)+f^2+dt*e^2+ds*c^2+tau0*isum12*(row1^2+row2^2*dt));
poly b00=red(-2*tau0*(tau0+2*tau1+tau2)*isum12);
poly b01=red(-2*tau1);
poly b10=red(-2*tau0*(tau0+tau2)*isum12);
poly b11=red(2*tau1);
poly bdet=red(8*tau0*tau1*tau3*isum12);
poly tx=red(-fs*s/2+(k-fst/4)*t);
poly ty=red((-k-fst/4)*s-ft*t/2);
poly mx=red((b11*tx-b10*ty)*ibdet);
poly my=red((-b01*tx+b00*ty)*ibdet);
poly mz=red((-(row0^2+row2^2*ds)*s/2-(row1^2+row2^2*dt)*t/2-ell0*mx-ell1*my)*isum12/2);
poly zz=l;
mx=red(mx-pp*iaa/2*zz);
my=red(my-qq*ibb/2*zz);
mz=red(mz-rr*icc/2*zz);
poly D0=red(s+zz);
poly D1=red(t+zz);
poly D2=red(ds*s+dt*t+zz);
poly D3=red(zz);
poly traceD=red(D0+D1+D2+D3);
poly EE=red((row0*D0+row1*D1+row2*D2+row3*D3)/2);
poly GG=red(-traceD/2-pp*mx-qq*my-rr*mz);
poly lx=red(((vv-ww)*EE-(bb-cc)*GG)*(-idelta));
poly ly=red((-(uu-ww)*EE+(aa-cc)*GG)*(-idelta));
poly lz=red(-lx-ly);
poly oa=red(lx+mx);
poly ob=red(b*(ly+my));
poly oc=red(c*(lz+mz));
poly od=red(d*(lz-mz));
poly oe=red(e*(ly-my));
poly of=red(f*(lx-mx));
poly orow0=red(oa+ob+oc);
poly orow1=red(oa+od+oe);
poly orow2=red(ob+od+of);
poly orow3=red(oc+oe+of);
print("RO_START");
print("CHECKPOINT_LAMBDA_MU");print(string(lx));print(string(ly));print(string(lz));print(string(mx));print(string(my));print(string(mz));
poly Ro=red(red(aa*red(lx^2-mx^2))+red(bb*red(ly^2-my^2))+red(cc*red(lz^2-mz^2)));
print("CHECKPOINT_RO");print(string(Ro));print("Q_START");
poly Q=red(4*Ro-D0^2-D1^2-D2^2-D3^2-(traceD^2)/2-4*(D0*orow0+D1*orow1+D2*orow2+D3*orow3));
print("C_START");
poly Ttwo=red(-ell0*lx*mx-ell1*ly*my-ell2*lz*mz-ell2*mx*my-ell1*mx*mz-ell0*my*mz);
poly Ctwo=red(2*(D0*D1*f+D0*D2*e+D0*D3*d+D1*D2*c+D1*D3*b+D2*D3+D0*row0*orow0+D1*row1*orow1+D2*row2*orow2+D3*row3*orow3+Ttwo));
print("EQUATION_Q");print(string(cleardenom(Q)));
print("EQUATION_C");print(string(cleardenom(Ctwo)));
print("HOLLOW_CUBIC");print(string(cleardenom(ch)));
poly guard=red((b-1)*b*c*d*e*f*delta*(tau1+tau2));
print("GUARD");print(string(cleardenom(guard)));
print("DONE");quit;
