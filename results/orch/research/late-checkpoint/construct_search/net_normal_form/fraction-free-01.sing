ring R=0,(k,l,b,c,d,e),(dp(2),dp(4));
short=0;
option(redSB);
int s=0;int t=1;
poly a=1;poly f=-1-b-c-d-e;
poly E=a*b*c*d*e*f;
poly AA=a*f;poly BB=b*e;poly CC=c*d;
poly uu=a+f;poly vv=b+e;poly ww=c+d;poly pp=a-f;poly qq=b-e;poly rr=c-d;
poly delta=uu*(BB-CC)+vv*(CC-AA)+ww*(AA-BB);
poly RH=AA+BB+CC;poly TH=d*e*f+b*c*f+a*c*e+a*b*d;
ideal HI=std(ideal(RH,TH));
matrix H[4][4];
H[1,2]=a;H[2,1]=a;
H[1,3]=b;H[3,1]=b;
H[1,4]=c;H[4,1]=c;
H[2,3]=d;H[3,2]=d;
H[2,4]=e;H[4,2]=e;
H[3,4]=f;H[4,3]=f;
matrix One[4][1]=1,1,1,1;
matrix Rows=H*One;
matrix Tau[4][1]=d*e*f,b*c*f,a*c*e,a*b*d;
matrix Sigma[4][1]=a*b*c,a*d*e,b*d*f,c*e*f;
matrix D[4][1]=a*c*s+l,a*e*t+l,-d*f*s-b*f*t+l,l;
matrix Amat[4][4];matrix hvec[4][1];
Amat[1,1]=Rows[1,1]^2;
hvec[1,1]=-(Rows[1,1]^2)/2+(H[2,3]^2+H[2,4]^2+H[3,4]^2)/4;
Amat[2,2]=Rows[2,1]^2;
hvec[2,1]=-(Rows[2,1]^2)/2+(H[1,3]^2+H[1,4]^2+H[3,4]^2)/4;
Amat[3,3]=Rows[3,1]^2;
hvec[3,1]=-(Rows[3,1]^2)/2+(H[1,2]^2+H[1,4]^2+H[2,4]^2)/4;
Amat[4,4]=Rows[4,1]^2;
hvec[4,1]=-(Rows[4,1]^2)/2+(H[1,2]^2+H[1,3]^2+H[2,3]^2)/4;
Amat[1,2]=Rows[1,1]*Rows[2,1]+(H[3,4]^2)/2;Amat[2,1]=Amat[1,2];
Amat[1,3]=Rows[1,1]*Rows[3,1]+(H[2,4]^2)/2;Amat[3,1]=Amat[1,3];
Amat[1,4]=Rows[1,1]*Rows[4,1]+(H[2,3]^2)/2;Amat[4,1]=Amat[1,4];
Amat[2,3]=Rows[2,1]*Rows[3,1]+(H[1,4]^2)/2;Amat[3,2]=Amat[2,3];
Amat[2,4]=Rows[2,1]*Rows[4,1]+(H[1,3]^2)/2;Amat[4,2]=Amat[2,4];
Amat[3,4]=Rows[3,1]*Rows[4,1]+(H[1,2]^2)/2;Amat[4,3]=Amat[3,4];
matrix Cmat[4][4];int ii;int jj;
for(ii=1;ii<=4;ii++){for(jj=1;jj<=4;jj++){Cmat[ii,jj]=-Amat[ii,jj]/2+(hvec[jj,1]-hvec[ii,1])/4;}}
matrix Raw=Cmat*D;for(ii=1;ii<=4;ii++){Raw[ii,1]=Sigma[ii,1]*Raw[ii,1];}
poly mean=(Raw[1,1]+Raw[2,1]+Raw[3,1]+Raw[4,1])/4;
matrix Kdiv[4][4];
Kdiv[1,2]=1*Tau[2,1]*(Tau[3,1]-Tau[4,1]);Kdiv[2,1]=-(1)*Tau[1,1]*(Tau[3,1]-Tau[4,1]);
Kdiv[1,3]=-1*Tau[3,1]*(Tau[2,1]-Tau[4,1]);Kdiv[3,1]=-(-1)*Tau[1,1]*(Tau[2,1]-Tau[4,1]);
Kdiv[1,4]=1*Tau[4,1]*(Tau[2,1]-Tau[3,1]);Kdiv[4,1]=-(1)*Tau[1,1]*(Tau[2,1]-Tau[3,1]);
Kdiv[2,3]=1*Tau[3,1]*(Tau[1,1]-Tau[4,1]);Kdiv[3,2]=-(1)*Tau[2,1]*(Tau[1,1]-Tau[4,1]);
Kdiv[2,4]=-1*Tau[4,1]*(Tau[1,1]-Tau[3,1]);Kdiv[4,2]=-(-1)*Tau[2,1]*(Tau[1,1]-Tau[3,1]);
Kdiv[3,4]=1*Tau[4,1]*(Tau[1,1]-Tau[2,1]);Kdiv[4,3]=-(1)*Tau[3,1]*(Tau[1,1]-Tau[2,1]);
matrix Nu=Raw-mean*One+k*Kdiv*D;
poly mx=(Nu[3,1]+Nu[4,1])/2;poly my=(Nu[2,1]+Nu[4,1])/2;poly mz=(Nu[2,1]+Nu[3,1])/2;
poly ER=E*(Rows[1,1]*D[1,1]+Rows[2,1]*D[2,1]+Rows[3,1]*D[3,1]+Rows[4,1]*D[4,1])/2;
poly EG=-E*(D[1,1]+D[2,1]+D[3,1]+D[4,1])/2-pp*mx-qq*my-rr*mz;
poly lx=-(vv-ww)*ER+(BB-CC)*EG;poly ly=(uu-ww)*ER-(AA-CC)*EG;poly lz=-lx-ly;
poly oa=a*(lx+delta*mx);poly ob=b*(ly+delta*my);poly oc=c*(lz+delta*mz);poly od=d*(lz-delta*mz);poly oe=e*(ly-delta*my);poly of=f*(lx-delta*mx);
matrix Diag=E*delta*D;
matrix ORows[4][1]=oa+ob+oc,oa+od+oe,ob+od+of,oc+oe+of;
poly traceD=Diag[1,1]+Diag[2,1]+Diag[3,1]+Diag[4,1];
poly Ro=oa*of+ob*oe+oc*od;
print("CHART_BUILT");
poly Q=4*Ro-(traceD^2)/2;for(ii=1;ii<=4;ii++){Q=Q-Diag[ii,1]^2-4*Diag[ii,1]*ORows[ii,1];}
poly Ttwo=a*ob*od+oa*b*od+oa*ob*d+a*oc*oe+oa*c*oe+oa*oc*e+b*oc*of+ob*c*of+ob*oc*f+d*oe*of+od*e*of+od*oe*f;
poly Ctwo=Diag[1,1]*Diag[2,1]*f+Diag[1,1]*Diag[3,1]*e+Diag[1,1]*Diag[4,1]*d+Diag[2,1]*Diag[3,1]*c+Diag[2,1]*Diag[4,1]*b+Diag[3,1]*Diag[4,1]*a+Ttwo;
for(ii=1;ii<=4;ii++){Ctwo=Ctwo+Diag[ii,1]*Rows[ii,1]*ORows[ii,1];}Ctwo=2*Ctwo;
print("RAW_TERM_COUNTS");size(Q);size(Ctwo);
Q=reduce(Q,HI);Ctwo=reduce(Ctwo,HI);
print("REDUCED_TERM_COUNTS");size(Q);size(Ctwo);
ideal GF=b,c,d,e,f,delta;
proc strip(poly v){int index;int count;poly rem;matrix quot;for(index=1;index<=6;index++){count=0;while(v!=0 && count<40){rem=reduce(v,std(ideal(GF[index])));if(rem!=0){break;}quot=lift(ideal(GF[index]),ideal(v));v=quot[1,1];count++;}print("STRIPPED_GUARD_FACTOR");index;count;}return(cleardenom(v));}
Q=strip(Q);Ctwo=strip(Ctwo);
print("FINAL_TERM_COUNTS");size(Q);size(Ctwo);
print("DEGREES");deg(Q);deg(Ctwo);
if(size(Q)<=5000 && size(Ctwo)<=5000){print("EQUATION_Q");print(string(Q));print("EQUATION_C");print(string(Ctwo));}else{print("EXPORT_TOO_LARGE");}
print("HOLLOW_QUADRATIC");print(string(RH));print("HOLLOW_CUBIC");print(string(TH));print("GUARD");print(string(b*c*d*e*f*delta));
print("DONE");quit;
