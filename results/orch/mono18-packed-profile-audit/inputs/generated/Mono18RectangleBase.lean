def spec (m : Nat) : Nat × Nat × Nat × Nat × Nat := specs.getD m (0, 0, 0, 1, 0)
def rowCount (m : Nat) : Nat := (spec m).1
def colCount (m : Nat) : Nat := (spec m).2.1

def weight (m r c : Nat) : Int :=
  let s := spec m
  Int.ofNat ((s.2.2.2.2 >>> (s.2.2.2.1 * (r * s.2.1 + c))) &&& ((1 <<< s.2.2.2.1) - 1)) - Int.ofNat s.2.2.1

def mask (n bits : Nat) : List Nat := (List.range n).filter (fun i => bits.testBit i)
def posMask (m code : Nat) : Nat := code &&& ((1 <<< rowCount m) - 1)
def negMask (m code : Nat) : Nat := code >>> rowCount m

def checkCode (m : Nat) (cap : Int) (code : Nat) : Bool :=
  RectanglePackedCheck.check (weight m) (mask (rowCount m) (posMask m code))
    (mask (colCount m) (negMask m code)) cap

abbrev Certificate := Sigma (fun mc : Nat × Int =>
  {xs : List Nat // xs.all (checkCode mc.1 mc.2) = true})

lemma mask_nodup (n bits : Nat) : (mask n bits).Nodup := List.Nodup.filter _ List.nodup_range

lemma bounds_of_code {R : Type} {p q : Nat} (P : Fin p → R) (N : Fin q → R)
    (m : Nat) (cap : Int) (code : Nat) (v : Wire R)
    (valid : checkCode m cap code = true)
    (positive : ∀ r, v (P r) = true → r.val ∈ mask (rowCount m) (posMask m code))
    (negative : ∀ c, v (N c) = false → c.val ∈ mask (colCount m) (negMask m code)) :
    Bounds P N (fun r c => weight m r.val c.val) v cap := by
  exact RectanglePackedCheck.bounds_of_check P N (weight m) _ _ v cap
    (mask_nodup _ _) (mask_nodup _ _) valid positive negative

lemma certificate_valid (g : Certificate) (code : Nat) (member : code ∈ g.2.val) :
    checkCode g.1.1 g.1.2 code = true := List.all_eq_true.mp g.2.property code member

def recordCap (m record : Nat) : Int := Int.ofNat (record >>> (rowCount m + colCount m))
def recordCode (m record : Nat) : Nat := record &&& ((1 <<< (rowCount m + colCount m)) - 1)
def checkRecord (m record : Nat) : Bool := checkCode m (recordCap m record) (recordCode m record)

abbrev Block := Sigma (fun m : Nat => {xs : List Nat // xs.all (checkRecord m) = true})

lemma block_valid (g : Block) (record : Nat) (member : record ∈ g.2.val) :
    checkRecord g.1 record = true := List.all_eq_true.mp g.2.property record member

lemma bounds_of_record {R : Type} {p q : Nat} (P : Fin p → R) (N : Fin q → R)
    (m record : Nat) (v : Wire R) (valid : checkRecord m record = true)
    (positive : ∀ r, v (P r) = true →
      r.val ∈ mask (rowCount m) (posMask m (recordCode m record)))
    (negative : ∀ c, v (N c) = false →
      c.val ∈ mask (colCount m) (negMask m (recordCode m record))) :
    Bounds P N (fun r c => weight m r.val c.val) v (recordCap m record) :=
  bounds_of_code P N m (recordCap m record) (recordCode m record) v valid positive negative

