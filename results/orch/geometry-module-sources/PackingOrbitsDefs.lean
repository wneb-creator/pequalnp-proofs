def label (i j : Fin 325) : Nat :=
  (labelWord i >>> (6 * (j.val - i.val - 1))) &&& 63

def depth (i j : Fin 325) : Nat := label i j / 4

def selector (i j : Fin 325) : Fin 4 := ⟨label i j % 4, Nat.mod_lt _ (by decide)⟩

def parent (i j : Fin 325) : Fin 325 × Fin 325 :=
  let a := pairPerm (selector i j) i
  let b := pairPerm (selector i j) j
  (min a b, max a b)

def valid (i j : Fin 325) : Prop := i.val < j.val ∧ pairMask i &&& pairMask j = 0

def roots : List (Fin 325 × Fin 325) := [(0, 49), (0, 51), (0, 59), (0, 60), (0, 61), (0, 62), (0, 63), (0, 77), (0, 81), (0, 82), (0, 83), (0, 87), (0, 247), (0, 248), (0, 259), (0, 261), (0, 270), (0, 273), (12, 37), (12, 38), (12, 40), (12, 60), (12, 62), (13, 38), (13, 40), (13, 86), (13, 87)]

def localCheck (i j : Fin 325) : Bool :=
  if valid i j then
    if depth i j = 0 then decide ((i, j) ∈ roots)
    else decide (valid (parent i j).1 (parent i j).2 ∧
      depth (parent i j).1 (parent i j).2 < depth i j)
  else true

def pairLabel (i : Fin 325) : Nat :=
  ( >>> (6 * i.val)) &&& 63

def pairDepth (i : Fin 325) : Nat := pairLabel i / 4

def pairSelector (i : Fin 325) : Fin 4 := ⟨pairLabel i % 4, Nat.mod_lt _ (by decide)⟩

def pairParent (i : Fin 325) : Fin 325 := pairPerm (pairSelector i) i

def pairRoots : List (Fin 325) := [0, 12, 59]

def pairLocalCheck (i : Fin 325) : Bool :=
  if pairDepth i = 0 then decide (i ∈ pairRoots)
  else decide (pairDepth (pairParent i) < pairDepth i)

def vertexLabel (v : Fin 26) : Nat :=
