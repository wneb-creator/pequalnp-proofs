lemma classified_24 : ∀ i : Fin 128,
    let m : Fin 8192 := ⟨128 * 24 + i.val, by omega⟩
    AllRows.admissible (decode m) → AllRows.points (rowFor m) = decode m := by
  unfold AllRows.admissible
  decide +kernel

