hAO : TopForm.IsAO2 15 C
hcomp :
  ∀ (z : Fin 15 → Bool),
    circuitFun 15 C z = decide (∃ p l, I p l ∧ z (Fin.castAdd 10 p) = true ∧ z (Fin.natAdd 5 l) = true)
hread : ReadK.IsReadK 15 C 1
z : Fin 15 → Bool
⊢ decide (∃ p l, I p l ∧ z (Fin.castAdd 10 p) = true ∧ z (Fin.natAdd 5 l) = true) =
    decide (∃ u v, G.Adj u v ∧ z u = true ∧ z v = true)
