        omega
      have hsame := hDiffUniq _ d1a _ d1b _ d2a _ d2b heq_diff hne_diff
      have hwp : Fin.ofNat 13 w1.val = Fin.ofNat 13 w2.val := sub_left_inj.mp hsame
      ext
      have hval := congrArg Fin.val hwp
      simp only [Fin.val_ofNat, Nat.mod_eq_of_lt hw1_lt, Nat.mod_eq_of_lt hw2_lt] at hval
      exact hval
  -- Edge count |E(G)| = 52 via bijection with S × Fin 13.
  let mkEdge : Fin 13 × Fin 13 → Sym2 (Fin 26) :=
    fun dp => s(Fin.castAdd 13 dp.2, Fin.natAdd 13 (dp.2 - dp.1))
  have hmkEdge_inj : Function.Injective mkEdge := by
    intro dp1 dp2 heq
    have hcases := Sym2.eq_iff.mp heq
    rcases hcases with ⟨h1, h2⟩ | ⟨h1, _⟩
    · have hp : dp1.2 = dp2.2 := by
        ext; have := congrArg Fin.val h1; simpa using this
      have hl : dp1.2 - dp1.1 = dp2.2 - dp2.1 := by
        ext; have := congrArg Fin.val h2; simp [Fin.natAdd] at this; omega
      have hd : dp1.1 = dp2.1 := sub_right_inj.mp (hp ▸ hl)
      exact Prod.ext hd hp
    · exfalso
      have := congrArg Fin.val h1
      simp [Fin.natAdd] at this
      omega
  have hGedges_eq : G.edgeFinset = (S ×ˢ (Finset.univ : Finset (Fin 13))).image mkEdge := by
    ext e
    induction e using Sym2.ind with
    | _ u v =>
      rw [SimpleGraph.mem_edgeFinset, G.mem_edgeSet, hGiff, Finset.mem_image]
      constructor
      · rintro ⟨p, l, hpl, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩
        · refine ⟨(p - l, p), Finset.mem_product.mpr ⟨hpl, Finset.mem_univ p⟩, ?_⟩
          simp [mkEdge]
        · refine ⟨(p - l, p), Finset.mem_product.mpr ⟨hpl, Finset.mem_univ p⟩, ?_⟩
          simp [mkEdge, Sym2.eq_swap]
      · rintro ⟨⟨d, p⟩, hmem, heq⟩
        have hd : d ∈ S := (Finset.mem_product.mp hmem).1
        have hcases := Sym2.eq_iff.mp heq
        rcases hcases with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · exact ⟨p, p - d, by simpa using hd, Or.inl ⟨h1.symm, h2.symm⟩⟩
        · exact ⟨p, p - d, by simpa using hd, Or.inr ⟨h1.symm, h2.symm⟩⟩
  have hScard : S.card = 4 := by decide
  have hGcard : G.edgeFinset.card = 52 := by
    rw [hGedges_eq, Finset.card_image_of_injective _ hmkEdge_inj, Finset.card_product,
      hScard, Finset.card_univ, Fintype.card_fin]
  -- Four-matching vertex-cover bound: for any U and vertex cover K of G \ U, 52 <= 4*|K| + |U|.
  have hMatch : ∀ (U : Finset (Sym2 (Fin 26))) (K : Finset (Fin 26)),
      CoverPromise.IsVertexCover (G.deleteEdges ↑U) K → 52 ≤ 4 * K.card + U.card := by
    intro U K hK
    have hPerD : ∀ d ∈ S,
        13 ≤ K.card + (Finset.univ.filter fun p : Fin 13 => mkEdge (d, p) ∈ U).card := by
      intro d hd
      let A := Finset.univ.filter fun p : Fin 13 => Fin.castAdd 13 p ∈ K
      let B := Finset.univ.filter fun p : Fin 13 => Fin.natAdd 13 (p - d) ∈ K
      let M := Finset.univ.filter fun p : Fin 13 => mkEdge (d, p) ∈ U
      have hcov : (Finset.univ : Finset (Fin 13)) ⊆ A ∪ B ∪ M := by
        intro p _
        by_cases hU : mkEdge (d, p) ∈ U
        · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ p, hU⟩)
        · have hadj : (G.deleteEdges ↑U).Adj (Fin.castAdd 13 p) (Fin.natAdd 13 (p - d)) := by
            rw [SimpleGraph.deleteEdges_adj]
            refine ⟨(hGiff _ _).mpr ⟨p, p - d, by simpa using hd, Or.inl ⟨rfl, rfl⟩⟩, ?_⟩
            exact fun hmem => hU (Finset.mem_coe.mp hmem)
          rcases hK _ _ hadj with h1 | h2
          · exact Finset.mem_union_left _ (Finset.mem_union_left _
              (Finset.mem_filter.mpr ⟨Finset.mem_univ p, h1⟩))
          · exact Finset.mem_union_left _ (Finset.mem_union_right _
              (Finset.mem_filter.mpr ⟨Finset.mem_univ p, h2⟩))
      have hAB : A.card + B.card ≤ K.card := by
        let iA : Finset (Fin 26) := A.image (Fin.castAdd 13)
        let iB : Finset (Fin 26) := B.image (fun p => Fin.natAdd 13 (p - d))
        have hdisj : Disjoint iA iB := by
          rw [Finset.disjoint_left]
          intro v hvA hvB
          obtain ⟨p1, _, rfl⟩ := Finset.mem_image.mp hvA
          obtain ⟨p2, _, hEq⟩ := Finset.mem_image.mp hvB
          have := congrArg Fin.val hEq
          simp [Fin.natAdd] at this
          omega
        have hsub : iA ∪ iB ⊆ K := by
          intro v hv
          rcases Finset.mem_union.mp hv with hv | hv
          · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hv
            exact (Finset.mem_filter.mp hp).2
          · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hv
            exact (Finset.mem_filter.mp hp).2
        have hinjA : Function.Injective (Fin.castAdd 13 : Fin 13 → Fin 26) := by
          intro p1 p2 h; ext; simpa using congrArg Fin.val h
        have hinjB : Function.Injective (fun p : Fin 13 => Fin.natAdd 13 (p - d)) := by
          intro p1 p2 h
          have hval : p1 - d = p2 - d := by
            ext; have := congrArg Fin.val h; simp [Fin.natAdd] at this; omega
          exact sub_left_inj.mp hval
        have hcardA : iA.card = A.card := Finset.card_image_of_injective _ hinjA
        have hcardB : iB.card = B.card := Finset.card_image_of_injective _ hinjB
        have hle := Finset.card_le_card hsub
        rw [Finset.card_union_of_disjoint hdisj, hcardA, hcardB] at hle
        exact hle
      have h13 : 13 ≤ (A ∪ B ∪ M).card := by
        have := Finset.card_le_card hcov
        simpa [Fintype.card_fin] using this
      have hle1 := Finset.card_union_le (A ∪ B) M
      have hle2 := Finset.card_union_le A B
      change 13 ≤ K.card + M.card
      omega
    have hsum1 : ∑ _d ∈ S, 13 ≤
        ∑ d ∈ S, (K.card + (Finset.univ.filter fun p : Fin 13 => mkEdge (d, p) ∈ U).card) :=
      Finset.sum_le_sum hPerD
    rw [Finset.sum_const, hScard, smul_eq_mul, Finset.sum_add_distrib, Finset.sum_const,
      hScard, smul_eq_mul] at hsum1
    have hsumU : (∑ d ∈ S, (Finset.univ.filter fun p : Fin 13 => mkEdge (d, p) ∈ U).card) ≤
        U.card := by
      have hbi : (∑ d ∈ S, (Finset.univ.filter fun p : Fin 13 => mkEdge (d, p) ∈ U).card) =
          ((S ×ˢ (Finset.univ : Finset (Fin 13))).filter fun dp => mkEdge dp ∈ U).card := by
        rw [Finset.card_eq_sum_ones, Finset.sum_filter, Finset.sum_product]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [Finset.card_eq_sum_ones, Finset.sum_filter]
      rw [hbi]
      have hsub : (((S ×ˢ (Finset.univ : Finset (Fin 13))).filter fun dp => mkEdge dp ∈ U).image
          mkEdge) ⊆ U := by
        intro e he
        obtain ⟨dp, hdp, rfl⟩ := Finset.mem_image.mp he
        exact (Finset.mem_filter.mp hdp).2
      calc ((S ×ˢ (Finset.univ : Finset (Fin 13))).filter fun dp => mkEdge dp ∈ U).card
          = (((S ×ˢ (Finset.univ : Finset (Fin 13))).filter fun dp => mkEdge dp ∈ U).image
              mkEdge).card :=
            (Finset.card_image_of_injective _ hmkEdge_inj).symm
        _ ≤ U.card := Finset.card_le_card hsub
    omega
  -- Every subgraph G \ U has a minimum vertex cover.
  have hExMinCover : ∀ U : Finset (Sym2 (Fin 26)),
      ∃ K : Finset (Fin 26), IsMinCover (G.deleteEdges ↑U) K := by
    classical
    intro U
    let covers := (Finset.univ : Finset (Finset (Fin 26))).filter
      fun K => CoverPromise.IsVertexCover (G.deleteEdges ↑U) K
    have hcne : covers.Nonempty := by
      refine ⟨Finset.univ, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩⟩
      intro u v _; exact Or.inl (Finset.mem_univ u)
    obtain ⟨K, hKmem, hKmin⟩ := Finset.exists_min_image covers Finset.card hcne
    exact ⟨K, (Finset.mem_filter.mp hKmem).2, fun K' hK' =>
      hKmin K' (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hK'⟩)⟩
  -- Convert computesIncidence D into circuitFun 26 D = graphFun G ∅.
  have hFunD : circuitFun 26 D = graphFun G ∅ := by
    funext x
    change D.eval (List.ofFn x) =
      (decide (∃ a ∈ (∅ : Finset (Fin 26)), x a = true) ||
        decide (∃ u v : Fin 26, G.Adj u v ∧ x u = true ∧ x v = true))
    simp only [Finset.notMem_empty, false_and, exists_false, decide_false, Bool.false_or]
    rw [Bool.eq_iff_iff, hComp x, decide_eq_true_eq]
    constructor
    · rintro ⟨p, l, hpl, hp, hl⟩
      exact ⟨Fin.castAdd 13 p, Fin.natAdd 13 l, (hGiff _ _).mpr ⟨p, l, hpl, Or.inl ⟨rfl, rfl⟩⟩,
        hp, hl⟩
    · rintro ⟨u, v, huv, hu, hv⟩
      obtain ⟨p, l, hpl, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ := (hGiff u v).mp huv
      · exact ⟨p, l, hpl, hu, hv⟩
      · exact ⟨p, l, hpl, hv, hu⟩
  -- Step 1: Normalize D to a least TopForm circuit C with C.size <= D.size.
  obtain ⟨C, hLeast, hTop, hCD⟩ := h_norm 26 G D hGne hMono hFunD
  suffices h64 : 64 ≤ C.size by omega
  have hAO : IsAO2 26 C := hLeast.1
  have hFunC : circuitFun 26 C = graphFun G ∅ := hLeast.2.1
  have hMinC : ∀ C' : Circuit, IsAO2 26 C' → circuitFun 26 C' = graphFun G ∅ → C.size ≤ C'.size :=
    hLeast.2.2
  have hCount := h_count 26 G C hG4 hGne hLeast hTop
  have hGateCount := hCount.1
  have hCoverBound := hCount.2
  rw [hGcard] at hGateCount
  have hNoOne : (junk G C).card ≠ 1 := h_no_one_junk 26 G C (fun v => decide (v.val < 13))
    hGbip hG4 hLeast
  -- Wire-evaluation helpers for IsAO2 circuits.
  have hgetD_append_lt : ∀ (l : List Bool) (b : Bool) (i : ℕ), i < l.length →
      (l ++ [b]).getD i false = l.getD i false := by
    intro l b i hi
    simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hi]
  have hgetD_append_eq : ∀ (l : List Bool) (b : Bool),
      (l ++ [b]).getD l.length false = b := by
    intro l b
    simp [List.getD_eq_getElem?_getD]
  have hgetD_ge : ∀ (l : List Bool) (i : ℕ), l.length ≤ i →
      l.getD i false = false := by
    intro l i hi
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hi]
  let stepW : List Bool → Gate → List Bool :=
    fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
  have hfold_len : ∀ (gs : List Gate) (w : List Bool),
      (gs.foldl stepW w).length = w.length + gs.length := by
    intro gs
    induction gs with
    | nil => intro w; simp
    | cons g gs ih =>
      intro w
      rw [List.foldl_cons, ih]
      simp [stepW]
      omega
  have hfold_lt : ∀ (gs : List Gate) (w : List Bool) (i : ℕ), i < w.length →
      (gs.foldl stepW w).getD i false = w.getD i false := by
    intro gs
    induction gs with
    | nil => intro _ _ _; rfl
    | cons g gs ih =>
      intro w i hi
      rw [List.foldl_cons, ih (stepW w g) i (by simp [stepW]; omega)]
      exact hgetD_append_lt w _ i hi
  have hfold_char : ∀ (gs : List Gate) (w : List Bool) (j : ℕ), j < gs.length →
      (gs.foldl stepW w).getD (w.length + j) false =
        (gs.getD j ⟨GateOp.or, []⟩).op.eval
          ((gs.getD j ⟨GateOp.or, []⟩).inputs.map fun i =>
            if i < w.length + j then (gs.foldl stepW w).getD i false else false) := by
    intro gs
    induction gs using List.reverseRecOn with
    | nil => intro _ _ hj; simp at hj
    | append_singleton gs g ih =>
      intro w j hj
      rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
      have hlen : (gs.foldl stepW w).length = w.length + gs.length := hfold_len gs w
      by_cases hjlt : j < gs.length
      · have h1 : (stepW (gs.foldl stepW w) g).getD (w.length + j) false =
            (gs.foldl stepW w).getD (w.length + j) false :=
          hgetD_append_lt _ _ _ (by rw [hlen]; omega)
        have h2 : (gs ++ [g]).getD j ⟨GateOp.or, []⟩ = gs.getD j ⟨GateOp.or, []⟩ := by
          simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hjlt]
        rw [h1, h2, ih w j hjlt]
        congr 1
        refine List.map_congr_left fun i _ => ?_
        split_ifs with hi
        · exact (hgetD_append_lt _ _ _ (by rw [hlen]; omega)).symm
        · rfl
      · have hjeq : j = gs.length := by simp at hj; omega
        subst hjeq
        have h1 : (stepW (gs.foldl stepW w) g).getD (w.length + gs.length) false =
            g.op.eval (g.inputs.map fun i => (gs.foldl stepW w).getD i false) := by
          rw [← hlen]
          exact hgetD_append_eq (gs.foldl stepW w) _
        have h2 : (gs ++ [g]).getD gs.length ⟨GateOp.or, []⟩ = g := by
          simp [List.getD_eq_getElem?_getD]
        rw [h1, h2]
        congr 1
        refine List.map_congr_left fun i _ => ?_
        split_ifs with hi
        · exact (hgetD_append_lt _ _ _ (by rw [hlen]; omega)).symm
        · exact hgetD_ge _ _ (by rw [hlen]; omega)
  have hval_in : ∀ (A : Circuit) (x : Fin 26 → Bool) (i : ℕ) (hi : i < 26),
      (A.wires (List.ofFn x)).getD i false = x ⟨i, hi⟩ := by
    intro A x i hi
    change (A.gates.foldl stepW (List.ofFn x)).getD i false = x ⟨i, hi⟩
    rw [hfold_lt A.gates (List.ofFn x) i (by simp [hi])]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, hi, ↓reduceDIte, Option.getD_some]
  have hval_gate : ∀ (A : Circuit), ReadsBack 26 A → ∀ (x : Fin 26 → Bool) (j : ℕ),
      j < A.gates.length →
      (A.wires (List.ofFn x)).getD (26 + j) false =
        (gateAt A j).op.eval ((gateAt A j).inputs.map fun i =>
          (A.wires (List.ofFn x)).getD i false) := by
    intro A hRB x j hj
    have hch := hfold_char A.gates (List.ofFn x) j hj
    rw [List.length_ofFn] at hch
    change (A.gates.foldl stepW (List.ofFn x)).getD (26 + j) false = _
    rw [hch]
    congr 1
    refine List.map_congr_left fun i hi => ?_
    have hlt : i < 26 + j := hRB j hj i hi
    simp only [hlt, ↓reduceIte]
    rfl
  have hval_ge : ∀ (A : Circuit) (x : Fin 26 → Bool) (w : ℕ), 26 + A.gates.length ≤ w →
      (A.wires (List.ofFn x)).getD w false = false := by
    intro A x w hw
    change (A.gates.foldl stepW (List.ofFn x)).getD w false = false
    have hlen : (A.gates.foldl stepW (List.ofFn x)).length = 26 + A.gates.length := by
      rw [hfold_len, List.length_ofFn]
    exact hgetD_ge _ _ (by rw [hlen]; exact hw)
  -- Characterization of orSets and cones (definitional `change` avoids generating `.eq_1` lemmas).
  have hgate_mem : ∀ (A : Circuit) (j : ℕ), j < A.gates.length → gateAt A j ∈ A.gates := by
    intro A j hj
    change A.gates.getD j ⟨GateOp.or, []⟩ ∈ A.gates
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
    exact List.getElem_mem hj
  have horSets_len : ∀ (gs : List Gate) (cs : List (List ℕ)),
      (gs.foldl (orStep 26) cs).length = cs.length + gs.length := by
    intro gs
    induction gs with
    | nil => intro cs; simp
    | cons g gs ih =>
      intro cs
      rw [List.foldl_cons, ih]
      have h1 : (orStep 26 cs g).length = cs.length + 1 := by
        change (cs ++ [_]).length = cs.length + 1
        rw [List.length_append, List.length_singleton]
      rw [h1, List.length_cons]
      omega
  have horSets_char : ∀ (gs : List Gate) (j : ℕ), j < gs.length →
      (gs.foldl (orStep 26) []).getD j [] =
        j :: (if (gs.getD j ⟨GateOp.or, []⟩).op = GateOp.or then
          ((gs.getD j ⟨GateOp.or, []⟩).inputs.filter (fun w => decide (26 ≤ w ∧ w < 26 + j))).flatMap
            (fun w => (gs.foldl (orStep 26) []).getD (w - 26) [])
          else []) := by
    intro gs
    induction gs using List.reverseRecOn with
    | nil => intro _ hj; simp at hj
    | append_singleton gs g ih =>
      intro j hj
      rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
      have hlen : (gs.foldl (orStep 26) []).length = gs.length := by
        rw [horSets_len]; simp
      have hget : ∀ k, k < gs.length →
          (orStep 26 (gs.foldl (orStep 26) []) g).getD k [] =
            (gs.foldl (orStep 26) []).getD k [] := by
        intro k hk
        change ((gs.foldl (orStep 26) []) ++ [_]).getD k [] = (gs.foldl (orStep 26) []).getD k []
        rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega : k < (gs.foldl (orStep 26) []).length),
          ← List.getD_eq_getElem?_getD]
      by_cases hjlt : j < gs.length
      · have h2 : (gs ++ [g]).getD j ⟨GateOp.or, []⟩ = gs.getD j ⟨GateOp.or, []⟩ := by
          simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hjlt]
        rw [hget j hjlt, ih j hjlt, h2]
        congr 1
        split_ifs with hop
        · refine List.flatMap_congr fun w hw => ?_
          have hw' := (List.mem_filter.mp hw).2
          simp only [decide_eq_true_eq] at hw'
          exact (hget (w - 26) (by omega)).symm
        · rfl
      · have hjeq : j = gs.length := by simp at hj; omega
        subst hjeq
        have h2 : (gs ++ [g]).getD gs.length ⟨GateOp.or, []⟩ = g := by
          simp [List.getD_eq_getElem?_getD]
        have h1 : (orStep 26 (gs.foldl (orStep 26) []) g).getD gs.length [] =
            gs.length :: (if g.op = GateOp.or then
              (g.inputs.filter (fun w => decide (26 ≤ w ∧ w < 26 + gs.length))).flatMap
                (fun w => (gs.foldl (orStep 26) []).getD (w - 26) [])
              else []) := by
          change ((gs.foldl (orStep 26) []) ++
            [(gs.foldl (orStep 26) []).length :: (if g.op = GateOp.or then
              (g.inputs.filter (fun w => decide (26 ≤ w ∧ w < 26 + (gs.foldl (orStep 26) []).length))).flatMap
                (fun w => (gs.foldl (orStep 26) []).getD (w - 26) [])
              else [])]).getD gs.length [] = _
          rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hlen, Nat.sub_self]
          rfl
        rw [h1, h2]
        congr 1
        split_ifs with hop
        · refine List.flatMap_congr fun w hw => ?_
          have hw' := (List.mem_filter.mp hw).2
          simp only [decide_eq_true_eq] at hw'
          exact (hget (w - 26) (by omega)).symm
        · rfl
  have hcones_len : ∀ (gs : List Gate) (cs : List (List ℕ)),
      (gs.foldl (coneStep 26) cs).length = cs.length + gs.length := by
    intro gs
    induction gs with
    | nil => intro cs; simp
    | cons g gs ih =>
      intro cs
      rw [List.foldl_cons, ih]
      have h1 : (coneStep 26 cs g).length = cs.length + 1 := by
        change (cs ++ [_]).length = cs.length + 1
        rw [List.length_append, List.length_singleton]
      rw [h1, List.length_cons]
      omega
  have hcones_char : ∀ (gs : List Gate) (i j : ℕ),
      i ∈ (gs.foldl (coneStep 26) []).getD j [] ↔
        j < gs.length ∧ ∃ w ∈ (gs.getD j ⟨GateOp.or, []⟩).inputs, 26 ≤ w ∧ w < 26 + j ∧
          (i = w - 26 ∨ i ∈ (gs.foldl (coneStep 26) []).getD (w - 26) []) := by
    intro gs
    induction gs using List.reverseRecOn with
    | nil => intro _ _; simp
    | append_singleton gs g ih =>
      intro i j
      rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
      have hlen : (gs.foldl (coneStep 26) []).length = gs.length := by
        rw [hcones_len]; simp
      have hget : ∀ k, k < gs.length →
          (coneStep 26 (gs.foldl (coneStep 26) []) g).getD k [] =
            (gs.foldl (coneStep 26) []).getD k [] := by
        intro k hk
        change ((gs.foldl (coneStep 26) []) ++ [_]).getD k [] = (gs.foldl (coneStep 26) []).getD k []
        rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega : k < (gs.foldl (coneStep 26) []).length),
          ← List.getD_eq_getElem?_getD]
      rcases Nat.lt_trichotomy j gs.length with hlt | heq | hgt
      · have e1 : (gs ++ [g]).getD j ⟨GateOp.or, []⟩ = gs.getD j ⟨GateOp.or, []⟩ := by
          simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hlt]
        rw [hget j hlt, ih i j, e1]
        constructor
        · rintro ⟨_, w, hw, h1, h2, h3⟩
          refine ⟨by simp; omega, w, hw, h1, h2, ?_⟩
          rw [hget (w - 26) (by omega)]
          exact h3
        · rintro ⟨_, w, hw, h1, h2, h3⟩
          refine ⟨hlt, w, hw, h1, h2, ?_⟩
          rw [hget (w - 26) (by omega)] at h3
          exact h3
      · subst heq
        have e1 : (gs ++ [g]).getD gs.length ⟨GateOp.or, []⟩ = g := by
          simp [List.getD_eq_getElem?_getD]
        have e2 : (coneStep 26 (gs.foldl (coneStep 26) []) g).getD gs.length [] =
            (g.inputs.filter (fun w => decide (26 ≤ w ∧ w < 26 + gs.length))).flatMap
              (fun w => (w - 26) :: (gs.foldl (coneStep 26) []).getD (w - 26) []) := by
          change ((gs.foldl (coneStep 26) []) ++
            [(g.inputs.filter (fun w => decide (26 ≤ w ∧ w < 26 + (gs.foldl (coneStep 26) []).length))).flatMap
              (fun w => (w - 26) :: (gs.foldl (coneStep 26) []).getD (w - 26) [])]).getD gs.length [] = _
          rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hlen, Nat.sub_self]
          rfl
        rw [e2, e1]
        simp only [List.mem_flatMap, List.mem_filter, List.mem_cons, decide_eq_true_eq]
        constructor
        · rintro ⟨w, ⟨hw, h1, h2⟩, h3⟩
          refine ⟨by simp, w, hw, h1, h2, ?_⟩
          rw [hget (w - 26) (by omega)]
          exact h3
        · rintro ⟨_, w, hw, h1, h2, h3⟩
          refine ⟨w, ⟨hw, h1, h2⟩, ?_⟩
          rw [hget (w - 26) (by omega)] at h3
          exact h3
      · have hnone : (coneStep 26 (gs.foldl (coneStep 26) []) g).getD j [] = [] := by
          have hlen2 : (coneStep 26 (gs.foldl (coneStep 26) []) g).length = gs.length + 1 := by
            change ((gs.foldl (coneStep 26) []) ++ [_]).length = gs.length + 1
            rw [List.length_append, List.length_singleton, hlen]
          simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by omega : (coneStep 26 (gs.foldl (coneStep 26) []) g).length ≤ j)]
        rw [hnone]
        simp only [List.not_mem_nil, List.length_append, List.length_singleton, false_iff]
        intro h; omega
  -- Case split on (junk G C).card: 0, 1 (impossible), or >= 2.
  by_cases hj0 : (junk G C).card = 0
  · -- Case |junk| = 0: show Ustar = ∅, then 4-matching + h_count gives 64 <= C.size.
    have hjEmpty : junk G C = ∅ := Finset.card_eq_zero.mp hj0
    let OrStep : ℕ → ℕ → Prop := fun w w' =>
      ∃ j, j < C.gates.length ∧ w = 26 + j ∧ (gateAt C j).op = GateOp.or ∧
        w' ∈ (gateAt C j).inputs ∧ w' < 26 + j
    have horStep_up : ∀ (x : Fin 26 → Bool) (w w' : ℕ),
        Relation.ReflTransGen OrStep w w' →
        (C.wires (List.ofFn x)).getD w' false = true →
        (C.wires (List.ofFn x)).getD w false = true := by
      intro x w w' hr
      induction hr with
      | refl => exact id
      | tail _ hstep ih =>
        intro hv
        apply ih
        obtain ⟨j, hj, rfl, hop, hmem, _⟩ := hstep
        rw [hval_gate C hAO.2.1 x j hj, hop]
        change ((gateAt C j).inputs.map fun i => (C.wires (List.ofFn x)).getD i false).any id = true
        simp only [List.any_map, Function.comp_apply, id_eq, List.any_eq_true]
        exact ⟨_, hmem, hv⟩
    have hor_trace : ∀ (x : Fin 26 → Bool) (w : ℕ),
        (C.wires (List.ofFn x)).getD w false = true →
        ∃ w', Relation.ReflTransGen OrStep w w' ∧
          (C.wires (List.ofFn x)).getD w' false = true ∧
          (w' < 26 ∨ ∃ h, h < C.gates.length ∧ w' = 26 + h ∧ (gateAt C h).op = GateOp.and) := by
      intro x w
      induction w using Nat.strong_induction_on with
      | _ w ih =>
        intro hv
        by_cases hw26 : w < 26
        · exact ⟨w, Relation.ReflTransGen.refl, hv, Or.inl hw26⟩
        · have hjlt : w - 26 < C.gates.length := by
            by_contra hge
            have := hval_ge C x w (by omega)
            rw [this] at hv
            exact Bool.false_ne_true hv
          have hweq : 26 + (w - 26) = w := by omega
          rcases hAO.1 (gateAt C (w - 26)) (hgate_mem C (w - 26) hjlt) with hand | hor
          · exact ⟨w, Relation.ReflTransGen.refl, hv, Or.inr ⟨w - 26, hjlt, hweq.symm, hand⟩⟩
          · rw [← hweq, hval_gate C hAO.2.1 x (w - 26) hjlt, hor] at hv
            change ((gateAt C (w - 26)).inputs.map fun i => (C.wires (List.ofFn x)).getD i false).any id = true at hv
            simp only [List.any_map, Function.comp_apply, id_eq, List.any_eq_true] at hv
            obtain ⟨u, humem, huv⟩ := hv
            have hult : u < w := by
              have := hAO.2.1 (w - 26) hjlt u humem
              omega
            obtain ⟨w', hr, hvw', hend⟩ := ih u hult huv
            exact ⟨w', Relation.ReflTransGen.head ⟨w - 26, hjlt, hweq.symm, hor, humem, by omega⟩ hr,
              hvw', hend⟩
    have horStep_inCone : ∀ (w h : ℕ),
        Relation.ReflTransGen OrStep w (26 + h) →
        ∀ a, a < C.gates.length → w ∈ (gateAt C a).inputs → w < 26 + a →
        InCone 26 C h a := by
      intro w h hr
      induction hr using Relation.ReflTransGen.head_induction_on with
      | refl =>
        intro a ha hwin hwlt
        change h ∈ (C.gates.foldl (coneStep 26) []).getD a []
        rw [hcones_char]
        exact ⟨ha, 26 + h, hwin, by omega, hwlt, Or.inl (by omega)⟩
      | @head w1 w2 hstep _ ih =>
        intro a ha hwin hwlt
        obtain ⟨j, hj, rfl, _, hmem, hlt⟩ := hstep
        have hsub : h ∈ (C.gates.foldl (coneStep 26) []).getD j [] := ih j hj hmem hlt
        change h ∈ (C.gates.foldl (coneStep 26) []).getD a []
        rw [hcones_char]
        exact ⟨ha, 26 + j, hwin, by omega, hwlt, Or.inr (by rwa [Nat.add_sub_cancel_left])⟩
    have horStep_orIn : ∀ (w : ℕ) (t : Fin 26),
        Relation.ReflTransGen OrStep w t.val → t ∈ orIn 26 C w := by
      intro w t hr
      induction hr using Relation.ReflTransGen.head_induction_on with
      | refl =>
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ t, Or.inl rfl⟩
      | @head w1 w2 hstep _ ih =>
        obtain ⟨j, hj, rfl, hop, hmem, hlt⟩ := hstep
        have ih2 := (Finset.mem_filter.mp ih).2
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ t, Or.inr ?_⟩
        rcases ih2 with htw2 | ⟨k, hk, hreach, hkop, htmem⟩
        · refine ⟨j, hj, ?_, hop, by rwa [htw2]⟩
          refine ⟨by omega, ?_⟩
          change j ∈ (C.gates.foldl (orStep 26) []).getD (26 + j - 26) []
          rw [Nat.add_sub_cancel_left, horSets_char C.gates j hj]
          exact List.mem_cons_self
        · refine ⟨k, hk, ?_, hkop, htmem⟩
          refine ⟨by omega, ?_⟩
          change k ∈ (C.gates.foldl (orStep 26) []).getD (26 + j - 26) []
          rw [Nat.add_sub_cancel_left, horSets_char C.gates j hj]
          have hop' : (C.gates.getD j ⟨GateOp.or, []⟩).op = GateOp.or := hop
          simp only [hop', ↓reduceIte, List.mem_cons, List.mem_flatMap,
            List.mem_filter, decide_eq_true_eq]
          right
          exact ⟨w2, ⟨hmem, hreach.1, hlt⟩, hreach.2⟩
    have hUempty : Ustar G C = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro e he
      induction e using Sym2.ind with
      | _ u v =>
        obtain ⟨huv_mem, hnotstar⟩ := Finset.mem_sdiff.mp he
        have huv : G.Adj u v := G.mem_edgeSet.mp (SimpleGraph.mem_edgeFinset.mp huv_mem)
        have hFuv : graphFun G ∅ (pairInput u v) = true := by
          change (decide (∃ a ∈ (∅ : Finset (Fin 26)), pairInput u v a = true) ||
            decide (∃ a b : Fin 26, G.Adj a b ∧ pairInput u v a = true ∧ pairInput u v b = true)) = true
          rw [Bool.or_eq_true]
          right
          rw [decide_eq_true_eq]
          exact ⟨u, v, huv,
            by change decide (u = u ∨ u = v) = true; simp,
            by change decide (v = u ∨ v = v) = true; simp⟩
        have hout_uv : (C.wires (List.ofFn (pairInput u v))).getD C.output false = true := by
          have h := congrFun hFunC (pairInput u v)
          change (C.wires (List.ofFn (pairInput u v))).getD C.output false = graphFun G ∅ (pairInput u v) at h
          rw [h, hFuv]
        obtain ⟨w', hr_out, hvw', hend⟩ := hor_trace (pairInput u v) C.output hout_uv
        rcases hend with hwlt | ⟨a, ha, rfl, haand⟩
        · exfalso
          let t : Fin 26 := ⟨w', hwlt⟩
          have ht : (C.wires (List.ofFn (pairInput t t))).getD w' false = true := by
            rw [hval_in C (pairInput t t) w' hwlt]
            change decide (t = t ∨ t = t) = true
            simp
          have hout_tt := horStep_up (pairInput t t) C.output w' hr_out ht
          have hFtt : graphFun G ∅ (pairInput t t) = true := by
            have h := congrFun hFunC (pairInput t t)
            change (C.wires (List.ofFn (pairInput t t))).getD C.output false =
              graphFun G ∅ (pairInput t t) at h
            rw [← h, hout_tt]
          change (decide (∃ a ∈ (∅ : Finset (Fin 26)), pairInput t t a = true) ||
            decide (∃ a1 a2 : Fin 26, G.Adj a1 a2 ∧ decide (a1 = t ∨ a1 = t) = true ∧
              decide (a2 = t ∨ a2 = t) = true)) = true at hFtt
          simp only [Finset.notMem_empty, false_and, exists_false, decide_false,
            Bool.false_or, decide_eq_true_eq, or_self] at hFtt
          obtain ⟨a1, a2, hadj, ha1, ha2⟩ := hFtt
          subst ha1; subst ha2
          exact G.irrefl hadj
        · have hbelA : BelowF G C a := by
            intro x hx
            have hox := horStep_up x C.output (26 + a) hr_out hx
            have h := congrFun hFunC x
            change (C.wires (List.ofFn x)).getD C.output false = graphFun G ∅ x at h
            rw [← h, hox]
          have hatop : a ∈ tops G C :=
            Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ha, haand, hbelA⟩
          have halen : (gateAt C a).inputs.length = 2 :=
            hAO.2.2 (gateAt C a) (hgate_mem C a ha)
          obtain ⟨p, q, hlist⟩ := List.length_eq_two.mp halen
          have hp_lt : p < 26 + a := hAO.2.1 a ha p (by rw [hlist]; simp)
          have hq_lt : q < 26 + a := hAO.2.1 a ha q (by rw [hlist]; simp)
          rw [hval_gate C hAO.2.1 (pairInput u v) a ha, haand, hlist] at hvw'
          change (([p, q].map fun i => (C.wires (List.ofFn (pairInput u v))).getD i false).all id) = true at hvw'
          simp only [List.map_cons, List.map_nil, List.all_cons, List.all_nil,
            id_eq, Bool.and_true, Bool.and_eq_true] at hvw'
          obtain ⟨hpv, hqv⟩ := hvw'
          have hno_junk_under : ∀ w, w ∈ (gateAt C a).inputs → w < 26 + a →
              ∀ h, h < C.gates.length → (gateAt C h).op = GateOp.and →
              Relation.ReflTransGen OrStep w (26 + h) → False := by
            intro w hwin hwlt h hh hhand hrw
            have hcone : InCone 26 C h a := horStep_inCone w h hrw a ha hwin hwlt
            have hnb : ¬ BelowF G C h := fun hbh => hTop h hh a ha hhand hbh haand hcone
            have hdirty : IsDirtyAnd 26 G C h := by
              refine ⟨hhand, hh, ?_⟩
              by_contra hnone
              apply hnb
              intro x hx
              by_contra hfx
              exact hnone ⟨x, hx, Bool.eq_false_iff.mpr hfx⟩
            have hmem : h ∈ junk G C :=
              Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hh, hdirty⟩
            rw [hjEmpty] at hmem
            exact Finset.notMem_empty h hmem
          obtain ⟨w1, hr1, hvw1, hend1⟩ := hor_trace (pairInput u v) p hpv
          obtain ⟨w2, hr2, hvw2, hend2⟩ := hor_trace (pairInput u v) q hqv
          rcases hend1 with hw1lt | ⟨h, hh, rfl, hhand⟩
          · rcases hend2 with hw2lt | ⟨h, hh, rfl, hhand⟩
            · let t1 : Fin 26 := ⟨w1, hw1lt⟩
              let t2 : Fin 26 := ⟨w2, hw2lt⟩
              have ht1uv : t1 = u ∨ t1 = v := by
                rw [hval_in C (pairInput u v) w1 hw1lt] at hvw1
                change decide (t1 = u ∨ t1 = v) = true at hvw1
                exact decide_eq_true_eq.mp hvw1
              have ht2uv : t2 = u ∨ t2 = v := by
                rw [hval_in C (pairInput u v) w2 hw2lt] at hvw2
                change decide (t2 = u ∨ t2 = v) = true at hvw2
                exact decide_eq_true_eq.mp hvw2
              have ha_t12 : (C.wires (List.ofFn (pairInput t1 t2))).getD (26 + a) false = true := by
                rw [hval_gate C hAO.2.1 (pairInput t1 t2) a ha, haand, hlist]
                change (([p, q].map fun i => (C.wires (List.ofFn (pairInput t1 t2))).getD i false).all id) = true
                simp only [List.map_cons, List.map_nil, List.all_cons, List.all_nil,
                  id_eq, Bool.and_true, Bool.and_eq_true]
                constructor
                · apply horStep_up (pairInput t1 t2) p w1 hr1
                  rw [hval_in C (pairInput t1 t2) w1 hw1lt]
                  change decide (t1 = t1 ∨ t1 = t2) = true
                  simp
                · apply horStep_up (pairInput t1 t2) q w2 hr2
                  rw [hval_in C (pairInput t1 t2) w2 hw2lt]
                  change decide (t2 = t1 ∨ t2 = t2) = true
                  simp
              have hFt12 : graphFun G ∅ (pairInput t1 t2) = true := hbelA (pairInput t1 t2) ha_t12
              have hadj12 : G.Adj t1 t2 := by
                change (decide (∃ a ∈ (∅ : Finset (Fin 26)), pairInput t1 t2 a = true) ||
                  decide (∃ b1 b2 : Fin 26, G.Adj b1 b2 ∧ decide (b1 = t1 ∨ b1 = t2) = true ∧
                    decide (b2 = t1 ∨ b2 = t2) = true)) = true at hFt12
                simp only [Finset.notMem_empty, false_and, exists_false, decide_false,
                  Bool.false_or, decide_eq_true_eq] at hFt12
                obtain ⟨b1, b2, hbadj, hb1, hb2⟩ := hFt12
                rcases hb1 with rfl | rfl <;> rcases hb2 with rfl | rfl
                · exact (G.irrefl hbadj).elim
                · exact hbadj
                · exact hbadj.symm
                · exact (G.irrefl hbadj).elim
              have hne12 : t1 ≠ t2 := G.ne_of_adj hadj12
              have hseq : s(u, v) = s(t1, t2) := by
                rcases ht1uv with h1 | h1 <;> rcases ht2uv with h2 | h2
                · exact (hne12 (h1.trans h2.symm)).elim
                · rw [h1, h2]
                · rw [h1, h2, Sym2.eq_swap]
                · exact (hne12 (h1.trans h2.symm)).elim
              apply hnotstar
              rw [hseq]
              refine Finset.mem_biUnion.mpr
                ⟨a, hatop, Finset.mem_image.mpr ⟨(t1, t2), Finset.mem_product.mpr ⟨?_, ?_⟩, rfl⟩⟩
              · change t1 ∈ orIn 26 C ((gateAt C a).inputs.getD 0 0)
                rw [hlist]
                exact horStep_orIn p t1 hr1
              · change t2 ∈ orIn 26 C ((gateAt C a).inputs.getD 1 0)
                rw [hlist]
                exact horStep_orIn q t2 hr2
            · exact hno_junk_under q (by rw [hlist]; simp) hq_lt h hh hhand hr2
          · exact hno_junk_under p (by rw [hlist]; simp) hp_lt h hh hhand hr1
    obtain ⟨K, hKmin⟩ := hExMinCover (Ustar G C)
    have hKm := hMatch (Ustar G C) K hKmin.1
    have hKc := hCoverBound K hKmin
    rw [hUempty] at hGateCount hKm
    rw [Finset.card_empty] at hGateCount hKm
    omega
  · -- Now 2 <= (junk G C).card.
    have hj2 : 2 ≤ (junk G C).card := by omega
    by_cases hU4 : 4 ≤ (Ustar G C).card
    · have hGiff' : ∀ u v : Fin 26, G.Adj u v ↔
          ∃ p l : Fin 13, (p - l = 0 ∨ p - l = 1 ∨ p - l = 3 ∨ p - l = 9) ∧
            ((u = Fin.castAdd 13 p ∧ v = Fin.natAdd 13 l) ∨
             (v = Fin.castAdd 13 p ∧ u = Fin.natAdd 13 l)) := by
        intro u v
        rw [hGiff u v]
        constructor
        · rintro ⟨p, l, hpl, hpair⟩
          exact ⟨p, l, by simpa [S] using hpl, hpair⟩
        · rintro ⟨p, l, hpl, hpair⟩
          exact ⟨p, l, by simpa [S] using hpl, hpair⟩
      exact h_core G C hGiff' hLeast hTop hj2 hU4 hGateCount hCoverBound
    · -- Case |Ustar| <= 3 and |junk| >= 2: use maximal junk gate to get 1 <= 2|Z| + |orN \ lam|.
      have hU3 : (Ustar G C).card ≤ 3 := by omega
      have hjne : (junk G C).Nonempty := Finset.card_pos.mp (by omega)
      let h := (junk G C).max' hjne
      have hhmem : h ∈ junk G C := Finset.max'_mem (junk G C) hjne
      have hh_max : ∀ j ∈ junk G C, j ≤ h := fun j hj => Finset.le_max' (junk G C) j hj
      have hh_dirty : IsDirtyAnd 26 G C h := (Finset.mem_filter.mp hhmem).2
      have hhand : (gateAt C h).op = GateOp.and := hh_dirty.1
      have hhlt : h < C.gates.length := hh_dirty.2.1
      have hhnb : ¬ BelowF G C h := by
        intro hbel
        obtain ⟨x, hx, hfx⟩ := hh_dirty.2.2
        have := hbel x hx
        rw [hfx] at this
        exact Bool.false_ne_true this
      -- C.output < 26 + C.gates.length (otherwise C.eval is constantly false).
      have hout_lt : C.output < 26 + C.gates.length := by
        by_contra hge
        let x0 := pairInput (Fin.castAdd 13 (0 : Fin 13)) (Fin.natAdd 13 (0 : Fin 13))
        have hF0 : graphFun G ∅ x0 = true := by
          change (decide (∃ a ∈ (∅ : Finset (Fin 26)), x0 a = true) ||
            decide (∃ a b : Fin 26, G.Adj a b ∧ x0 a = true ∧ x0 b = true)) = true
          rw [Bool.or_eq_true]
          right
          rw [decide_eq_true_eq]
          exact ⟨Fin.castAdd 13 (0 : Fin 13), Fin.natAdd 13 (0 : Fin 13),
            (hGiff _ _).mpr ⟨0, 0, by simp [S], Or.inl ⟨rfl, rfl⟩⟩,
            by change decide (_ = _ ∨ _ = _) = true; simp,
            by change decide (_ = _ ∨ _ = _) = true; simp⟩
        have hc0 := congrFun hFunC x0
        rw [hF0] at hc0
        have := hval_ge C x0 C.output (by omega)
        change (C.wires (List.ofFn x0)).getD C.output false = true at hc0
        rw [this] at hc0
        exact Bool.false_ne_true hc0
      -- C.output != 26 + h (otherwise h would be BelowF).
      have hout_ne : C.output ≠ 26 + h := by
        intro heq
        apply hhnb
        intro x hx
        have := congrFun hFunC x
        change (C.wires (List.ofFn x)).getD C.output false = graphFun G ∅ x at this
        rw [heq] at this
        exact this.symm.trans hx
      -- Gate h must be read by some gate k < C.gates.length (else deleting h contradicts IsLeastAO).
      have hread : ∃ k, k < C.gates.length ∧ 26 + h ∈ (gateAt C k).inputs := by
        by_contra hnoread
        push Not at hnoread
        let shift : ℕ → ℕ := fun w => if 26 + h < w then w - 1 else w
        let C' : Circuit :=
          ⟨(C.gates.eraseIdx h).map fun g => ⟨g.op, g.inputs.map shift⟩, shift C.output⟩
        have hC'len : C'.gates.length = C.gates.length - 1 := by
          simp [C', List.length_eraseIdx, hhlt]
        have hC'gate : ∀ k', k' < C.gates.length - 1 →
            gateAt C' k' =
              ⟨(gateAt C (if k' < h then k' else k' + 1)).op,
               (gateAt C (if k' < h then k' else k' + 1)).inputs.map shift⟩ := by
          intro k' hk'
          have hk'lt : k' < (C.gates.eraseIdx h).length := by
            rw [List.length_eraseIdx_of_lt hhlt]; exact hk'
          have herase : (C.gates.eraseIdx h)[k']'hk'lt =
              C.gates[if k' < h then k' else k' + 1]'(by split_ifs <;> omega) := by
            by_cases hkh : k' < h
            · simp [hkh, List.getElem_eraseIdx_of_lt]
            · simp [hkh, List.getElem_eraseIdx]
          change C'.gates.getD k' ⟨GateOp.or, []⟩ =
            ⟨(C.gates.getD (if k' < h then k' else k' + 1) ⟨GateOp.or, []⟩).op,
             (C.gates.getD (if k' < h then k' else k' + 1) ⟨GateOp.or, []⟩).inputs.map shift⟩
          simp only [C', List.getD_eq_getElem?_getD, List.getElem?_map,
            List.getElem?_eq_getElem hk'lt, Option.map_some, Option.getD_some, herase]
          have hidx_lt : (if k' < h then k' else k' + 1) < C.gates.length := by
            split_ifs <;> omega
          simp [List.getElem?_eq_getElem hidx_lt]
        have hC'AO : IsAO2 26 C' := by
          refine ⟨?_, ?_, ?_⟩
          · intro g hg
            simp only [C', List.mem_map] at hg
            obtain ⟨g0, hg0, rfl⟩ := hg
            exact hAO.1 g0 (List.mem_of_mem_eraseIdx hg0)
          · intro k' hk' w hw
            rw [hC'len] at hk'
            rw [hC'gate k' hk'] at hw
            simp only [List.mem_map] at hw
            obtain ⟨w0, hw0, rfl⟩ := hw
            set k := if k' < h then k' else k' + 1 with hkdef
            have hklt : k < C.gates.length := by
              by_cases hkh : k' < h <;> simp [hkdef, hkh] <;> omega
            have hw0lt : w0 < 26 + k := hAO.2.1 k hklt w0 hw0
            have hw0ne : w0 ≠ 26 + h := fun heq => hnoread k hklt (heq ▸ hw0)
            simp only [shift]
            by_cases hkh : k' < h
            · simp only [hkh, ↓reduceIte] at hkdef
              split_ifs <;> omega
            · simp only [hkh, ↓reduceIte] at hkdef
              split_ifs <;> omega
          · intro g hg
            simp only [C', List.mem_map] at hg
            obtain ⟨g0, hg0, rfl⟩ := hg
            simp [hAO.2.2 g0 (List.mem_of_mem_eraseIdx hg0)]
        have hC'wires : ∀ (x : Fin 26 → Bool) (w : ℕ), w < 26 + C.gates.length → w ≠ 26 + h →
            (C'.wires (List.ofFn x)).getD (shift w) false = (C.wires (List.ofFn x)).getD w false := by
          intro x w
          induction w using Nat.strong_induction_on with
          | _ w ih =>
            intro hwlt hwne
            by_cases hw26 : w < 26
            · have hsw : shift w = w := by simp [shift]; omega
              rw [hsw, hval_in C' x w hw26, hval_in C x w hw26]
            · set k := w - 26 with hkdef
              have hweq : 26 + k = w := by omega
              have hklt : k < C.gates.length := by omega
              have hkne : k ≠ h := by omega
              set k' := if k < h then k else k - 1 with hk'def
              have hk'lt : k' < C.gates.length - 1 := by
                by_cases hkh : k < h <;> simp [hk'def, hkh] <;> omega
              have hsw : shift w = 26 + k' := by
                by_cases hkh : k < h <;> simp [shift, hk'def, hkh] <;> split_ifs <;> omega
              have hback : (if k' < h then k' else k' + 1) = k := by
                by_cases hkh : k < h
                · simp [hk'def, hkh]
                · simp only [hk'def, hkh, ↓reduceIte]
                  split_ifs <;> omega
              rw [hsw, ← hweq, hval_gate C' hC'AO.2.1 x k' (by rw [hC'len]; exact hk'lt),
                hval_gate C hAO.2.1 x k hklt, hC'gate k' hk'lt, hback]
              simp only [List.map_map]
              congr 1
              refine List.map_congr_left fun u hu => ?_
              have hult : u < w := by
                have := hAO.2.1 k hklt u hu
                omega
              have hune : u ≠ 26 + h := fun heq => hnoread k hklt (heq ▸ hu)
              exact ih u hult (by omega) hune
        have hC'fun : circuitFun 26 C' = graphFun G ∅ := by
          funext x
          rw [← hFunC]
          change (C'.wires (List.ofFn x)).getD (shift C.output) false =
            (C.wires (List.ofFn x)).getD C.output false
          exact hC'wires x C.output hout_lt hout_ne
        have hle := hMinC C' hC'AO hC'fun
        change C.gates.length ≤ C'.gates.length at hle
        omega
      obtain ⟨k, hklt, hkh_mem⟩ := hread
      have hhk : h < k := by
        have := hAO.2.1 k hklt (26 + h) hkh_mem
        omega
      -- orIn 26 C (26 + h) = ∅ because gate h is an AND gate.
      have horIn_h_empty : orIn 26 C (26 + h) = ∅ := by
        rw [Finset.eq_empty_iff_forall_notMem]
        intro v hv
        rcases (Finset.mem_filter.mp hv).2 with hv26 | ⟨j, hj, hreach, hjor, _⟩
        · have := v.isLt; omega
        · have hjmem : j ∈ (C.gates.foldl (orStep 26) []).getD (26 + h - 26) [] := hreach.2
          rw [Nat.add_sub_cancel_left, horSets_char C.gates h hhlt] at hjmem
          have hne_or : (gateAt C h).op ≠ GateOp.or := by rw [hhand]; decide
          have hne_or' : (C.gates.getD h ⟨GateOp.or, []⟩).op ≠ GateOp.or := hne_or
          simp only [hne_or', ↓reduceIte, List.mem_cons, List.not_mem_nil, or_false] at hjmem
          subst hjmem
          exact hne_or hjor
      -- Gate k has 2 inputs, one of which is 26 + h.
      have hklen : (gateAt C k).inputs.length = 2 :=
        hAO.2.2 (gateAt C k) (hgate_mem C k hklt)
      obtain ⟨p, q, hklist⟩ := List.length_eq_two.mp hklen
      have hkh_pq : p = 26 + h ∨ q = 26 + h := by
        rw [hklist] at hkh_mem
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hkh_mem
        rcases hkh_mem with h1 | h2
        · exact Or.inl h1.symm
        · exact Or.inr h2.symm
      -- Therefore 1 <= 2 * |centreless| + |orN \ lam|.
      have hExtra : 1 ≤ 2 * (centreless G C).card + (orN G C \ lam G C).card := by
        rcases hAO.1 (gateAt C k) (hgate_mem C k hklt) with hkand | hkor
        · -- k is an AND gate; by maximality of h in junk, k ∈ tops, hence k ∈ centreless.
          have hkbel : BelowF G C k := by
            by_contra hknb
            have hkdirty : IsDirtyAnd 26 G C k := by
              refine ⟨hkand, hklt, ?_⟩
              by_contra hnone
              apply hknb
              intro x hx
              by_contra hfx
              exact hnone ⟨x, hx, Bool.eq_false_iff.mpr hfx⟩
            have hkjunk : k ∈ junk G C :=
              Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hklt, hkdirty⟩
            have := hh_max k hkjunk
            omega
          have hktop : k ∈ tops G C :=
            Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hklt, hkand, hkbel⟩
          have hkcen : k ∈ centreless G C := by
            refine Finset.mem_filter.mpr ⟨hktop, ?_⟩
            rcases hkh_pq with rfl | rfl
            · left
              change orIn 26 C ((gateAt C k).inputs.getD 0 0) = ∅
              rw [hklist]
              exact horIn_h_empty
            · right
              change orIn 26 C ((gateAt C k).inputs.getD 1 0) = ∅
              rw [hklist]
              exact horIn_h_empty
          have hpos : 1 ≤ (centreless G C).card := Finset.card_pos.mpr ⟨k, hkcen⟩
          omega
        · -- k is an OR gate; k ∈ orN \ lam.
          have hknb : ¬ BelowF G C k := by
            intro hkbel
            obtain ⟨x, hx, hfx⟩ := hh_dirty.2.2
            have hkx : gateVal 26 C k x = true := by
              change (C.wires (List.ofFn x)).getD (26 + k) false = true
              rw [hval_gate C hAO.2.1 x k hklt, hkor]
              change ((gateAt C k).inputs.map fun i => (C.wires (List.ofFn x)).getD i false).any id = true
              simp only [List.any_map, Function.comp_apply, id_eq, List.any_eq_true]
              exact ⟨26 + h, hkh_mem, hx⟩
            have := hkbel x hkx
            rw [hfx] at this
            exact Bool.false_ne_true this
          have hkorN : k ∈ orN G C :=
            Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hklt, hkor, hknb⟩
          have hknlam : k ∉ lam G C := by
            intro hlam
            obtain ⟨_, h0ne, h1ne, _⟩ := Finset.mem_filter.mp hlam
            rcases hkh_pq with rfl | rfl
            · have : orIn 26 C (opnd C k 0) = ∅ := by
                change orIn 26 C ((gateAt C k).inputs.getD 0 0) = ∅
                rw [hklist]
                exact horIn_h_empty
              rw [this] at h0ne
              exact Finset.not_nonempty_empty h0ne
            · have : orIn 26 C (opnd C k 1) = ∅ := by
                change orIn 26 C ((gateAt C k).inputs.getD 1 0) = ∅
                rw [hklist]
                exact horIn_h_empty
              rw [this] at h1ne
              exact Finset.not_nonempty_empty h1ne
          have hpos : 1 ≤ (orN G C \ lam G C).card :=
            Finset.card_pos.mpr ⟨k, Finset.mem_sdiff.mpr ⟨hkorN, hknlam⟩⟩
          omega
      obtain ⟨K, hKmin⟩ := hExMinCover (Ustar G C)
      have hKm := hMatch (Ustar G C) K hKmin.1
      have hKc := hCoverBound K hKmin
      omega

