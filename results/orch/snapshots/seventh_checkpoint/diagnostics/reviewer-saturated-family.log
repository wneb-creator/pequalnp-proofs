--- The nine maximal independent sets of two disjoint triangles.
-def Zt (p : Fin 3 × Fin 3) : Fin 6 → Bool :=
-  fun v => decide (v.val = p.1.val ∨ v.val = 3 + p.2.val)
-
-theorem noedge : ∀ p : Fin 3 × Fin 3, ¬ ∃ u v : Fin 6,
-    (u.val, v.val) ∈ ([(0, 1), (0, 2), (1, 2), (3, 4), (3, 5), (4, 5)] : List (ℕ × ℕ)) ∧
-      Zt p u = true ∧ Zt p v = true := by
-  decide
