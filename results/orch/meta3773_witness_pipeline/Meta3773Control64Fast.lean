lemma circuitOf_monotone (gs : List (Bool × ℕ × ℕ)) :
    PEqualNP.MetaComplexity.Monotone2 (circuitOf gs) := by
  intro g hg
  obtain ⟨x,hx,rfl⟩ := List.mem_map.mp hg
  cases h : x.1 <;> simp [gateOf,h]

