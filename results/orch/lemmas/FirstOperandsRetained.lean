def pairRow (a c : Fin 10) : Row := Fin.ofNat 1024 ((1 <<< a.val) ||| (1 <<< c.val))

def tripleRow (a b c : Fin 10) : Row :=
  Fin.ofNat 1024 ((1 <<< a.val) ||| (1 <<< b.val) ||| (1 <<< c.val))

