def closure (a b c : Nat) : List Nat :=
  let i := extras.idxOf a
  let j := extras.idxOf b
  let k := extras.idxOf c
  let mask := ((certificates.getD i []).getD (j-i-1) []).getD (k-j-1) 0
  seeds ++ ((targets ++ [a,b,c]).zipIdx.filterMap fun (z,n) =>
    if mask.testBit n then some z else none)

def missing (a b c : Nat) : Bool :=
  let seen := closure a b c
  (seeds.all fun t => seen.contains t) &&
  ((targets ++ [a,b,c]).all fun t => !(canMake seen t) || seen.contains t) &&
  !(targets.all fun t => seen.contains t)

def checkedAt (a : Nat) : Bool :=
  extras.all fun b => !(decide (a < b)) ||
    extras.all fun c => !(decide (b < c)) || missing a b c

def checked : Bool := extras.all checkedAt

