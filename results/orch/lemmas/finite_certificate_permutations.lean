lemma vertexMap_anchor : ∀ a : Fin 10, vertexMap a a = 0 := by
  decide +kernel

lemma rowPerm_anchor (a : Fin 10) :
    Extended.renameRows (rowPerm a) (Extended.initial.getD a.val Extended.zero) =
      Extended.first := by
  rw [rowPerm_input, vertexMap_anchor]
  rfl

lemma rowPerm_initial (a : Fin 10) (v : Extended.Sig) (h : v ∈ Extended.initial) :
    Extended.renameRows (rowPerm a) v ∈ Extended.initial := by
  obtain ⟨j, hj, hv⟩ := List.mem_iff_getElem.mp h
  let q : Fin 10 := ⟨j, by simpa [Extended.initial, Extended.pins] using hj⟩
  have eqv : Extended.initial.getD q.val Extended.zero = v := by
    rw [List.getD_eq_getElem _ _ hj]
    exact hv
  rw [← eqv, rowPerm_input]
  have hh : (vertexMap a q).val < Extended.initial.length := by
    simpa [Extended.initial, Extended.pins] using (vertexMap a q).isLt
  rw [List.getD_eq_getElem _ _ hh]
  exact List.getElem_mem _

lemma live_rowPerm (a : Fin 10) {u k S}
    (h : Extended.Live u Extended.target k S) :
    Extended.Live u Extended.target k (S.image (Extended.renameRows (rowPerm a))) := by
  have r := Extended.live_renameRows h (rowPerm a) (rowPerm_surjective a)
  rwa [rowPerm_target] at r

