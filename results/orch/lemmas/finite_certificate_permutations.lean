lemma rowPerm_target (a : Fin 10) :
    Extended.renameRows (rowPerm a) Extended.target = Extended.target := by
  apply Extended.bit_ext
  intro r
  rw [Extended.bit_renameRows]
  exact rowPerm_target_bits a r

lemma rowPerm_input (a j : Fin 10) :
    Extended.renameRows (rowPerm a) (Extended.initial.getD j.val Extended.zero) =
      Extended.initial.getD (vertexMap a j).val Extended.zero := by
  apply Extended.bit_ext
  intro r
  rw [Extended.bit_renameRows]
  exact rowPerm_input_bits a j r

set_option maxRecDepth 8192 in
