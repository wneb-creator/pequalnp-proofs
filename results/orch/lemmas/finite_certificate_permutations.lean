def renameRows (f : Row → Row) (a : Sig) := table fun r => bit (f r) a
theorem bit_renameRows (f : Row → Row) (a : Sig) (r : Row) :
    bit r (renameRows f a) = bit (f r) a := bit_table _ _
theorem observe_renameRows (f : Row → Row) (a : Sig) :
    observe (renameRows f a) = restrictRows f (observe a) := by funext r; exact bit_renameRows f a r
theorem renameRows_bin (f : Row → Row) (d : Nat) (a b : Sig) :
    renameRows f (bin d a b) = bin d (renameRows f a) (renameRows f b) := by
  apply bit_ext
  intro r
  simp only [bit_renameRows,bit_bin]

theorem renameRows_inj (f : Row → Row) (onto : Function.Surjective f) :
    Function.Injective (renameRows f) := by
  intro a b h
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  obtain ⟨r,hr⟩ := onto ⟨j,hj⟩
  have he := congrArg (bit r) h
  change bit ⟨j,hj⟩ a = bit ⟨j,hj⟩ b
  rw [bit_renameRows,bit_renameRows,hr] at he
  exact he
theorem renameRows_constants (f : Row → Row) : renameRows f zero = zero ∧ renameRows f one = one := by
  constructor <;> apply BitVec.eq_of_getLsbD_eq <;> intro j hj
  · exact (bit_renameRows f zero ⟨j,hj⟩).trans ((bit_zero _).trans (bit_zero ⟨j,hj⟩).symm)
  · exact (bit_renameRows f one ⟨j,hj⟩).trans ((bit_one _).trans (bit_one ⟨j,hj⟩).symm)
theorem live_renameRows {u T k S} (h : Live u T k S) (f : Row → Row) (onto : Function.Surjective f) :
    Live u (renameRows f T) k (S.image (renameRows f)) := by
  have inj := renameRows_inj f onto
  obtain ⟨fz,fo⟩ := renameRows_constants f
  have pp (v) (p : proper v) : proper (renameRows f v) :=
    ⟨fun e => p.1 (inj (e.trans fz.symm)),fun e => p.2 (inj (e.trans fo.symm))⟩
  induction h using Live.ind with
  | stop hp => simpa using Live.stop (pp _ hp)
  | @binary k U a b d hd ha hb hab hf _ ih =>
    have fresh : renameRows f (bin d a b) ∉ (insert a (insert b U)).image (renameRows f) := by
      intro hm
      obtain ⟨v,hv,eq⟩ := Finset.mem_image.mp hm
      exact hf (inj eq ▸ hv)
    simp only [Finset.image_insert,renameRows_bin] at fresh ih ⊢
    exact Live.binary hd (pp _ ha) (pp _ hb) (fun hh => hab (inj hh)) fresh ih
