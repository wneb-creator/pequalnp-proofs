lemma least_and_private_boundary {n:ℕ} (C:Circuit) (ao:IsAO2 n C)
 (least:∀D:Circuit,IsAO2 n D→circuitFun n D=circuitFun n C→C.size≤D.size)
 (N:Set (Fin n→Bool))
 (boundary:∀x:Fin n→Bool,circuitFun n C x=false→
   ∃y∈N,(∀i,x i=true→y i=true)∧circuitFun n C y=false)
 (m p:ℕ) (hm:m<C.gates.length) (hop:(gateAt C m).op=GateOp.and)
 (hmem:p∈(gateAt C m).inputs):
 ∃x∈N,circuitFun n C x=false ∧ gateVal n C m x=false ∧
   Erase.val C (List.ofFn x) p=true := by
 classical
 by_contra absent
 let D:=eraseGate n C m p
 have hp:=ao.2.1 m hm p hmem
 have dAO:IsAO2 n D:=Lift.eraseGate_isAO2 n C m p ao hm hp
 have equalBoundary (y:Fin n→Bool) (hy:y∈N) (negative:circuitFun n C y=false):
     circuitFun n D y=circuitFun n C y := by
   have sameWire:Erase.val C (List.ofFn y) p=Erase.val C (List.ofFn y) (n+m) := by
     cases hpv:Erase.val C (List.ofFn y) p <;>
       cases hmv:Erase.val C (List.ofFn y) (n+m)
     · rfl
     · have h:=Erase.erase_and_below hm hop hmem List.length_ofFn hmv
       simp [hpv] at h
     · exact False.elim (absent ⟨y,hy,negative,hmv,hpv⟩)
     · rfl
   exact Erase.erase_eval hm hp List.length_ofFn sameWire
 have same:circuitFun n D=circuitFun n C := by
   funext x
   have up:circuitFun n C x=true→circuitFun n D x=true:=
     Erase.erase_eval_and hm ao.1 hop hmem hp List.length_ofFn
   have down:circuitFun n D x=true→circuitFun n C x=true := by
     intro positive
     cases old:circuitFun n C x with
     | true=>rfl
     | false=>
       obtain ⟨y,hy,xy,negative⟩:=boundary x old
       have posY:=Erase.circuitFun_mono n D dAO.1 x y xy positive
       rw [equalBoundary y hy negative,negative] at posY
       contradiction
   cases hc:circuitFun n C x <;> cases hd:circuitFun n D x
   · rfl
   · have := down hd; simp [hc] at this
   · have := up hc; simp [hd] at this
   · rfl
 have lower:=least D dAO same
 have size:=Erase.erase_size n C m p hm
 change C.size≤(eraseGate n C m p).size at lower
 omega

end PEqualNP.Outside.L_meta_2585
