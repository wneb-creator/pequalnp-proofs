lemma erase_val_down {n:ℕ} {C:Circuit} {m p:ℕ}
 (hm:m<C.gates.length) (hp:p<n+m) (hAO:AndOrOnly C)
 {x:List Bool} (hx:x.length=n)
 (hv:Erase.val C x p=true→Erase.val C x (n+m)=true):
 ∀i,Erase.val (eraseGate n C m p) x (eraseRedirect n m p i)=true→Erase.val C x i=true := by
 apply Erase.erase_val_rel (fun op=>op=GateOp.and∨op=GateOp.or)
   (fun a b=>b=true→a=true) (fun _ h=>h) hm hp
 · intro op l f f' hop h
   have hh:=Erase.erase_hop_le id op l (fun i=>f' (eraseRedirect n m p i)) f hop h
   simpa only [List.map_map,List.map_id,Function.comp_def] using hh
 · exact fun g hg=>hAO g (List.mem_of_mem_drop hg)
 · exact hx
 · exact hv

lemma erase_or_down {n:ℕ} {C:Circuit} {m p:ℕ}
 (ao:IsAO2 n C) (hm:m<C.gates.length) (hop:(gateAt C m).op=GateOp.or)
 (hmem:p∈(gateAt C m).inputs) (x:Fin n→Bool):
 circuitFun n (eraseGate n C m p) x=true→circuitFun n C x=true := by
 have hp:=ao.2.1 m hm p hmem
 have hv:Erase.val C (List.ofFn x) p=true→Erase.val C (List.ofFn x) (n+m)=true := by
   intro h
   rw [Erase.val_gate_rb List.length_ofFn hm (ao.2.1 m hm),hop]
   exact List.any_eq_true.mpr ⟨true,List.mem_map.mpr ⟨p,hmem,h⟩,rfl⟩
 have h:=erase_val_down hm hp ao.1 List.length_ofFn hv C.output
 simpa only [circuitFun,Circuit.eval,Erase.val,Erase.erase_output n C m p hm] using h

lemma least_or_private_edge {n:ℕ} (G:SimpleGraph (Fin n)) [DecidableRel G.Adj]
 (C:Circuit) (ao:IsAO2 n C) (computes:circuitFun n C=graphFun G ∅)
 (least:∀D:Circuit,IsAO2 n D→circuitFun n D=circuitFun n C→C.size≤D.size)
 (m p:ℕ) (hm:m<C.gates.length) (hop:(gateAt C m).op=GateOp.or)
 (hmem:p∈(gateAt C m).inputs):
 ∃u v:Fin n,G.Adj u v ∧ gateVal n C m (pairInput u v)=true ∧
   Erase.val C (List.ofFn (pairInput u v)) p=false := by
 classical
 by_contra absent
 let D:=eraseGate n C m p
 have hp:=ao.2.1 m hm p hmem
 have dAO:IsAO2 n D:=Lift.eraseGate_isAO2 n C m p ao hm hp
 have same:circuitFun n D=circuitFun n C := by
   funext x
   have down:circuitFun n D x=true→circuitFun n C x=true:=erase_or_down ao hm hop hmem x
   have up:circuitFun n C x=true→circuitFun n D x=true := by
     intro positive
     have target:graphFun G ∅ x=true:=by simpa only [computes] using positive
     simp only [graphFun,Finset.notMem_empty,false_and,exists_false,decide_false,Bool.false_or,decide_eq_true_eq] at target
     obtain ⟨u,v,edge,xu,xv⟩:=target
