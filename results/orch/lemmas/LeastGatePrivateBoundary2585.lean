lemma erase_below_and {n : ℕ} {C : Circuit} {m p : ℕ}
    (hAO : IsAO2 n C) (hm : m < C.gates.length)
    (hop : (gateAt C m).op = GateOp.and) (hpi : p ∈ (gateAt C m).inputs)
    (hb : WireBelowOutput n C p) :
    circuitFun n (eraseGate n C m p) = circuitFun n C := by
  have hp : p < n + m := hAO.2.1 m hm p hpi
  funext x
  change (eraseGate n C m p).eval (List.ofFn x) = C.eval (List.ofFn x)
  have hx : (List.ofFn x).length = n := List.length_ofFn
  by_cases hv : Erase.val C (List.ofFn x) p = true
  · have old : C.eval (List.ofFn x) = true := hb x hv
    have new := Erase.erase_eval_and hm hAO.1 hop hpi hp hx old
    exact new.trans old.symm
  · have hp0 : Erase.val C (List.ofFn x) p = false := Bool.eq_false_iff.mpr hv
    have hm0 : Erase.val C (List.ofFn x) (n + m) = false := by
      apply Bool.eq_false_iff.mpr
      intro h
      exact hv (Erase.erase_and_below hm hop hpi hx h)
    exact Erase.erase_eval hm hp hx (hp0.trans hm0.symm)

lemma optimal_normal (n : ℕ) (C : Circuit) (hAO : IsAO2 n C)
    (hout : C.output < n + C.gates.length)
    (hmin : ∀ D : Circuit, IsAO2 n D → D.output < n + D.gates.length →
      circuitFun n D = circuitFun n C → C.size ≤ D.size)
    (hpot : ∀ D : Circuit, IsAO2 n D → D.output < n + D.gates.length →
      circuitFun n D = circuitFun n C → D.size = C.size →
      C.size - Lift.belowCount n C ≤ D.size - Lift.belowCount n D) :
    ∀ g < C.gates.length, WireBelowOutput n C (n + g) →
      ∀ j < C.gates.length, n + g ∈ (gateAt C j).inputs →
        (gateAt C j).op = GateOp.or ∧ WireBelowOutput n C (n + j) := by
  intro g hg hb j hj hread
  have hng : n + g < n + j := hAO.2.1 j hj _ hread
  have hjmem := Erase.gateAt_mem hj
  have hor : (gateAt C j).op = GateOp.or := by
    rcases hAO.1 (gateAt C j) hjmem with hand | hor
    · have heq := erase_below_and hAO hj hand hread hb
      have heAO := Lift.eraseGate_isAO2 n C j (n + g) hAO hj hng
      have heout := Lift.eraseGate_output_lt n C j (n + g) hj hng hout
      have hsmall := hmin (eraseGate n C j (n + g)) heAO heout heq
      have hlen := Lift.eraseGate_gates_length n C j (n + g) hj
      simp only [Circuit.size] at hsmall
      omega
    · exact hor
  refine ⟨hor, ?_⟩
  by_contra hnot
  have hlen := hAO.2.2 (gateAt C j) hjmem
  obtain ⟨a, b, hab⟩ := List.length_eq_two.mp hlen
  have hgate : C.gates[j]? = some ⟨GateOp.or, [a,b]⟩ := by
    have heq : gateAt C j = ⟨GateOp.or, [a,b]⟩ := by
      cases he : gateAt C j with
      | mk op ins =>
        simp only [he] at hor hab
        cases hor
        cases hab
        rfl
    simpa [Lift.gateAt_eq_getElem C j hj, hj] using congrArg some heq
  have ha : a < n + j := hAO.2.1 j hj a (by simp [hab])
  have hb' : b < n + j := hAO.2.1 j hj b (by simp [hab])
  have both : WireBelowOutput n C a → WireBelowOutput n C b →
      WireBelowOutput n C (n+j) := by
    intro hba hbb x hx
    rw [Lift.gate_m_val n C j a b hAO.2.1 hj (Or.inl hgate) (List.ofFn x)
      List.length_ofFn] at hx
    rcases Bool.or_eq_true_iff.mp hx with h | h
    · exact hba x h
    · exact hbb x h
  simp [hab] at hread
  have ex : ∃ p, p < n+j ∧
      (C.gates[j]? = some ⟨GateOp.or, [p,n+g]⟩ ∨
        C.gates[j]? = some ⟨GateOp.or, [n+g,p]⟩) ∧ ¬WireBelowOutput n C p := by
    rcases hread with h | h
    · subst a
      exact ⟨b,hb',Or.inr hgate,fun hbb => hnot (both hb hbb)⟩
    · subst b
      exact ⟨a,ha,Or.inl hgate,fun hba => hnot (both hba hb)⟩
  obtain ⟨p,hp,hgm,hnp⟩ := ex
  let D := liftAt n C j p (n+g)
  have hd : IsAO2 n D := Lift.liftAt_isAO2 n C j p (n+g) hAO hout hj hp hng
  have hdl : D.gates.length = C.gates.length := Lift.liftAt_gates_length n C j p (n+g) hj
  have hel := Lift.eraseGate_gates_length n C j p hj
  have hdo : D.output < n+D.gates.length := by
    change n+(eraseGate n C j p).gates.length < n+D.gates.length
    omega
  have hdf : circuitFun n D = circuitFun n C := by
    funext x
    exact Lift.liftAt_eval_eq n C j p (n+g) hAO hout hj hp hng hgm hb x
  have hds : D.size = C.size := hdl
  have hp' := hpot D hd hdo hdf hds
  have hmore := Lift.belowCount_lt_liftAt n C j p (n+g) hAO hout hj hp hng hgm hb hnp
  have hbd := Lift.belowCount_le n D
  change Lift.belowCount n C < Lift.belowCount n D at hmore
  simp only [Circuit.size] at hp'
  omega

lemma generic_normalize (n : ℕ) (C : Circuit) (hAO : IsAO2 n C) :
    ∃ D : Circuit, IsAO2 n D ∧ circuitFun n D = circuitFun n C ∧ D.size ≤ C.size ∧
      ∀ g < D.gates.length, WireBelowOutput n D (n+g) →
        ∀ j < D.gates.length, n+g ∈ (gateAt D j).inputs →
          (gateAt D j).op = GateOp.or ∧ WireBelowOutput n D (n+j) := by
  classical
  by_cases hout : C.output < n+C.gates.length
  · let Good (D : Circuit) := IsAO2 n D ∧ D.output < n+D.gates.length ∧
      circuitFun n D = circuitFun n C
    have hex : ∃ s, ∃ D : Circuit, Good D ∧ D.size = s := ⟨C.size,C,⟨hAO,hout,rfl⟩,rfl⟩
    let s := Nat.find hex
    have hbase : ∃ D : Circuit, Good D ∧ D.size = s := Nat.find_spec hex
    have hx : ∃ q, ∃ D : Circuit, Good D ∧ D.size = s ∧
        D.size-Lift.belowCount n D = q := by
      obtain ⟨D,hd,hs⟩ := hbase
      exact ⟨_,D,hd,hs,rfl⟩
    obtain ⟨D, hd, hs, hq⟩ := Nat.find_spec hx
    have hmin : ∀ E : Circuit, Good E → s ≤ E.size := by
      intro E he
      exact Nat.find_min' hex ⟨E,he,rfl⟩
    have hpot : ∀ E : Circuit, Good E → E.size=s →
        D.size-Lift.belowCount n D ≤ E.size-Lift.belowCount n E := by
      intro E he hes
      rw [hq]
      exact Nat.find_min' hx ⟨E,he,hes,rfl⟩
    refine ⟨D,hd.1,hd.2.2,?_,?_⟩
    · rw [hs]
      exact hmin C ⟨hAO,hout,rfl⟩
    · apply optimal_normal n D hd.1 hd.2.1
      · intro E he heo hef
        rw [hs]
        exact hmin E ⟨he,heo,hef.trans hd.2.2⟩
      · intro E he heo hef hes
        exact hpot E ⟨he,heo,hef.trans hd.2.2⟩ (hes.trans hs)
  · let D : Circuit := ⟨[],n⟩
    refine ⟨D,?_,?_,?_,?_⟩
    · simp [D,IsAO2,PEqualNP.EdgeOwnership.AndOrOnly,ReadsBack]
    · funext x
      change (List.ofFn x).getD n false = (Erase.W C.gates (List.ofFn x)).getD C.output false
      rw [Erase.ofFn_getD_ge x n (by omega), Erase.W_ge C.gates (List.ofFn x) C.output]
      simpa using Nat.le_of_not_gt hout
    · simp [D,Circuit.size]
    · intro g hg
      simp [D] at hg

lemma generic_normalize_least (n : ℕ) (C : Circuit) (hAO : IsAO2 n C) :
    ∃ D : Circuit, IsAO2 n D ∧ circuitFun n D = circuitFun n C ∧ D.size ≤ C.size ∧
      (∀ E : Circuit, IsAO2 n E → circuitFun n E = circuitFun n D → D.size ≤ E.size) ∧
      ∀ g < D.gates.length, WireBelowOutput n D (n+g) →
        ∀ j < D.gates.length, n+g ∈ (gateAt D j).inputs →
          (gateAt D j).op = GateOp.or ∧ WireBelowOutput n D (n+j) := by
  classical
  have hex : ∃ s, ∃ E : Circuit, IsAO2 n E ∧ circuitFun n E = circuitFun n C ∧ E.size=s :=
    ⟨C.size,C,hAO,rfl,rfl⟩
  obtain ⟨C0,h0,hf0,hs0⟩ := Nat.find_spec hex
  have hmin : ∀ E : Circuit, IsAO2 n E → circuitFun n E = circuitFun n C → C0.size ≤ E.size := by
    intro E he hef
    rw [hs0]
    exact Nat.find_min' hex ⟨E,he,hef,rfl⟩
  obtain ⟨D,hd,hf,hs,hn⟩ := generic_normalize n C0 h0
  refine ⟨D,hd,hf.trans hf0,hs.trans (hmin C hAO rfl),?_,hn⟩
  intro E he hef
  exact hs.trans (hmin E he ((hef.trans hf).trans hf0))

end PEqualNP.Outside.L_meta_2585

