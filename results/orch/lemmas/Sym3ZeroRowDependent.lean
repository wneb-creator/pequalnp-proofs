      simpa [v',chartV,V00,sub_eq_add_neg] using he

    · have he := congrFun hv (4 : Fin 5)
      simpa [v',chartV,V00,sub_eq_add_neg] using he

  apply chart00_cubic_impossible p h k
  intro a b
  simpa only [hequ,heqv] using hc a b

