lemma normalized_cubic_pair00_impossible (u v : Fin 5 → ℂ)
    (hq : ∀ a b : ℂ, wittQ (fun r => a*u r+b*v r)=0)
    (hc : ∀ a b : ℂ, cubic (fun r => a*u r+b*v r)=0)
    (hu0 : u 0=1) (hu1 : u 1=0) (hv0 : v 0=0) (hv1 : v 1=1) : False := by
  let u' : Fin 5 → ℂ := ![u 0,u 1,u 2,u 3,u 4]
  let v' : Fin 5 → ℂ := ![v 0,v 1,v 2,v 3,v 4]
  have hq' (a b : ℂ) : wittQ (fun r => a*u' r+b*v' r)=0 := by
    have he := hq a b
    dsimp [wittQ,u',v'] at he ⊢
    linear_combination he
  obtain ⟨p,h,k,hu,hv⟩ := normalized_pair u' v' hq' hu0 hu1 hv0 hv1
  have hequ : u=U00 p h k := by
    funext r
    fin_cases r

    · have he := congrFun hu (0 : Fin 5)
      simpa [u',chartU,U00,sub_eq_add_neg] using he

    · have he := congrFun hu (1 : Fin 5)
      simpa [u',chartU,U00,sub_eq_add_neg] using he

    · have he := congrFun hu (2 : Fin 5)
      simpa [u',chartU,U00,sub_eq_add_neg] using he

    · have he := congrFun hu (3 : Fin 5)
      simpa [u',chartU,U00,sub_eq_add_neg] using he

    · have he := congrFun hu (4 : Fin 5)
      simpa [u',chartU,U00,sub_eq_add_neg] using he

  have heqv : v=V00 p h k := by
    funext r
    fin_cases r

    · have he := congrFun hv (0 : Fin 5)
      simpa [v',chartV,V00,sub_eq_add_neg] using he

    · have he := congrFun hv (1 : Fin 5)
