def cubic (u : Fin 5 → ℂ) : ℂ := (((-27648) * ((u 4) ^ 3)) + ((-26) * ((u 2) ^ 3)) + (26 * ((u 3) ^ 3)) + ((-13824) * (u 4) * ((u 0) ^ 2)) + ((-13824) * (u 4) * ((u 1) ^ 2)) + ((-4608) * (u 1) * ((u 0) ^ 2)) + ((-1152) * (u 3) * ((u 0) ^ 2)) + ((-576) * (u 2) * ((u 0) ^ 2)) + ((-120) * (u 0) * ((u 2) ^ 2)) + ((-39) * (u 3) * ((u 2) ^ 2)) + (39 * (u 2) * ((u 3) ^ 2)) + (120 * (u 1) * ((u 3) ^ 2)) + (504 * (u 4) * ((u 2) ^ 2)) + (504 * (u 4) * ((u 3) ^ 2)) + (576 * (u 3) * ((u 1) ^ 2)) + (1152 * (u 2) * ((u 1) ^ 2)) + (4608 * (u 0) * ((u 1) ^ 2)) + ((-1152) * (u 0) * (u 1) * (u 2)) + ((-240) * (u 0) * (u 2) * (u 3)) + (240 * (u 1) * (u 2) * (u 3)) + (504 * (u 2) * (u 3) * (u 4)) + (576 * (u 0) * (u 2) * (u 4)) + (576 * (u 1) * (u 3) * (u 4)) + (1152 * (u 0) * (u 1) * (u 3)) + (13824 * (u 0) * (u 1) * (u 4)))


def U00 (p h k : ℂ) : Fin 5 → ℂ := ![1,0,((-9) * (h ^ 2)),(((-1) * p) + ((-9) * h * k)),h]

def V00 (p h k : ℂ) : Fin 5 → ℂ := ![0,1,(p + ((-9) * h * k)),((-9) * (k ^ 2)),k]


set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
lemma chart00_cubic_impossible (p h k : ℂ)
    (hc : ∀ a b : ℂ, cubic (fun r => a*U00 p h k r+b*V00 p h k r)=0) : False := by
  have h10 := hc 1 0
  have h01 := hc 0 1
  have h11 := hc 1 1
  have hm1 := hc (-1) 1
  simp [cubic,U00,V00] at h10 h01 h11 hm1
  apply sym3_chart00_obstruction p h k

  · linear_combination 1*h10

  · linear_combination (1/3:ℂ)*((1/2:ℂ)*(h11+hm1)-h01)

  · linear_combination (1/3:ℂ)*((1/2:ℂ)*(h11-hm1)-h10)

  · linear_combination 1*h01

