lemma quadratic_cubic_pair_dependent (u v : Fin 5 → ℂ)
    (hq : ∀ a b : ℂ, wittQ (fun r => a*u r+b*v r)=0)
    (hc : ∀ a b : ℂ, cubic (fun r => a*u r+b*v r)=0) :
    ∀ i j : Fin 5, minor u v i j=0 := by
  by_contra hn
  have hind : ∃ i j : Fin 5, minor u v i j≠0 := by
    push Not at hn
    exact hn
  obtain hm|hm|hm|hm := nonzero_chart_minor u v hq hind

  · obtain ⟨U,V,hU0,hU1,hV0,hV1,hQ,hPres⟩ := rebase_pair u v 0 1 hm wittQ hq
    exact normalized_cubic_pair00_impossible U V hQ (hPres cubic hc) hU0 hU1 hV0 hV1

  · obtain ⟨U,V,hU0,hU1,hV0,hV1,hQ,hPres⟩ := rebase_pair u v 0 3 hm wittQ hq
    exact normalized_cubic_pair01_impossible U V hQ (hPres cubic hc) hU0 hU1 hV0 hV1

  · obtain ⟨U,V,hU0,hU1,hV0,hV1,hQ,hPres⟩ := rebase_pair u v 2 1 hm wittQ hq
    exact normalized_cubic_pair10_impossible U V hQ (hPres cubic hc) hU0 hU1 hV0 hV1

  · obtain ⟨U,V,hU0,hU1,hV0,hV1,hQ,hPres⟩ := rebase_pair u v 2 3 hm wittQ hq
    exact normalized_cubic_pair11_impossible U V hQ (hPres cubic hc) hU0 hU1 hV0 hV1

