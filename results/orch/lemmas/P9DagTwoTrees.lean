def bsearch (data : Array Nat) (value : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | k+1, lo, hi =>
    if lo < hi then
      let mid := (lo+hi)/2
      if data[mid]?.getD 0 < value then bsearch data value k (mid+1) hi
      else bsearch data value k lo mid
    else lo

def decodeAux : Nat → Nat → List W → List W
  | 0, _, acc => acc
  | k+1, code, acc => if code ≤ 1 then acc else
      decodeAux k (code/532) ((BitVec.ofNat 192 (dictWord (code%532) dictTree))::acc)

def decode (key : Nat) : List W := decodeAux 12 (key/16) []

def insertNat (a : Nat) : List Nat → List Nat
  | [] => [a]
  | b :: bs => if a ≤ b then a :: b :: bs else b :: insertNat a bs

def sortNat : List Nat → List Nat
  | [] => []
  | a :: xs => insertNat a (sortNat xs)

def encode (n : Nat) (ws : List W) : Nat :=
  let ids := ws.map fun w => dictIndex w.toNat dictTree
  (sortNat ids).foldl (fun k i => k*532+i) 1 * 16 + n

inductive SearchTree where
  | nil
  | node (left : SearchTree) (value : Nat) (right : SearchTree)

def findKey (key : Nat) : SearchTree → Option Nat
  | .nil => none
  | .node left value right =>
    if key = value then some value else if key < value then findKey key left else findKey key right

