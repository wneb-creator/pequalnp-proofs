  let label := firstInputBoundary L.hcl out live
  let bs : Finset (Fin (10 + gs.length)) := circuitBranchWires gs
  have computes (x : V → Bool) : vl gs x out.val = PetersenScratch.edgeValue graph x := by
    change vl gs x o = _
    rw [L.hev,Bool.eq_iff_iff,graph_edges]
    simp only [PetersenScratch.edgeValue,decide_eq_true_eq]
  have indep (r) := firstInputGroup_independent L.hcl out live (predecessors_nodup L nonconstant)
    graph computes alternate_neighbors r
  have diff (i j : V) (e : graph.Adj i j) : label i ≠ label j := by
    intro h
    exact indep (label i) i ((mem_firstInputGroup _ _ _ _ _).2 rfl)
      j ((mem_firstInputGroup _ _ _ _ _).2 h.symm) e
  have marked (S : Finset V) : vl gs (setInput S) out.val = true ↔
      BranchGraph.containsEdge graph S := by
    change vl gs (setInput S) o = true ↔ _
    rw [L.hev]
    exact marked_edges S
  have leout (v : V) : label v ≤ out := wire_le_output L.hcl out live _
  have branch (v : V) (h : label v ≠ out) : label v ∈ bs := by
    have stop := FirstBranchRoute.first_stops (readEdge gs) out (read_order L.hcl) live (inputWire gs v)
    exact in_circuit_branches.mpr (stop.resolve_left h)
  let s := Finset.univ.filter fun i : V => ∃ k, graph.Adj i k ∧ label i < label k
  have smem (i : V) : i ∈ s ↔ ∃ k, graph.Adj i k ∧ label i < label k := by simp [s]
  have contained : s.image label ⊆ bs := by
    intro w hw
    obtain ⟨v,hv,rfl⟩ := Finset.mem_image.mp hw
    obtain ⟨k,_,lt⟩ := (smem v).mp hv
    exact branch v (ne_of_lt (lt_of_lt_of_le lt (leout k)))
  have inject : Set.InjOn label (s : Set V) := by
    intro i hi j hj same
    by_contra ne
    obtain ⟨k,e,lk⟩ := (smem i).mp hi
    obtain ⟨l,edge,ll⟩ := (smem j).mp hj
    have stop := FirstBranchRoute.first_stops (readEdge gs) out (read_order L.hcl) live (inputWire gs i)
    have twin := circuit_branch_class_twins L.hcl out live graph marked (label i) (leout i)
      stop (indep (label i))
    have im := (class_mem label (label i) i).mpr rfl
    have jm := (class_mem label (label i) j).mpr same.symm
    have km : k ∈ BranchGraph.neighborsAfter graph (classesBefore label (label i)) i := by
      simp [BranchGraph.neighborsAfter,e,classes_before_mem,lk.le]
    have lm : l ∈ BranchGraph.neighborsAfter graph (classesBefore label (label i)) j := by
      rw [← same] at ll
      simp [BranchGraph.neighborsAfter,edge,classes_before_mem,ll.le]
    have sameNeighbors := twin i im j jm ⟨k,km⟩ ⟨l,lm⟩
    change BranchGraph.neighborsAfter graph (classesBefore label (label i)) i =
      BranchGraph.neighborsAfter graph (classesBefore label (label i)) j at sameNeighbors
    rw [sameNeighbors] at km
    have jk := (Finset.mem_filter.mp km).2.1
    exact excludes_tie L out rfl live i j k ne e jk same lk
  have image_card := Finset.card_image_of_injOn inject
  have budget := branching_budget L.hcl valid (fun w hw hne => by
    let wire : Fin (10 + gs.length) := ⟨w,hw⟩
    obtain ⟨v,p,g,hg,_,hw'⟩ := live wire (fun h => hne (congrArg Fin.val h))
    exact ⟨p,g,hg,hw'⟩)
