noncomputable def binCheck (i : ℕ) : Bool :=
  let p := binRow i
  !(if binMode i = 0 then
    look1 initL initM initG 13 12 p.1 p.2.1 p.2.2.1 p.2.2.2
  else look initL initM initG 13 p.1 p.2.1 p.2.2.1 p.2.2.2)
noncomputable def frcAll (v : List W) : (List W → Bool) → Bool :=
  List.rec (motive := fun _ => (List W → Bool) → Bool) (fun h => h [])
    (fun w _ ih h => st w.s fun s => st w.a fun a => st w.b fun b =>
      st w.c fun c => st w.r fun tag => ih fun r => h (⟨s,a,b,c,tag⟩ :: r)) v
lemma frcAll_eq (v : List W) : ∀ h, frcAll v h = h v := by
  induction v with
  | nil => intro h; rfl
  | cons w v ih =>
    intro h
    change st w.s (fun s => st w.a fun a => st w.b fun b =>
      st w.c fun c => st w.r fun tag => frcAll v fun r => h (⟨s,a,b,c,tag⟩ :: r)) = _
    simp only [st_eq]
    rw [ih]
noncomputable def forceBinCheck (i : ℕ) : Bool :=
  let p := binRow i
  st initL fun l => st initM fun m => st initG fun g =>
    st p.1 fun k => st p.2.1 fun t => st p.2.2.1 fun z =>
    frcAll p.2.2.2 fun v =>
      !(if binMode i = 0 then look1 l m g 13 12 k t z v
      else look l m g 13 k t z v)
lemma forceBinCheck_eq (i : ℕ) : forceBinCheck i = binCheck i := by
  simp only [forceBinCheck, binCheck, st_eq, frcAll_eq]
noncomputable def binGroupCheck (q : ℕ × ℕ) : Bool :=
  (List.range' q.1 q.2).all forceBinCheck

