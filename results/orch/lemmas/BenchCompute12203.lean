noncomputable def forcedPanelWord (pos neg : Nat) (ws : List Sig) (T : Sig) (k rec : Nat) :=
  forceMap BitVec.toNat ws fun ns => panelWord pos neg (ns.map (BitVec.ofNat 512)) T k rec
noncomputable def forcedPanelTableCheck (pos neg : Nat) (g : Forest) (k start n : Nat) (data : Nat→Nat) :=
  (List.range n).all (fun i => forcedPanelWord pos neg (stateSet g k (start+i)) (targetOf g) k (packedAt data (68*i) 68))
noncomputable def forcedPanelDispatch (pos neg : Nat) (g : Forest) (k i : Nat) (kw panels : Nat→Nat) (tag : Nat) :=
  if tag=0 then nodeVerified g k i else if tag<128 then
    kwWord pos neg (targetOf g) (stateSet g k i) k (packedAt kw (32*(tag-1)) 32)
  else forcedPanelWord pos neg (stateSet g k i) (targetOf g) k (packedAt panels (68*(tag-128)) 68)
noncomputable def forcedPanelDispatchTable (pos neg : Nat) (g : Forest) (k start n : Nat) (kw panels : Nat→Nat) (data : Nat) :=
  (List.range n).all fun j => forcedPanelDispatch pos neg g k (start+j) kw panels ((data >>> (8*j)) &&& 255)
noncomputable def forcedKwWord (pos neg : Nat) (T : Sig) (ws : List Sig) (k value : Nat) :=
  forceMap BitVec.toNat ws fun ns => kwWord pos neg T (ns.map (BitVec.ofNat 512)) k value
noncomputable def forcedKwTest (pos neg : Nat) (g : Forest) (k a n : Nat) (data : Nat → Nat) :=
  (List.range n).all (fun j => forcedKwWord pos neg (targetOf g) (stateSet g k (a+j)) k (packedAt data (32*j) 32))
theorem pieces_all {α f xs d} (h : @listPieces α f xs d) : xs.all f=true := by
  induction d generalizing xs with
  | zero => exact h
  | succ d ih =>
    have ap : ((xs.take (xs.length/2)) ++ (xs.drop (xs.length/2))).all f=true := by
      simp only [List.all_append,ih h.1,ih h.2,Bool.and_self]
    simpa only [List.take_append_drop] using ap
