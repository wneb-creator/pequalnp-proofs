lemma current_lower20 (C : Circuit) (hC : Monotone2 C)
    (he : ∀ x : Fin 14 → Bool, C.eval (List.ofFn x) =
      decide (∃ u v : Fin 14, (u.val,v.val) ∈ currentEdges ∧
        x u = true ∧ x v = true)) : 20 ≤ C.size := by
