lemma current_adjacency : ∀ u v : Fin 14,
    (SimpleGraph.fromRel (fun a b : Fin 14 => a.val < 7 ∧ 7 ≤ b.val ∧
      (a.val + (b.val - 7)) % 7 ∈ ({0, 1, 3} : Finset ℕ))).Adj u v ↔
    (u.val, v.val) ∈ currentEdges ∨ (v.val, u.val) ∈ currentEdges := by
