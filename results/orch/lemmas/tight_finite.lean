def canonicalMap (i j k : Fin 10) : Fin 10 :=
  (permutationRows.getD (10 * i.val + j.val) []).getD k.val 0

set_option maxRecDepth 16000 in
set_option maxHeartbeats 3000000 in
lemma canonicalMap_bijective : ∀ i j : Fin 10, Function.Bijective (canonicalMap i j) := by
  decide +kernel

set_option maxRecDepth 16000 in
set_option maxHeartbeats 3000000 in
lemma canonicalMap_adj : ∀ i j a b : Fin 10,
    graphAdj (canonicalMap i j a) (canonicalMap i j b) = graphAdj a b := by
  decide +kernel

set_option maxRecDepth 16000 in
set_option maxHeartbeats 3000000 in
lemma canonicalMap_pair : ∀ i j : Fin 10,
    canonicalMap i j i = 0 ∧ canonicalMap i j j =
      (if i = j then 0 else if graphAdj i j then 1 else 2) := by
  decide +kernel

lemma pair_orbits (i j : Fin 10) :
    ∃ π : Fin 10 ≃ Fin 10,
      (∀ a b : Fin 10, graphAdj (π a) (π b) = graphAdj a b) ∧
      π i = 0 ∧ π j = (if i = j then 0 else if graphAdj i j then 1 else 2) := by
  let π := Equiv.ofBijective (canonicalMap i j) (canonicalMap_bijective i j)
  exact ⟨π, canonicalMap_adj i j, canonicalMap_pair i j⟩

