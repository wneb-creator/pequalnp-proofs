set_option maxHeartbeats 0 in
lemma pin_ne_dependent_and : ∀ (negate : Bool) (i j c : Fin 10),
    i ≠ j → i ≠ c → j ≠ c →
    pins.getD c.val zero ≠ bin (if negate then 3 else 0)
      (bin 1 (pins.getD i.val zero) (pins.getD j.val zero)) (pins.getD c.val zero) := by
  decide +kernel

