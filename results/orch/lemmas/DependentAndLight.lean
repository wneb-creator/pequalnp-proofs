def dependentAndRows (negate : Bool) (i j c : Fin 10) : Row × Row :=
  (Fin.ofNat 1024 (dependentAndBase negate i j c),
    Fin.ofNat 1024 (dependentAndBase negate i j c +
      ([512,128,32,256,64,16,4,1,8,2] : List Nat).getD c.val 0))

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
lemma dependentAndChecked : ∀ (negate : Bool) (i j c : Fin 10),
    i ≠ j → i ≠ c → j ≠ c →
    let rs := dependentAndRows negate i j c
    let s := bin 1 (pins.getD i.val zero) (pins.getD j.val zero)
    let z := bin (if negate then 3 else 0) s (pins.getD c.val zero)
    bit rs.1 target ≠ bit rs.2 target ∧
    bit rs.1 s = bit rs.2 s ∧ bit rs.1 z = bit rs.2 z ∧
    ∀ q : Fin 10, q ≠ c →
      bit rs.1 (pins.getD q.val zero) = bit rs.2 (pins.getD q.val zero) := by
  decide +kernel

lemma dependent_and_keep_input (negate : Bool) (i j c : Fin 10)
    (ij : i ≠ j) (ic : i ≠ c) (jc : j ≠ c)
    {k : Nat} {S : Finset Sig}
    (raw : ∀ v ∈ S, v ∈ pins ∨
      v = bin 1 (pins.getD i.val zero) (pins.getD j.val zero) ∨
      v = bin (if negate then 3 else 0)
        (bin 1 (pins.getD i.val zero) (pins.getD j.val zero)) (pins.getD c.val zero))
    (run : Live true target k S) : pins.getD c.val zero ∈ S := by
  by_contra missing
  obtain ⟨diff, leftSame, rightSame, othersSame⟩ := dependentAndChecked negate i j c ij ic jc
  obtain ⟨v, hv, changed⟩ := live_row_difference run diff
  rcases raw v hv with ordinary | rfl | rfl
  · obtain ⟨q, eq⟩ := (pin_mem v).mp ordinary
    have qc : q ≠ c := by
      rintro rfl
      exact missing (eq.symm ▸ hv)
    exact changed (eq ▸ othersSame q qc)
  · exact changed leftSame
  · exact changed rightSame

