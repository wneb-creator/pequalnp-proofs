def inc (p l : Nat) : Bool :=
  let d := (p + 13 - l) % 13
  d == 0 || d == 1 || d == 3 || d == 9

def rowOK (r : Nat) : Bool :=
  decide (r < 2^26) &&
  (List.range 13).all (fun p =>
    (List.range 13).all (fun l => !(inc p l && r.testBit p && r.testBit (13+l)))) &&
  (List.range 13).all (fun p => r.testBit p ||
    (List.range 13).any (fun l => inc p l && r.testBit (13+l))) &&
  (List.range 13).all (fun l => r.testBit (13+l) ||
    (List.range 13).any (fun p => inc p l && r.testBit p))

