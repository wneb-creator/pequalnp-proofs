lemma singular_direction (T : Matrix (Fin 4) (Fin 4) ℂ) (r : ℂ)
    (hs : ∀ i j : Fin 4, T i j=T j i) (hrow : ∀ j : Fin 4, T 3 j=0)
    (h00 : T 0 0=0) (h01 : T 0 1=1) (h02 : T 0 2=r)
    (hr : r≠0) (hne : r+1≠0)
    (hG : T 2 2+2*r*T 1 2+r^2*T 1 1=0)
    (hK : T 2 2=r^2*T 1 1)
    (hp : ∀ z : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 4) => (1:ℂ)+z*T i j)=24) :
    r^4-4*r^3+14*r^2-4*r+1=0 ∧ T=fixedT r := by
  have hb0 : r*(T 1 2+T 1 1*r)=0 := by
    linear_combination (1/2:ℂ)*hG-(1/2:ℂ)*hK
  have hb : T 1 2= -T 1 1*r := by
    have hz := (mul_eq_zero.mp hb0).resolve_left hr
    linear_combination hz
  have hshape : T=normalizedT (T 1 1) r := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [normalizedT,h00,h01,h02,hb,hK,hs 1 0,hs 2 0,hs 2 1,hs 0 3,hs 1 3,hs 2 3,hrow] <;> ring
  obtain ⟨hQ,hT⟩ := normalized_direction (T 1 1) r hne (by
    intro z
    have hz := hp z
    rw [hshape] at hz
    exact hz)
  exact ⟨hQ,hshape.trans hT⟩


