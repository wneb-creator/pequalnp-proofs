lemma singular_partner_impossible (T B : Matrix (Fin 4) (Fin 4) ℂ) (r : ℂ)
    (hsT : ∀ i j : Fin 4, T i j=T j i) (hsB : ∀ i j : Fin 4, B i j=B j i)
    (hrow : ∀ j : Fin 4, T 3 j=0)
    (h00 : T 0 0=0) (h01 : T 0 1=1) (h02 : T 0 2=r)
    (hr : r≠0) (hne : r+1≠0)
    (hG : T 2 2+2*r*T 1 2+r^2*T 1 1=0)
    (hK : T 2 2=r^2*T 1 1)
    (hB01 : B 0 1=B 0 0) (hB02 : B 0 2=B 0 0+1) (hB03 : B 0 3=B 0 0)
    (hp : ∀ t x : ℂ, Matrix.permanent (Matrix.of fun (i j : Fin 4) => (1:ℂ)+t*T i j+x*B i j)=24) : False := by
