    (pins : g.inputs = k :: tail) (constant : acc.1.getD k (Sum.inl false) = Sum.inl b) :
    (qa n acc g).2 = acc.2 := by
  simp only [qa, hop, pins, List.map_cons, constant, qg, wr]
