lemma tail_lower_of_constant
    {R : Type} (rows : R → Extended.Row) (roots : List (Wire R))
    {T c a : Extended.Sig} {k L : Nat} {U : Finset Extended.Sig}
    (run : Extended.Live true T k (insert c U))
    (ha : a ∈ insert c U)
    (hconst : Constant (restrictRows rows (Extended.observe a)))
    (supplyInputs : ∀ v ∈ insert c U,
      Available true roots (restrictRows rows (Extended.observe v)))
    (hnc : ¬ Constant (restrictRows rows (Extended.observe T)))
    (lower : ∀ q bs, Reach true roots q bs →
      Available true bs (restrictRows rows (Extended.observe T)) → L ≤ q) : L + 1 ≤ k := by
  classical
  let front := a :: ((insert c U).erase a).toList
  have nd : front.Nodup := by
    apply List.nodup_cons.mpr
    exact ⟨by simp, Finset.nodup_toList _⟩
  have eqS : front.toFinset = insert c U := by
    ext v
    by_cases hv : v = a <;> simp [front, hv, ha]
  have hrun := Extended.list_run run front nd eqS
  have hs : supply true roots ((front.map Extended.observe).map (restrictRows rows)) := by
    intro v hv
    obtain ⟨_, hin, rfl⟩ := List.mem_map.mp hv
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hin
    exact supplyInputs w (eqS ▸ List.mem_toFinset.mpr hw)
  have need := projected_bound rows hrun hnc Reach.start hs lower
  have charge : 1 ≤ mass ((front.map Extended.observe).map (restrictRows rows)) := by
    simp [front, mass_cons, cost, hconst]
  omega

