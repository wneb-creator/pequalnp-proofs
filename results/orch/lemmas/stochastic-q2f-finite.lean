def q2f_seed (s : Fin 15) (a b c : Fin 10) (m : Fin 128) : Bool :=
  decide (cap7_card m = 3 ∨ cap7_card m = 4) &&
    ((q2f_small s a b c (q2f_cut m 0 0) && q2f_small s a b c (q2f_cut m 0 1)) || (q2f_small s a b c (q2f_cut m 1 0) && q2f_small s a b c (q2f_cut m 1 1)) || (q2f_small s a b c (q2f_cut m 2 0) && q2f_small s a b c (q2f_cut m 2 1)))

def q2f_grow (s : Fin 15) (a b c : Fin 10) (x m : Fin 128) : Bool :=
  q2f_sub x m && q2f_small s a b c (q2f_diff m x)

def q2f_node (s : Fin 15) (a b c : Fin 10) (i : Fin 10) : Bool :=
  let m := q2f_raw s a b c i
  q2f_closed s a b c m ||
    (!q2f_seed s a b c m && !q2f_grow s a b c (q2f_known s a b c 0) m &&
    !q2f_grow s a b c (q2f_known s a b c 1) m &&
    !q2f_grow s a b c (q2f_known s a b c 2) m)

def q2f_pair (s : Fin 15) (a b c : Fin 10) (i j : Fin 3) : Bool :=
  let u := q2f_union (q2f_known s a b c i) (q2f_known s a b c j)
  let v := q2f_inter (q2f_known s a b c i) (q2f_known s a b c j)
  (!q2f_allowed s a b c u || q2f_closed s a b c u) &&
    (!q2f_allowed s a b c v || q2f_closed s a b c v)

def q2f_generators (s : Fin 15) (a b c : Fin 10) : Bool :=
  q2f_node s a b c 0 &&
    q2f_node s a b c 1 &&
    q2f_node s a b c 2 &&
    q2f_node s a b c 3 &&
    q2f_node s a b c 4 &&
    q2f_node s a b c 5 &&
    q2f_node s a b c 6 &&
    q2f_node s a b c 7 &&
    q2f_node s a b c 8 &&
    q2f_node s a b c 9 &&
    q2f_pair s a b c 0 1 &&
    q2f_pair s a b c 0 2 &&
    q2f_pair s a b c 1 2

def q2f_shape (s : Fin 15) (a b c : Fin 10) : Bool :=
  (decide (cap7_card (q2f_raw s a b c 0) ≤ 2) || decide (q2f_raw s a b c 0 = 11) || decide (q2f_raw s a b c 0 = 69) || decide (q2f_raw s a b c 0 = 49) || decide (q2f_raw s a b c 0 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 1) ≤ 2) || decide (q2f_raw s a b c 1 = 11) || decide (q2f_raw s a b c 1 = 69) || decide (q2f_raw s a b c 1 = 49) || decide (q2f_raw s a b c 1 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 2) ≤ 2) || decide (q2f_raw s a b c 2 = 11) || decide (q2f_raw s a b c 2 = 69) || decide (q2f_raw s a b c 2 = 49) || decide (q2f_raw s a b c 2 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 3) ≤ 2) || decide (q2f_raw s a b c 3 = 11) || decide (q2f_raw s a b c 3 = 69) || decide (q2f_raw s a b c 3 = 49) || decide (q2f_raw s a b c 3 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 4) ≤ 2) || decide (q2f_raw s a b c 4 = 11) || decide (q2f_raw s a b c 4 = 69) || decide (q2f_raw s a b c 4 = 49) || decide (q2f_raw s a b c 4 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 5) ≤ 2) || decide (q2f_raw s a b c 5 = 11) || decide (q2f_raw s a b c 5 = 69) || decide (q2f_raw s a b c 5 = 49) || decide (q2f_raw s a b c 5 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 6) ≤ 2) || decide (q2f_raw s a b c 6 = 11) || decide (q2f_raw s a b c 6 = 69) || decide (q2f_raw s a b c 6 = 49) || decide (q2f_raw s a b c 6 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 7) ≤ 2) || decide (q2f_raw s a b c 7 = 11) || decide (q2f_raw s a b c 7 = 69) || decide (q2f_raw s a b c 7 = 49) || decide (q2f_raw s a b c 7 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 8) ≤ 2) || decide (q2f_raw s a b c 8 = 11) || decide (q2f_raw s a b c 8 = 69) || decide (q2f_raw s a b c 8 = 49) || decide (q2f_raw s a b c 8 = q2f_superCode s)) &&
    (decide (cap7_card (q2f_raw s a b c 9) ≤ 2) || decide (q2f_raw s a b c 9 = 11) || decide (q2f_raw s a b c 9 = 69) || decide (q2f_raw s a b c 9 = 49) || decide (q2f_raw s a b c 9 = q2f_superCode s))

def q2f_certificate (s : Fin 15) (a b c : Fin 10) : Bool :=
  decide (7 ≤ (q2f_codes s a b c).card) &&
    (decide (8 ≤ (q2f_codes s a b c).card) || q2f_shape s a b c ||
      (q2f_generators s a b c && !q2f_closed s a b c (q2f_missing s a b c)))


