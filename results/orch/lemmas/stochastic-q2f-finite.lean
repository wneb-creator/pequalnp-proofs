def q2f_pack (s : Fin 15) (a b c : Fin 10) : ℕ :=
  ![q2f_pack0 a b c,q2f_pack1 a b c,q2f_pack2 a b c,q2f_pack3 a b c,q2f_pack4 a b c,q2f_pack5 a b c,q2f_pack6 a b c,q2f_pack7 a b c,q2f_pack8 a b c,q2f_pack9 a b c,q2f_pack10 a b c,q2f_pack11 a b c,q2f_pack12 a b c,q2f_pack13 a b c,q2f_pack14 a b c] s

def q2f_known (s : Fin 15) (a b c : Fin 10) (j : Fin 3) : Fin 128 :=
  let k := q2f_pack s a b c / 11^j.val % 11
  if h : k < 10 then q2f_raw s a b c ⟨k,h⟩ else 0

def q2f_missing (s : Fin 15) (a b c : Fin 10) : Fin 128 :=
  q2f_raw s a b c ⟨q2f_pack s a b c / 1331 % 10,Nat.mod_lt _ (by decide)⟩

def q2f_closed (s : Fin 15) (a b c : Fin 10) (m : Fin 128) : Bool :=
  q2f_small s a b c m || decide (m = q2f_known s a b c 0) || decide (m = q2f_known s a b c 1) || decide (m = q2f_known s a b c 2)

