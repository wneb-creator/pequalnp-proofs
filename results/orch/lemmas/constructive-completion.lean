def hit (x : Fin 14 → Bool) : Bool :=
  decide (∃ p l : Fin 7, (p = l ∨ p = l+1 ∨ p = l+3) ∧
    x (Fin.castAdd 7 p) = true ∧ x (Fin.natAdd 7 l) = true)

def rows (p q : Fin 7) (x : Fin 14 → Bool) : Bool :=
  hit x || ((x (Fin.castAdd 7 p) || x (Fin.castAdd 7 q)) &&
    decide (∃ t : Fin 7,
      ((p = t ∨ p = t+1 ∨ p = t+3) ∨ (q = t ∨ q = t+1 ∨ q = t+3)) ∧
        x (Fin.natAdd 7 t) = true))

def cols (l m : Fin 7) (x : Fin 14 → Bool) : Bool :=
  hit x || ((x (Fin.natAdd 7 l) || x (Fin.natAdd 7 m)) &&
    decide (∃ p : Fin 7,
      ((p = l ∨ p = l+1 ∨ p = l+3) ∨ (p = m ∨ p = m+1 ∨ p = m+3)) ∧
        x (Fin.castAdd 7 p) = true))

def pairIndex (p q : Fin 7) : ℕ := p.val * (13-p.val) / 2 + (q.val-p.val-1)

