def witness (p q l m : Fin 7) (i : Fin 14) : Bool :=
  (masks.getD (pairIndex p q * 21 + pairIndex l m) 0).testBit i.val

set_option maxRecDepth 16000 in
set_option maxHeartbeats 4000000 in
lemma witness_correct : ∀ p q l m : Fin 7, p < q → l < m →
    hit (witness p q l m) = false ∧ rows p q (witness p q l m) = true ∧
      cols l m (witness p q l m) = true := by
  decide

lemma pair_completion_obstruction (p q l m : Fin 7) (hpq : p < q) (hlm : l < m) :
    ¬ (∀ x : Fin 14 → Bool, (rows p q x && cols l m x) = hit x) := by
  intro h
  obtain ⟨hf,hr,hc⟩ := witness_correct p q l m hpq hlm
  have bad := h (witness p q l m)
  rw [hf,hr,hc] at bad
  contradiction

