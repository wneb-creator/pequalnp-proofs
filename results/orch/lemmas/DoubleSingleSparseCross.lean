lemma coefficients_zero (a b c d e f g k i j rr : ℂ) (hr : rr ^ 2 = 2)
    (hp : ∀ x y z, Matrix.permanent (Matrix.of fun r s => (1 : ℂ) +
      model a b c d e f g k i j rr x y z r s) = 24) : ∀ n, coefficients a b c d e f g k i j rr n = 0 := by
