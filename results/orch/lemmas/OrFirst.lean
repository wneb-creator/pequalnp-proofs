import Structural16

namespace PEqualNP.Outside.L_meta_2592_aux.SignedFloor.Extended

def orSecondRows : Nat := 

def orSecondPair (a b c : Sig) (d : Nat) : Row × Row :=
  let r := (orSecondRows >>> ((((pins.idxOf a * 10 + pins.idxOf b) * 10 + pins.idxOf c) * 4 + d) * 10)) &&& 1023
  let flip := ([512,128,32,256,64,16,4,1,8,2] : List Nat).getD (pins.idxOf c) 0
  (Fin.ofNat 1024 r, Fin.ofNat 1024 (r ^^^ flip))

def orSecondTest (a b c : Sig) (d : Nat) : Bool :=
  let r := (orSecondPair a b c d).1
  let s := (orSecondPair a b c d).2
  let first := bin 1 a b
  (bit r target != bit s target) && (bit r first == bit s first) &&
    (bit r (bin d first c) == bit s (bin d first c)) &&
    pins.all (fun z => z == c || bit r z == bit s z)

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
lemma orSecondCertificate : pins.all (fun a => pins.all (fun b => pins.all (fun c =>
    (List.range 4).all (fun d => a == b || c == a || c == b || orSecondTest a b c d)))) = true := by
  decide +kernel

lemma orSecondWitness {a b c : Sig} {d : Nat}
    (ha : a ∈ pins) (hb : b ∈ pins) (hc : c ∈ pins)
    (hab : a ≠ b) (hca : c ≠ a) (hcb : c ≠ b) (hd : d < 4) :
    ∃ r s : Row, bit r target ≠ bit s target ∧
      bit r (bin 1 a b) = bit s (bin 1 a b) ∧
      bit r (bin d (bin 1 a b) c) = bit s (bin d (bin 1 a b) c) ∧
      ∀ z ∈ pins, z ≠ c → bit r z = bit s z := by
  have check := List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp
    (List.all_eq_true.mp orSecondCertificate a ha) b hb) c hc) d (List.mem_range.mpr hd)
  have good : orSecondTest a b c d = true := by
    simpa only [Bool.or_eq_true, beq_iff_eq, hab, hca, hcb, false_or] using check
  simp only [orSecondTest, Bool.and_eq_true, bne_iff_ne, beq_iff_eq] at good
  refine ⟨(orSecondPair a b c d).1, (orSecondPair a b c d).2,
    good.1.1.1, good.1.1.2, good.1.2, ?_⟩
  intro z hz hzc
  have equal := List.all_eq_true.mp good.2 z hz
  simpa only [Bool.or_eq_true, beq_iff_eq, hzc, false_or] using equal

lemma or_second_pin_retained {a b c : Sig} {d k : Nat} {U : Finset Sig}
    (ha : a ∈ pins) (hb : b ∈ pins) (hc : c ∈ pins)
    (hab : a ≠ b) (hca : c ≠ a) (hcb : c ≠ b) (hd : d < 4)
    (raw : ∀ z ∈ U, z ∈ pins ∨ z = bin 1 a b)
    (tail : Live true target k (insert (bin d (bin 1 a b) c) U)) :
    c ∈ U := by
  by_contra missing
  obtain ⟨r,s,diff,firstSame,secondSame,others⟩ := orSecondWitness ha hb hc hab hca hcb hd
  obtain ⟨z,hz,changed⟩ := live_row_difference tail diff
  rcases Finset.mem_insert.mp hz with rfl | hz
  · exact changed secondSame
  · rcases raw z hz with pin | rfl
    · exact changed (others z pin (fun e => missing (e ▸ hz)))
    · exact changed firstSame

end PEqualNP.Outside.L_meta_2592_aux.SignedFloor.Extended
