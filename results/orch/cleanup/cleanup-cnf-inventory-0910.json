  "total_bytes": 91755570,
  "regeneration": "Use a fresh scratch directory and retained source/map/seed data; never remove retained maps to satisfy generator no-overwrite guards. Regenerated DIMACS bytes are independent of output path.",
  "recipes": {
    "unique": {
      "generator": "unique_input_base.py (metadata-only copy of repair_base.py)",
      "base_flags": [
        "--gates",
        "N",
        "--no-canon",
        "--allow-initial-repeats",
        "--allow-trivial"
      ],
      "stages": [
        "Generate base (N26/27/28 from preserved map).",
        "Apply add_unique_input.py to base for critical stage.",
        "Apply add_raw_fanout.py to critical stage for fanout stage.",
        "For fixed27/28, fix_correlated_smoke.py --toposort using unique0-star27.json or unique0-star28-padded.json."
      ],
      "special": "original-equivalence uses repair_base.py with the same26 flags; its CNF is byte-identical to unique0-26-permissive-base.",
      "provenance": [
        "unique0-preparation.json",
        "unique-input-source.diff",
        "unique0-27-smoke-result.json",
        "unique0-27-smoke-solve.log",
        "unique0-28-pad-result.json",
        "unique0-28-pad-solve.log"
      ]
    },
    "repair": {
      "generator": "repair_base.py",
      "base_flags": [
        "--gates",
        "N",
        "--no-canon",
        "--allow-initial-repeats",
        "--allow-trivial",
        "--no-liveness",
        "--no-lex-order"
      ],
      "stages": [
        "Generate base (N26/27 from preserved map; repair-base26.cnf is kept).",
        "Apply repair_neighborhood.py --cnf BASE --seed SEED --budget K --output OUT, with K and exact normalized seed retained in map.repair."
      ],
      "seeds": [
        "near26.json",
        "star27.json",
        "repair-star27-op-error-seed.json",
        "/tmp/oec/pequalnp-pilot-70/lower-bound/cegis26-hints.iteration-7.json"
      ],
      "provenance": [
        "repair-review.json",
        "repair-properties.log",
        "repair-k4-preparation.json",
        "stable-repair-k4-artifacts.json"
      ]
    },
    "fanout": {
      "stages": [
        "raw-fanout26: add_raw_fanout.py repair-base26.cnf OUT.",
        "raw-fanout27-smoke: add_raw_fanout.py repair-star27-k0-smoke.cnf OUT."
      ],
      "provenance": [
        "raw-fanout27-smoke-validation.log",
        "raw-fanout27-smoke-generation.log",
        "/tmp/oec/pequalnp-pilot-70/lower-bound/raw-fanout27-independent-review.log"
      ]
    },
    "f0": {
      "generator": "synthesize.py",
      "base_flags": [
        "--gates",
        "24",
        "--edge-file",
        "f0-available-a-graph.json",
        "--no-canon",
        "--no-liveness",
        "--no-lex-order"
      ],
      "stages": [
        "Generate f0-available-a24-base.cnf.",
        "Apply f0_available_a.py fix-prefix BASE OUT."
      ],
      "provenance": [
        "f0-available-a24-run.json",
        "f0-available-a24-result.json",
        "f0-available-a24-solve.log"
      ]
    }
  },
