#!/usr/bin/env python3
"""Scratch Lake handoff prototype: no environment capture or reinjection."""
import json
import os
from pathlib import Path
import select
import signal
import socket
import subprocess
import sys
import tempfile
import time

VERIFIER = "/workspace/pequalnp-proofs/lean/.lake/build/bin/checklemma"
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)


def finish(status):
    if status < 0:
        number = -status
        if number not in (signal.SIGKILL, signal.SIGSTOP):
            signal.signal(number, signal.SIG_DFL)
        os.kill(os.getpid(), number)
        return 128 + number
    return status


def receive_line(connection, buffer):
    if b"\n" in buffer:
        line, _, rest = buffer.partition(b"\n")
        return line.decode("ascii"), rest, False
    ready, _, _ = select.select([connection], [], [], 0.05)
    if not ready:
        return None, buffer, False
    chunk = connection.recv(512)
    if not chunk:
        return None, buffer, True
    buffer += chunk
    if len(buffer) > 1024:
        raise RuntimeError("oversized worker status message")
    if b"\n" in buffer:
        line, _, rest = buffer.partition(b"\n")
        return line.decode("ascii"), rest, False
    return None, buffer, False


def stop_lake(lake, number=signal.SIGTERM, grace=2):
    if lake.poll() is not None:
        return lake.returncode
    try:
        lake.send_signal(number)
    except ProcessLookupError:
        return lake.wait(timeout=grace)
    try:
        return lake.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        lake.kill()
        try:
            return lake.wait(timeout=grace)
        except subprocess.TimeoutExpired as error:
            raise RuntimeError("owned Lake did not exit after kill") from error


def handoff(config_path, config, argv):
    directory = config_path.parent
    pending = []
    old_handlers = {number: signal.signal(number, lambda n, f: pending.append(n))
                    for number in SIGNALS}
    connection = None
    lake = None
    go_sent = False
    stop_grace = config.get("lake_stop_timeout_seconds", 2)
    try:
        # Explicit scratch location; no TMPDIR or other environment lookup.
        with tempfile.TemporaryDirectory(prefix="run-", dir=directory) as temporary:
            os.chmod(temporary, 0o700)
            address = str(Path(temporary) / "control")
            listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                listener.bind(address)
                listener.listen(1)
                listener.setblocking(False)
                command = [config["real_lake"], "env", sys.executable, "-B",
                    str(directory / "helper.py"), "--socket", address,
                    "--config", str(config_path), "--", *argv]
                lake = subprocess.Popen(command)
                deadline = time.monotonic() + config.get("handoff_timeout_seconds", 120)
                while connection is None:
                    if pending:
                        stop_lake(lake, pending[0], stop_grace)
                        return -pending[0]
                    if time.monotonic() > deadline:
                        raise RuntimeError("Lake handoff connection timed out")
                    ready, _, _ = select.select([listener], [], [], 0.05)
                    if ready:
                        connection, _ = listener.accept()
                        break
                    status = lake.poll()
                    if status is not None and status != 0:
                        return status
                listener.close()
                buffer = b""
                worker_ready = False
                sent_signal = False
                while not worker_ready:
                    if pending:
                        number = pending[0]
                        connection.sendall(f"SIGNAL {number}\n".encode("ascii"))
                        stop_lake(lake, number, stop_grace)
                        return -number
                    line, buffer, eof = receive_line(connection, buffer)
                    if eof:
                        raise RuntimeError("worker disconnected before readiness")
                    if line is not None:
                        fields = line.split()
                        if len(fields) != 2 or fields[0] != "READY" or not fields[1].isdigit():
                            raise RuntimeError("invalid worker readiness message")
                        if int(fields[1]) <= 0:
                            raise RuntimeError("invalid worker process id")
                        worker_ready = True
                    if time.monotonic() > deadline:
                        raise RuntimeError("worker readiness timed out")
                # Lake must be fully gone before the worker can enter storage mode.
                while lake.poll() is None:
                    if pending:
                        number = pending[0]
                        connection.sendall(f"SIGNAL {number}\n".encode("ascii"))
                        stop_lake(lake, number, stop_grace)
                        return -number
                    if time.monotonic() > deadline:
                        raise RuntimeError("Lake did not exit after helper fork")
                    time.sleep(0.01)
                if lake.returncode != 0:
                    connection.sendall(b"SIGNAL 15\n")
                    return lake.returncode
                while pending:
                    connection.sendall(f"SIGNAL {pending.pop(0)}\n".encode("ascii"))
                    sent_signal = True
                if not sent_signal:
                    connection.sendall(b"GO\n")
                    go_sent = True
                while True:
                    while pending:
                        connection.sendall(f"SIGNAL {pending.pop(0)}\n".encode("ascii"))
                    line, buffer, eof = receive_line(connection, buffer)
                    if line is not None:
                        fields = line.split()
                        if len(fields) != 2 or fields[0] != "STATUS":
                            raise RuntimeError("invalid worker completion message")
                        status = int(fields[1])
                        if not -64 <= status <= 255:
                            raise RuntimeError("invalid worker status value")
                        return status
                    if eof:
                        raise RuntimeError("worker exited without a restoration-complete status")
            finally:
                listener.close()
    except (OSError, ValueError, RuntimeError) as error:
        print(f"handoff-wrapper: {error}", file=sys.stderr)
        return 125
    finally:
        # On unexpected outer failure, EOF requests worker cancellation and restoration.
        if connection is not None:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            connection.close()
        if lake is not None and lake.poll() is None and not go_sent:
            stop_lake(lake, grace=stop_grace)
        for number, handler in old_handlers.items():
            signal.signal(number, handler)


def main():
    config_path = Path(__file__).resolve().parent / "config.json"
    try:
        config = json.loads(config_path.read_text())
        real_lake = config["real_lake"]
        if not isinstance(real_lake, str) or not os.path.isabs(real_lake):
            raise ValueError("real_lake must be absolute")
        if Path(real_lake).resolve() == Path(__file__).resolve():
            raise ValueError("recursive real_lake path")
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"handoff-wrapper: invalid configuration: {error}", file=sys.stderr)
        return 125
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "env" and argv[1] == VERIFIER:
        return finish(handoff(config_path, config, argv[1:]))
    try:
        os.execv(real_lake, [real_lake, *argv])
    except OSError as error:
        print(f"handoff-wrapper: cannot execute Lake: {error}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
