lemma pair_orbits : ∀ i j : Fin 9, i ≠ j → ∃ g : Fin 12,
    (rawSym g i, rawSym g j) ∈ pairReps ∨ (rawSym g j, rawSym g i) ∈ pairReps := by
  decide +kernel

