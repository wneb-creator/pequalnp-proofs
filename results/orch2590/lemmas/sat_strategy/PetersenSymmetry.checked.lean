def orbitMap (u v i : Fin 10) : Fin 10 :=
  ((table.getD u.val []).getD v.val []).getD i.val 0

set_option maxRecDepth 10000 in
set_option maxHeartbeats 100000000 in
lemma orbit_checked :
    ∀ u v : Fin 10,
      Function.Bijective (orbitMap u v) ∧
      orbitMap u v u = 0 ∧
      orbitMap u v v = (if u = v then 0 else if adj u v then 1 else 2) ∧
      ∀ i j : Fin 10, adj (orbitMap u v i) (orbitMap u v j) = adj i j := by
  decide +kernel

