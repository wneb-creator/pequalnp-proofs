def collisionDeltaKeep : List Nat → Nat → List Nat
  | [], _ => []
  | x :: xs, mask => if mask % 2 = 0 then collisionDeltaKeep xs (mask / 2)
      else x :: collisionDeltaKeep xs (mask / 2)

def collisionDeltaIds : Nat → Nat → List Nat
  | 0, _ => []
  | fuel + 1, i =>
      let code := collisionDeltaCodes[i]?.getD 0
      let distance := code &&& 15
      let count := (code >>> 4) &&& 255
      let old := if distance = 0 then [] else collisionDeltaIds fuel (i - distance)
      let mask := (code >>> 12) &&& (2 ^ old.length - 1)
      collisionDeltaKeep old mask ++ (List.range count).map fun k =>
        (code >>> (12 + old.length + 9 * k)) &&& 511

def collisionIds (node : Nat) : List Nat := collisionDeltaIds 8 (node / 32)
