def decodeStateBy (getCode : Nat → Nat) : Nat → Nat → State
  | 0, _ => ⟨Extended.initial, []⟩
  | fuel+1, i => if i=0 then ⟨Extended.initial, []⟩ else
      let code := getCode i
      applyCode (decodeStateBy getCode fuel (code >>> 19)) code

lemma decodeStateBy_unpack (codes fuel i : Nat) :
    decodeStateBy (unpack codes) fuel i = decodeState codes fuel i := by
  induction fuel generalizing i with
  | zero => rfl
  | succ fuel ih =>
    simp only [decodeStateBy,decodeState]
    split
    · rfl
    · rw [ih]

