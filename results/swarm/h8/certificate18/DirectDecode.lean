def readStateParent : Nat → Nat → Nat → Nat
  | 0, parent, _ => parent
  | count + 1, parent, deltas =>
    let d := Nat.log2 (deltas ^^^ (deltas - 1))
    readStateParent count (parent + d) (deltas >>> (d + 1))

def stateCodeAt (i : Nat) : Nat :=
  let block := parentStateBlocks[i / 32]?.getD 0
  let parent := readStateParent (i % 32) (block &&& 8191) (block >>> 13)
  ((localStateCodes >>> (19 * i)) &&& 524287) ||| (parent <<< 19)

def state (i : Fin 5230) : State := decodeStateBy stateCodeAt 9 i.val

def parentAt (i : Nat) : Nat := stateCodeAt i >>> 19

