def inversePinCodes : Nat := 

def inversePins (i : Fin 120) : List Word :=
  (List.finRange 10).map fun j =>
    Extended.pins.getD ((inversePinCodes >>> (40*i.val+4*j.val)) &&& 15) Extended.zero

set_option maxRecDepth 16384 in
set_option maxHeartbeats 0 in
lemma inversePins_checked : (List.finRange 120).all (fun i =>
    Extended.initial.map (Automorphism.movedWord (autoMoves i).reverse) == inversePins i) = true := by
  apply listPieces_all (d:=4)
  simp only [listPieces]
  repeat' apply And.intro
  all_goals decide +kernel

lemma inversePins_eq (i : Fin 120) :
    Extended.initial.map (Automorphism.movedWord (autoMoves i).reverse) = inversePins i :=
  beq_iff_eq.mp (List.all_eq_true.mp inversePins_checked i (List.mem_finRange i))

def replayBank (getCode : Nat → Nat) (fuel node : Nat) (a : Fin 120) : List Word :=
  decodeLiveFrom getCode (inversePins a) fuel node

lemma replayBank_eq (getCode : Nat → Nat) (fuel node : Nat) (a : Fin 120) :
    replayBank getCode fuel node a =
      (decodeStateBy getCode fuel node).live.map (Automorphism.movedWord (autoMoves a).reverse) := by
  rw [moved_decodeStateBy,inversePins_eq]
  rfl

end PEqualNP.Outside.L_meta_2373_aux.Cert18.Replay.LinkedReplay
