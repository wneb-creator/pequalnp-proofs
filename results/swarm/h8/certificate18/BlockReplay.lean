def poolUnary : Nat → Nat → Nat → Nat × Nat
  | 0, data, count => (count, data)
  | fuel + 1, data, count =>
      if data % 2 = 0 then (count, data / 2)
      else poolUnary fuel (data / 2) (count + 1)

def poolSymbol : Nat → Nat → Nat → Nat → Nat → Nat → Nat × Nat
  | 0, data, _, _, _, _ => (0, data)
  | fuel + 1, data, code, first, base, len =>
      let code := 2 * code + data % 2
      let data := data / 2
      let count := (poolHuffmanCounts >>> (11 * (len - 1))) % 2048
      if first ≤ code ∧ code < first + count then
        ((poolAtomCodes >>> (20 * (base + code - first))) % 1048576, data)
      else poolSymbol fuel data code (2 * (first + count)) (base + count) (len + 1)

def poolSymbols : Nat → Nat → List Nat × Nat
  | 0, data => ([], data)
  | count + 1, data =>
      let (value, data) := poolSymbol 14 data 0 0 0 1
      let (values, data) := poolSymbols count data
      (value :: values, data)

def poolKeep : List Nat → Nat → List Nat
  | [], _ => []
  | x :: xs, mask =>
      if mask % 2 = 0 then poolKeep xs (mask / 2)
      else x :: poolKeep xs (mask / 2)

def poolDecode : Nat → Nat → Array (List Nat) → Array (List Nat)
  | 0, _, rows => rows
  | count + 1, data, rows =>
      let (kept, data) :=
        if data % 2 = 0 then ([], data / 2)
        else
          let (quotient, data) := poolUnary 64 (data / 2) 0
          let scale := 2 ^ poolDeltaRiceBits
          let distance := quotient * scale + data % scale + 1
          let data := data / scale
          let old := rows[rows.size - distance]?.getD []
          let scale := 2 ^ old.length
          (poolKeep old (data % scale), data / scale)
      let (addedCount, data) := poolUnary 32 data 0
      let (added, data) := poolSymbols addedCount data
      poolDecode count data (rows.push (kept ++ added))

def poolHintCodesAt (i : Nat) : List Nat :=
  let localIndex := i % poolBlockSize
  let data := poolBlockCodes[i / poolBlockSize]?.getD 0
  let rows := poolDecode (localIndex + 1) data #[]
  rows[localIndex]?.getD []


def hints (i : Node) : List PoolHint := (poolHintCodesAt i.val).map hintOfCode

def checkNode (i : Node) : Bool :=
  nodeCheckHalf PEqualNP.Outside.L_meta_6581.Extended.target
    (oracleOf hints i) (budget i) (state i).live

