def linkLevelStarts : Array Nat := #[0,1,3,27,292,1926,4547,5181,5228,5230,5230]

def readLinkDelta : Nat → Nat → Nat × Nat
  | 0, n => (0, n)
  | fuel + 1, n =>
    let b := n &&& 15
    if b < 8 then (b, n >>> 4) else
      let rest := readLinkDelta fuel (n >>> 4)
      (b % 8 + 8 * rest.1, rest.2)

def readLinkAuto : Nat → Nat → Nat → Nat × Nat
  | 0, _, n => (0, n)
  | fuel + 1, q, n =>
    if q ≥ 128 then (q - 128, n) else
      let w := linkAutoTree >>> (16 * q)
      readLinkAuto fuel ((w >>> (8 * (n % 2))) &&& 255) (n >>> 1)

def readLinks : Nat → Nat → Nat → List (Nat × Nat)
  | 0, _, _ => []
  | count + 1, previous, n =>
    let d := readLinkDelta 4 n
    let a := readLinkAuto 13 0 d.2
    let target := previous + d.1
    (target, a.1) :: readLinks count target a.2

def explicitLinkIndices (depth node : Nat) : List (Nat × Nat) :=
  let n := linkCodes[node]?.getD 0
  readLinks (n &&& 63) (linkLevelStarts[depth + 1]?.getD 0) (n >>> 6)


def externalLinks (i : Node) : List (Link 5230) :=
  (explicitLinkIndices (state i).paidPrefix.length i.val).map fun l =>
    (Fin.ofNat 5230 l.1, autoMoves (Fin.ofNat 120 l.2))

def allLinks (i : Node) : List (Link 5230) := identityLinks i ++ externalLinks i

lemma allLinks_valid (i : Node) :
    ∀ l ∈ allLinks i, Automorphism.autoOK Extended.target l.2 = true := by
  intro l hl
  rcases List.mem_append.mp hl with hi | he
  · exact identityLinks_valid i l hi
  · obtain ⟨j,hj,rfl⟩ := List.mem_map.mp he
    exact autoMoves_valid _

def oracleOf (hints : Node → List PoolHint) (i : Node) : Nat → List Word → Choice → Bool :=
  preparedOracleFast (poolList (state i) (hints i))
    (profilePairs (state i).live pairs) (prepareLinks state budget i (allLinks i))

lemma oracleOf_sound (hints : Node → List PoolHint) (i : Node)
    (earlier : ∀ j, budget j < budget i →
      Impossible Extended.target (budget j) (state j).live)
    {k ws op} (checked : oracleOf hints i k ws op = true) :
    Impossible Extended.target k ws := by
  exact preparedOracleFast_sound (fun _ hc => poolList_sound hc)
    (prepareLinks_sound (allLinks_valid i) earlier) checked

lemma closedOf (hints : Node → List PoolHint)
    (checked : ∀ i, nodeCheckHalf Extended.target (oracleOf hints i)
      (budget i) (state i).live = true) :
    Impossible Extended.target 17 Extended.initial :=
  close_forest (oracleOf hints) (fun i hi _ _ _ hc => oracleOf_sound hints i hi hc) checked

