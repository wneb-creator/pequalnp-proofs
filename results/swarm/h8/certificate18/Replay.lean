abbrev Node := Fin 5230

def state (i : Node) : State := decodeState stateCodes 9 i.val

def budget (i : Node) : Nat := 17 - (state i).paidPrefix.length

def parentAt (j : Nat) : Nat := (unpack stateCodes j) >>> 19

def lowerParent (wanted : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | fuel+1, lo, hi =>
    if lo < hi then
      let mid := (lo+hi)/2
      if parentAt mid < wanted then lowerParent wanted fuel (mid+1) hi
      else lowerParent wanted fuel lo mid
    else lo

def identityLinks (i : Node) : List (Link 5230) :=
  let first := lowerParent i.val 13 1 5230
  let last := lowerParent (i.val+1) 13 1 5230
  (List.range (last-first)).map fun j => (Fin.ofNat 5230 (first+j), [])

lemma identityLinks_valid (i : Node) :
    ∀ l ∈ identityLinks i, Automorphism.autoOK Extended.target l.2 = true := by
  intro l hl
  obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hl
  simp [Automorphism.autoOK,Automorphism.composedOK,Automorphism.movedWord]

def unpackSwaps : Nat → Nat → List (Fin 10 × Fin 10)
  | 0, _ => []
  | fuel+1, code => if code=0 then [] else
      (Fin.ofNat 10 (code &&& 15),Fin.ofNat 10 ((code >>> 4) &&& 15)) ::
        unpackSwaps fuel (code >>> 8)

def autoMoves (i : Fin 120) : List Automorphism.Move :=
  Automorphism.fastSwapWords (unpackSwaps 9 (autoSwapCodes.getD i.val 0))

set_option maxRecDepth 16384 in
set_option maxHeartbeats 0 in
lemma autoMoves_valid : ∀ i : Fin 120,
    Automorphism.autoOK Extended.target (autoMoves i) = true := by
  have all : (List.finRange 120).all (fun i =>
      Automorphism.autoOK Extended.target (autoMoves i)) = true := by
    apply listPieces_all (d:=4)
    simp only [listPieces]
    repeat' apply And.intro
    all_goals decide +kernel
  intro i
  exact List.all_eq_true.mp all i (List.mem_finRange i)

def linkOfCode (code : Nat) : Link 5230 :=
  (Fin.ofNat 5230 (code &&& 8191), autoMoves (Fin.ofNat 120 (code >>> 13)))

lemma linkOfCode_valid (code : Nat) :
    Automorphism.autoOK Extended.target (linkOfCode code).2 = true :=
  autoMoves_valid _

def pairs : List Pair := (List.range collisionPairCount).map fun i =>
  let v := collisionPairCodes >>> (20*i)
  (Fin.ofNat 1024 v, Fin.ofNat 1024 (v >>> 10))

lemma close_forest
    (oracle : Node → Nat → List Word → Choice → Bool)
    (sound : ∀ i, (∀ j, budget j < budget i →
        Impossible Extended.target (budget j) (state j).live) →
      ∀ k ws op, oracle i k ws op = true → Impossible Extended.target k ws)
    (checked : ∀ i, nodeCheckHalf Extended.target (oracle i) (budget i) (state i).live = true) :
    Impossible Extended.target 17 Extended.initial := by
  have go : ∀ b i, budget i = b → Impossible Extended.target (budget i) (state i).live := by
    intro b
    induction b using Nat.strong_induction_on with
    | ind b ih =>
      intro i hi
      apply nodeCheckHalf_sound (sound i ?_) (checked i)
      intro j hj
      exact ih (budget j) (by omega) j rfl
  exact go 17 0 rfl
