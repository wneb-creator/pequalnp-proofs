def firstPerm (m : Fin 1024) : Fin 120 := ⟨(firstCode m.val % 128) % 120, by omega⟩

def firstRep (m : Fin 1024) : Fin 34 := ⟨(firstCode m.val / 128) % 34, by omega⟩

set_option maxRecDepth 8000 in
lemma firstCheck : ∀ (m : Fin 1024) (v : V), m.val.testBit v.val =
    (singleRep (firstRep m).val).testBit (permV (firstPerm m) v).val := by decide +kernel

def Independent (I : Finset V) : Prop := ∀ a ∈ I, ∀ b ∈ I, related a b = false

lemma independent_image (I : Finset V) (hI : Independent I) (p : Equiv.Perm V)
    (hp : Autom p) : Independent (I.image p) := by
  intro a ha b hb
  obtain ⟨u, hu, hua⟩ := Finset.mem_image.mp ha
  obtain ⟨v, hv, hvb⟩ := Finset.mem_image.mp hb
  rw [← hua, ← hvb]
  exact (hp u v).trans (hI u hu v hv)

lemma representative_check : ∀ r : Fin 34,
    Independent (decode (singleRep r.val)) →
    singleRep r.val = 0 ∨ singleRep r.val ∈ ([1,5,42,50,116] : List ℕ) := by
  unfold Independent
  decide +kernel

lemma independent_orbit (I : Finset V) (hI : Independent I) (hne : I.Nonempty) :
    ∃ p : Equiv.Perm V, Autom p ∧
      ∃ m ∈ ([1,5,42,50,116] : List ℕ), I.image p = decode m := by
  obtain ⟨m, hm⟩ := decodeSurj I
  let p := permEquiv (firstPerm m)
  have hp : Autom p := permVgood (firstPerm m)
  have hi : I.image p = decode (singleRep (firstRep m).val) := by
    rw [← hm]
    exact imageBits m.val _ (firstPerm m) (firstCheck m)
  have hind : Independent (decode (singleRep (firstRep m).val)) :=
    hi ▸ independent_image I hI p hp
  rcases representative_check (firstRep m) hind with hz | hc
  · have hn := hne.image p
    rw [hi, hz] at hn
    simp [decode] at hn
  · exact ⟨p, hp, _, hc, hi⟩

