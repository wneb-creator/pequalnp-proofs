pointing : ∀ (t u : Fin N), t ≠ u → ∀ g ∈ pay t, g ∈ pay u → ∃ p ∈ L t \ L u, (B t p ∩ L u).Nonempty
dis : ∀ t ∈ Lam, ∀ u ∈ Lam, t ≠ u → Disjoint (pay t) (pay u)
paid : Finset (Fin gates.length) := Lam.biUnion pay
