C : Circuit
correct : ∀ (x : Fin 8 → Bool), C.eval (List.ofFn x) = eight x
y : Fin 9 → Bool
w : List Bool := List.foldl ws (List.ofFn y) (List.map remap C.gates)
len : w.length = 9 + C.size
old :
  (List.foldl ws (List.ofFn y) (List.map remap C.gates)).getD (wire C.output) false =
    (List.foldl ws (List.ofFn (y ∘ pins)) C.gates).getD C.output false
oldEq : w.getD (wire C.output) false = eight (y ∘ pins)
hv : wire C.output < w.length
⊢ (List.foldl ws w
          [{ op := GateOp.or, inputs := [0, 6] }, { op := GateOp.or, inputs := [w.length, 2] },
            { op := GateOp.and, inputs := [1, w.length + 1] },
            { op := GateOp.or, inputs := [wire C.output, w.length + 2] }]).getD
      (w.length + 3) false =
    GeneralReaderCertificate.edge y
