def orbitMap (u v i : Fin 14) : Fin 14 :=
  ((table.getD u.val []).getD v.val []).getD i.val 0

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem orbit_checked :
    ∀ u v : Fin 14,
      Function.Bijective (orbitMap u v) ∧
      orbitMap u v u = 0 ∧
      orbitMap u v v = (if u = v then 0 else
        if (u.val < 7 ↔ v.val < 7) then 1 else if adjacent u v then 8 else 7) ∧
      ∀ i j : Fin 14, adjacent (orbitMap u v i) (orbitMap u v j) = adjacent i j := by
  intro u
  fin_cases u <;> decide +kernel

