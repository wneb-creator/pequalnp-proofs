  have hb2 : (b + 1) ^ 2 = 0 := by
    have hh := h5
    simp only [hq, hr, zero_mul, mul_zero, zero_pow (by decide : 4 ≠ 0), zero_pow (by decide : 3 ≠ 0), zero_pow (by decide : 2 ≠ 0), add_zero, sub_zero, zero_add, neg_zero] at hh
    linear_combination hh
  have ha1 : a + 1 = 0 := pow_eq_zero ha2
  have hb1 : b + 1 = 0 := pow_eq_zero hb2
  refine ⟨hp, hq, hr, ?_, ?_⟩
  · linear_combination ha1
  · linear_combination hb1

