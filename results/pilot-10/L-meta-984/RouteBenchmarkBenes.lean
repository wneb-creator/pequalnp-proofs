 def stage (lo keep d w : Nat) : Nat := ((w &&& lo) <<< d) ||| ((w >>> d) &&& lo) ||| (w &&& keep)
 def keptMask (lo d : Nat) : Nat := (2^256-1) ^^^ (lo ||| (lo <<< d))
 def step (lo d w : Nat) : Nat := if lo=0 then w else stage lo (keptMask lo d) d w
 def routeStages : List (Nat×Nat) → Nat → Nat
 | [],w => w
 | (lo,d)::rest,w => routeStages rest (step lo d w)
 def routeFixed (masks : List Nat) : Nat → Nat := routeStages (masks.zip [1,2,4,8,16,32,64,128,64,32,16,8,4,2,1])
 def mapBits (js : List Nat) (w : Nat) : Nat :=
 match js with
 | [] => 0
 | j::rest => Nat.bit (w.testBit j) (mapBits rest w)
