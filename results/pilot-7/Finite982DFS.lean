theorem next_two {forbidden m y a b rest} {conj ka kb : Bool} {s ws}
    (p : (a :: b :: rest).Perm ws)
    (fresh : Fresh forbidden (if conj then a &&& b else a ||| b) (a::b::rest))
    (h : RNatRun forbidden m y s
