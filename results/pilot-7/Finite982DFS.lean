theorem next_complete {forbidden m y t ws} (h : RNatRun forbidden m y t ws) :
    ∀ s, t = s+1 → ∀ zs, ws.Perm zs → ∀ f : Nat → List Nat → Bool,
      (∀ (t : Nat) ys, RNatRun forbidden m y s ys → f t ys = true) →
