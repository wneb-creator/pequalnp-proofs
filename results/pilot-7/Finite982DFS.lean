theorem next_one {forbidden m y a rest} {neg save : Bool} {s ws}
    (p : (a :: rest).Perm ws)
    (fresh : Fresh forbidden (if neg then a ^^^ m else a) (a::rest))
    (h : RNatRun forbidden m y s ((if neg then a ^^^ m else a) :: kept save a rest))
