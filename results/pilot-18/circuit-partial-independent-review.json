    "theorem": "PEqualNP.Outside.L_meta_1342_aux.circuit_partial_edge_bound",
    "conclusion": "A vertex cover T of G exists with |E(G)| + |T| <= C.gates.length + 1.",
    "hypotheses": [
      "K is a simple C4-free graph on Fin n; G is any simple graph on these vertices.",
      "Actual Circuit gates are AND or OR with at most two operands.",
      "Every true AND output implies an edge of K is present in that input.",
      "Output rejects all singleton inputs.",
      "Output accepts each pair input belonging to an edge of G."
    ],
    "no_exact_output_hypothesis": true,
    "no_clean_for_G_hypothesis": true,
    "no_abstract_model_assumptions": true,
    "G_subset_K": "No explicit premise is needed: singleton rejection and acceptance imply a target-edge AND birth; cleanliness makes that edge belong to K.",
    "proof_checks": [
      "Singleton rejection gives empty output support; accepted edges give root edge hits.",
      "Position 0 denotes false; clamping future or unavailable reads matches Circuit getD semantics.",
      "Unary/repeated operands use idempotence; empty OR is false; cleanliness rules out empty AND on the all-false input.",
      "root_read handles actual Circuit.eval and out-of-range outputs.",
      "Copied lemmas discharge all actual-circuit premises of total_from_model_partial."
    ]
